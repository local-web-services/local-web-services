module(
    name = "local_web_services",
    version = "0.1.0",
)

# ── Python ────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_python", version = "1.1.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "pip_core",
    python_version = "3.12",
    requirements_lock = "//core:requirements.txt",
)
use_repo(pip, "pip_core")

pip.parse(
    hub_name = "pip_python_sdk",
    python_version = "3.12",
    requirements_lock = "//lang/python/sdk:requirements.txt",
)
use_repo(pip, "pip_python_sdk")

# ── Go ────────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.40.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//lang/go/sdk:go.mod")
use_repo(go_deps, "com_github_aws_aws_sdk_go_v2")

# ── Java ──────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_jvm_external", version = "6.6")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "software.amazon.awssdk:dynamodb:2.26.0",
        "software.amazon.awssdk:sqs:2.26.0",
        "software.amazon.awssdk:s3:2.26.0",
        "software.amazon.awssdk:sns:2.26.0",
        "software.amazon.awssdk:sfn:2.26.0",
        "software.amazon.awssdk:ssm:2.26.0",
        "software.amazon.awssdk:secretsmanager:2.26.0",
        "org.junit.jupiter:junit-jupiter-api:5.10.2",
        "org.junit.jupiter:junit-jupiter-engine:5.10.2",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

# ── JavaScript / TypeScript ───────────────────────────────────────────────────
bazel_dep(name = "aspect_rules_js", version = "2.3.0")
bazel_dep(name = "aspect_rules_ts", version = "3.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.9.4")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)

npm.npm_translate_lock(
    name = "npm_typescript_sdk",
    pnpm_lock = "//lang/typescript/sdk:pnpm-lock.yaml",
    npmrc = "//lang/typescript/sdk:.npmrc",
)
use_repo(npm, "npm_typescript_sdk")

npm.npm_translate_lock(
    name = "npm_javascript_sdk",
    pnpm_lock = "//lang/javascript/sdk:pnpm-lock.yaml",
    npmrc = "//lang/javascript/sdk:.npmrc",
)
use_repo(npm, "npm_javascript_sdk")
