#!/usr/bin/env bash
# Pre-commit hook: mirrors all CI checks, scoped to staged paths.
# Install via: make install-hooks
# Bypass via:  git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

# ── Path detection (mirrors CI dorny/paths-filter) ────────────────────────────

PYTHON_CORE=false   # lang/python/core/**
PYTHON=false        # lang/python/**  (sdk + example)
TYPESCRIPT=false    # lang/typescript/**
JAVA=false          # lang/java/**
GO=false            # lang/go/**
SPECIFICATION=false # lang/specification/core/formal/**
SAMPLE_CDK=false    # sample-project/cdk/** or lang/python/core/**
SAMPLE_HCL=false    # sample-project/hcl/** or lang/python/core/**

echo "$STAGED" | grep -q "^lang/python/core/"               && PYTHON_CORE=true
echo "$STAGED" | grep -q "^lang/python/"                    && PYTHON=true
echo "$STAGED" | grep -q "^lang/typescript/"                && TYPESCRIPT=true
echo "$STAGED" | grep -q "^lang/java/"                      && JAVA=true
echo "$STAGED" | grep -q "^lang/go/"                        && GO=true
echo "$STAGED" | grep -q "^lang/specification/core/formal/" && SPECIFICATION=true
{ echo "$STAGED" | grep -q "^lang/python/core/" || echo "$STAGED" | grep -q "^sample-project/cdk/"; } && SAMPLE_CDK=true
{ echo "$STAGED" | grep -q "^lang/python/core/" || echo "$STAGED" | grep -q "^sample-project/hcl/"; } && SAMPLE_HCL=true

FAILED=0

run() {
  local label="$1"; shift
  echo ""
  echo "── $label ──────────────────────────────────────────"
  if "$@"; then
    echo "✓ $label passed"
  else
    echo "✗ $label FAILED"
    FAILED=1
  fi
}

run_in() {
  local label="$1"; local dir="$2"; shift 2
  echo ""
  echo "── $label ──────────────────────────────────────────"
  if (cd "$REPO_ROOT/$dir" && "$@"); then
    echo "✓ $label passed"
  else
    echo "✗ $label FAILED"
    FAILED=1
  fi
}

wait_for_ldk() {
  local port="${1:-3000}"
  for i in $(seq 1 60); do
    if curl -sf "http://localhost:$port/_ldk/status" \
        | python3 -c "import sys,json; d=json.load(sys.stdin); exit(0 if d.get('running') else 1)" 2>/dev/null; then
      echo "ldk is ready"
      return 0
    fi
    sleep 1
  done
  echo "ldk failed to start within 60s"
  return 1
}

# ── Python core ───────────────────────────────────────────────────────────────
if $PYTHON_CORE; then
  run "python-core lint"         make -C "$REPO_ROOT/lang/python/core" lint
  run "python-core format-check" make -C "$REPO_ROOT/lang/python/core" format-check
  run "python-core test"         make -C "$REPO_ROOT/lang/python/core" test
fi

# ── Python SDK + example ──────────────────────────────────────────────────────
if $PYTHON; then
  run "python-sdk test"     make -C "$REPO_ROOT/lang/python/sdk" test
  run_in "python-example test" "lang/python/example" uv run --extra test pytest
fi

# ── TypeScript core + SDK + example ──────────────────────────────────────────
if $TYPESCRIPT; then
  run_in "typescript-core lint"         "lang/typescript/core" npm run lint
  run_in "typescript-core format-check" "lang/typescript/core" npm run format-check
  run "typescript-core test"            make -C "$REPO_ROOT/lang/typescript/core" test
  run_in "typescript-sdk lint"          "lang/typescript/sdk" npm run lint
  run_in "typescript-sdk format-check"  "lang/typescript/sdk" npm run format-check
  run_in "typescript-sdk test"          "lang/typescript/sdk" npm test
fi

# ── Go core + SDK + example ───────────────────────────────────────────────────
if $GO; then
  run "go-sdk lint" make -C "$REPO_ROOT/lang/go/sdk" lint
fi

# ── Java core + SDK + example ─────────────────────────────────────────────────
if $JAVA; then
  run_in "java-core lint"    "lang/java/core" \
      env GRADLE_OPTS="-Dorg.gradle.project.buildDir=/tmp/gradle-build-lws-java-core" make lint
  run_in "java-sdk lint"     "lang/java/sdk" \
      env GRADLE_OPTS="-Dorg.gradle.project.buildDir=/tmp/gradle-build-lws-java-sdk" make lint
  run_in "java-example lint" "lang/java/example" \
      env GRADLE_OPTS="-Dorg.gradle.project.buildDir=/tmp/gradle-build-lws-java-example" make lint
fi

# ── FizzBee formal specs ──────────────────────────────────────────────────────
if $SPECIFICATION; then
  if ! command -v fizz &>/dev/null; then
    echo ""
    echo "── fizzbee-check (SKIPPED — fizz not in PATH) ───────────────────────"
  else
    SPEC_FAILED=0
    echo ""
    echo "── fizzbee-check ─────────────────────────────────────────────────────"
    while IFS= read -r spec; do
      echo "  Checking: $spec"
      if ! timeout 120 fizz "$REPO_ROOT/$spec"; then
        echo "  FAILED: $spec"
        SPEC_FAILED=1
      fi
    done < <(echo "$STAGED" | grep '\.fizz$')
    if [ $SPEC_FAILED -eq 0 ]; then
      echo "✓ fizzbee-check passed"
    else
      echo "✗ fizzbee-check FAILED"
      FAILED=1
    fi
  fi
fi

# ── Sample project CDK ────────────────────────────────────────────────────────
if $SAMPLE_CDK; then
  echo ""
  echo "── sample-project-cdk ────────────────────────────────────────────────"
  if [ ! -d "$REPO_ROOT/sample-project/cdk" ]; then
    echo "── sample-project-cdk (SKIPPED — directory does not exist in this worktree) ─"
  else
    LDK_PID=""
    _cleanup_cdk() { ldk stop 2>/dev/null || true; [ -n "$LDK_PID" ] && kill "$LDK_PID" 2>/dev/null || true; }
    trap _cleanup_cdk EXIT
    (cd "$REPO_ROOT/sample-project/cdk" && ldk dev) &
    LDK_PID=$!
    if wait_for_ldk 3000; then
      if (cd "$REPO_ROOT/sample-project/cdk" && npx cdk synth) && \
         (cd "$REPO_ROOT/sample-project/cdk" && ./test-orders.sh); then
        echo "✓ sample-project-cdk passed"
      else
        echo "✗ sample-project-cdk FAILED"
        FAILED=1
      fi
    else
      echo "✗ sample-project-cdk FAILED (ldk did not start)"
      FAILED=1
    fi
    ldk stop 2>/dev/null || true
    pkill -TERM -f "ldk dev" 2>/dev/null || true
    kill "$LDK_PID" 2>/dev/null || true
    wait "$LDK_PID" 2>/dev/null || true
    # Wait for port 3000 to be released before starting the next ldk instance
    for _i in $(seq 1 20); do nc -z localhost 3000 2>/dev/null || break; sleep 1; done
    LDK_PID=""
    trap - EXIT
  fi
fi

# ── Sample project HCL ────────────────────────────────────────────────────────
if $SAMPLE_HCL; then
  echo ""
  echo "── sample-project-hcl ────────────────────────────────────────────────"
  if [ ! -d "$REPO_ROOT/sample-project/hcl" ]; then
    echo "── sample-project-hcl (SKIPPED — directory does not exist in this worktree) ─"
  elif ! command -v tofu &>/dev/null; then
    echo "── sample-project-hcl (SKIPPED — tofu not in PATH) ─────────────────"
  else
    LDK_PID=""
    _cleanup_hcl() { ldk stop 2>/dev/null || true; [ -n "$LDK_PID" ] && kill "$LDK_PID" 2>/dev/null || true; }
    trap _cleanup_hcl EXIT
    (cd "$REPO_ROOT/sample-project/hcl" && ldk dev) &
    LDK_PID=$!
    if wait_for_ldk 3000; then
      # Remove stale state so tofu apply always starts from a clean slate
      # (ldk runs with persist:false, so each run is a fresh instance)
      rm -f "$REPO_ROOT/sample-project/hcl/terraform.tfstate"
      if (cd "$REPO_ROOT/sample-project/hcl" && tofu init) && \
         (cd "$REPO_ROOT/sample-project/hcl" && tofu apply -auto-approve) && \
         (cd "$REPO_ROOT/sample-project/hcl" && ./test-orders.sh); then
        echo "✓ sample-project-hcl passed"
      else
        echo "✗ sample-project-hcl FAILED"
        FAILED=1
      fi
    else
      echo "✗ sample-project-hcl FAILED (ldk did not start)"
      FAILED=1
    fi
    ldk stop 2>/dev/null || true
    pkill -TERM -f "ldk dev" 2>/dev/null || true
    kill "$LDK_PID" 2>/dev/null || true
    wait "$LDK_PID" 2>/dev/null || true
    LDK_PID=""
    trap - EXIT
  fi
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo ""
if [ $FAILED -ne 0 ]; then
  echo "Pre-commit checks FAILED. Fix the issues above or use git commit --no-verify to skip."
  exit 1
fi
echo "All pre-commit checks passed."
