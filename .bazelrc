# Common Bazel settings

# Use Bzlmod
common --enable_bzlmod

# requirements.txt files are generated by uv (see tools/sync_requirements.sh)

# Show test output on failure
test --test_output=errors

# Cache test results
test --cache_test_results=yes

# Stamp builds with version info
build --stamp

# Java toolchain — use local JDK for both building and tool execution
build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=local_jdk
build --tool_java_runtime_version=local_jdk
