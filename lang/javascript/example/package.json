{
  "name": "local-web-services-sdk-javascript-example-project",
  "version": "0.1.0",
  "description": "Example project showing how to test Step Functions with the local-web-services JavaScript SDK",
  "private": true,
  "scripts": {
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-sfn": "^3.600.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "local-web-services-javascript-sdk": "^0.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 120000
  }
}
