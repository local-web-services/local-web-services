<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
        https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Exclude test source directories from SpotBugs analysis -->
    <Match>
        <Source name="~.*src/test/.*"/>
    </Match>

    <!-- Exclude generated code patterns -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- ServerState uses public primitive fields intentionally: they are read and written
         by multiple handler/middleware classes in the same package and across packages. -->
    <Match>
        <Class name="io.localwebservices.lws.ServerState"/>
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    </Match>

    <!-- LogCapture background methods intentionally swallow exceptions to avoid
         crashing test threads when the log endpoint is unavailable or returns
         unexpected data. The REC_CATCH_EXCEPTION is a companion false positive. -->
    <Match>
        <Class name="io.localwebservices.lws.LogCapture"/>
        <Bug pattern="DE_MIGHT_IGNORE,REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- LambdaHandler.invokeFunction is an intentional fire-and-forget no-op fake that
         accepts the call for cross-service delivery but does not execute the Lambda
         function body. SpotBugs flags it as UC_USELESS_VOID_METHOD. -->
    <Match>
        <Class name="io.localwebservices.lws.providers.lambda.LambdaHandler"/>
        <Method name="invokeFunction"/>
        <Bug pattern="UC_USELESS_VOID_METHOD"/>
    </Match>

    <!-- StepFunctionsSyncExecutor.execute catches Exception broadly because it must handle
         both JSON parsing failures (IOException) and state machine execution errors from
         any service task bridge, which can throw arbitrary unchecked exceptions. The broad
         catch is intentional to return the original input on any failure. -->
    <Match>
        <Class name="io.localwebservices.lws.providers.stepfunctions.StepFunctionsSyncExecutor"/>
        <Method name="execute"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

</FindBugsFilter>
