---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# Formal specification for AWS S3 Glacier
# Models vault lifecycle, archive management, multipart uploads,
# job processing (retrieval and inventory), and vault inventory consistency

VAULT_NAMES = ["vault-a", "vault-b", "vault-c"]
ARCHIVE_IDS = ["archive-1", "archive-2", "archive-3", "archive-4"]
UPLOAD_IDS = ["upload-1", "upload-2"]
JOB_IDS = ["job-1", "job-2", "job-3", "inv-job-1", "inv-job-2"]
PART_NUMBERS = [1, 2, 3, 4]

action Init:
    vault_status = {}
    vault_archive_count = {}
    vault_inventory_fresh = {}
    archive_status = {}
    upload_status = {}
    upload_vault = {}
    upload_part = {}
    job_status = {}
    job_vault = {}
    job_type = {}
    job_archive = {}
    job_output_available = {}
    job_output_retrieved = {}

# step: a "glacier" "vault" is created
# result: the "glacier" "vault" will be "ACTIVE" with zero archives
# guard: the "glacier" "vault" did not already exist
# guard_violation: the "glacier" "vault" already existed
atomic action CreateVault:
    oneof vault in VAULT_NAMES:
        if vault not in vault_status:
            vault_status[vault] = "ACTIVE"
            vault_archive_count[vault] = 0
            vault_inventory_fresh[vault] = False

# step: an empty "glacier" "vault" is deleted
# result: the "glacier" "vault" will be "DELETED"
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "vault" had no archives
# guard_violation: the "glacier" "vault" had archives
# guard: the "glacier" "vault" had no in-progress jobs
# guard_violation: the "glacier" "vault" had in-progress jobs
atomic action DeleteVault:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                if vault_archive_count[vault] == 0:
                    if all([jid not in job_vault or job_vault[jid] != vault or job_status[jid] != "InProgress" for jid in JOB_IDS]):
                        vault_status[vault] = "DELETED"

# step: a "glacier" "archive" is uploaded to a "glacier" "vault"
# result: the "glacier" "archive" will be "STORED" and the "glacier" "vault" archive count will increase
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "archive" did not already exist
# guard_violation: the "glacier" "archive" already existed
atomic action UploadArchive:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                oneof archive in ARCHIVE_IDS:
                    arch_key = vault + "#" + archive
                    if arch_key not in archive_status:
                        archive_status[arch_key] = "STORED"
                        vault_archive_count[vault] = vault_archive_count[vault] + 1

# step: a "glacier" "archive" is deleted from a "glacier" "vault"
# result: the "glacier" "archive" will be deleted and the "glacier" "vault" archive count decreases
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "archive" existed
# guard_violation: the "glacier" "archive" did not exist
# guard: the "glacier" "archive" was "STORED"
# guard_violation_lifecycle: the "glacier" "archive" was not "STORED"
atomic action DeleteArchive:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                oneof archive in ARCHIVE_IDS:
                    arch_key = vault + "#" + archive
                    if arch_key in archive_status:
                        if archive_status[arch_key] == "STORED":
                            archive_status[arch_key] = "DELETED"
                            vault_archive_count[vault] = vault_archive_count[vault] - 1

# step: a multipart "glacier" "upload" is initiated for a "glacier" "vault"
# result: the "glacier" "upload" will be "InProgress"
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "upload" did not already exist
# guard_violation: the "glacier" "upload" already existed
atomic action InitiateMultipartUpload:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                oneof upload in UPLOAD_IDS:
                    if upload not in upload_status:
                        upload_status[upload] = "InProgress"
                        upload_vault[upload] = vault

# step: a part is uploaded for a multipart "glacier" "upload"
# result: the "glacier" "upload" part will be recorded
# guard: the "glacier" "upload" existed
# guard_violation: the "glacier" "upload" did not exist
# guard: the "glacier" "upload" was "InProgress"
# guard_violation_lifecycle: the "glacier" "upload" was not "InProgress"
# guard: the "glacier" "upload" part has not already been uploaded
# guard_violation: the "glacier" "upload" part has already been uploaded
atomic action UploadMultipartPart:
    oneof upload in UPLOAD_IDS:
        if upload in upload_status:
            if upload_status[upload] == "InProgress":
                oneof pnum in PART_NUMBERS:
                    pkey = upload + "#" + str(pnum)
                    if pkey not in upload_part:
                        upload_part[pkey] = True

# step: a multipart "glacier" "upload" is completed
# result: the "glacier" "upload" will be "Completed" and the assembled archive will be "STORED" in the "glacier" "vault"
# guard: the "glacier" "upload" existed
# guard_violation: the "glacier" "upload" did not exist
# guard: the "glacier" "upload" was "InProgress"
# guard_violation_lifecycle: the "glacier" "upload" was not "InProgress"
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "archive" slot is available
# guard_violation_capacity: the "glacier" "archive" slot is not available
atomic action CompleteMultipartUpload:
    oneof upload_id in UPLOAD_IDS:
        if upload_id in upload_status:
            if upload_status[upload_id] == "InProgress":
                vault_name = upload_vault[upload_id]
                if vault_name in vault_status:
                    if vault_status[vault_name] == "ACTIVE":
                        oneof archive_id in ARCHIVE_IDS:
                            arch_key = vault_name + "#" + archive_id
                            if arch_key not in archive_status:
                                archive_status[arch_key] = "STORED"
                                vault_archive_count[vault_name] = vault_archive_count[vault_name] + 1
                                upload_status[upload_id] = "Completed"

# step: a multipart "glacier" "upload" is aborted
# result: the "glacier" "upload" will be "Aborted"
# guard: the "glacier" "upload" existed
# guard_violation: the "glacier" "upload" did not exist
# guard: the "glacier" "upload" was "InProgress"
# guard_violation_lifecycle: the "glacier" "upload" was not "InProgress"
atomic action AbortMultipartUpload:
    oneof upload_id in UPLOAD_IDS:
        if upload_id in upload_status:
            if upload_status[upload_id] == "InProgress":
                upload_status[upload_id] = "Aborted"

# step: a "glacier" "archive" retrieval job is initiated
# result: the "glacier" "JOB" will be "InProgress" for the given archive
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "archive" existed
# guard_violation: the "glacier" "archive" did not exist
# guard: the "glacier" "archive" was "STORED"
# guard_violation_lifecycle: the "glacier" "archive" was not "STORED"
# guard: the "glacier" "job" slot is available
# guard_violation_capacity: the "glacier" "job" slot is not available
atomic action InitiateArchiveRetrievalJob:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                oneof archive in ARCHIVE_IDS:
                    arch_key = vault + "#" + archive
                    if arch_key in archive_status:
                        if archive_status[arch_key] == "STORED":
                            oneof jid in JOB_IDS:
                                if jid not in job_status:
                                    job_status[jid] = "InProgress"
                                    job_vault[jid] = vault
                                    job_type[jid] = "ArchiveRetrieval"
                                    job_archive[jid] = archive
                                    job_output_available[jid] = False
                                    job_output_retrieved[jid] = False

# step: a "glacier" "vault" inventory retrieval job is initiated
# result: the "glacier" "JOB" will be "InProgress" for the given "glacier" "vault"
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
# guard: the "glacier" "job" slot is available
# guard_violation_capacity: the "glacier" "job" slot is not available
atomic action InitiateInventoryRetrievalJob:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                oneof jid in JOB_IDS:
                    if jid not in job_status:
                        job_status[jid] = "InProgress"
                        job_vault[jid] = vault
                        job_type[jid] = "InventoryRetrieval"
                        job_archive[jid] = ""
                        job_output_available[jid] = False
                        job_output_retrieved[jid] = False

# fake_skip: internal
# step: a "glacier" "job" completes successfully
# result: the "glacier" "JOB" will be "Succeeded" and its output will be available
# guard: the "glacier" "job" existed
# guard_violation: the "glacier" "job" did not exist
# guard: the "glacier" "job" was "InProgress"
# guard_violation: the "glacier" "job" was not "InProgress"
atomic action JobSucceeds:
    oneof jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "InProgress":
                job_status[jid] = "Succeeded"
                job_output_available[jid] = True

# fake_skip: internal
# step: a "glacier" "job" fails
# result: the "glacier" "JOB" will be "Failed"
# guard: the "glacier" "job" existed
# guard_violation: the "glacier" "job" did not exist
# guard: the "glacier" "job" was "InProgress"
# guard_violation: the "glacier" "job" was not "InProgress"
atomic action JobFails:
    oneof jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "InProgress":
                job_status[jid] = "Failed"

# step: the output of a succeeded "glacier" "job" is retrieved
# result: the "glacier" "job" output will be marked as retrieved
# guard: the "glacier" "job" existed
# guard_violation: the "glacier" "job" did not exist
# guard: the "glacier" "job" was "Succeeded"
# guard_violation_lifecycle: the "glacier" "job" was not "Succeeded"
# guard: the "glacier" "job" output is available
# guard_violation: the "glacier" "job" output is not available
atomic action GetJobOutput:
    oneof jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "Succeeded":
                if job_output_available[jid] == True:
                    job_output_retrieved[jid] = True

# fake_skip: internal
# step: a "glacier" "vault" inventory is refreshed
# result: the "glacier" "vault" inventory will be marked as fresh
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" was "ACTIVE"
# guard_violation_lifecycle: the "glacier" "vault" was not "ACTIVE"
atomic action VaultInventoryRefresh:
    oneof vault in VAULT_NAMES:
        if vault in vault_status:
            if vault_status[vault] == "ACTIVE":
                vault_inventory_fresh[vault] = True

# check: every in-progress "glacier" "job" references an active "glacier" "vault"
always assertion InProgressJobReferencesActiveVault:
    for jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "InProgress":
                if jid in job_vault:
                    vault = job_vault[jid]
                    if vault in vault_status:
                        if vault_status[vault] == "DELETED":
                            return False
    return True

# check: "glacier" "vault" archive count is never negative
always assertion VaultArchiveCountNonNegative:
    for vault in VAULT_NAMES:
        if vault in vault_archive_count:
            if vault_archive_count[vault] < 0:
                return False
    return True

# check: all stored "glacier" "archive"s belong to an "ACTIVE" "glacier" "vault"
always assertion ArchivesHaveActiveParentVault:
    for arch_key in archive_status:
        if archive_status[arch_key] == "STORED":
            parts = arch_key.split("#")
            vault = parts[0]
            if vault not in vault_status:
                return False
            if vault_status[vault] == "DELETED":
                return False
    return True

# check: "glacier" "job" output is only available for succeeded "glacier" "job"s
always assertion JobOutputOnlyOnSuccess:
    for jid in JOB_IDS:
        if jid in job_output_available:
            if job_output_available[jid] == True:
                if job_status[jid] != "Succeeded":
                    return False
    return True

# check: every "glacier" "archive" retrieval "glacier" "job" references a non-empty "glacier" "archive" ID
always assertion ArchiveRetrievalJobHasArchive:
    for jid in JOB_IDS:
        if jid in job_type:
            if job_type[jid] == "ArchiveRetrieval":
                if job_archive[jid] == "":
                    return False
    return True
