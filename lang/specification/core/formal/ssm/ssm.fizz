---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 8
---
# SSM Parameter Store Formal Specification
# Models parameters with versioning, types, tags, and overwrite semantics.

PARAM_NAMES = ["param1", "param2"]
PARAM_TYPES = ["String", "SecureString"]
TAG_KEYS = ["env", "team"]

action Init:
    param_exists = {}
    param_value = {}
    param_type = {}
    param_version = {}
    param_tag = {}
    errors = []

# step: a "ssm" "parameter" is stored
# result: the "ssm" "parameter" will exist with version 1
# guard: the "ssm" "parameter" did not already exist or has been deleted
# guard_violation: the "ssm" "parameter" already existed
atomic action PutParameterCreate:
    oneof pname in PARAM_NAMES:
        if pname not in param_exists or param_exists[pname] == False:
            oneof ptype in PARAM_TYPES:
                param_exists[pname] = True
                param_value[pname] = "value1"
                param_type[pname] = ptype
                param_version[pname] = 1

# step: an existing "ssm" "parameter" value is updated
# result: the "ssm" "parameter" has a new value and an incremented version
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action PutParameterOverwrite:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                param_value[pname] = "value2"
                param_version[pname] = param_version[pname] + 1

# step: a "ssm" "parameter" is written without overwrite when it already exists
# result: a ParameterAlreadyExists error will be recorded
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action PutParameterNoOverwriteConflict:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                errors.append("ParameterAlreadyExists:" + pname)

# step: a "ssm" "parameter" is retrieved
# result: the "ssm" "parameter" value will be returned
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action GetParameter:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                pass

# step: multiple "ssm" "parameter"s are retrieved
# result: the "ssm" "parameter" values will be returned
atomic action GetParameters:
    pass

# step: "ssm" "parameter"s under a path are retrieved
# result: the "ssm" "parameter"s under the path will be returned
atomic action GetParametersByPath:
    pass

# step: "ssm" "parameter"s are described
# result: the "ssm" "parameter" metadata will be returned
atomic action DescribeParameters:
    pass

# step: a "ssm" "parameter" is deleted
# result: the "ssm" "parameter" no longer will exist
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action DeleteParameter:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                param_exists[pname] = False

# step: multiple "ssm" "parameter"s are deleted
# result: the "ssm" "parameter"s no longer exist
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action DeleteParameters:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                param_exists[pname] = False

# step: tags are added to a "ssm" "parameter"
# result: the tags are associated with the "ssm" "parameter"
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action AddTagsToResource:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                oneof tkey in TAG_KEYS:
                    param_tag[pname + "#" + tkey] = True

# step: tags are removed from a "ssm" "parameter"
# result: the tags are disassociated from the "ssm" "parameter"
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
# guard: the tag was associated with the "ssm" "parameter"
# guard_violation: the tag was not associated with the "ssm" "parameter"
# guard: the tag association was "ACTIVE"
# guard_violation: the tag association was not "ACTIVE"
atomic action RemoveTagsFromResource:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                oneof tkey in TAG_KEYS:
                    if (pname + "#" + tkey) in param_tag:
                        if param_tag[pname + "#" + tkey] == True:
                            param_tag[pname + "#" + tkey] = False

# step: tags for a "ssm" "parameter" are listed
# result: the list of tags will be returned
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" was "active"
# guard_violation: the "ssm" "parameter" was not "active"
atomic action ListTagsForResource:
    oneof pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] == True:
                pass

# check: every parameter version is a positive integer
always assertion VersionIsPositive:
    for pname in PARAM_NAMES:
        if pname in param_version:
            if param_version[pname] < 1:
                return False
    return True

# check: every parameter has a valid type (String, SecureString, or StringList)
always assertion TypeIsValid:
    valid_types = ["String", "SecureString", "StringList"]
    for pname in PARAM_NAMES:
        if pname in param_type:
            if param_type[pname] not in valid_types:
                return False
    return True

# check: param_exists values are always valid booleans
always assertion ParamExistsValuesValid:
    for pname in PARAM_NAMES:
        if pname in param_exists:
            if param_exists[pname] != True and param_exists[pname] != False:
                return False
    return True

# check: the error log only contains ParameterAlreadyExists entries
always assertion ErrorLogEntriesAreValid:
    for entry in errors:
        valid = False
        for pname in PARAM_NAMES:
            if entry == "ParameterAlreadyExists:" + pname:
                valid = True
        if not valid:
            return False
    return True
