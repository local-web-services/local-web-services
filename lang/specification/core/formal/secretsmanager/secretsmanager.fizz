---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
SECRET_NAMES = ["secret1", "secret2"]
TAG_KEYS = ["env"]

action Init:
    secret_status = {}
    secret_recovery_open = {}
    secret_current_version = {}
    secret_prev_version = {}
    secret_tag = {}
    next_version_id = 0

# step: a secret is created
# result: the secret is ACTIVE with an initial version
# guard: the secret does not already exist
# guard_violation: the secret already exists
atomic action CreateSecret:
    oneof sname in SECRET_NAMES:
        if sname not in secret_status:
            vid = "v" + str(next_version_id)
            secret_status[sname] = "ACTIVE"
            secret_recovery_open[sname] = False
            secret_current_version[sname] = vid
            secret_prev_version[sname] = ""
            next_version_id = next_version_id + 1

# step: a secret is deleted
# result: the secret is DELETED and the recovery window is open
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action DeleteSecret:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                secret_status[sname] = "DELETED"
                secret_recovery_open[sname] = True

# step: a deleted secret is restored within the recovery window
# result: the secret is ACTIVE again and the recovery window is closed
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is DELETED
# guard_violation_lifecycle: the secret is not DELETED
# guard: the recovery window is open
# guard_violation_lifecycle: the recovery window is not open
atomic action RestoreSecret:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "DELETED":
                if secret_recovery_open[sname]:
                    secret_status[sname] = "ACTIVE"
                    secret_recovery_open[sname] = False

# step: a secret is described
# result: the secret metadata is returned
# guard: the secret exists
# guard_violation: the secret does not exist
atomic action DescribeSecret:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            pass

# step: the current value of an active secret is retrieved
# result: the current secret value is returned
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action GetSecretValue:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                pass

# step: a new value is stored for an active secret
# result: the secret has a new current version and the previous version is retained
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action PutSecretValue:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                vid = "v" + str(next_version_id)
                secret_prev_version[sname] = secret_current_version[sname]
                secret_current_version[sname] = vid
                next_version_id = next_version_id + 1

# step: metadata or description for an active secret is updated
# result: the secret metadata is updated
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action UpdateSecret:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                pass

# step: all secrets are listed
# result: the list of secrets is returned
atomic action ListSecrets:
    pass

# step: tags are added to an active secret
# result: the specified tags are associated with the secret
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action TagResource:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                oneof tkey in TAG_KEYS:
                    secret_tag[sname + "#" + tkey] = True

# step: tags are removed from an active secret
# result: the specified tags are no longer associated with the secret
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action UntagResource:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                oneof tkey in TAG_KEYS:
                    secret_tag[sname + "#" + tkey] = False

# fake_skip: internal
# step: the recovery window for a deleted secret expires
# result: the secret can no longer be restored
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is DELETED
# guard_violation: the secret is not DELETED
# guard: the recovery window is open
# guard_violation: the recovery window is not open
atomic action RecoveryWindowExpires:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "DELETED":
                if secret_recovery_open[sname]:
                    secret_recovery_open[sname] = False

# fake_skip: internal
# step: an automatic rotation event occurs for an active secret
# result: a new secret version is created and the previous version is retained
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation: the secret is not ACTIVE
atomic action RotationEvent:
    oneof sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                vid = "v" + str(next_version_id)
                secret_prev_version[sname] = secret_current_version[sname]
                secret_current_version[sname] = vid
                next_version_id = next_version_id + 1

# check: every ACTIVE secret has a current version assigned
always assertion ActiveSecretHasCurrentVersion:
    for sname in secret_status:
        if secret_status[sname] == "ACTIVE":
            if secret_current_version[sname] == "":
                return False
    return True

# check: at most one current version exists per secret
always assertion AtMostOneCurrentVersionPerSecret:
    for sname in SECRET_NAMES:
        if sname in secret_current_version:
            if sname in secret_status:
                if secret_status[sname] == "ACTIVE":
                    if secret_current_version[sname] == "":
                        return False
    return True

# check: at most one previous version exists per secret
always assertion AtMostOnePreviousVersionPerSecret:
    for sname in SECRET_NAMES:
        if sname in secret_current_version:
            if sname in secret_prev_version:
                cv = secret_current_version[sname]
                pv = secret_prev_version[sname]
                if cv != "" and pv != "":
                    if cv == pv:
                        return False
    return True

# check: a deleted secret with a closed recovery window cannot be restored
always assertion DeletedSecretWithClosedWindowNotRestored:
    for sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                if secret_recovery_open[sname] == True:
                    return False
    return True

# check: all secret names are unique
always assertion SecretNamesAreUnique:
    for sname in secret_status:
        if sname not in SECRET_NAMES:
            return False
    return True

# check: all version identifiers are unique across secrets
always assertion VersionIdsAreUnique:
    seen = []
    for sname in SECRET_NAMES:
        if sname in secret_current_version:
            cv = secret_current_version[sname]
            if cv != "":
                if cv in seen:
                    return False
                seen.append(cv)
        if sname in secret_prev_version:
            pv = secret_prev_version[sname]
            if pv != "":
                if pv in seen:
                    return False
                seen.append(pv)
    return True

# check: every deleted secret with an open recovery window can still be restored or expired
always assertion DeletedSecretRecoveryWindowIsOpen:
    for sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "DELETED":
                if secret_recovery_open[sname] != True and secret_recovery_open[sname] != False:
                    return False
    return True

# check: every active secret has a current version assigned
always assertion ActiveSecretHasVersion:
    for sname in SECRET_NAMES:
        if sname in secret_status:
            if secret_status[sname] == "ACTIVE":
                if sname not in secret_current_version:
                    return False
                if secret_current_version[sname] == "":
                    return False
    return True
