---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 30
---
# EventBridge (events) Formal Specification
# Models event buses, rules, targets, event publishing, pattern matching, and target invocation.

BUS_NAMES = ["default", "bus-a"]
RULE_NAMES = ["rule-1"]
TARGET_IDS = ["target-lambda"]

action Init:
    bus_status = {}
    rule_status = {}
    rule_bus = {}
    rule_pattern_type = {}
    rule_target = {}
    dlq = []

# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof name in BUS_NAMES:
        if name not in bus_status:
            bus_status[name] = "ACTIVE"

# step: an "eventbridge" "bus" is deleted
# result: the "eventbridge" "bus" will be deleted
# guard: the "eventbridge" "bus" is not the default eventbridge bus
# guard_violation: the "eventbridge" "bus" is the default eventbridge bus
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: the "eventbridge" "bus" has no rules
# guard_violation: the "eventbridge" "bus" has rules
atomic action DeleteEventBus:
    oneof name in BUS_NAMES:
        if name != "default":
            if name in bus_status:
                if bus_status[name] == "ACTIVE":
                    if all([rule_name not in rule_bus or rule_bus[rule_name] != name for rule_name in RULE_NAMES]):
                        bus_status[name] = "DELETED"

# step: an "eventbridge" "bus" is described
# result: the "eventbridge" "bus" details will be returned
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation: the "eventbridge" "bus" was not "ACTIVE"
atomic action DescribeEventBus:
    oneof name in BUS_NAMES:
        if name in bus_status:
            if bus_status[name] == "ACTIVE":
                pass

# step: all "eventbridge" "bus"es are listed
# result: the list of "eventbridge" "bus"es will be returned
atomic action ListEventBuses:
    pass

# step: an "eventbridge" "rule" is created
# result: the "eventbridge" "rule" will be "ENABLED"
# guard: the "eventbridge" "rule" did not already exist
# guard_violation: the "eventbridge" "rule" already existed
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation: the "eventbridge" "bus" was not "ACTIVE"
atomic action PutRule:
    oneof rule_name in RULE_NAMES:
        if rule_name not in rule_status:
            oneof bus_name in BUS_NAMES:
                if bus_name in bus_status:
                    if bus_status[bus_name] == "ACTIVE":
                        oneof:
                            atomic:
                                rule_status[rule_name] = "ENABLED"
                                rule_bus[rule_name] = bus_name
                                rule_pattern_type[rule_name] = "EVENT_PATTERN"
                            atomic:
                                rule_status[rule_name] = "ENABLED"
                                rule_bus[rule_name] = bus_name
                                rule_pattern_type[rule_name] = "SCHEDULE"

# step: an "eventbridge" "rule" is deleted
# result: the "eventbridge" "rule" will be "DELETED"
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" is not already "DELETED"
# guard_violation: the "eventbridge" "rule" is already "DELETED"
# guard: the "eventbridge" "rule" has no active targets
# guard_violation: the "eventbridge" "rule" has active targets
atomic action DeleteRule:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] != "DELETED":
                if all([(rule_name + "#" + tid) not in rule_target or rule_target[rule_name + "#" + tid] == False for tid in TARGET_IDS]):
                    rule_status[rule_name] = "DELETED"

# step: an "eventbridge" "rule" is described
# result: the "eventbridge" "rule" details will be returned
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was not "DELETED"
# guard_violation: the "eventbridge" "rule" was "DELETED"
atomic action DescribeRule:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] != "DELETED":
                pass

# step: all rules on an "eventbridge" "bus" are listed
# result: the list of "eventbridge" "rule"s will be returned
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation: the "eventbridge" "bus" was not "ACTIVE"
atomic action ListRules:
    oneof bus_name in BUS_NAMES:
        if bus_name in bus_status:
            if bus_status[bus_name] == "ACTIVE":
                pass

# step: an "eventbridge" "rule" was "ENABLED"
# result: the "eventbridge" "rule" will be "ENABLED"
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was "DISABLED"
# guard_violation: the "eventbridge" "rule" was not "DISABLED"
atomic action EnableRule:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] == "DISABLED":
                rule_status[rule_name] = "ENABLED"

# step: an "eventbridge" "rule" was "DISABLED"
# result: the "eventbridge" "rule" will be "DISABLED"
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was "ENABLED"
# guard_violation: the "eventbridge" "rule" was not "ENABLED"
atomic action DisableRule:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] == "ENABLED":
                rule_status[rule_name] = "DISABLED"

# step: targets are added to an "eventbridge" "rule"
# result: the targets are associated with the "eventbridge" "rule"
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was not "DELETED"
# guard_violation: the "eventbridge" "rule" was "DELETED"
atomic action PutTargets:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] != "DELETED":
                oneof target_id in TARGET_IDS:
                    rule_target[rule_name + "#" + target_id] = True

# step: targets are removed from an "eventbridge" "rule"
# result: the targets are disassociated from the "eventbridge" "rule"
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was not "DELETED"
# guard_violation: the "eventbridge" "rule" was "DELETED"
# guard: the target is associated with the "eventbridge" "rule"
# guard_violation: the target is not associated with the "eventbridge" "rule"
# guard: the "eventbridge" "rule" target association was "ACTIVE"
# guard_violation: the "eventbridge" "rule" target association was not "ACTIVE"
atomic action RemoveTargets:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] != "DELETED":
                oneof target_id in TARGET_IDS:
                    if (rule_name + "#" + target_id) in rule_target:
                        if rule_target[rule_name + "#" + target_id] == True:
                            rule_target[rule_name + "#" + target_id] = False

# step: targets for an "eventbridge" "rule" are listed
# result: the list of "eventbridge" "rule" targets will be returned
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was not "DELETED"
# guard_violation: the "eventbridge" "rule" was "DELETED"
atomic action ListTargetsByRule:
    oneof rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] != "DELETED":
                pass

# step: events are published to an "eventbridge" "bus"
# result: matching enabled "eventbridge" "rule"s will route the event to their targets
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation: the "eventbridge" "bus" was not "ACTIVE"
# guard: an "eventbridge" "rule" is associated with the "eventbridge" "bus"
# guard_violation: no eventbridge rule is associated with the "eventbridge" "bus"
# guard: the "eventbridge" "rule"'s event eventbridge bus matches
# guard_violation: the "eventbridge" "rule"'s event eventbridge bus does not match
# guard: the "eventbridge" "rule" was "ENABLED"
# guard_violation: the "eventbridge" "rule" was not "ENABLED"
# guard: a target is associated with the "eventbridge" "rule"
# guard_violation: no target is associated with the "eventbridge" "rule"
# guard: the "eventbridge" "rule" target association was "ACTIVE"
# guard_violation: the "eventbridge" "rule" target association was not "ACTIVE"
atomic action PutEvents:
    oneof bus_name in BUS_NAMES:
        if bus_name in bus_status:
            if bus_status[bus_name] == "ACTIVE":
                oneof rule_name in RULE_NAMES:
                    if rule_name in rule_bus:
                        if rule_bus[rule_name] == bus_name:
                            if rule_status[rule_name] == "ENABLED":
                                oneof target_id in TARGET_IDS:
                                    if (rule_name + "#" + target_id) in rule_target:
                                        if rule_target[rule_name + "#" + target_id] == True:
                                            if len(dlq) < 2:
                                                oneof:
                                                    pass
                                                    dlq.append(rule_name + "#" + target_id)

# fake_skip: internal
# step: a dead-letter "eventbridge" "dead-letter queue" entry is retried or discarded
# result: the entry will be removed from the "eventbridge" "dead-letter queue"
# guard: the "eventbridge" "dead-letter queue" was not empty
# guard_violation: the "eventbridge" "dead-letter queue" was empty
atomic action RetryDeadLetter:
    if len(dlq) > 0:
        oneof entry in dlq:
            oneof:
                dlq.remove(entry)
                pass

# check: every "eventbridge" "bus" has a valid status (ACTIVE or DELETED)
always assertion EventBusStatusValid:
    for name in BUS_NAMES:
        if name in bus_status:
            if bus_status[name] not in ["ACTIVE", "DELETED"]:
                return False
    return True

# check: every "eventbridge" "rule" has a valid status (ENABLED, DISABLED, or DELETED)
always assertion RuleStatusValid:
    for rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] not in ["ENABLED", "DISABLED", "DELETED"]:
                return False
    return True

# check: every "eventbridge" "rule" has a valid pattern type (EVENT_PATTERN or SCHEDULE)
always assertion RulePatternTypeValid:
    for rule_name in RULE_NAMES:
        if rule_name in rule_pattern_type:
            if rule_pattern_type[rule_name] not in ["EVENT_PATTERN", "SCHEDULE"]:
                return False
    return True

# check: every "eventbridge" "rule" references an "eventbridge" "bus" that exists
always assertion RuleBusExists:
    for rule_name in RULE_NAMES:
        if rule_name in rule_bus:
            bus = rule_bus[rule_name]
            if bus not in bus_status:
                return False
    return True

# check: the default "eventbridge" "bus" cannot be deleted
always assertion DefaultBusCannotBeDeleted:
    if "default" in bus_status:
        if bus_status["default"] == "DELETED":
            return False
    return True

# check: an "eventbridge" "rule" can only be deleted when it has no targets
always assertion DeleteRuleRequiresNoTargets:
    for rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] == "DELETED":
                for tid in TARGET_IDS:
                    key = rule_name + "#" + tid
                    if key in rule_target:
                        if rule_target[key] == True:
                            return False
    return True

# check: no enabled "eventbridge" "rule" references a deleted "eventbridge" "bus"
always assertion RuleOnlyEnabledOnActiveBus:
    for rule_name in RULE_NAMES:
        if rule_name in rule_status:
            if rule_status[rule_name] == "ENABLED":
                if rule_name in rule_bus:
                    bus = rule_bus[rule_name]
                    if bus in bus_status:
                        if bus_status[bus] != "ACTIVE":
                            return False
    return True

# check: the "eventbridge" "dead-letter queue" never exceeds its bounded capacity
always assertion DeadLetterQueueBounded:
    if len(dlq) > 2:
        return False
    return True
