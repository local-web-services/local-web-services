---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
# DynamoDB Formal Specification
# Models tables, items, GSI/LSI indexes, transactions, and throttling.
#
# FizzBee grammar rules:
#   - Iterate over a fixed list/set, NOT over the dict being mutated
#   - Only single-level subscript assignments: dict[key] = x is OK
#   - del dict[key] is NOT supported: use sentinel values instead
#   - No inline comments (comments on their own line only)
#   - No comments inside oneof: blocks

TABLE_NAMES = ["TableA", "TableB"]
PK_VALUES = ["pk1", "pk2"]
SK_VALUES = ["sk1"]

action Init:
    # table_status[name] = "CREATING" | "ACTIVE" | "DELETED"
    table_status = {}

    # items[table+"#"+pk+"#"+sk] = True (exists) or False (deleted)
    items = {}

    # gsi_pending[name] = count of writes not yet propagated to GSI
    gsi_pending = {}

    # transaction_status = "" | "PENDING" | "COMMITTED" | "ROLLED_BACK"
    transaction_status = ""
    transaction_table = ""

    throttle_reads = False
    throttle_writes = False

# step: a "dynamodb" "table" is created
# result: the "dynamodb" "table" will be in "CREATING" state
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTable:
    oneof name in TABLE_NAMES:
        if name not in table_status:
            table_status[name] = "CREATING"
            gsi_pending[name] = 0

# fake_skip: internal
# step: a "dynamodb" "table" finishes creating and becomes active
# result: the "dynamodb" "table" will be "ACTIVE" and ready for reads and writes
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "CREATING"
# guard_violation: the "dynamodb" "table" was not "CREATING"
atomic action ActivateTable:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "CREATING":
                table_status[name] = "ACTIVE"

# step: a "dynamodb" "table" is deleted
# result: the "dynamodb" "table" will be in "DELETING" state and all its items will be removed
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
atomic action DeleteTable:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                table_status[name] = "DELETING"
                for pk in PK_VALUES:
                    for sk in SK_VALUES:
                        item_key = name + "#" + pk + "#" + sk
                        if item_key in items:
                            items[item_key] = False
                if transaction_table == name:
                    transaction_status = ""
                    transaction_table = ""

# fake_skip: internal
# step: a "dynamodb" "table" deletion completes
# result: the "dynamodb" "table" will be "DELETED"
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "DELETING"
# guard_violation: the "dynamodb" "table" was not "DELETING"
atomic action FinishDeleteTable:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "DELETING":
                table_status[name] = "DELETED"

# step: a "dynamodb" "table" is described
# result: the "dynamodb" "table" metadata will be returned
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation: the "dynamodb" "table" was not "ACTIVE"
atomic action DescribeTable:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                pass

# step: all "dynamodb" "table"s are listed
# result: the list of "dynamodb" "table"s will be returned
atomic action ListTables:
    pass

# step: a "dynamodb" "item" is written to the "dynamodb" "table"
# result: the "dynamodb" "item" will exist in the "dynamodb" "table" and GSI propagation will be pending
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "write" throttling was not active
# guard_violation_capacity: "dynamodb" "write" throttling was active
atomic action PutItem:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_writes:
                    oneof pk in PK_VALUES:
                        oneof sk in SK_VALUES:
                            item_key = name + "#" + pk + "#" + sk
                            items[item_key] = True
                            gsi_pending[name] = gsi_pending[name] + 1

# step: a "dynamodb" "item" is conditionally written to the "dynamodb" "table"
# result: the "dynamodb" "item" will be written if the condition holds, otherwise the write will be rejected
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "write" throttling was not active
# guard_violation_capacity: "dynamodb" "write" throttling was active
atomic action ConditionalPutItem:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_writes:
                    oneof pk in PK_VALUES:
                        oneof sk in SK_VALUES:
                            item_key = name + "#" + pk + "#" + sk
                            oneof:
                                items[item_key] = True
                                pass

# step: a "dynamodb" "item" is read from the "dynamodb" "table"
# result: the "dynamodb" "item" value will be returned
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "read" throttling was not active
# guard_violation_capacity: "dynamodb" "read" throttling was active
atomic action GetItem:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_reads:
                    pass

# step: an existing "dynamodb" "item" is updated in the "dynamodb" "table"
# result: the "dynamodb" "item" will be updated or unchanged (conditional update)
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "write" throttling was not active
# guard_violation_capacity: "dynamodb" "write" throttling was active
# guard: the "dynamodb" "item" existed
# guard_violation: the "dynamodb" "item" did not exist
# guard: the "dynamodb" "item" was present
# guard_violation: the "dynamodb" "item" was not present
atomic action UpdateItem:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_writes:
                    oneof pk in PK_VALUES:
                        oneof sk in SK_VALUES:
                            item_key = name + "#" + pk + "#" + sk
                            if item_key in items:
                                if items[item_key] == True:
                                    oneof:
                                        items[item_key] = True
                                        pass

# step: an existing "dynamodb" "item" is deleted from the "dynamodb" "table"
# result: the "dynamodb" "item" will be "DELETED" or unchanged (conditional delete)
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "write" throttling was not active
# guard_violation_capacity: "dynamodb" "write" throttling was active
# guard: the "dynamodb" "item" existed
# guard_violation: the "dynamodb" "item" did not exist
# guard: the "dynamodb" "item" was present
# guard_violation: the "dynamodb" "item" was not present
atomic action DeleteItem:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_writes:
                    oneof pk in PK_VALUES:
                        oneof sk in SK_VALUES:
                            item_key = name + "#" + pk + "#" + sk
                            if item_key in items:
                                if items[item_key] == True:
                                    oneof:
                                        items[item_key] = False
                                        pass

# step: "dynamodb" "item"s are queried from the "dynamodb" "table" by key
# result: matching "dynamodb" "item"s will be returned
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "read" throttling was not active
# guard_violation_capacity: "dynamodb" "read" throttling was active
atomic action Query:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_reads:
                    pass

# step: all "dynamodb" "item"s in the "dynamodb" "table" are scanned
# result: all "dynamodb" "item"s will be returned
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "read" throttling was not active
# guard_violation_capacity: "dynamodb" "read" throttling was active
atomic action Scan:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_reads:
                    pass

# step: a transactional write is initiated across one or more items in a "dynamodb" "table"
# result: the "dynamodb" "transaction" will be "PENDING"
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: "dynamodb" "write" throttling was not active
# guard_violation_capacity: "dynamodb" "write" throttling was active
# guard: no "dynamodb" "transaction" was currently in progress
# guard_violation: a "dynamodb" "transaction" was currently in progress
atomic action TransactWriteItems:
    oneof name in TABLE_NAMES:
        if name in table_status:
            if table_status[name] == "ACTIVE":
                if not throttle_writes:
                    if transaction_status == "":
                        transaction_status = "PENDING"
                        transaction_table = name

# fake_skip: internal
# step: a pending "dynamodb" "transaction" resolves non-deterministically
# result: the "dynamodb" "transaction" will be "COMMITTED" or "ROLLED_BACK"
# guard: a "dynamodb" "transaction" was "PENDING"
# guard_violation: no "dynamodb" "transaction" was "PENDING"
# guard: the transaction's "dynamodb" "table" existed
# guard_violation: the transaction's "dynamodb" "table" did not exist
# guard: the transaction's "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the transaction's "dynamodb" "table" was not "ACTIVE"
atomic action CommitTransaction:
    if transaction_status == "PENDING":
        if transaction_table in table_status:
            if table_status[transaction_table] == "ACTIVE":
                oneof:
                    transaction_status = "COMMITTED"
                    transaction_status = "ROLLED_BACK"

# fake_skip: internal
# step: a committed "dynamodb" "transaction" is cleared
# result: the "dynamodb" "transaction" "slot" will be free
# guard: the "dynamodb" "transaction" was "COMMITTED"
# guard_violation: the "dynamodb" "transaction" was not "COMMITTED"
atomic action ClearTransaction:
    if transaction_status == "COMMITTED":
        transaction_status = ""
        transaction_table = ""

# fake_skip: internal
# step: a rolled-back "dynamodb" "transaction" is cleared
# result: the "dynamodb" "transaction" "slot" will be free
# guard: the "dynamodb" "transaction" was "ROLLED_BACK"
# guard_violation: the "dynamodb" "transaction" was not "ROLLED_BACK"
atomic action ClearRolledBack:
    if transaction_status == "ROLLED_BACK":
        transaction_status = ""
        transaction_table = ""

# fake_skip: internal
# step: a "dynamodb" "GSI" catches up with pending write propagation
# result: the "dynamodb" "GSI" will be consistent with the "dynamodb" "table"
# guard: the "dynamodb" "table" had pending GSI propagation
# guard_violation: the "dynamodb" "table" did not have pending GSI propagation
# guard: there were writes pending propagation to the "dynamodb" "GSI"
# guard_violation: there were no writes pending propagation to the "dynamodb" "GSI"
atomic action PropagateGSI:
    oneof name in TABLE_NAMES:
        if name in gsi_pending:
            if gsi_pending[name] > 0:
                gsi_pending[name] = 0

# step: "dynamodb" "read" throttling is toggled on or off
# result: "dynamodb" reads will be throttled or unthrottled
atomic action SetThrottleReads:
    oneof:
        throttle_reads = True
        throttle_reads = False

# step: "dynamodb" "write" throttling is toggled on or off
# result: "dynamodb" writes will be throttled or unthrottled
atomic action SetThrottleWrites:
    oneof:
        throttle_writes = True
        throttle_writes = False

# check: every "dynamodb" "table" has a valid status (CREATING, ACTIVE, or DELETED)
always assertion TableStatusValid:
    for name in table_status:
        if table_status[name] not in ["CREATING", "ACTIVE", "DELETING", "DELETED"]:
            return False
    return True

# check: "dynamodb" "GSI" pending write count is never negative
always assertion GsiPendingNonNegative:
    for name in gsi_pending:
        if gsi_pending[name] < 0:
            return False
    return True

# check: "dynamodb" "transaction" status is always a valid value
always assertion TransactionStatusValid:
    if transaction_status not in ["", "PENDING", "COMMITTED", "ROLLED_BACK"]:
        return False
    return True

# check: a pending "dynamodb" "transaction" always references an existing "dynamodb" "table"
always assertion TransactionTableExists:
    if transaction_status == "PENDING":
        if transaction_table not in table_status:
            return False
    return True

# check: "dynamodb" "item"s only exist in non-deleted "dynamodb" "table"s
always assertion ItemsOnlyInActiveTables:
    for item_key in items:
        if items[item_key] == True:
            parts = item_key.split("#")
            name = parts[0]
            if name in table_status:
                if table_status[name] == "DELETED":
                    return False
    return True

# check: deleted "dynamodb" "table"s are never the target of a pending "dynamodb" "transaction"
always assertion DeletedTableNotWritable:
    for name in table_status:
        if table_status[name] == "DELETED":
            if transaction_table == name:
                if transaction_status == "PENDING":
                    return False
    return True

