---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 20
---
# Formal specification for AWS S3 Tables (s3tables)
# Models table bucket lifecycle, namespace lifecycle, table lifecycle,
# Apache Iceberg table format (snapshots, schema evolution),
# maintenance configuration, table policies, and background compaction

BUCKET_NAMES = ["bucket-a", "bucket-b"]
NS_NAMES = ["ns-1", "ns-2"]
TABLE_NAMES = ["table-1", "table-2", "table-3"]
SNAPSHOT_IDS = ["snap-1", "snap-2", "snap-3", "snap-4"]

action Init:
    bucket_status = {}

    ns_status = {}

    table_status = {}
    table_schema_version = {}
    table_snapshot_count = {}

    snapshot_status = {}

    maintenance_compaction = {}

    table_policy_exists = {}

# step: a "s3 tables" "bucket" is created
# result: the "s3 tables" "bucket" will be in "CREATING" state
# guard: the "s3 tables" "bucket" did not already exist
# guard_violation: the "s3 tables" "bucket" already existed
atomic action CreateTableBucket:
    oneof bname in BUCKET_NAMES:
        if bname not in bucket_status:
            bucket_status[bname] = "CREATING"

# fake_skip: internal
# step: a "s3 tables" "bucket" finishes creating
# result: the "s3 tables" "bucket" will be "ACTIVE"
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "CREATING"
# guard_violation: the "s3 tables" "bucket" was not "CREATING"
atomic action FinishCreatingTableBucket:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "CREATING":
                bucket_status[bname] = "ACTIVE"

# step: a "s3 tables" "bucket" is deleted
# result: the "s3 tables" "bucket" will be in "DELETING" state
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "bucket" was not "ACTIVE"
# guard: the "s3 tables" "bucket" had no active namespaces
# guard_violation: the "s3 tables" "bucket" had active namespaces
atomic action DeleteTableBucket:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                if all([bname + "#" + ns not in ns_status or ns_status[bname + "#" + ns] != "ACTIVE" for ns in NS_NAMES]):
                    bucket_status[bname] = "DELETING"

# fake_skip: internal
# step: a "s3 tables" "bucket" finishes being deleted
# result: the "s3 tables" "bucket" will be "DELETED" and all its namespaces and tables will be deleted
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "DELETING"
# guard_violation: the "s3 tables" "bucket" was not "DELETING"
# guard: the "s3 tables" "namespace" existed
# guard_violation: the "s3 tables" "namespace" did not exist
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
atomic action FinishDeletingTableBucket:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "DELETING":
                bucket_status[bname] = "DELETED"
                for ns in NS_NAMES:
                    ns_key = bname + "#" + ns
                    if ns_key in ns_status:
                        ns_status[ns_key] = "DELETED"
                        for tname in TABLE_NAMES:
                            tkey = bname + "#" + ns + "#" + tname
                            if tkey in table_status:
                                table_status[tkey] = "DELETED"

# step: a "s3 tables" "namespace" is created in a "s3 tables" "bucket"
# result: the "s3 tables" "namespace" will be "ACTIVE"
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "bucket" was not "ACTIVE"
# guard: the "s3 tables" "namespace" did not already exist
# guard_violation: the "s3 tables" "namespace" already existed
atomic action CreateNamespace:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof ns in NS_NAMES:
                    ns_key = bname + "#" + ns
                    if ns_key not in ns_status:
                        ns_status[ns_key] = "ACTIVE"

# step: a "s3 tables" "namespace" is deleted from a "s3 tables" "bucket"
# result: the "s3 tables" "namespace" will be in "DELETING" state
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "bucket" was not "ACTIVE"
# guard: the "s3 tables" "namespace" existed
# guard_violation: the "s3 tables" "namespace" did not exist
# guard: the "s3 tables" "namespace" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "namespace" was not "ACTIVE"
# guard: the "s3 tables" "namespace" had no active tables
# guard_violation: the "s3 tables" "namespace" had active tables
atomic action DeleteNamespace:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof ns in NS_NAMES:
                    ns_key = bname + "#" + ns
                    if ns_key in ns_status:
                        if ns_status[ns_key] == "ACTIVE":
                            if all([bname + "#" + ns + "#" + tname not in table_status or table_status[bname + "#" + ns + "#" + tname] != "ACTIVE" for tname in TABLE_NAMES]):
                                ns_status[ns_key] = "DELETING"

# fake_skip: internal
# step: a "s3 tables" "namespace" finishes being deleted
# result: the "s3 tables" "namespace" will be deleted and all its tables will be deleted
# guard: the "s3 tables" "namespace" existed
# guard_violation: the "s3 tables" "namespace" did not exist
# guard: the "s3 tables" "namespace" was "DELETING"
# guard_violation: the "s3 tables" "namespace" was not "DELETING"
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
atomic action FinishDeletingNamespace:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            ns_key = bname + "#" + ns
            if ns_key in ns_status:
                if ns_status[ns_key] == "DELETING":
                    ns_status[ns_key] = "DELETED"
                    for tname in TABLE_NAMES:
                        tkey = bname + "#" + ns + "#" + tname
                        if tkey in table_status:
                            table_status[tkey] = "DELETED"

# step: a "s3 tables" "table" is created in a "s3 tables" "namespace"
# result: the "s3 tables" "table" will be in "CREATING" state
# guard: the "s3 tables" "bucket" existed
# guard_violation: the "s3 tables" "bucket" did not exist
# guard: the "s3 tables" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "bucket" was not "ACTIVE"
# guard: the "s3 tables" "namespace" existed
# guard_violation: the "s3 tables" "namespace" did not exist
# guard: the "s3 tables" "namespace" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "namespace" was not "ACTIVE"
# guard: the "s3 tables" "table" did not already exist
# guard_violation: the "s3 tables" "table" already existed
atomic action CreateTable:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof ns in NS_NAMES:
                    ns_key = bname + "#" + ns
                    if ns_key in ns_status:
                        if ns_status[ns_key] == "ACTIVE":
                            oneof tname in TABLE_NAMES:
                                tkey = bname + "#" + ns + "#" + tname
                                if tkey not in table_status:
                                    table_status[tkey] = "CREATING"
                                    table_schema_version[tkey] = 1
                                    table_snapshot_count[tkey] = 0
                                    maintenance_compaction[tkey] = True
                                    table_policy_exists[tkey] = False

# fake_skip: internal
# step: a "s3 tables" "table" finishes creating
# result: the "s3 tables" "table" will be "ACTIVE"
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "CREATING"
# guard_violation: the "s3 tables" "table" was not "CREATING"
atomic action FinishCreatingTable:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "CREATING":
                        table_status[tkey] = "ACTIVE"

# step: a "s3 tables" "table" is deleted
# result: the "s3 tables" "table" will be in "DELETING" state
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
atomic action DeleteTable:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        table_status[tkey] = "DELETING"

# fake_skip: internal
# step: a "s3 tables" "table" finishes being deleted
# result: the "s3 tables" "table" will be "DELETED" and all its snapshots will be deleted
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "DELETING"
# guard_violation: the "s3 tables" "table" was not "DELETING"
# guard: the "s3 tables" "snapshot" existed
# guard_violation: the "s3 tables" "snapshot" did not exist
atomic action FinishDeletingTable:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "DELETING":
                        table_status[tkey] = "DELETED"
                        for snap in SNAPSHOT_IDS:
                            snap_key = tkey + "#" + snap
                            if snap_key in snapshot_status:
                                snapshot_status[snap_key] = "DELETED"

# step: a "s3 tables" "snapshot" is created for a "s3 tables" "table"
# result: the "s3 tables" "snapshot" will be "ACTIVE" and the "s3 tables" "table" snapshot count will increase
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
# guard: the "s3 tables" "snapshot" did not already exist
# guard_violation: the "s3 tables" "snapshot" already existed
atomic action CreateSnapshot:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        oneof snap in SNAPSHOT_IDS:
                            snap_key = tkey + "#" + snap
                            if snap_key not in snapshot_status:
                                snapshot_status[snap_key] = "ACTIVE"
                                table_snapshot_count[tkey] = table_snapshot_count[tkey] + 1

# step: a "s3 tables" "table"'s schema is evolved
# result: the "s3 tables" "table" schema version will be incremented
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
atomic action EvolveSchema:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        table_schema_version[tkey] = table_schema_version[tkey] + 1

# step: maintenance configuration is applied to a "s3 tables" "table"
# result: compaction will be enabled for the "s3 tables" "table"
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
atomic action PutTableMaintenanceConfiguration:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        maintenance_compaction[tkey] = True

# step: a policy is attached to a "s3 tables" "table"
# result: the "s3 tables" "table" has a policy
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
atomic action PutTablePolicy:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        table_policy_exists[tkey] = True

# step: a "s3 tables" "table"'s policy is deleted
# result: the "s3 tables" "table" has no policy
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
# guard: the "s3 tables" "table" has a policy
# guard_violation: the "s3 tables" "table" does not have a policy
atomic action DeleteTablePolicy:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        if table_policy_exists[tkey] == True:
                            table_policy_exists[tkey] = False

# step: compaction is started on a "s3 tables" "table"
# result: the "s3 tables" "table" will be in "MAINTENANCE" state
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
# guard: compaction was "ENABLED" for the "s3 tables" "table"
# guard_violation: compaction was not "ENABLED" for the "s3 tables" "table"
atomic action StartCompaction:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        if maintenance_compaction[tkey] == True:
                            table_status[tkey] = "MAINTENANCE"

# fake_skip: internal
# step: compaction finishes on a "s3 tables" "table"
# result: the "s3 tables" "table" returns to "ACTIVE" state
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was in "MAINTENANCE" state
# guard_violation_lifecycle: the "s3 tables" "table" is not in MAINTENANCE state
atomic action FinishCompaction:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "MAINTENANCE":
                        table_status[tkey] = "ACTIVE"

# step: an expired s3 tables snapshot is removed from a "s3 tables" "table"
# result: the "s3 tables" "snapshot" will be "DELETED" and the "s3 tables" "table" snapshot count will decrease
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" was not "ACTIVE"
# guard: the "s3 tables" "table" has more than one s3 tables snapshot
# guard_violation: the "s3 tables" "table" had one or fewer snapshots
# guard: the "s3 tables" "snapshot" existed
# guard_violation: the "s3 tables" "snapshot" did not exist
# guard: the "s3 tables" "snapshot" was "ACTIVE"
# guard_violation: the "s3 tables" "snapshot" was not "ACTIVE"
atomic action ExpireSnapshot:
    oneof bname in BUCKET_NAMES:
        oneof ns in NS_NAMES:
            oneof tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_status:
                    if table_status[tkey] == "ACTIVE":
                        if table_snapshot_count[tkey] > 1:
                            oneof snap in SNAPSHOT_IDS:
                                snap_key = tkey + "#" + snap
                                if snap_key in snapshot_status:
                                    if snapshot_status[snap_key] == "ACTIVE":
                                        snapshot_status[snap_key] = "DELETED"
                                        table_snapshot_count[tkey] = table_snapshot_count[tkey] - 1

# check: a "s3 tables" "bucket" in "DELETING" state has no "ACTIVE" "s3 tables" "namespace"s
always assertion BucketDeletionRequiresNoNamespaces:
    for bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "DELETING":
                for ns in NS_NAMES:
                    ns_key = bname + "#" + ns
                    if ns_key in ns_status:
                        if ns_status[ns_key] == "ACTIVE":
                            return False
    return True

# check: a "s3 tables" "namespace" in "DELETING" state has no "ACTIVE" "s3 tables" "table"s
always assertion NamespaceDeletionRequiresNoTables:
    for bname in BUCKET_NAMES:
        for ns in NS_NAMES:
            ns_key = bname + "#" + ns
            if ns_key in ns_status:
                if ns_status[ns_key] == "DELETING":
                    for tname in TABLE_NAMES:
                        tkey = bname + "#" + ns + "#" + tname
                        if tkey in table_status:
                            if table_status[tkey] == "ACTIVE":
                                return False
    return True

# check: "s3 tables" "table" snapshot count is never negative
always assertion SnapshotCountNonNegative:
    for bname in BUCKET_NAMES:
        for ns in NS_NAMES:
            for tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_snapshot_count:
                    if table_snapshot_count[tkey] < 0:
                        return False
    return True

# check: "s3 tables" "table" schema version is always at least one
always assertion SchemaVersionAtLeastOne:
    for bname in BUCKET_NAMES:
        for ns in NS_NAMES:
            for tname in TABLE_NAMES:
                tkey = bname + "#" + ns + "#" + tname
                if tkey in table_schema_version:
                    if table_schema_version[tkey] < 1:
                        return False
    return True
