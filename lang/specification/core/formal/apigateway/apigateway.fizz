---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
# AWS API Gateway REST Formal Specification
# Models REST APIs, resources, methods, integrations, deployments, and stages
#
# FizzBee grammar rules:
#   - Iterate over fixed lists, NOT over mutable dicts
#   - Only single-level subscript assignments: dict[key] = x is OK
#   - del dict[key] is NOT supported: use sentinel values instead
#   - No comments inside oneof: blocks

API_IDS = ["api-1"]
RESOURCE_IDS = ["res-root-1", "res-1"]
METHOD_KEYS = ["res-1:GET"]
DEPLOYMENT_IDS = ["dep-1", "dep-2"]
STAGE_NAMES = ["prod"]

action Init:
    # api_status[aid] = "ACTIVE"|"DELETED"
    api_status = {}

    # resource_api[rid] = api_id (which API owns this resource)
    resource_api = {}

    # resource_path[rid] = "/"|"segment" (root vs child)
    resource_path = {}

    # resource_status[rid] = "ACTIVE"|"DELETED"
    resource_status = {}

    # method_status[mk] = "EXISTS"|"DELETED"
    method_status = {}

    # method_api[mk] = api_id
    method_api = {}

    # method_resource[mk] = resource_id
    method_resource = {}

    # integration_status[mk] = "EXISTS"|"DELETED"
    integration_status = {}

    # integration_api[mk] = api_id (which API this integration belongs to)
    integration_api = {}

    # method_response_exists[mk+":200"] = True|False
    method_response_exists = {}

    # ir_exists[mk+":200"] = True|False
    ir_exists = {}

    # deployment_status[did] = "ACTIVE"|"DELETED"
    deployment_status = {}

    # deployment_api[did] = api_id
    deployment_api = {}

    # stage_exists["aid:sname"] = True|False
    stage_exists = {}

    # stage_deployment["aid:sname"] = dep_id
    stage_deployment = {}

    # stage_throttling["aid:sname"] = True|False
    stage_throttling = {}

# step: a "api gateway" "REST API" is created with a root resource
# result: the "api gateway" "API" will be "ACTIVE" and its root resource will be "ACTIVE"
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
# guard: a "api gateway" "resource" "slot" was "available"
# guard_violation_capacity: no "api gateway" "resource" "slot" was "available"
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            oneof rid in RESOURCE_IDS:
                if rid not in resource_api:
                    api_status[aid] = "ACTIVE"
                    resource_api[rid] = aid
                    resource_path[rid] = "/"
                    resource_status[rid] = "ACTIVE"

# step: a root resource is initialized for an "api gateway" "API"
# result: the root "api gateway" "resource" will be "ACTIVE"
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "API" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "API" was not "ACTIVE"
# guard: the "api gateway" "API" has no root resource yet
# guard_violation: the "api gateway" "API" already has a root resource
# guard: the "api gateway" "resource" slot is unallocated
# guard_violation: the "api gateway" "resource" slot is already allocated
atomic action InitRootResource:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                has_root = False
                for rid in RESOURCE_IDS:
                    if rid in resource_api:
                        if resource_api[rid] == aid:
                            if rid in resource_path:
                                if resource_path[rid] == "/":
                                    has_root = True
                if not has_root:
                    oneof rid in RESOURCE_IDS:
                        if rid not in resource_api:
                            resource_api[rid] = aid
                            resource_path[rid] = "/"
                            resource_status[rid] = "ACTIVE"

# step: a "api gateway" "REST API" is deleted
# result: the "api gateway" "API" will be deleted along with all its resources, methods, integrations, deployments, and stages
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "API" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "API" was not "ACTIVE"
atomic action DeleteRestApi:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                api_status[aid] = "DELETED"
                for rid in RESOURCE_IDS:
                    if rid in resource_api:
                        if resource_api[rid] == aid:
                            resource_status[rid] = "DELETED"
                for mk in METHOD_KEYS:
                    if mk in method_api:
                        if method_api[mk] == aid:
                            if method_status[mk] == "EXISTS":
                                method_status[mk] = "DELETED"
                for mk in METHOD_KEYS:
                    if mk in integration_api:
                        if integration_api[mk] == aid:
                            if integration_status[mk] == "EXISTS":
                                integration_status[mk] = "DELETED"
                for did in DEPLOYMENT_IDS:
                    if did in deployment_api:
                        if deployment_api[did] == aid:
                            if deployment_status[did] == "ACTIVE":
                                deployment_status[did] = "DELETED"
                for sname in STAGE_NAMES:
                    sk = aid + ":" + sname
                    if sk in stage_exists:
                        stage_exists[sk] = False

# step: a child "api gateway" "resource" is created under an existing "api gateway" "resource"
# result: the new "api gateway" "resource" will be "ACTIVE"
# guard: the "api gateway" "resource" slot is unallocated
# guard_violation: the "api gateway" "resource" slot is already allocated
# guard: the parent "api gateway" "resource" existed
# guard_violation: the parent "api gateway" "resource" did not exist
# guard: the parent "api gateway" "resource" was "ACTIVE"
# guard_violation_lifecycle: the parent "api gateway" "resource" was not "ACTIVE"
# CreateResource: add a non-root resource under an existing ACTIVE resource
atomic action CreateResource:
    oneof rid in RESOURCE_IDS:
        if rid not in resource_api:
            oneof parent_rid in RESOURCE_IDS:
                if parent_rid in resource_status:
                    if resource_status[parent_rid] == "ACTIVE":
                        resource_api[rid] = resource_api[parent_rid]
                        resource_path[rid] = "segment"
                        resource_status[rid] = "ACTIVE"

# step: a non-root "api gateway" "resource" is deleted along with its methods and integrations
# result: the "api gateway" "resource" will be deleted along with all its methods and integrations
# guard: the "api gateway" "resource" existed
# guard_violation: the "api gateway" "resource" did not exist
# guard: the "api gateway" "resource" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "resource" was not "ACTIVE"
# guard: the "api gateway" "resource" has a path
# guard_violation: the "api gateway" "resource" does not have a path
# guard: the "api gateway" "resource" is not the root "api gateway" "resource"
# guard_violation: the "api gateway" "resource" is the root "api gateway" "resource"
atomic action DeleteResource:
    oneof rid in RESOURCE_IDS:
        if rid in resource_status:
            if resource_status[rid] == "ACTIVE":
                if rid in resource_path:
                    if resource_path[rid] != "/":
                        resource_status[rid] = "DELETED"
                        for mk in METHOD_KEYS:
                            if mk in method_resource:
                                if method_resource[mk] == rid:
                                    if method_status[mk] == "EXISTS":
                                        method_status[mk] = "DELETED"
                                    if mk in integration_status:
                                        if integration_status[mk] == "EXISTS":
                                            integration_status[mk] = "DELETED"

# step: a GET method is created on a "api gateway" "resource"
# result: the "api gateway" "method" will exist on the "api gateway" "resource"
# guard: the "api gateway" "method" did not already exist
# guard_violation: the "api gateway" "method" already existed
# guard: the "api gateway" "resource" existed
# guard_violation: the "api gateway" "resource" did not exist
# guard: the "api gateway" "resource" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "resource" was not "ACTIVE"
# PutMethod: create a GET method for a resource
atomic action PutMethodGet:
    oneof mk in METHOD_KEYS:
        if mk not in method_status:
            rid = mk[:mk.index(":")]
            if rid in resource_status:
                if resource_status[rid] == "ACTIVE":
                    method_status[mk] = "EXISTS"
                    method_api[mk] = resource_api[rid]
                    method_resource[mk] = rid

# step: an existing "api gateway" "method" is updated
# result: the "api gateway" "method" remains unchanged
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# PutMethod (re-put on existing active method has no semantic change)
atomic action PutMethodUpdate:
    oneof mk in METHOD_KEYS:
        if mk in method_status:
            if method_status[mk] == "EXISTS":
                pass

# step: a "api gateway" "method" is deleted along with its integration
# result: the "api gateway" "method" will be deleted and its integration will be deleted if it will exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
atomic action DeleteMethod:
    oneof mk in METHOD_KEYS:
        if mk in method_status:
            if method_status[mk] == "EXISTS":
                method_status[mk] = "DELETED"
                if mk in integration_status:
                    if integration_status[mk] == "EXISTS":
                        integration_status[mk] = "DELETED"

# step: a 200 "api gateway" "method" response is configured
# result: the "api gateway" "method" response will exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# PutMethodResponse: record 200 response for an existing method
atomic action PutMethodResponse:
    oneof mk in METHOD_KEYS:
        if mk in method_status:
            if method_status[mk] == "EXISTS":
                mr_key = mk + ":200"
                method_response_exists[mr_key] = True

# step: a backend integration is attached to a "api gateway" "method"
# result: the "api gateway" "integration" will exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# guard: the "api gateway" "method" existed
# guard_violation: the "api gateway" "method" did not exist
# PutIntegration: attach backend integration to a method
atomic action PutIntegration:
    oneof mk in METHOD_KEYS:
        if mk in method_status:
            if method_status[mk] == "EXISTS":
                integration_status[mk] = "EXISTS"
                integration_api[mk] = method_api[mk]

# step: an "api gateway" "integration" is deleted
# result: the "api gateway" "integration" will be deleted
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# DeleteIntegration
atomic action DeleteIntegration:
    oneof mk in METHOD_KEYS:
        if mk in integration_status:
            if integration_status[mk] == "EXISTS":
                integration_status[mk] = "DELETED"

# step: a 200 "api gateway" "integration" response is configured
# result: the "api gateway" "integration" response will exist
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# PutIntegrationResponse: record 200 integration response
atomic action PutIntegrationResponse:
    oneof mk in METHOD_KEYS:
        if mk in integration_status:
            if integration_status[mk] == "EXISTS":
                ir_key = mk + ":200"
                ir_exists[ir_key] = True

# step: an "api gateway" "API" deployment is created
# result: the "api gateway" "deployment" will be "ACTIVE"
# guard: the "api gateway" "deployment" slot is available
# guard_violation: the "api gateway" "deployment" slot is already in use
# guard: the "api gateway" "method" has an "api gateway" "integration"
# guard_violation: the "api gateway" "method" does not have an "api gateway" "integration"
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# guard: the "api gateway" "method" has an "api gateway" "API" association
# guard_violation: the "api gateway" "method" does not have an "api gateway" "API" association
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "API" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "API" was not "ACTIVE"
# CreateDeployment: create a deployment for an API that has at least one integration
atomic action CreateDeployment:
    oneof did in DEPLOYMENT_IDS:
        if did not in deployment_status:
            oneof mk in METHOD_KEYS:
                if mk in integration_status:
                    if integration_status[mk] == "EXISTS":
                        if mk in method_api:
                            aid = method_api[mk]
                            if aid in api_status:
                                if api_status[aid] == "ACTIVE":
                                    deployment_status[did] = "ACTIVE"
                                    deployment_api[did] = aid

# step: a "api gateway" "deployment" is deleted when no stage references it
# result: the "api gateway" "deployment" will be deleted
# guard: the "api gateway" "deployment" existed
# guard_violation: the "api gateway" "deployment" did not exist
# guard: the "api gateway" "deployment" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "deployment" was not "ACTIVE"
# guard: the "api gateway" "stage" key existed
# guard_violation: the "api gateway" "stage" key did not exist
# guard: the "api gateway" "stage" is "ACTIVE"
# guard_violation: the "api gateway" "stage" is not "ACTIVE"
# guard: the "api gateway" "stage" has a "api gateway" "deployment" reference
# guard_violation: the "api gateway" "stage" does not have a "api gateway" "deployment" reference
# guard: the "api gateway" "stage" references this deployment
# guard_violation: the "api gateway" "stage" does not reference this deployment
# guard: no "api gateway" "stage" references this "api gateway" "deployment"
# guard_violation: an "api gateway" "stage" references this "api gateway" "deployment"
# DeleteDeployment: only if no stage references it
atomic action DeleteDeployment:
    oneof did in DEPLOYMENT_IDS:
        if did in deployment_status:
            if deployment_status[did] == "ACTIVE":
                can_delete = True
                for sname in STAGE_NAMES:
                    for aid in API_IDS:
                        sk = aid + ":" + sname
                        if sk in stage_exists:
                            if stage_exists[sk] == True:
                                if sk in stage_deployment:
                                    if stage_deployment[sk] == did:
                                        can_delete = False
                if can_delete:
                    deployment_status[did] = "DELETED"

# step: a prod stage is created for an "api gateway" "API"
# result: the "api gateway" "prod stage" will exist pointing to the "api gateway" "deployment"
# guard: the "api gateway" "deployment" existed
# guard_violation: the "api gateway" "deployment" did not exist
# guard: the "api gateway" "deployment" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "deployment" was not "ACTIVE"
# guard: the "api gateway" "prod stage" did not already exist for this API
# guard_violation: the "api gateway" "prod stage" already existed for this API
# CreateStage: associate a stage name with an existing deployment
atomic action CreateStageProd:
    oneof did in DEPLOYMENT_IDS:
        if did in deployment_status:
            if deployment_status[did] == "ACTIVE":
                aid = deployment_api[did]
                sk = aid + ":prod"
                if sk not in stage_exists:
                    stage_exists[sk] = True
                    stage_deployment[sk] = did
                    stage_throttling[sk] = False

# step: the "api gateway" "prod stage" is deleted
# result: the "api gateway" "prod stage" no longer will exist
# guard: the "api gateway" "prod stage" existed
# guard_violation: the "api gateway" "prod stage" did not exist
# guard: the "api gateway" "prod stage" is "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "prod stage" is not "ACTIVE"
# DeleteStage
atomic action DeleteStageProd:
    oneof aid in API_IDS:
        sk = aid + ":prod"
        if sk in stage_exists:
            if stage_exists[sk] == True:
                stage_exists[sk] = False

# step: the "api gateway" "prod stage" is redeployed to a new deployment
# result: the "api gateway" "prod stage" points to the new deployment
# guard: the "api gateway" "deployment" existed
# guard_violation: the "api gateway" "deployment" did not exist
# guard: the "api gateway" "deployment" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "deployment" was not "ACTIVE"
# guard: the "api gateway" "prod stage" existed
# guard_violation: the "api gateway" "prod stage" did not exist
# guard: the "api gateway" "prod stage" is "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "prod stage" is not "ACTIVE"
# UpdateStage: point stage at a different deployment (redeploy)
atomic action UpdateStageProd:
    oneof did in DEPLOYMENT_IDS:
        if did in deployment_status:
            if deployment_status[did] == "ACTIVE":
                aid = deployment_api[did]
                sk = aid + ":prod"
                if sk in stage_exists:
                    if stage_exists[sk] == True:
                        stage_deployment[sk] = did

# step: throttling was "ENABLED" for the "api gateway" "prod stage"
# result: "api gateway" "prod stage" requests will be throttled
# guard: the "api gateway" "prod stage" existed
# guard_violation: the "api gateway" "prod stage" did not exist
# guard: the "api gateway" "prod stage" is "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "prod stage" is not "ACTIVE"
# EnableStageThrottling / DisableStageThrottling
atomic action EnableStageThrottlingProd:
    oneof aid in API_IDS:
        sk = aid + ":prod"
        if sk in stage_exists:
            if stage_exists[sk] == True:
                stage_throttling[sk] = True

# step: throttling was "DISABLED" for the "api gateway" "prod stage"
# result: "api gateway" "prod stage" requests will not be throttled
# guard: the "api gateway" "prod stage" existed
# guard_violation: the "api gateway" "prod stage" did not exist
# guard: the "api gateway" "prod stage" is "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "prod stage" is not "ACTIVE"
atomic action DisableStageThrottlingProd:
    oneof aid in API_IDS:
        sk = aid + ":prod"
        if sk in stage_exists:
            if stage_exists[sk] == True:
                stage_throttling[sk] = False

# fake_skip: internal
# step: a request is made to the throttled "api gateway" "prod stage"
# result: the "api gateway" "prod stage" request will be throttled or pass non-deterministically
# guard: the "api gateway" "prod stage" has throttling configured
# guard_violation: the "api gateway" "prod stage" does not have throttling configured
# guard: throttling was "ENABLED" for the "api gateway" "prod stage"
# guard_violation: throttling was not "ENABLED" for the "api gateway" "prod stage"
# RequestThrottled: non-deterministic outcome when throttling is enabled
atomic action RequestThrottledProd:
    oneof aid in API_IDS:
        sk = aid + ":prod"
        if sk in stage_throttling:
            if stage_throttling[sk] == True:
                oneof:
                    pass
                    pass

# fake_skip: internal
# step: a "api gateway" "backend integration" is called
# result: the "api gateway" "integration" times out or responds non-deterministically
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# guard: the "api gateway" "integration" existed
# guard_violation: the "api gateway" "integration" did not exist
# IntegrationTimeout: non-deterministic backend latency
atomic action IntegrationTimeout:
    oneof mk in METHOD_KEYS:
        if mk in integration_status:
            if integration_status[mk] == "EXISTS":
                oneof:
                    pass
                    pass

# check: all "ACTIVE" "api gateway" "resource"s belong to "ACTIVE" "api gateway" "API"s
# Safety: all ACTIVE resources belong to ACTIVE APIs
always assertion ResourcesBelongToExistingApis:
    for rid in resource_api:
        if rid in resource_status:
            if resource_status[rid] == "ACTIVE":
                aid = resource_api[rid]
                if aid in api_status:
                    if api_status[aid] == "DELETED":
                        return False
    return True

# check: all "api gateway" "method"s belong to "ACTIVE" "api gateway" "resource"s
# Safety: all EXISTING methods belong to ACTIVE resources
always assertion MethodsBelongToExistingResources:
    for mk in method_resource:
        if mk in method_status:
            if method_status[mk] == "EXISTS":
                rid = method_resource[mk]
                if rid in resource_status:
                    if resource_status[rid] == "DELETED":
                        return False
    return True

# check: all "api gateway" "integration"s correspond to existing "api gateway" "method"s
# Safety: all EXISTING integrations correspond to EXISTING methods
always assertion IntegrationsBelongToExistingMethods:
    for mk in integration_status:
        if integration_status[mk] == "EXISTS":
            if mk in method_status:
                if method_status[mk] == "DELETED":
                    return False
    return True

# check: all "ACTIVE" "api gateway" "deployment"s belong to "ACTIVE" "api gateway" "API"s
# Safety: all ACTIVE deployments belong to ACTIVE APIs
always assertion DeploymentsBelongToExistingApis:
    for did in deployment_api:
        if did in deployment_status:
            if deployment_status[did] == "ACTIVE":
                aid = deployment_api[did]
                if aid in api_status:
                    if api_status[aid] == "DELETED":
                        return False
    return True

# check: all active "api gateway" "stage"s reference "ACTIVE" "api gateway" "deployment"s
# Safety: all active stages reference ACTIVE deployments
always assertion StagesReferenceExistingDeployments:
    for sk in stage_deployment:
        if sk in stage_exists:
            if stage_exists[sk] == True:
                did = stage_deployment[sk]
                if did in deployment_status:
                    if deployment_status[did] == "DELETED":
                        return False
    return True

# check: all active "api gateway" "stage"s belong to "ACTIVE" "api gateway" "API"s
# Safety: all active stages belong to ACTIVE APIs
always assertion StagesBelongToExistingApis:
    for aid in API_IDS:
        for sname in STAGE_NAMES:
            sk = aid + ":" + sname
            if sk in stage_exists:
                if stage_exists[sk] == True:
                    if aid in api_status:
                        if api_status[aid] == "DELETED":
                            return False
    return True

# check: each "ACTIVE" "api gateway" "API" has at least one "ACTIVE" root "api gateway" "resource"
# Safety: each ACTIVE API has at least one root resource (path "/")
always assertion RootResourcePreserved:
    for aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                has_root = False
                for rid in RESOURCE_IDS:
                    if rid in resource_api:
                        if resource_api[rid] == aid:
                            if rid in resource_status:
                                if resource_status[rid] == "ACTIVE":
                                    if rid in resource_path:
                                        if resource_path[rid] == "/":
                                            has_root = True
                if not has_root:
                    return False
    return True
