---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
DOMAIN_NAMES = ["domain-a", "domain-b", "domain-c"]
INDEX_NAMES = ["index-1", "index-2", "index-3"]
TAG_KEYS = ["env", "team", "cost-center", "project"]

action Init:
    domain_status = {}
    domain_instance_type = {}
    domain_instance_count = {}
    domain_pending_config = {}
    domain_tag = {}
    index_status = {}
    index_doc_count = {}

# step: an "elasticsearch" "domain" is created
# result: the "elasticsearch" "domain" will be in "CREATING" state
# guard: the "elasticsearch" "domain" did not already exist
# guard_violation: the "elasticsearch" "domain" already existed
atomic action CreateElasticsearchDomain:
    oneof domain in DOMAIN_NAMES:
        if domain not in domain_status:
            domain_status[domain] = "CREATING"
            domain_instance_type[domain] = "r5.large.elasticsearch"
            domain_instance_count[domain] = 1
            domain_pending_config[domain] = False

# fake_skip: internal
# step: an "elasticsearch" "domain" finishes creating
# result: the "elasticsearch" "domain" will be "ACTIVE" and ready for use
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "CREATING"
# guard_violation: the "elasticsearch" "domain" was not "CREATING"
atomic action FinishCreatingDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "CREATING":
                domain_status[domain] = "ACTIVE"

# step: an "elasticsearch" "domain" is deleted
# result: the "elasticsearch" "domain" will be in "DELETING" state
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
atomic action DeleteElasticsearchDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_status[domain] = "DELETING"

# fake_skip: internal
# step: an "elasticsearch" "domain" finishes deleting
# result: the "elasticsearch" "domain" will be "DELETED" and all its indices will be removed
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "DELETING"
# guard_violation: the "elasticsearch" "domain" was not "DELETING"
# guard: the "elasticsearch" "index" existed
# guard_violation: the "elasticsearch" "index" did not exist
atomic action FinishDeletingDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "DELETING":
                domain_status[domain] = "DELETED"
                for iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key in index_status:
                        index_status[idx_key] = "DELETED"
                for tkey in TAG_KEYS:
                    domain_tag[domain + "#" + tkey] = False

# step: an "elasticsearch" "domain" configuration update is requested
# result: the "elasticsearch" "domain" will be in "PROCESSING" state with a pending config change
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
atomic action UpdateElasticsearchDomainConfig:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_status[domain] = "PROCESSING"
                domain_pending_config[domain] = True

# fake_skip: internal
# step: an "elasticsearch" "domain" finishes processing its configuration update
# result: the "elasticsearch" "domain" will be "ACTIVE" with the new configuration applied
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "PROCESSING"
# guard_violation: the "elasticsearch" "domain" was not "PROCESSING"
# guard: the "elasticsearch" "domain" has a pending configuration change
# guard_violation: the "elasticsearch" "domain" does not have a pending configuration change
atomic action FinishProcessingDomainConfig:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "PROCESSING":
                if domain_pending_config[domain] == True:
                    domain_instance_type[domain] = "r5.xlarge.elasticsearch"
                    domain_instance_count[domain] = 2
                    domain_pending_config[domain] = False
                domain_status[domain] = "ACTIVE"

# step: an "elasticsearch" "index" is created in an active "elasticsearch" "domain"
# result: the "elasticsearch" "index" will be "ACTIVE" with zero documents
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
# guard: the "elasticsearch" "index" did not already exist
# guard_violation: the "elasticsearch" "index" already existed
atomic action CreateIndex:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                oneof iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key not in index_status:
                        index_status[idx_key] = "ACTIVE"
                        index_doc_count[idx_key] = 0

# step: a "elasticsearch" "document" is indexed in an active index
# result: the "elasticsearch" "document" count for the "elasticsearch" "index" increases by one
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
# guard: the "elasticsearch" "index" existed
# guard_violation: the "elasticsearch" "index" did not exist
# guard: the "elasticsearch" "index" was "ACTIVE"
# guard_violation: the "elasticsearch" "index" was not "ACTIVE"
atomic action IndexDocument:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                oneof iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key in index_status:
                        if index_status[idx_key] == "ACTIVE":
                            index_doc_count[idx_key] = index_doc_count[idx_key] + 1

# step: an "elasticsearch" "index" is deleted from an active "elasticsearch" "domain"
# result: the "elasticsearch" "index" will be marked as "DELETED"
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
# guard: the "elasticsearch" "index" existed
# guard_violation: the "elasticsearch" "index" did not exist
# guard: the "elasticsearch" "index" was "ACTIVE"
# guard_violation: the "elasticsearch" "index" was not "ACTIVE"
atomic action DeleteIndex:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                oneof iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key in index_status:
                        if index_status[idx_key] == "ACTIVE":
                            index_status[idx_key] = "DELETED"

# step: tags are added to an "elasticsearch" "domain"
# result: the specified tags are associated with the "elasticsearch" "domain"
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" is not being deleted
# guard_violation_lifecycle: the "elasticsearch" "domain" is being deleted
# guard: the "elasticsearch" "domain" was not "DELETED"
# guard_violation: the "elasticsearch" "domain" was "DELETED"
atomic action AddTags:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] != "DELETING":
                if domain_status[domain] != "DELETED":
                    oneof tkey in TAG_KEYS:
                        domain_tag[domain + "#" + tkey] = True

# step: tags are removed from an "elasticsearch" "domain"
# result: the specified tags are no longer associated with the "elasticsearch" "domain"
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" is not being deleted
# guard_violation_lifecycle: the "elasticsearch" "domain" is being deleted
# guard: the "elasticsearch" "domain" was not "DELETED"
# guard_violation: the "elasticsearch" "domain" was "DELETED"
# guard: the "elasticsearch" "tag key" existed
# guard_violation: the "elasticsearch" "tag key" did not exist
atomic action RemoveTags:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] != "DELETING":
                if domain_status[domain] != "DELETED":
                    oneof tkey in TAG_KEYS:
                        tk = domain + "#" + tkey
                        if tk in domain_tag:
                            domain_tag[tk] = False

# fake_skip: internal
# step: shards are reallocated across nodes in an active "elasticsearch" "domain"
# result: the "elasticsearch" "domain" shard layout will be updated without changing document counts
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
# guard: the "elasticsearch" "index" existed
# guard_violation: the "elasticsearch" "index" did not exist
# guard: the "elasticsearch" "index" was "ACTIVE"
# guard_violation: the "elasticsearch" "index" was not "ACTIVE"
atomic action ShardReallocation:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                oneof iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key in index_status:
                        if index_status[idx_key] == "ACTIVE":
                            index_doc_count[idx_key] = index_doc_count[idx_key]

# fake_skip: internal
# step: a replica sync lag event occurs on an active "elasticsearch" "domain"
# result: the replica eventually catches up without changing document counts
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
# guard: the "elasticsearch" "index" existed
# guard_violation: the "elasticsearch" "index" did not exist
# guard: the "elasticsearch" "index" was "ACTIVE"
# guard_violation: the "elasticsearch" "index" was not "ACTIVE"
atomic action ReplicaSyncLag:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                oneof iname in INDEX_NAMES:
                    idx_key = domain + "#" + iname
                    if idx_key in index_status:
                        if index_status[idx_key] == "ACTIVE":
                            index_doc_count[idx_key] = index_doc_count[idx_key]

# fake_skip: internal
# step: a node failure occurs in an active "elasticsearch" "domain"
# result: the "elasticsearch" "domain" will be in "PROCESSING" state while recovering
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "ACTIVE"
atomic action NodeFailure:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_status[domain] = "PROCESSING"
                domain_pending_config[domain] = False

# check: every active index belongs to an existing non-deleted domain
always assertion IndicesHaveParentDomain:
    for idx_key in index_status:
        if index_status[idx_key] == "ACTIVE":
            parts = idx_key.split("#")
            domain = parts[0]
            if domain not in domain_status:
                return False
            if domain_status[domain] == "DELETED":
                return False
    return True

# check: every active tag belongs to an existing non-deleted domain
always assertion TagsHaveParentDomain:
    for tkey in domain_tag:
        if domain_tag[tkey] == True:
            parts = tkey.split("#")
            domain = parts[0]
            if domain not in domain_status:
                return False
            if domain_status[domain] == "DELETED":
                return False
    return True

# check: a pending config change only exists on a "elasticsearch" "domain" that is PROCESSING
always assertion PendingConfigOnlyOnProcessingDomain:
    for domain in DOMAIN_NAMES:
        if domain in domain_pending_config:
            if domain_pending_config[domain] == True:
                if domain in domain_status:
                    if domain_status[domain] != "PROCESSING":
                        return False
    return True
