---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
# SNS Formal Specification
# Models topics, subscriptions, confirmation, fan-out, filtering, and delivery retries.

TOPIC_ARNS = ["topic1", "topic2"]
SUB_IDS = ["sub-1", "sub-2", "sub-3", "sub-4", "sub-5"]
DELIVERY_IDS = ["del-1", "del-2", "del-3", "del-4", "del-5"]
ENDPOINTS = ["ep1", "ep2", "ep3"]
FILTER_POLICIES = ["", "policy_a", "policy_b"]

action Init:
    topic_status = {}
    sub_status = {}
    sub_topic = {}
    sub_endpoint = {}
    sub_filter = {}
    delivery_status = {}
    delivery_sub = {}
    delivery_retry = {}

# step: an SNS topic is created
# result: the topic is ACTIVE
# guard: the topic does not already exist
# guard_violation: the topic already exists
atomic action CreateTopic:
    oneof tarn in TOPIC_ARNS:
        if tarn not in topic_status:
            topic_status[tarn] = "ACTIVE"

# step: an SNS topic is deleted
# result: the topic is DELETED and its subscriptions are removed
# guard: the topic exists
# guard_violation: the topic does not exist
# guard: the topic is ACTIVE
# guard_violation_lifecycle: the topic is not ACTIVE
atomic action DeleteTopic:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                topic_status[tarn] = "DELETED"
                for sid in SUB_IDS:
                    if sid in sub_topic:
                        if sub_topic[sid] == tarn:
                            sub_status[sid] = "DELETED"

# step: an endpoint subscribes to a topic
# result: the subscription is PENDING_CONFIRMATION or CONFIRMED
# guard: the topic exists
# guard_violation: the topic does not exist
# guard: the topic is ACTIVE
# guard_violation_lifecycle: the topic is not ACTIVE
# guard: the subscription slot is available
# guard_violation_capacity: the subscription slot is not available
atomic action Subscribe:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                oneof sid in SUB_IDS:
                    if sid not in sub_status:
                        oneof ep in ENDPOINTS:
                            oneof fp in FILTER_POLICIES:
                                oneof:
                                    atomic:
                                        sub_topic[sid] = tarn
                                        sub_endpoint[sid] = ep
                                        sub_filter[sid] = fp
                                        sub_status[sid] = "PENDING_CONFIRMATION"
                                    atomic:
                                        sub_topic[sid] = tarn
                                        sub_endpoint[sid] = ep
                                        sub_filter[sid] = fp
                                        sub_status[sid] = "CONFIRMED"

# step: a pending subscription is confirmed
# result: the subscription is CONFIRMED
# guard: the subscription exists
# guard_violation: the subscription does not exist
# guard: the subscription is PENDING_CONFIRMATION
# guard_violation: the subscription is not PENDING_CONFIRMATION
# guard: the subscription's topic exists
# guard_violation: the subscription's topic does not exist
# guard: the subscription's topic is ACTIVE
# guard_violation_lifecycle: the subscription's topic is not ACTIVE
atomic action ConfirmSubscription:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "PENDING_CONFIRMATION":
                if sub_topic[sid] in topic_status:
                    if topic_status[sub_topic[sid]] == "ACTIVE":
                        sub_status[sid] = "CONFIRMED"

# step: a subscription is removed
# result: the subscription is DELETED
# guard: the subscription exists
# guard_violation: the subscription does not exist
# guard: the subscription is CONFIRMED
# guard_violation_lifecycle: the subscription is not CONFIRMED
atomic action Unsubscribe:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "CONFIRMED":
                sub_status[sid] = "DELETED"

# step: a message is published to a topic
# result: the message is delivered to confirmed subscriptions
# guard: the topic exists
# guard_violation: the topic does not exist
# guard: the topic is ACTIVE
# guard_violation_lifecycle: the topic is not ACTIVE
# guard: a confirmed subscription exists for the topic
# guard_violation: no confirmed subscription exists for the topic
# guard: the subscription belongs to this topic
# guard_violation: the subscription does not belong to this topic
# guard: a delivery slot is available
# guard_violation_capacity: no delivery slot is available
atomic action Publish:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                oneof sid in SUB_IDS:
                    if sid in sub_status:
                        if sub_status[sid] == "CONFIRMED":
                            if sub_topic[sid] == tarn:
                                oneof did in DELIVERY_IDS:
                                    if did not in delivery_status:
                                        delivery_sub[did] = sid
                                        delivery_retry[did] = 0
                                        delivery_status[did] = "IN_FLIGHT"

# fake_skip: internal
# step: a delivery attempt succeeds
# result: the delivery is DONE
# guard: the delivery exists
# guard_violation: the delivery does not exist
# guard: the delivery is IN_FLIGHT
# guard_violation: the delivery is not IN_FLIGHT
atomic action DeliverySucceeds:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                delivery_status[did] = "DONE"

# fake_skip: internal
# step: a delivery attempt fails and is retried
# result: the delivery retry count is incremented
# guard: the delivery exists
# guard_violation: the delivery does not exist
# guard: the delivery is IN_FLIGHT
# guard_violation: the delivery is not IN_FLIGHT
# guard: the retry count is below the limit
# guard_violation: the retry count has reached the limit
atomic action DeliveryFails:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                if delivery_retry[did] < 3:
                    delivery_retry[did] = delivery_retry[did] + 1

# fake_skip: internal
# step: all delivery retries are exhausted
# result: the delivery is marked DONE
# guard: the delivery exists
# guard_violation: the delivery does not exist
# guard: the delivery is IN_FLIGHT
# guard_violation: the delivery is not IN_FLIGHT
# guard: the retry count has reached the limit
# guard_violation: the retry count is below the limit
atomic action RetryExhausted:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                if delivery_retry[did] >= 3:
                    delivery_status[did] = "DONE"

# fake_skip: internal
# step: a subscription confirmation token expires
# result: the pending subscription is DELETED
# guard: the subscription exists
# guard_violation: the subscription does not exist
# guard: the subscription is PENDING_CONFIRMATION
# guard_violation: the subscription is not PENDING_CONFIRMATION
atomic action ConfirmationTokenExpires:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "PENDING_CONFIRMATION":
                sub_status[sid] = "DELETED"

# check: no delivery is in-flight to a deleted subscription
always assertion NoDeliveryToDeletedSubscription:
    for did in delivery_status:
        if delivery_status[did] == "IN_FLIGHT":
            sid = delivery_sub[did]
            if sid in sub_status:
                if sub_status[sid] == "DELETED":
                    return False
    return True

# check: no delivery is in-flight to an unconfirmed subscription
always assertion NoDeliveryToUnconfirmedSubscription:
    for did in delivery_status:
        if delivery_status[did] == "IN_FLIGHT":
            sid = delivery_sub[did]
            if sid in sub_status:
                if sub_status[sid] == "PENDING_CONFIRMATION":
                    return False
    return True

# check: every active subscription references an ACTIVE topic
always assertion SubscriptionsReferActiveTopic:
    for sid in sub_status:
        if sub_status[sid] != "DELETED":
            tarn = sub_topic[sid]
            if tarn not in topic_status:
                return False
            if topic_status[tarn] == "DELETED":
                return False
    return True

# check: every delivery retry count is within the allowed limit
always assertion RetryCountBounded:
    for did in delivery_retry:
        if delivery_retry[did] > 3:
            return False
    return True

