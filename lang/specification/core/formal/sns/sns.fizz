---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
# SNS Formal Specification
# Models topics, subscriptions, confirmation, fan-out, filtering, and delivery retries.

TOPIC_ARNS = ["topic1", "topic2"]
SUB_IDS = ["sub-1", "sub-2", "sub-3", "sub-4", "sub-5"]
DELIVERY_IDS = ["del-1", "del-2", "del-3", "del-4", "del-5"]
ENDPOINTS = ["ep1", "ep2", "ep3"]
FILTER_POLICIES = ["", "policy_a", "policy_b"]

action Init:
    topic_status = {}
    sub_status = {}
    sub_topic = {}
    sub_endpoint = {}
    sub_filter = {}
    delivery_status = {}
    delivery_sub = {}
    delivery_retry = {}

# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tarn in TOPIC_ARNS:
        if tarn not in topic_status:
            topic_status[tarn] = "ACTIVE"

# step: a "sns" "topic" is deleted
# result: the "sns" "topic" will be "DELETED" and its subscriptions will be removed
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
atomic action DeleteTopic:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                topic_status[tarn] = "DELETED"
                for sid in SUB_IDS:
                    if sid in sub_topic:
                        if sub_topic[sid] == tarn:
                            sub_status[sid] = "DELETED"

# step: an endpoint subscribes to a "sns" "topic"
# result: the "sns" "subscription" will be "PENDING_CONFIRMATION" or "CONFIRMED"
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
# guard: the subscription slot is available
# guard_violation_capacity: the subscription slot is not available
atomic action Subscribe:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                oneof sid in SUB_IDS:
                    if sid not in sub_status:
                        oneof ep in ENDPOINTS:
                            oneof fp in FILTER_POLICIES:
                                oneof:
                                    atomic:
                                        sub_topic[sid] = tarn
                                        sub_endpoint[sid] = ep
                                        sub_filter[sid] = fp
                                        sub_status[sid] = "PENDING_CONFIRMATION"
                                    atomic:
                                        sub_topic[sid] = tarn
                                        sub_endpoint[sid] = ep
                                        sub_filter[sid] = fp
                                        sub_status[sid] = "CONFIRMED"

# step: a pending "sns" "subscription" is confirmed
# result: the "sns" "subscription" will be "CONFIRMED"
# guard: the "sns" "subscription" existed
# guard_violation: the "sns" "subscription" did not exist
# guard: the "sns" "subscription" was "PENDING_CONFIRMATION"
# guard_violation: the "sns" "subscription" was not "PENDING_CONFIRMATION"
# guard: the "sns" "subscription"'s sns topic existed
# guard_violation: the "sns" "subscription"'s sns topic did not exist
# guard: the "sns" "subscription"'s "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "subscription"'s "sns" "topic" was not "ACTIVE"
atomic action ConfirmSubscription:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "PENDING_CONFIRMATION":
                if sub_topic[sid] in topic_status:
                    if topic_status[sub_topic[sid]] == "ACTIVE":
                        sub_status[sid] = "CONFIRMED"

# step: a "sns" "subscription" is removed
# result: the "sns" "subscription" will be "DELETED"
# guard: the "sns" "subscription" existed
# guard_violation: the "sns" "subscription" did not exist
# guard: the "sns" "subscription" was "CONFIRMED"
# guard_violation_lifecycle: the "sns" "subscription" was not "CONFIRMED"
atomic action Unsubscribe:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "CONFIRMED":
                sub_status[sid] = "DELETED"

# step: a "sns" "message" is published to a "sns" "topic"
# result: the "sns" "message" will be delivered to confirmed subscriptions
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
# guard: a confirmed subscription existed for the "sns" "topic"
# guard_violation: no confirmed subscription existed for the "sns" "topic"
# guard: the "sns" "subscription" belongs to this "sns" "topic"
# guard_violation: the "sns" "subscription" does not belong to this "sns" "topic"
# guard: a delivery slot is available
# guard_violation_capacity: no delivery slot is available
atomic action Publish:
    oneof tarn in TOPIC_ARNS:
        if tarn in topic_status:
            if topic_status[tarn] == "ACTIVE":
                oneof sid in SUB_IDS:
                    if sid in sub_status:
                        if sub_status[sid] == "CONFIRMED":
                            if sub_topic[sid] == tarn:
                                oneof did in DELIVERY_IDS:
                                    if did not in delivery_status:
                                        delivery_sub[did] = sid
                                        delivery_retry[did] = 0
                                        delivery_status[did] = "IN_FLIGHT"

# fake_skip: internal
# step: a "sns" "delivery" attempt succeeds
# result: the "sns" "delivery" will be "DONE"
# guard: the delivery existed
# guard_violation: the delivery did not exist
# guard: the "sns" "delivery" was "IN_FLIGHT"
# guard_violation: the "sns" "delivery" was not "IN_FLIGHT"
atomic action DeliverySucceeds:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                delivery_status[did] = "DONE"

# fake_skip: internal
# step: a "sns" "delivery" attempt fails and is retried
# result: the "sns" "delivery" retry count will be incremented
# guard: the delivery existed
# guard_violation: the delivery did not exist
# guard: the "sns" "delivery" was "IN_FLIGHT"
# guard_violation: the "sns" "delivery" was not "IN_FLIGHT"
# guard: the retry count was below the limit
# guard_violation: the retry count had reached the limit
atomic action DeliveryFails:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                if delivery_retry[did] < 3:
                    delivery_retry[did] = delivery_retry[did] + 1

# fake_skip: internal
# step: all "sns" "delivery" retries are exhausted
# result: the "sns" "delivery" will be marked "DONE"
# guard: the delivery existed
# guard_violation: the delivery did not exist
# guard: the "sns" "delivery" was "IN_FLIGHT"
# guard_violation: the "sns" "delivery" was not "IN_FLIGHT"
# guard: the retry count had reached the limit
# guard_violation: the retry count was below the limit
atomic action RetryExhausted:
    oneof did in DELIVERY_IDS:
        if did in delivery_status:
            if delivery_status[did] == "IN_FLIGHT":
                if delivery_retry[did] >= 3:
                    delivery_status[did] = "DONE"

# fake_skip: internal
# step: a "sns" "subscription" confirmation token expires
# result: the pending "sns" "subscription" will be "DELETED"
# guard: the "sns" "subscription" existed
# guard_violation: the "sns" "subscription" did not exist
# guard: the "sns" "subscription" was "PENDING_CONFIRMATION"
# guard_violation: the "sns" "subscription" was not "PENDING_CONFIRMATION"
atomic action ConfirmationTokenExpires:
    oneof sid in SUB_IDS:
        if sid in sub_status:
            if sub_status[sid] == "PENDING_CONFIRMATION":
                sub_status[sid] = "DELETED"

# check: no delivery is in-flight to a deleted subscription
always assertion NoDeliveryToDeletedSubscription:
    for did in delivery_status:
        if delivery_status[did] == "IN_FLIGHT":
            sid = delivery_sub[did]
            if sid in sub_status:
                if sub_status[sid] == "DELETED":
                    return False
    return True

# check: no delivery is in-flight to an unconfirmed subscription
always assertion NoDeliveryToUnconfirmedSubscription:
    for did in delivery_status:
        if delivery_status[did] == "IN_FLIGHT":
            sid = delivery_sub[did]
            if sid in sub_status:
                if sub_status[sid] == "PENDING_CONFIRMATION":
                    return False
    return True

# check: every active subscription references an ACTIVE topic
always assertion SubscriptionsReferActiveTopic:
    for sid in sub_status:
        if sub_status[sid] != "DELETED":
            tarn = sub_topic[sid]
            if tarn not in topic_status:
                return False
            if topic_status[tarn] == "DELETED":
                return False
    return True

# check: every delivery retry count is within the allowed limit
always assertion RetryCountBounded:
    for did in delivery_retry:
        if delivery_retry[did] > 3:
            return False
    return True

