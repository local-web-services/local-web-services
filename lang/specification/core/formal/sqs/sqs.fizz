---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
# SQS Formal Specification
# Models queues, messages, visibility timeouts, DLQ redrive, and FIFO ordering.

QUEUE_NAMES = ["q1", "q2", "dlq1"]
MSG_IDS = ["msg-1", "msg-2", "msg-3", "msg-4", "msg-5", "msg-6"]

action Init:
    queue_status = {}
    queue_is_fifo = {}
    queue_dlq = {}
    queue_max_receive = {}

    msg_status = {}
    msg_queue = {}
    msg_receive_count = {}

# step: a "sqs" "queue" is created
# result: the "sqs" "queue" will be "ACTIVE"
# guard: the "sqs" "queue" did not already exist
# guard_violation: the "sqs" "queue" already existed
atomic action CreateQueue:
    oneof qname in QUEUE_NAMES:
        if qname not in queue_status:
            oneof:
                atomic:
                    queue_status[qname] = "ACTIVE"
                    queue_is_fifo[qname] = False
                    queue_dlq[qname] = ""
                    queue_max_receive[qname] = 0
                atomic:
                    queue_status[qname] = "ACTIVE"
                    queue_is_fifo[qname] = False
                    queue_dlq[qname] = "dlq1"
                    queue_max_receive[qname] = 3
                atomic:
                    queue_status[qname] = "ACTIVE"
                    queue_is_fifo[qname] = True
                    queue_dlq[qname] = ""
                    queue_max_receive[qname] = 0

# step: a "sqs" "queue" is deleted
# result: the "sqs" "queue" will be "DELETED" and its messages will be removed
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
atomic action DeleteQueue:
    oneof qname in QUEUE_NAMES:
        if qname in queue_status:
            if queue_status[qname] == "ACTIVE":
                queue_status[qname] = "DELETED"
                for mid in MSG_IDS:
                    if mid in msg_queue:
                        if msg_queue[mid] == qname:
                            msg_status[mid] = "DELETED"

# step: a "sqs" "message" is sent to the "sqs" "queue"
# result: the "sqs" "message" will be "AVAILABLE" for delivery
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
# guard: an "sqs" "message" "slot" was "available"
# guard_violation_capacity: no "sqs" "message" "slot" was "available"
atomic action SendMessage:
    oneof qname in QUEUE_NAMES:
        if qname in queue_status:
            if queue_status[qname] == "ACTIVE":
                oneof mid in MSG_IDS:
                    if mid not in msg_status:
                        msg_queue[mid] = qname
                        msg_receive_count[mid] = 0
                        msg_status[mid] = "AVAILABLE"

# step: a "sqs" "message" is received from the "sqs" "queue"
# result: the "sqs" "message" will be "IN_FLIGHT"
# guard: the "sqs" "message" existed
# guard_violation: the "sqs" "message" did not exist
# guard: the "sqs" "message" was "AVAILABLE"
# guard_violation: the "sqs" "message" was not "AVAILABLE"
# guard: the "sqs" "message"'s "sqs" "queue" existed
# guard_violation: the "sqs" "message"'s "sqs" "queue" did not exist
# guard: the "sqs" "message"'s "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "message"'s "sqs" "queue" was not "ACTIVE"
atomic action ReceiveMessage:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "AVAILABLE":
                if msg_queue[mid] in queue_status:
                    if queue_status[msg_queue[mid]] == "ACTIVE":
                        msg_status[mid] = "IN_FLIGHT"
                        msg_receive_count[mid] = msg_receive_count[mid] + 1

# step: an in-flight "sqs" "message" is deleted
# result: the "sqs" "message" will be removed from the "sqs" "queue"
# guard: the "sqs" "message" existed
# guard_violation: the "sqs" "message" did not exist
# guard: the "sqs" "message" was "IN_FLIGHT"
# guard_violation: the "sqs" "message" was not "IN_FLIGHT"
atomic action DeleteMessage:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "IN_FLIGHT":
                msg_status[mid] = "DELETED"

# step: "sqs" "message" visibility timeout is changed
# result: the "sqs" "message" visibility will be updated
# guard: the "sqs" "message" existed
# guard_violation: the "sqs" "message" did not exist
# guard: the "sqs" "message" was "IN_FLIGHT"
# guard_violation: the "sqs" "message" was not "IN_FLIGHT"
atomic action ChangeMessageVisibility:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "IN_FLIGHT":
                pass

# step: all "sqs" "message"s in a "sqs" "queue" are purged
# result: all messages in the "sqs" "queue" will be "DELETED"
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
atomic action PurgeQueue:
    oneof qname in QUEUE_NAMES:
        if qname in queue_status:
            if queue_status[qname] == "ACTIVE":
                for mid in MSG_IDS:
                    if mid in msg_queue:
                        if msg_queue[mid] == qname:
                            msg_status[mid] = "DELETED"

# step: "sqs" "queue" attributes are retrieved
# result: the "sqs" "queue" attributes will be returned
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
atomic action GetQueueAttributes:
    oneof qname in QUEUE_NAMES:
        if qname in queue_status:
            if queue_status[qname] == "ACTIVE":
                pass

# fake_skip: internal
# step: a "sqs" "message" visibility timeout expires
# result: the "sqs" "message" becomes "AVAILABLE" again
# guard: the "sqs" "message" existed
# guard_violation: the "sqs" "message" did not exist
# guard: the "sqs" "message" was "IN_FLIGHT"
# guard_violation: the "sqs" "message" was not "IN_FLIGHT"
atomic action VisibilityTimeoutExpires:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "IN_FLIGHT":
                msg_status[mid] = "AVAILABLE"

# fake_skip: internal
# step: a "sqs" "message" exceeding its receive count is moved to the dead-letter "sqs" "queue"
# result: the "sqs" "message" will be "AVAILABLE" in the dead-letter "sqs" "queue"
# guard: the "sqs" "message" existed
# guard_violation: the "sqs" "message" did not exist
# guard: the "sqs" "message" was "AVAILABLE"
# guard_violation: the "sqs" "message" was not "AVAILABLE"
# guard: the "sqs" "message"'s "sqs" "queue" existed
# guard_violation: the "sqs" "message"'s "sqs" "queue" did not exist
# guard: the "sqs" "queue" had a maximum receive count configured
# guard_violation: the "sqs" "queue" did not have a maximum receive count configured
# guard: the "sqs" "message" had exceeded the maximum receive count
# guard_violation: the "sqs" "message" had not exceeded the maximum receive count
# guard: the dead-letter "sqs" "queue" existed
# guard_violation: the dead-letter "sqs" "queue" did not exist
# guard: the dead-letter "sqs" "queue" was "ACTIVE"
# guard_violation: the dead-letter "sqs" "queue" was not "ACTIVE"
atomic action RedriveToDeadLetterQueue:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "AVAILABLE":
                if msg_queue[mid] in queue_status:
                    if queue_max_receive[msg_queue[mid]] > 0:
                        if msg_receive_count[mid] >= queue_max_receive[msg_queue[mid]]:
                            if queue_dlq[msg_queue[mid]] in queue_status:
                                if queue_status[queue_dlq[msg_queue[mid]]] == "ACTIVE":
                                    msg_queue[mid] = queue_dlq[msg_queue[mid]]
                                    msg_status[mid] = "AVAILABLE"

# check: every non-deleted "sqs" "message" belongs to an "ACTIVE" "sqs" "queue"
always assertion MessagesReferValidQueues:
    for mid in msg_status:
        if msg_status[mid] != "DELETED":
            if msg_queue[mid] in queue_status:
                if queue_status[msg_queue[mid]] == "DELETED":
                    return False
    return True

# check: every "IN_FLIGHT" "sqs" "message" belongs to an "ACTIVE" "sqs" "queue"
always assertion InFlightMessagesBelongToActiveQueues:
    for mid in msg_status:
        if msg_status[mid] == "IN_FLIGHT":
            if msg_queue[mid] in queue_status:
                if queue_status[msg_queue[mid]] != "ACTIVE":
                    return False
    return True

# check: every "sqs" "message" has a non-negative receive count
always assertion ReceiveCountNonNegative:
    for mid in msg_receive_count:
        if msg_receive_count[mid] < 0:
            return False
    return True

