---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# AWS Lambda Formal Specification
# Models function lifecycle, event source mappings, invocation, concurrency, and permissions
#
# FizzBee grammar rules:
#   - Iterate over fixed lists, NOT over mutable dicts
#   - Only single-level subscript assignments: dict[key] = x is OK
#   - del dict[key] is NOT supported: use sentinel values instead
#   - No comments inside oneof: blocks

FUNC_IDS = ["func-1", "func-2", "func-3"]
MAPPING_IDS = ["esm-1", "esm-2", "esm-3"]
ASYNC_SLOTS = ["async-1", "async-2", "async-3", "async-4", "async-5"]

action Init:
    # func_status[fid] = "PENDING"|"ACTIVE"|"INACTIVE"|"FAILED"|"DELETING"|"DELETED"
    func_status = {}

    # func_reserved_conc[fid] = int (-1 = unreserved, 0 = throttled, N = limit)
    func_reserved_conc = {}

    # func_active_execs[fid] = int count of in-progress synchronous invocations
    func_active_execs = {}

    # func_has_tag[fid+"#"+key] = True|False
    func_has_tag = {}

    # func_has_policy[fid] = True|False
    func_has_policy = {}

    # mapping_status[mid] = "CREATING"|"ENABLED"|"DISABLED"|"DELETING"|"DELETED"
    mapping_status = {}

    # mapping_enabled[mid] = True|False
    mapping_enabled = {}

    # mapping_func[mid] = func_id (which function this mapping triggers)
    mapping_func = {}

    # async_func[slot] = func_id or "" (empty means slot is free)
    async_func = {}

    # async_retries[slot] = int (number of retries attempted so far)
    async_retries = {}

# step: a "lambda" "function" is created
# result: the "lambda" "function" will be in "PENDING" state
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
# CreateFunction: allocate a function ID and place it in PENDING
atomic action CreateFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "PENDING"
            func_reserved_conc[fid] = -1
            func_active_execs[fid] = 0
            func_has_policy[fid] = False

# fake_skip: internal
# step: a pending "lambda" "function" resolves its deployment
# result: the "lambda" "function" becomes "ACTIVE" or "FAILED" non-deterministically
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "PENDING"
# guard_violation_lifecycle: the "lambda" "function" was not "PENDING"
# ActivateFunction: non-deterministically resolves PENDING to ACTIVE or FAILED
atomic action ActivateFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "PENDING":
                oneof:
                    func_status[fid] = "ACTIVE"
                    func_status[fid] = "FAILED"

# step: an active "lambda" "function" is deleted
# result: the "lambda" "function" will be in "DELETING" state
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: the "lambda" "function" had no active executions
# guard_violation: the "lambda" "function" had active executions
# DeleteFunction: begin deletion when function is not executing
atomic action DeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if func_active_execs[fid] == 0:
                    func_status[fid] = "DELETING"

# step: a failed "lambda" "function" is deleted
# result: the "lambda" "function" will be in "DELETING" state
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "FAILED"
# guard_violation_lifecycle: the "lambda" "function" was not "FAILED"
atomic action DeleteFailedFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "FAILED":
                func_status[fid] = "DELETING"

# fake_skip: internal
# step: a "lambda" "function" finishes being deleted
# result: the "lambda" "function" will be "DELETED"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "DELETING"
# guard_violation_lifecycle: the "lambda" "function" was not "DELETING"
# FinishDeleteFunction: mark function DELETED (sentinel instead of del)
atomic action FinishDeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "DELETING":
                func_status[fid] = "DELETED"

# step: a "lambda" "function"'s code is updated
# result: the "lambda" "function" returns to "PENDING" state for redeployment
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# UpdateFunctionCode: transitions ACTIVE function back to PENDING for redeployment
atomic action UpdateFunctionCode:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_status[fid] = "PENDING"

# step: a "lambda" "function"'s configuration is updated
# result: the "lambda" "function" configuration will be updated while remaining "ACTIVE"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# UpdateFunctionConfiguration: allowed on ACTIVE functions (no nested dict needed)
atomic action UpdateFunctionConfiguration:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                pass

# step: reserved concurrency is set for a "lambda" "function"
# result: the "lambda" "function" has an unreserved, throttled, or explicit concurrency limit
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# SetReservedConcurrency: -1 = unreserved, 0 = throttled, 5 = explicit limit
atomic action SetReservedConcurrency:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof:
                    func_reserved_conc[fid] = -1
                    func_reserved_conc[fid] = 0
                    func_reserved_conc[fid] = 5

# step: a "lambda" "function" is invoked synchronously without a concurrency limit
# result: the "lambda" "function" active execution count will increase
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: the "lambda" "function" had concurrency configured
# guard_violation: the "lambda" "function" did not have concurrency configured
# guard: the "lambda" "function" had unreserved concurrency
# guard_violation_capacity: the "lambda" "function" did not have unreserved concurrency
# InvokeFunctionSync: increment active execution count if concurrency allows
atomic action InvokeFunctionSync:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if fid in func_reserved_conc:
                    if func_reserved_conc[fid] == -1:
                        func_active_execs[fid] = func_active_execs[fid] + 1

# step: a "lambda" "function" is invoked synchronously within its concurrency limit
# result: the "lambda" "function" active execution count will increase
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: the "lambda" "function" had concurrency configured
# guard_violation: the "lambda" "function" did not have concurrency configured
# guard: the "lambda" "function" had a positive concurrency limit
# guard_violation_capacity: the "lambda" "function" did not have a positive concurrency limit
# guard: the "lambda" "function" had active executions tracked
# guard_violation: the "lambda" "function" does not have active executions tracked
# guard: the "lambda" "function" active executions were below the concurrency limit
# guard_violation_capacity: the "lambda" "function" active executions were at or above the concurrency limit
atomic action InvokeFunctionSyncWithConcurrency:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if fid in func_reserved_conc:
                    if func_reserved_conc[fid] > 0:
                        if fid in func_active_execs:
                            if func_active_execs[fid] < func_reserved_conc[fid]:
                                func_active_execs[fid] = func_active_execs[fid] + 1

# fake_skip: internal
# step: a synchronous "lambda" "function" invocation completes
# result: the "lambda" "function" active execution count will decrease
# guard: the "lambda" "function" had active execution tracking
# guard_violation: the "lambda" "function" did not have active execution tracking
# guard: the "lambda" "function" had at least one active execution
# guard_violation: the "lambda" "function" had no active executions
# FinishInvokeFunctionSync: decrement active execution count
atomic action FinishInvokeFunctionSync:
    oneof fid in FUNC_IDS:
        if fid in func_active_execs:
            if func_active_execs[fid] > 0:
                func_active_execs[fid] = func_active_execs[fid] - 1

# step: a "lambda" "function" is invoked asynchronously
# result: the "lambda" "function" event will be queued in an "async" "slot"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "async" "slot" was "available"
# guard_violation_capacity: no "lambda" "async" "slot" was "available"
# InvokeFunctionAsync: place event in a free async slot
atomic action InvokeFunctionAsync:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof slot in ASYNC_SLOTS:
                    if slot not in async_func:
                        async_func[slot] = fid
                        async_retries[slot] = 0

# fake_skip: internal
# step: a "lambda" "async" invocation succeeds
# result: the "lambda" "async" "slot" will be freed
# guard: the "lambda" "async" "slot" was occupied
# guard_violation: the "lambda" "async" "slot" was empty
# guard: the async slot has a "lambda" "function" assigned
# guard_violation: the async slot does not have a "lambda" "function" assigned
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# ProcessAsyncSuccess: async invocation succeeded; free the slot
atomic action ProcessAsyncSuccess:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        async_func[slot] = ""

# fake_skip: internal
# step: a "lambda" "async" invocation fails and is retried
# result: the "lambda" "function" async retry count will increase
# guard: the "lambda" "async" "slot" was occupied
# guard_violation: the "lambda" "async" "slot" was empty
# guard: the async slot has a "lambda" "function" assigned
# guard_violation: the async slot does not have a "lambda" "function" assigned
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: "lambda" "async" "slot" retry tracking was available
# guard_violation: "lambda" "async" "slot" retry tracking was not available
# guard: the "lambda" "function" async retry count had not been exhausted
# guard_violation: the "lambda" "function" async retry count had been exhausted
# ProcessAsyncRetry: invocation failed but retries remain; increment retry count
atomic action ProcessAsyncRetry:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        if slot in async_retries:
                            if async_retries[slot] < 2:
                                async_retries[slot] = async_retries[slot] + 1

# fake_skip: internal
# step: a "lambda" "async" invocation exhausts all retries
# result: the "lambda" "function" async event will be dropped and the "async" "slot" will be freed
# guard: the "lambda" "async" "slot" was occupied
# guard_violation: the "lambda" "async" "slot" was empty
# guard: the async slot has a "lambda" "function" assigned
# guard_violation: the async slot does not have a "lambda" "function" assigned
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: "lambda" "async" "slot" retry tracking was available
# guard_violation: "lambda" "async" "slot" retry tracking was not available
# guard: the "lambda" "function" async retry count had been exhausted
# guard_violation: the "lambda" "function" async retry count had not been exhausted
# ProcessAsyncExhausted: retries exhausted; drop the event
atomic action ProcessAsyncExhausted:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        if slot in async_retries:
                            if async_retries[slot] >= 2:
                                async_func[slot] = ""

# step: a "lambda" "event source mapping" is created
# result: the "lambda" "event source mapping" will be in "CREATING" state and linked to a "lambda" "function"
# guard: the "lambda" "event source mapping" did not already exist
# guard_violation: the "lambda" "event source mapping" already existed
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# CreateEventSourceMapping
atomic action CreateEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid not in mapping_status:
            oneof fid in FUNC_IDS:
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        mapping_status[mid] = "CREATING"
                        mapping_enabled[mid] = True
                        mapping_func[mid] = fid

# fake_skip: internal
# step: a "lambda" "event source mapping" finishes creating
# result: the "lambda" "event source mapping" will be "ENABLED"
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "CREATING"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "CREATING"
# ActivateEventSourceMapping: CREATING -> ENABLED
atomic action ActivateEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "CREATING":
                mapping_status[mid] = "ENABLED"

# step: a disabled "lambda" "event source mapping" was "ENABLED"
# result: the "lambda" "event source mapping" will be "ENABLED" and active
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "DISABLED"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "DISABLED"
# UpdateEventSourceMapping: toggle enabled/disabled
atomic action EnableEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DISABLED":
                atomic:
                    mapping_status[mid] = "ENABLED"
                    mapping_enabled[mid] = True

# step: an enabled "lambda" "event source mapping" was "DISABLED"
# result: the "lambda" "event source mapping" will be "DISABLED" and inactive
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "ENABLED"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "ENABLED"
atomic action DisableEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "ENABLED":
                atomic:
                    mapping_status[mid] = "DISABLED"
                    mapping_enabled[mid] = False

# step: an enabled "lambda" "event source mapping" is deleted
# result: the "lambda" "event source mapping" will be in "DELETING" state
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "ENABLED"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "ENABLED"
# DeleteEventSourceMapping: begin deletion
atomic action DeleteEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "ENABLED":
                mapping_status[mid] = "DELETING"

# step: a disabled "lambda" "event source mapping" is deleted
# result: the "lambda" "event source mapping" will be in "DELETING" state
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "DISABLED"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "DISABLED"
atomic action DeleteDisabledEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DISABLED":
                mapping_status[mid] = "DELETING"

# step: a "lambda" "event source mapping" finishes being deleted
# result: the "lambda" "event source mapping" will be deleted
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "DELETING"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "DELETING"
# FinishDeleteEventSourceMapping: mark DELETED
atomic action FinishDeleteEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DELETING":
                mapping_status[mid] = "DELETED"

# step: a tag is added to a "lambda" "function"
# result: the "lambda" "function" has the tag set
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was not "DELETING"
# guard_violation_lifecycle: the "lambda" "function" was "DELETING"
# guard: the "lambda" "function" was not "DELETED"
# guard_violation_lifecycle: the "lambda" "function" was "DELETED"
# TagResource: set a tag on an active function using compound key fid+"#env"
atomic action TagResource:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] != "DELETING":
                if func_status[fid] != "DELETED":
                    tag_key = fid + "#env"
                    func_has_tag[tag_key] = True

# step: a tag is removed from a "lambda" "function"
# result: the tag will be cleared from the "lambda" "function"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the tag existed on the "lambda" "function"
# guard_violation: the tag did not exist on the "lambda" "function"
# guard: the "lambda" "function" tag was set
# guard_violation: the "lambda" "function" tag was not set
# UntagResource: clear the tag
atomic action UntagResource:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            tag_key = fid + "#env"
            if tag_key in func_has_tag:
                if func_has_tag[tag_key] == True:
                    func_has_tag[tag_key] = False

# step: a permission is added to a "lambda" "function"'s resource policy
# result: the "lambda" "function" has a resource policy
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# AddPermission: mark function as having a resource policy
atomic action AddPermission:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_has_policy[fid] = True

# step: a permission is removed from a "lambda" "function"'s resource policy
# result: the "lambda" "function"'s resource policy will be cleared
# guard: the "lambda" "function" had a resource policy entry
# guard_violation: the "lambda" "function" did not have a resource policy entry
# guard: the "lambda" "function" had a resource policy
# guard_violation: the "lambda" "function" did not have a resource policy
# RemovePermission: clear the resource policy
atomic action RemovePermission:
    oneof fid in FUNC_IDS:
        if fid in func_has_policy:
            if func_has_policy[fid] == True:
                func_has_policy[fid] = False

# check: every active "lambda" "event source mapping" references an existing non-deleted "lambda" "function"
always assertion ActiveMappingReferencesActiveFunction:
    for mid in mapping_status:
        if mapping_status[mid] != "DELETED":
            if mid in mapping_func:
                fid = mapping_func[mid]
                if fid in func_status:
                    if func_status[fid] == "DELETED":
                        return False
    return True

# check: no "lambda" "function" in "DELETING" state has active executions
# Safety: no DELETING function has active executions
always assertion NoExecutionsOnDeletingFunction:
    for fid in func_status:
        if func_status[fid] == "DELETING":
            if fid in func_active_execs:
                if func_active_execs[fid] > 0:
                    return False
    return True

# check: "lambda" "function" active execution count never exceeds reserved concurrency when set
# Safety: active_executions never exceeds reserved_concurrency when set
always assertion ConcurrencyLimitRespected:
    for fid in func_reserved_conc:
        if func_reserved_conc[fid] > 0:
            if fid in func_active_execs:
                if func_active_execs[fid] > func_reserved_conc[fid]:
                    return False
    return True

# check: "lambda" "function" async retry count never exceeds two
# Safety: async retries never exceed 2
always assertion AsyncRetryLimitRespected:
    for slot in async_retries:
        if async_retries[slot] > 2:
            return False
    return True

# check: every "lambda" "event source mapping" has a valid status
# Safety: event source mapping statuses are valid
always assertion ValidEventSourceMappingStatus:
    for mid in mapping_status:
        s = mapping_status[mid]
        if s != "CREATING":
            if s != "ENABLED":
                if s != "DISABLED":
                    if s != "DELETING":
                        if s != "DELETED":
                            return False
    return True

# check: every "lambda" "function" has a valid status
# Safety: function statuses are valid
always assertion ValidFunctionStatus:
    for fid in func_status:
        s = func_status[fid]
        if s != "PENDING":
            if s != "ACTIVE":
                if s != "INACTIVE":
                    if s != "FAILED":
                        if s != "DELETING":
                            if s != "DELETED":
                                return False
    return True

# check: all "lambda" "async" "slot"s reference known "lambda" "function" IDs or are empty
# Safety: async slots reference known function IDs or are empty
always assertion AsyncSlotsReferenceKnownFunctions:
    for slot in async_func:
        if async_func[slot] != "":
            fid = async_func[slot]
            if fid not in func_status:
                return False
    return True
