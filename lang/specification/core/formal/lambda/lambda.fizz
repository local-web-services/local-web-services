---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# AWS Lambda Formal Specification
# Models function lifecycle, event source mappings, invocation, concurrency, and permissions
#
# FizzBee grammar rules:
#   - Iterate over fixed lists, NOT over mutable dicts
#   - Only single-level subscript assignments: dict[key] = x is OK
#   - del dict[key] is NOT supported: use sentinel values instead
#   - No comments inside oneof: blocks

FUNC_IDS = ["func-1", "func-2", "func-3"]
MAPPING_IDS = ["esm-1", "esm-2", "esm-3"]
ASYNC_SLOTS = ["async-1", "async-2", "async-3", "async-4", "async-5"]

action Init:
    # func_status[fid] = "PENDING"|"ACTIVE"|"INACTIVE"|"FAILED"|"DELETING"|"DELETED"
    func_status = {}

    # func_reserved_conc[fid] = int (-1 = unreserved, 0 = throttled, N = limit)
    func_reserved_conc = {}

    # func_active_execs[fid] = int count of in-progress synchronous invocations
    func_active_execs = {}

    # func_has_tag[fid+"#"+key] = True|False
    func_has_tag = {}

    # func_has_policy[fid] = True|False
    func_has_policy = {}

    # mapping_status[mid] = "CREATING"|"ENABLED"|"DISABLED"|"DELETING"|"DELETED"
    mapping_status = {}

    # mapping_enabled[mid] = True|False
    mapping_enabled = {}

    # mapping_func[mid] = func_id (which function this mapping triggers)
    mapping_func = {}

    # async_func[slot] = func_id or "" (empty means slot is free)
    async_func = {}

    # async_retries[slot] = int (number of retries attempted so far)
    async_retries = {}

# step: a function is created
# result: the function is in PENDING state
# guard: the function does not already exist
# guard_violation: the function already exists
# CreateFunction: allocate a function ID and place it in PENDING
atomic action CreateFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "PENDING"
            func_reserved_conc[fid] = -1
            func_active_execs[fid] = 0
            func_has_policy[fid] = False

# fake_skip: internal
# step: a pending function resolves its deployment
# result: the function becomes ACTIVE or FAILED non-deterministically
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is PENDING
# guard_violation_lifecycle: the function is not PENDING
# ActivateFunction: non-deterministically resolves PENDING to ACTIVE or FAILED
atomic action ActivateFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "PENDING":
                oneof:
                    func_status[fid] = "ACTIVE"
                    func_status[fid] = "FAILED"

# step: an active function is deleted
# result: the function enters DELETING state
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: the function has no active executions
# guard_violation: the function has active executions
# DeleteFunction: begin deletion when function is not executing
atomic action DeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if func_active_execs[fid] == 0:
                    func_status[fid] = "DELETING"

# step: a failed function is deleted
# result: the function enters DELETING state
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is FAILED
# guard_violation_lifecycle: the function is not FAILED
atomic action DeleteFailedFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "FAILED":
                func_status[fid] = "DELETING"

# fake_skip: internal
# step: a function finishes being deleted
# result: the function is DELETED
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is DELETING
# guard_violation_lifecycle: the function is not DELETING
# FinishDeleteFunction: mark function DELETED (sentinel instead of del)
atomic action FinishDeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "DELETING":
                func_status[fid] = "DELETED"

# step: a function's code is updated
# result: the function returns to PENDING state for redeployment
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# UpdateFunctionCode: transitions ACTIVE function back to PENDING for redeployment
atomic action UpdateFunctionCode:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_status[fid] = "PENDING"

# step: a function's configuration is updated
# result: the function configuration is updated while remaining ACTIVE
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# UpdateFunctionConfiguration: allowed on ACTIVE functions (no nested dict needed)
atomic action UpdateFunctionConfiguration:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                pass

# step: reserved concurrency is set for a function
# result: the function has an unreserved, throttled, or explicit concurrency limit
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# SetReservedConcurrency: -1 = unreserved, 0 = throttled, 5 = explicit limit
atomic action SetReservedConcurrency:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof:
                    func_reserved_conc[fid] = -1
                    func_reserved_conc[fid] = 0
                    func_reserved_conc[fid] = 5

# step: a function is invoked synchronously without a concurrency limit
# result: the active execution count increases
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: the function has concurrency configured
# guard_violation: the function does not have concurrency configured
# guard: the function has unreserved concurrency
# guard_violation_capacity: the function does not have unreserved concurrency
# InvokeFunctionSync: increment active execution count if concurrency allows
atomic action InvokeFunctionSync:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if fid in func_reserved_conc:
                    if func_reserved_conc[fid] == -1:
                        func_active_execs[fid] = func_active_execs[fid] + 1

# step: a function is invoked synchronously within its concurrency limit
# result: the active execution count increases
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: the function has concurrency configured
# guard_violation: the function does not have concurrency configured
# guard: the function has a positive concurrency limit
# guard_violation_capacity: the function does not have a positive concurrency limit
# guard: the function has active executions tracked
# guard_violation: the function does not have active executions tracked
# guard: the active executions are below the concurrency limit
# guard_violation_capacity: the active executions are at or above the concurrency limit
atomic action InvokeFunctionSyncWithConcurrency:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                if fid in func_reserved_conc:
                    if func_reserved_conc[fid] > 0:
                        if fid in func_active_execs:
                            if func_active_execs[fid] < func_reserved_conc[fid]:
                                func_active_execs[fid] = func_active_execs[fid] + 1

# fake_skip: internal
# step: a synchronous function invocation completes
# result: the active execution count decreases
# guard: the function has active execution tracking
# guard_violation: the function does not have active execution tracking
# guard: the function has at least one active execution
# guard_violation: the function has no active executions
# FinishInvokeFunctionSync: decrement active execution count
atomic action FinishInvokeFunctionSync:
    oneof fid in FUNC_IDS:
        if fid in func_active_execs:
            if func_active_execs[fid] > 0:
                func_active_execs[fid] = func_active_execs[fid] - 1

# step: a function is invoked asynchronously
# result: the event is queued in an async slot
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: an async slot is available
# guard_violation_capacity: no async slot is available
# InvokeFunctionAsync: place event in a free async slot
atomic action InvokeFunctionAsync:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof slot in ASYNC_SLOTS:
                    if slot not in async_func:
                        async_func[slot] = fid
                        async_retries[slot] = 0

# fake_skip: internal
# step: an async invocation succeeds
# result: the async slot is freed
# guard: the async slot is occupied
# guard_violation: the async slot is empty
# guard: the async slot has a function assigned
# guard_violation: the async slot does not have a function assigned
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# ProcessAsyncSuccess: async invocation succeeded; free the slot
atomic action ProcessAsyncSuccess:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        async_func[slot] = ""

# fake_skip: internal
# step: an async invocation fails and is retried
# result: the retry count increases
# guard: the async slot is occupied
# guard_violation: the async slot is empty
# guard: the async slot has a function assigned
# guard_violation: the async slot does not have a function assigned
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: retry tracking is available for the slot
# guard_violation: retry tracking is not available for the slot
# guard: the retry count has not been exhausted
# guard_violation: the retry count has been exhausted
# ProcessAsyncRetry: invocation failed but retries remain; increment retry count
atomic action ProcessAsyncRetry:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        if slot in async_retries:
                            if async_retries[slot] < 2:
                                async_retries[slot] = async_retries[slot] + 1

# fake_skip: internal
# step: an async invocation exhausts all retries
# result: the event is dropped and the slot is freed
# guard: the async slot is occupied
# guard_violation: the async slot is empty
# guard: the async slot has a function assigned
# guard_violation: the async slot does not have a function assigned
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: retry tracking is available for the slot
# guard_violation: retry tracking is not available for the slot
# guard: the retry count has been exhausted
# guard_violation: the retry count has not been exhausted
# ProcessAsyncExhausted: retries exhausted; drop the event
atomic action ProcessAsyncExhausted:
    oneof slot in ASYNC_SLOTS:
        if slot in async_func:
            if async_func[slot] != "":
                fid = async_func[slot]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        if slot in async_retries:
                            if async_retries[slot] >= 2:
                                async_func[slot] = ""

# step: an event source mapping is created
# result: the mapping is in CREATING state and linked to a function
# guard: the event source mapping does not already exist
# guard_violation: the event source mapping already exists
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# CreateEventSourceMapping
atomic action CreateEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid not in mapping_status:
            oneof fid in FUNC_IDS:
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        mapping_status[mid] = "CREATING"
                        mapping_enabled[mid] = True
                        mapping_func[mid] = fid

# fake_skip: internal
# step: an event source mapping finishes creating
# result: the mapping is ENABLED
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is CREATING
# guard_violation_lifecycle: the mapping is not CREATING
# ActivateEventSourceMapping: CREATING -> ENABLED
atomic action ActivateEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "CREATING":
                mapping_status[mid] = "ENABLED"

# step: a disabled event source mapping is enabled
# result: the mapping is ENABLED and active
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is DISABLED
# guard_violation_lifecycle: the mapping is not DISABLED
# UpdateEventSourceMapping: toggle enabled/disabled
atomic action EnableEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DISABLED":
                atomic:
                    mapping_status[mid] = "ENABLED"
                    mapping_enabled[mid] = True

# step: an enabled event source mapping is disabled
# result: the mapping is DISABLED and inactive
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is ENABLED
# guard_violation_lifecycle: the mapping is not ENABLED
atomic action DisableEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "ENABLED":
                atomic:
                    mapping_status[mid] = "DISABLED"
                    mapping_enabled[mid] = False

# step: an enabled event source mapping is deleted
# result: the mapping enters DELETING state
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is ENABLED
# guard_violation_lifecycle: the mapping is not ENABLED
# DeleteEventSourceMapping: begin deletion
atomic action DeleteEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "ENABLED":
                mapping_status[mid] = "DELETING"

# step: a disabled event source mapping is deleted
# result: the mapping enters DELETING state
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is DISABLED
# guard_violation_lifecycle: the mapping is not DISABLED
atomic action DeleteDisabledEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DISABLED":
                mapping_status[mid] = "DELETING"

# step: an event source mapping finishes being deleted
# result: the mapping is DELETED
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the mapping is DELETING
# guard_violation_lifecycle: the mapping is not DELETING
# FinishDeleteEventSourceMapping: mark DELETED
atomic action FinishDeleteEventSourceMapping:
    oneof mid in MAPPING_IDS:
        if mid in mapping_status:
            if mapping_status[mid] == "DELETING":
                mapping_status[mid] = "DELETED"

# step: a tag is added to a function
# result: the function has the tag set
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is not DELETING
# guard_violation_lifecycle: the function is DELETING
# guard: the function is not DELETED
# guard_violation_lifecycle: the function is DELETED
# TagResource: set a tag on an active function using compound key fid+"#env"
atomic action TagResource:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] != "DELETING":
                if func_status[fid] != "DELETED":
                    tag_key = fid + "#env"
                    func_has_tag[tag_key] = True

# step: a tag is removed from a function
# result: the tag is cleared from the function
# guard: the function exists
# guard_violation: the function does not exist
# guard: the tag exists on the function
# guard_violation: the tag does not exist on the function
# guard: the tag is set
# guard_violation: the tag is not set
# UntagResource: clear the tag
atomic action UntagResource:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            tag_key = fid + "#env"
            if tag_key in func_has_tag:
                if func_has_tag[tag_key] == True:
                    func_has_tag[tag_key] = False

# step: a permission is added to a function's resource policy
# result: the function has a resource policy
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# AddPermission: mark function as having a resource policy
atomic action AddPermission:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_has_policy[fid] = True

# step: a permission is removed from a function's resource policy
# result: the function's resource policy is cleared
# guard: the function has a resource policy entry
# guard_violation: the function does not have a resource policy entry
# guard: the function has a resource policy
# guard_violation: the function does not have a resource policy
# RemovePermission: clear the resource policy
atomic action RemovePermission:
    oneof fid in FUNC_IDS:
        if fid in func_has_policy:
            if func_has_policy[fid] == True:
                func_has_policy[fid] = False

# check: every active event source mapping references an existing non-deleted function
always assertion ActiveMappingReferencesActiveFunction:
    for mid in mapping_status:
        if mapping_status[mid] != "DELETED":
            if mid in mapping_func:
                fid = mapping_func[mid]
                if fid in func_status:
                    if func_status[fid] == "DELETED":
                        return False
    return True

# check: no function in DELETING state has active executions
# Safety: no DELETING function has active executions
always assertion NoExecutionsOnDeletingFunction:
    for fid in func_status:
        if func_status[fid] == "DELETING":
            if fid in func_active_execs:
                if func_active_execs[fid] > 0:
                    return False
    return True

# check: active execution count never exceeds reserved concurrency when set
# Safety: active_executions never exceeds reserved_concurrency when set
always assertion ConcurrencyLimitRespected:
    for fid in func_reserved_conc:
        if func_reserved_conc[fid] > 0:
            if fid in func_active_execs:
                if func_active_execs[fid] > func_reserved_conc[fid]:
                    return False
    return True

# check: async retry count never exceeds two
# Safety: async retries never exceed 2
always assertion AsyncRetryLimitRespected:
    for slot in async_retries:
        if async_retries[slot] > 2:
            return False
    return True

# check: every event source mapping has a valid status
# Safety: event source mapping statuses are valid
always assertion ValidEventSourceMappingStatus:
    for mid in mapping_status:
        s = mapping_status[mid]
        if s != "CREATING":
            if s != "ENABLED":
                if s != "DISABLED":
                    if s != "DELETING":
                        if s != "DELETED":
                            return False
    return True

# check: every function has a valid status
# Safety: function statuses are valid
always assertion ValidFunctionStatus:
    for fid in func_status:
        s = func_status[fid]
        if s != "PENDING":
            if s != "ACTIVE":
                if s != "INACTIVE":
                    if s != "FAILED":
                        if s != "DELETING":
                            if s != "DELETED":
                                return False
    return True

# check: all async slots reference known function IDs or are empty
# Safety: async slots reference known function IDs or are empty
always assertion AsyncSlotsReferenceKnownFunctions:
    for slot in async_func:
        if async_func[slot] != "":
            fid = async_func[slot]
            if fid not in func_status:
                return False
    return True
