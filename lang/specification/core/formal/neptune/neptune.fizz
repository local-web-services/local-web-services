---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 20
---
# Amazon Neptune formal specification
# Models DB clusters, instances, and snapshots with lifecycle transitions
# Uses flat dicts and fixed resource pools (no nested subscript, no del, no state: block)

CLUSTER_IDS = ["neptune-c1", "neptune-c2", "neptune-c3"]
INSTANCE_IDS = ["neptune-i1", "neptune-i2", "neptune-i3", "neptune-i4"]
SNAPSHOT_IDS = ["neptune-s1", "neptune-s2", "neptune-s3"]

action Init:
    cluster_status = {}
    cluster_multi_az = {}
    cluster_primary_instance = {}

    instance_status = {}
    instance_cluster = {}
    instance_is_primary = {}

    snapshot_status = {}
    snapshot_cluster = {}

# step: a "neptune" "cluster" is created
# result: the "neptune" "cluster" will be in "CREATING" state
# guard: the "neptune" "cluster" did not already exist
# guard_violation: the "neptune" "cluster" already existed
atomic action CreateDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_multi_az[cid] = True
            cluster_primary_instance[cid] = ""

# fake_skip: internal
# step: a "neptune" "cluster" finishes creating
# result: the "neptune" "cluster" will be "AVAILABLE"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "CREATING"
# guard_violation: the "neptune" "cluster" was not "CREATING"
atomic action CompleteClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "AVAILABLE"

# fake_skip: internal
# step: a "neptune" "cluster" creation fails
# result: the "neptune" "cluster" will be in "FAILED" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "CREATING"
# guard_violation: the "neptune" "cluster" was not "CREATING"
atomic action FailClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "FAILED"

# step: a "neptune" "cluster" configuration is modified
# result: the "neptune" "cluster" will be in "MODIFYING" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
atomic action ModifyDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: a "neptune" "cluster" modification completes
# result: the "neptune" "cluster" returns to "AVAILABLE" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "MODIFYING"
# guard_violation: the "neptune" "cluster" was not "MODIFYING"
atomic action CompleteClusterModification:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a "neptune" "cluster" is stopped
# result: the "neptune" "cluster" will be in "STOPPING" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
atomic action StopDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "STOPPING"

# fake_skip: internal
# step: a "neptune" "cluster" stop completes
# result: the "neptune" "cluster" and its instances are "STOPPED"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "STOPPING"
# guard_violation: the "neptune" "cluster" was not "STOPPING"
# guard: the "neptune" "instance" is associated with a "neptune" "cluster"
# guard_violation: the "neptune" "instance" is not associated with a "neptune" "cluster"
# guard: the "neptune" "instance" belongs to this "neptune" "cluster"
# guard_violation: the "neptune" "instance" belongs to a different neptune cluster
# guard: the "neptune" "instance" was "AVAILABLE"
# guard_violation: the "neptune" "instance" was not "AVAILABLE"
atomic action CompleteClusterStop:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "STOPPING":
                cluster_status[cid] = "STOPPED"
                for iid in INSTANCE_IDS:
                    if iid in instance_cluster:
                        if instance_cluster[iid] == cid:
                            if instance_status[iid] == "AVAILABLE":
                                instance_status[iid] = "STOPPED"

# step: a stopped "neptune" "cluster" is started
# result: the "neptune" "cluster" will be in "STARTING" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "STOPPED"
# guard_violation_lifecycle: the "neptune" "cluster" was not "STOPPED"
atomic action StartDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "STOPPED":
                cluster_status[cid] = "STARTING"

# fake_skip: internal
# step: a "neptune" "cluster" start completes
# result: the "neptune" "cluster" and its instances are "AVAILABLE"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "STARTING"
# guard_violation: the "neptune" "cluster" was not "STARTING"
# guard: the "neptune" "instance" is associated with a "neptune" "cluster"
# guard_violation: the "neptune" "instance" is not associated with a "neptune" "cluster"
# guard: the "neptune" "instance" belongs to this "neptune" "cluster"
# guard_violation: the "neptune" "instance" belongs to a different neptune cluster
# guard: the "neptune" "instance" was "STOPPED"
# guard_violation: the "neptune" "instance" was not "STOPPED"
atomic action CompleteClusterStart:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "STARTING":
                cluster_status[cid] = "AVAILABLE"
                for iid in INSTANCE_IDS:
                    if iid in instance_cluster:
                        if instance_cluster[iid] == cid:
                            if instance_status[iid] == "STOPPED":
                                instance_status[iid] = "AVAILABLE"

# step: a "neptune" "cluster" is deleted
# result: the "neptune" "cluster" will be in "DELETING" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
# guard: the "neptune" "cluster" has no non-deleted instances
# guard_violation_lifecycle: the "neptune" "cluster" has non-deleted instances
atomic action DeleteDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if all([iid not in instance_status or instance_cluster[iid] != cid or instance_status[iid] == "DELETED" for iid in INSTANCE_IDS]):
                    cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a "neptune" "cluster" deletion completes
# result: the "neptune" "cluster" will be "DELETED"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "DELETING"
# guard_violation: the "neptune" "cluster" was not "DELETING"
atomic action CompleteClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"

# step: a "neptune" "instance" is created in an available neptune cluster
# result: the "neptune" "instance" will be in "CREATING" state and associated with the "neptune" "cluster"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
# guard: the "neptune" "instance" slot is available
# guard_violation: the "neptune" "instance" slot is not available
atomic action CreateDBInstance:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof iid in INSTANCE_IDS:
                    if iid not in instance_status:
                        instance_status[iid] = "CREATING"
                        instance_cluster[iid] = cid
                        if cluster_primary_instance[cid] == "":
                            instance_is_primary[iid] = True
                        else:
                            instance_is_primary[iid] = False

# fake_skip: internal
# step: a "neptune" "instance" finishes creating
# result: the "neptune" "instance" will be "AVAILABLE" and the "neptune" "cluster" primary will be updated if applicable
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "CREATING"
# guard_violation: the "neptune" "instance" was not "CREATING"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "instance" is the primary
# guard_violation: the "neptune" "instance" is not the primary
atomic action CompleteInstanceCreation:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "CREATING":
                instance_status[iid] = "AVAILABLE"
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if instance_is_primary[iid]:
                        cluster_primary_instance[cid] = iid

# step: a "neptune" "instance" configuration is modified
# result: the "neptune" "instance" will be in "MODIFYING" state
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "instance" was not "AVAILABLE"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
atomic action ModifyDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_status[cid] == "AVAILABLE":
                        instance_status[iid] = "MODIFYING"

# fake_skip: internal
# step: a "neptune" "instance" modification completes
# result: the "neptune" "instance" returns to "AVAILABLE" state
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "MODIFYING"
# guard_violation: the "neptune" "instance" was not "MODIFYING"
atomic action CompleteInstanceModification:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "MODIFYING":
                instance_status[iid] = "AVAILABLE"

# step: a "neptune" "instance" is rebooted
# result: the "neptune" "instance" will be in "REBOOTING" state
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "instance" was not "AVAILABLE"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
atomic action RebootDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_status[cid] == "AVAILABLE":
                        instance_status[iid] = "REBOOTING"

# fake_skip: internal
# step: a "neptune" "instance" reboot completes
# result: the "neptune" "instance" returns to "AVAILABLE" state
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "REBOOTING"
# guard_violation: the "neptune" "instance" was not "REBOOTING"
atomic action CompleteInstanceReboot:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "REBOOTING":
                instance_status[iid] = "AVAILABLE"

# step: a "neptune" "instance" is deleted
# result: the "neptune" "instance" will be in "DELETING" state
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "instance" was not "AVAILABLE"
atomic action DeleteDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_status[iid] = "DELETING"

# fake_skip: internal
# step: a "neptune" "instance" deletion completes
# result: the "neptune" "instance" will be "DELETED" and the "neptune" "cluster" primary will be cleared if applicable
# guard: the "neptune" "instance" existed
# guard_violation: the "neptune" "instance" did not exist
# guard: the "neptune" "instance" was "DELETING"
# guard_violation: the "neptune" "instance" was not "DELETING"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "instance" is the primary of the "neptune" "cluster"
# guard_violation: the "neptune" "instance" is not the primary of the "neptune" "cluster"
atomic action CompleteInstanceDeletion:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "DELETING":
                instance_status[iid] = "DELETED"
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_primary_instance[cid] == iid:
                        cluster_primary_instance[cid] = ""

# MultiAZFailover: model as cluster going through MODIFYING (promotes a new primary)
# step: a multi-AZ failover is triggered on a "neptune" "cluster"
# result: the "neptune" "cluster" will be in "MODIFYING" state for primary promotion
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
# guard: multi-AZ was "ENABLED" for the "neptune" "cluster"
# guard_violation: multi-AZ was not "ENABLED" for the "neptune" "cluster"
atomic action MultiAZFailover:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_multi_az[cid]:
                    cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# Promote a replica instance to primary while cluster is MODIFYING
# step: a replica "neptune" "instance" is promoted to primary during failover
# result: the "neptune" "cluster" returns to "AVAILABLE" with a new primary "neptune" "instance"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "MODIFYING"
# guard_violation: the "neptune" "cluster" was not "MODIFYING"
# guard: the new primary "neptune" "instance" existed
# guard_violation: the new primary "neptune" "instance" did not exist
# guard: the "neptune" "instance" belongs to this "neptune" "cluster"
# guard_violation: the "neptune" "instance" does not belong to this "neptune" "cluster"
# guard: the "neptune" "instance" was not already the primary
# guard_violation: the "neptune" "instance" was already the primary
# guard: the "neptune" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "instance" was not "AVAILABLE"
atomic action PromoteReplicaToPrimary:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                oneof new_primary in INSTANCE_IDS:
                    if new_primary in instance_status:
                        if instance_cluster[new_primary] == cid:
                            if not instance_is_primary[new_primary]:
                                if instance_status[new_primary] == "AVAILABLE":
                                    old_primary = cluster_primary_instance[cid]
                                    cluster_primary_instance[cid] = new_primary
                                    instance_is_primary[new_primary] = True
                                    if old_primary != "":
                                        instance_is_primary[old_primary] = False
                                    cluster_status[cid] = "AVAILABLE"

# step: a "neptune" "cluster" neptune snapshot is created
# result: the "neptune" "snapshot" will be in "CREATING" state and linked to the "neptune" "cluster"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
# guard: the "neptune" "snapshot" slot is available
# guard_violation: the "neptune" "snapshot" slot is not available
atomic action CreateDBClusterSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_cluster[sid] = cid

# fake_skip: internal
# step: a "neptune" "cluster" neptune snapshot finishes creating
# result: the "neptune" "snapshot" will be "AVAILABLE" and the "neptune" "cluster" returns to "AVAILABLE" if it was backing up
# guard: the "neptune" "snapshot" existed
# guard_violation: the "neptune" "snapshot" did not exist
# guard: the "neptune" "snapshot" was "CREATING"
# guard_violation: the "neptune" "snapshot" was not "CREATING"
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                cid = snapshot_cluster[sid]
                if cid in cluster_status:
                    if cluster_status[cid] == "BACKING_UP":
                        cluster_status[cid] = "AVAILABLE"

# step: a "neptune" "cluster" neptune snapshot is deleted
# result: the "neptune" "snapshot" will be in "DELETING" state
# guard: the "neptune" "snapshot" existed
# guard_violation: the "neptune" "snapshot" did not exist
# guard: the "neptune" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "snapshot" was not "AVAILABLE"
atomic action DeleteDBClusterSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a "neptune" "cluster" neptune snapshot deletion completes
# result: the "neptune" "snapshot" will be "DELETED"
# guard: the "neptune" "snapshot" existed
# guard_violation: the "neptune" "snapshot" did not exist
# guard: the "neptune" "snapshot" was "DELETING"
# guard_violation: the "neptune" "snapshot" was not "DELETING"
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"

# step: a "neptune" "cluster" is restored from a neptune snapshot
# result: the restored "neptune" "cluster" will be in "RESTORING" state
# guard: the "neptune" "snapshot" existed
# guard_violation: the "neptune" "snapshot" did not exist
# guard: the "neptune" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "snapshot" was not "AVAILABLE"
# guard: the target "neptune" "cluster" slot is available
# guard_violation: the target "neptune" "cluster" slot is not available
atomic action RestoreDBClusterFromSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_multi_az[cid] = True
                        cluster_primary_instance[cid] = ""

# fake_skip: internal
# step: a "neptune" "cluster" restore from neptune snapshot completes
# result: the "neptune" "cluster" will be "AVAILABLE"
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "RESTORING"
# guard_violation: the "neptune" "cluster" was not "RESTORING"
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# fake_skip: internal
# step: an automated backup window runs on an available "neptune" "cluster"
# result: a neptune snapshot will be "CREATING" and the "neptune" "cluster" will be in "BACKING_UP" state
# guard: the "neptune" "cluster" existed
# guard_violation: the "neptune" "cluster" did not exist
# guard: the "neptune" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "neptune" "cluster" was not "AVAILABLE"
# guard: a "neptune" "snapshot" "slot" was "available"
# guard_violation: no "neptune" "snapshot" "slot" was "available"
atomic action AutomatedBackupWindow:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_cluster[sid] = cid
                        cluster_status[cid] = "BACKING_UP"

# Safety: cluster statuses are valid
# check: every "neptune" "cluster" has a valid status
always assertion ValidClusterStatus:
    for cid in cluster_status:
        s = cluster_status[cid]
        if s != "CREATING" and s != "AVAILABLE" and s != "MODIFYING" and s != "DELETING" and s != "FAILED" and s != "STOPPED" and s != "STARTING" and s != "STOPPING" and s != "RESTORING" and s != "BACKING_UP" and s != "DELETED":
            return False
    return True

# Safety: instance statuses are valid
# check: every "neptune" "instance" has a valid status
always assertion ValidInstanceStatus:
    for iid in instance_status:
        s = instance_status[iid]
        if s != "CREATING" and s != "AVAILABLE" and s != "MODIFYING" and s != "DELETING" and s != "REBOOTING" and s != "STOPPED" and s != "DELETED":
            return False
    return True

# Safety: snapshot statuses are valid
# check: every "neptune" "snapshot" has a valid status
always assertion ValidSnapshotStatus:
    for sid in snapshot_status:
        s = snapshot_status[sid]
        if s != "CREATING" and s != "AVAILABLE" and s != "DELETING" and s != "DELETED":
            return False
    return True

# Safety: stopped clusters must not have AVAILABLE instances
# check: a stopped "neptune" "cluster" has no available "neptune" "instance"s
always assertion StoppedClusterHasNoAvailableInstances:
    for cid in cluster_status:
        if cluster_status[cid] == "STOPPED":
            for iid in instance_status:
                if iid in instance_cluster:
                    if instance_cluster[iid] == cid:
                        if instance_status[iid] == "AVAILABLE":
                            return False
    return True

# Safety: instances on a stopped/stopping cluster cannot be modifying
# check: "neptune" "instance"s on a stopped or stopping "neptune" "cluster" are not in "MODIFYING" state
always assertion StoppedClusterInstancesNotModifiable:
    for iid in instance_status:
        if instance_status[iid] == "MODIFYING":
            if iid in instance_cluster:
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_status[cid] == "STOPPED" or cluster_status[cid] == "STOPPING":
                        return False
    return True

# Safety: DELETED clusters should not have non-deleted instances
# check: a deleted "neptune" "cluster" has no available "neptune" "instance"s
always assertion NoAvailableInstancesOnDeletedCluster:
    for cid in cluster_status:
        if cluster_status[cid] == "DELETED":
            for iid in INSTANCE_IDS:
                if iid in instance_status:
                    if iid in instance_cluster:
                        if instance_cluster[iid] == cid:
                            if instance_status[iid] != "DELETED":
                                return False
    return True

# Safety: a BACKING_UP cluster must have a corresponding in-progress snapshot
# check: every backing-up "neptune" "cluster" has a corresponding in-progress "neptune" "snapshot"
always assertion BackingUpClusterHasSnapshot:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "BACKING_UP":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_status[sid] == "CREATING":
                            if snapshot_cluster[sid] == cid:
                                found = True
                if not found:
                    return False
    return True

# Safety: FAILED clusters should not have AVAILABLE instances
# check: a failed "neptune" "cluster" has no available "neptune" "instance"s
always assertion NoAvailableInstancesOnFailedCluster:
    for cid in cluster_status:
        if cluster_status[cid] == "FAILED":
            for iid in instance_status:
                if iid in instance_cluster:
                    if instance_cluster[iid] == cid:
                        if instance_status[iid] == "AVAILABLE":
                            return False
    return True
