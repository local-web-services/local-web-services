---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 8
---
# S3 (s3api) Formal Specification
# Models buckets, objects, versioning, multipart uploads, and lifecycle expiry.

BUCKET_NAMES = ["bucket-a", "bucket-b"]
OBJECT_KEYS = ["key1", "key2"]
UPLOAD_IDS = ["upload1"]

action Init:
    bucket_status = {}
    bucket_versioning = {}

    object_status = {}

    upload_status = {}
    upload_has_parts = {}

# step: a bucket is created
# result: the bucket is ACTIVE with versioning disabled
# guard: the bucket does not already exist
# guard_violation: the bucket already exists
atomic action CreateBucket:
    oneof bname in BUCKET_NAMES:
        if bname not in bucket_status:
            bucket_status[bname] = "ACTIVE"
            bucket_versioning[bname] = "DISABLED"

# step: a bucket is deleted
# result: the bucket is DELETED
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the bucket is empty
# guard_violation: the bucket is not empty
atomic action DeleteBucket:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                if all([(bname + "#" + key) not in object_status or object_status[bname + "#" + key] != "EXISTS" for key in OBJECT_KEYS]):
                    bucket_status[bname] = "DELETED"

# step: the list of buckets is retrieved
# result: the available buckets are returned
atomic action ListBuckets:
    pass

# step: versioning is configured on a bucket
# result: the bucket versioning state is ENABLED or SUSPENDED non-deterministically
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
atomic action PutBucketVersioning:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof:
                    bucket_versioning[bname] = "ENABLED"
                    bucket_versioning[bname] = "SUSPENDED"

# step: an object is uploaded to a bucket
# result: the object EXISTS in the bucket
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
atomic action PutObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    object_status[obj_key] = "EXISTS"

# step: an object is retrieved from a bucket
# result: the object data is returned
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the object exists in the bucket
# guard_violation: the object does not exist in the bucket
# guard: the object is not deleted
# guard_violation: the object is deleted
atomic action GetObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            pass

# step: an object is deleted from a bucket
# result: the object is DELETED
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the object exists in the bucket
# guard_violation: the object does not exist in the bucket
# guard: the object is not deleted
# guard_violation: the object is deleted
atomic action DeleteObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            object_status[obj_key] = "DELETED"

# step: object metadata is retrieved from a bucket
# result: the object metadata is returned
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the object exists in the bucket
# guard_violation: the object does not exist in the bucket
# guard: the object is not deleted
# guard_violation: the object is deleted
atomic action HeadObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            pass

# step: objects in a bucket are listed
# result: the list of objects in the bucket is returned
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
atomic action ListObjectsV2:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                pass

# step: an object is copied from one bucket to another
# result: the object EXISTS in the destination bucket
# guard: the source bucket exists
# guard_violation: the source bucket does not exist
# guard: the source bucket is ACTIVE
# guard_violation_lifecycle: the source bucket is not ACTIVE
# guard: the source object exists
# guard_violation: the source object does not exist
# guard: the source object is not deleted
# guard_violation: the source object is deleted
# guard: the destination bucket exists
# guard_violation: the destination bucket does not exist
# guard: the destination bucket is ACTIVE
# guard_violation_lifecycle: the destination bucket is not ACTIVE
atomic action CopyObject:
    oneof src_bname in BUCKET_NAMES:
        if src_bname in bucket_status:
            if bucket_status[src_bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    src_key = src_bname + "#" + key
                    if src_key in object_status:
                        if object_status[src_key] == "EXISTS":
                            oneof dst_bname in BUCKET_NAMES:
                                if dst_bname in bucket_status:
                                    if bucket_status[dst_bname] == "ACTIVE":
                                        dst_key = dst_bname + "#" + key
                                        object_status[dst_key] = "EXISTS"

# step: a multipart upload is initiated
# result: the upload is IN_PROGRESS with no parts
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the upload does not already exist
# guard_violation: the upload already exists
atomic action CreateMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key not in upload_status:
                        upload_status[upload_key] = "IN_PROGRESS"
                        upload_has_parts[upload_key] = False

# step: a part is uploaded for a multipart upload
# result: the upload has at least one part
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the upload exists
# guard_violation: the upload does not exist
# guard: the upload is IN_PROGRESS
# guard_violation: the upload is not IN_PROGRESS
atomic action UploadPart:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            upload_has_parts[upload_key] = True

# step: a multipart upload is completed
# result: the upload is COMPLETED and the assembled object EXISTS in the bucket
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the upload exists
# guard_violation: the upload does not exist
# guard: the upload is IN_PROGRESS
# guard_violation: the upload is not IN_PROGRESS
# guard: the upload has at least one part
# guard_violation: the upload has no parts
atomic action CompleteMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            if upload_has_parts[upload_key] == True:
                                upload_status[upload_key] = "COMPLETED"
                                obj_key = bname + "#" + "multipart-" + uid
                                object_status[obj_key] = "EXISTS"

# step: a multipart upload is aborted
# result: the upload is ABORTED
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the upload exists
# guard_violation: the upload does not exist
# guard: the upload is IN_PROGRESS
# guard_violation: the upload is not IN_PROGRESS
atomic action AbortMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            upload_status[upload_key] = "ABORTED"

# fake_skip: internal
# step: a lifecycle rule expires an object
# result: the object is DELETED by the lifecycle policy
# guard: the bucket exists
# guard_violation: the bucket does not exist
# guard: the bucket is ACTIVE
# guard_violation_lifecycle: the bucket is not ACTIVE
# guard: the object exists in the bucket
# guard_violation: the object does not exist in the bucket
# guard: the object is not deleted
# guard_violation: the object is deleted
atomic action LifecycleExpireObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            object_status[obj_key] = "DELETED"

# check: every bucket has a valid status (ACTIVE or DELETED)
always assertion BucketStatusValid:
    for bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] not in ["ACTIVE", "DELETED"]:
                return False
    return True

# check: every bucket versioning state is valid (DISABLED, ENABLED, or SUSPENDED)
always assertion VersioningStateValid:
    for bname in BUCKET_NAMES:
        if bname in bucket_versioning:
            if bucket_versioning[bname] not in ["DISABLED", "ENABLED", "SUSPENDED"]:
                return False
    return True

# check: every multipart upload has a valid status (IN_PROGRESS, COMPLETED, or ABORTED)
always assertion MultipartUploadStatusValid:
    for bname in BUCKET_NAMES:
        for uid in UPLOAD_IDS:
            upload_key = bname + "#" + uid
            if upload_key in upload_status:
                if upload_status[upload_key] not in ["IN_PROGRESS", "COMPLETED", "ABORTED"]:
                    return False
    return True

# check: deleting a bucket requires it to be empty
always assertion DeleteBucketRequiresEmpty:
    for bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "DELETED":
                for key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            return False
    return True
