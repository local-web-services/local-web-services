---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 8
---
# S3 (s3api) Formal Specification
# Models buckets, objects, versioning, multipart uploads, and lifecycle expiry.

BUCKET_NAMES = ["bucket-a", "bucket-b"]
OBJECT_KEYS = ["key1", "key2"]
UPLOAD_IDS = ["upload1"]

action Init:
    bucket_status = {}
    bucket_versioning = {}

    object_status = {}

    upload_status = {}
    upload_has_parts = {}

# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE" with versioning disabled
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bname in BUCKET_NAMES:
        if bname not in bucket_status:
            bucket_status[bname] = "ACTIVE"
            bucket_versioning[bname] = "DISABLED"

# step: a "s3" "bucket" is deleted
# result: the "s3" "bucket" will be "DELETED"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" was empty
# guard_violation: the "s3" "bucket" was not empty
atomic action DeleteBucket:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                if all([(bname + "#" + key) not in object_status or object_status[bname + "#" + key] != "EXISTS" for key in OBJECT_KEYS]):
                    bucket_status[bname] = "DELETED"

# step: the list of "s3" "buckets" is retrieved
# result: the available "s3" "buckets" will be returned
atomic action ListBuckets:
    pass

# step: versioning is configured on a "s3" "bucket"
# result: the "s3" "bucket" versioning state will be "ENABLED" or "SUSPENDED" non-deterministically
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
atomic action PutBucketVersioning:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof:
                    bucket_versioning[bname] = "ENABLED"
                    bucket_versioning[bname] = "SUSPENDED"

# step: a "s3" "object" is uploaded to a "s3" "bucket"
# result: the "s3" "object" will exist in the "s3" "bucket"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
atomic action PutObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    object_status[obj_key] = "EXISTS"

# step: a "s3" "object" is retrieved from a "s3" "bucket"
# result: the "s3" "object" data will be returned
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "object" existed in the "s3" "bucket"
# guard_violation: the "s3" "object" did not exist in the "s3" "bucket"
# guard: the "s3" "object" was not "deleted"
# guard_violation: the "s3" "object" was "deleted"
atomic action GetObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            pass

# step: a "s3" "object" is deleted from a "s3" "bucket"
# result: the "s3" "object" will be "DELETED"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "object" existed in the "s3" "bucket"
# guard_violation: the "s3" "object" did not exist in the "s3" "bucket"
# guard: the "s3" "object" was not "deleted"
# guard_violation: the "s3" "object" was "deleted"
atomic action DeleteObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            object_status[obj_key] = "DELETED"

# step: "s3" "object" metadata is retrieved from a "s3" "bucket"
# result: the "s3" "object" metadata will be returned
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "object" existed in the "s3" "bucket"
# guard_violation: the "s3" "object" did not exist in the "s3" "bucket"
# guard: the "s3" "object" was not "deleted"
# guard_violation: the "s3" "object" was "deleted"
atomic action HeadObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            pass

# step: objects in a "s3" "bucket" are listed
# result: the list of objects in the "s3" "bucket" will be returned
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
atomic action ListObjectsV2:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                pass

# step: a "s3" "object" is copied from one "s3" "bucket" to another
# result: the "s3" "object" will exist in the destination "s3" "bucket"
# guard: the source "s3" "bucket" existed
# guard_violation: the source "s3" "bucket" did not exist
# guard: the source "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the source "s3" "bucket" was not "ACTIVE"
# guard: the source "s3" "object" existed
# guard_violation: the source "s3" "object" did not exist
# guard: the source "s3" "object" is not "DELETED"
# guard_violation: the source "s3" "object" is "DELETED"
# guard: the destination "s3" "bucket" existed
# guard_violation: the destination "s3" "bucket" did not exist
# guard: the destination "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the destination "s3" "bucket" was not "ACTIVE"
atomic action CopyObject:
    oneof src_bname in BUCKET_NAMES:
        if src_bname in bucket_status:
            if bucket_status[src_bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    src_key = src_bname + "#" + key
                    if src_key in object_status:
                        if object_status[src_key] == "EXISTS":
                            oneof dst_bname in BUCKET_NAMES:
                                if dst_bname in bucket_status:
                                    if bucket_status[dst_bname] == "ACTIVE":
                                        dst_key = dst_bname + "#" + key
                                        object_status[dst_key] = "EXISTS"

# step: a multipart "s3" "upload" is initiated
# result: the "s3" "upload" will be "IN_PROGRESS" with no parts
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "upload" did not already exist
# guard_violation: the "s3" "upload" already existed
atomic action CreateMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key not in upload_status:
                        upload_status[upload_key] = "IN_PROGRESS"
                        upload_has_parts[upload_key] = False

# step: a part is uploaded for a multipart "s3" "upload"
# result: the "s3" "upload" has at least one part
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "upload" existed
# guard_violation: the "s3" "upload" did not exist
# guard: the "s3" "upload" was "IN_PROGRESS"
# guard_violation: the "s3" "upload" was not "IN_PROGRESS"
atomic action UploadPart:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            upload_has_parts[upload_key] = True

# step: a multipart "s3" "upload" is completed
# result: the "s3" "upload" will be "COMPLETED" and the assembled "s3" "object" will exist in the "s3" "bucket"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "upload" existed
# guard_violation: the "s3" "upload" did not exist
# guard: the "s3" "upload" was "IN_PROGRESS"
# guard_violation: the "s3" "upload" was not "IN_PROGRESS"
# guard: the "s3" "upload" had at least one part
# guard_violation: the "s3" "upload" had no parts
atomic action CompleteMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            if upload_has_parts[upload_key] == True:
                                upload_status[upload_key] = "COMPLETED"
                                obj_key = bname + "#" + "multipart-" + uid
                                object_status[obj_key] = "EXISTS"

# step: a multipart "s3" "upload" is aborted
# result: the "s3" "upload" will be "ABORTED"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "upload" existed
# guard_violation: the "s3" "upload" did not exist
# guard: the "s3" "upload" was "IN_PROGRESS"
# guard_violation: the "s3" "upload" was not "IN_PROGRESS"
atomic action AbortMultipartUpload:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof uid in UPLOAD_IDS:
                    upload_key = bname + "#" + uid
                    if upload_key in upload_status:
                        if upload_status[upload_key] == "IN_PROGRESS":
                            upload_status[upload_key] = "ABORTED"

# fake_skip: internal
# step: a lifecycle "s3" rule expires a "s3" "object"
# result: the "s3" "object" will be "DELETED" by the lifecycle policy
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "object" existed in the "s3" "bucket"
# guard_violation: the "s3" "object" did not exist in the "s3" "bucket"
# guard: the "s3" "object" was not "deleted"
# guard_violation: the "s3" "object" was "deleted"
atomic action LifecycleExpireObject:
    oneof bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "ACTIVE":
                oneof key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            object_status[obj_key] = "DELETED"

# check: every "s3" "bucket" has a valid status ("ACTIVE" or "DELETED")
always assertion BucketStatusValid:
    for bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] not in ["ACTIVE", "DELETED"]:
                return False
    return True

# check: every "s3" "bucket" versioning state is valid ("DISABLED", "ENABLED", or "SUSPENDED")
always assertion VersioningStateValid:
    for bname in BUCKET_NAMES:
        if bname in bucket_versioning:
            if bucket_versioning[bname] not in ["DISABLED", "ENABLED", "SUSPENDED"]:
                return False
    return True

# check: every "s3" "multipart upload" has a valid status ("IN_PROGRESS", "COMPLETED", or "ABORTED")
always assertion MultipartUploadStatusValid:
    for bname in BUCKET_NAMES:
        for uid in UPLOAD_IDS:
            upload_key = bname + "#" + uid
            if upload_key in upload_status:
                if upload_status[upload_key] not in ["IN_PROGRESS", "COMPLETED", "ABORTED"]:
                    return False
    return True

# check: deleting an "s3" "bucket" requires it to be empty
always assertion DeleteBucketRequiresEmpty:
    for bname in BUCKET_NAMES:
        if bname in bucket_status:
            if bucket_status[bname] == "DELETED":
                for key in OBJECT_KEYS:
                    obj_key = bname + "#" + key
                    if obj_key in object_status:
                        if object_status[obj_key] == "EXISTS":
                            return False
    return True
