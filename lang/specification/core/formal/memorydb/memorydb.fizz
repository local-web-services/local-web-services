---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 12
---
# Amazon MemoryDB for Redis formal specification
# Models clusters, snapshots, ACLs, users, and durability guarantees

CLUSTER_IDS = ["cl1", "cl2", "cl3", "cl4"]
SNAPSHOT_IDS = ["snap1", "snap2", "snap3"]
ACL_IDS = ["acl1", "acl2", "acl3"]
USER_IDS = ["user1", "user2", "user3", "user4"]

action Init:
    cluster_status = {}
    cluster_multi_az = {}
    cluster_acl = {}
    cluster_writes_persisted = {}

    snapshot_status = {}
    snapshot_cluster = {}

    acl_status = {}

    user_status = {}

    acl_has_user = {}

    tag_exists = {}

# step: a MemoryDB cluster is created
# result: the cluster is in CREATING state
# guard: the cluster does not already exist
# guard_violation: the cluster already exists
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_multi_az[cid] = True
            cluster_acl[cid] = ""
            cluster_writes_persisted[cid] = True
            tag_exists[cid] = True

# fake_skip: internal
# step: a MemoryDB cluster finishes creating
# result: the cluster is AVAILABLE
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is CREATING
# guard_violation: the cluster is not CREATING
atomic action CompleteClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "AVAILABLE"

# step: a MemoryDB cluster configuration is updated
# result: the cluster is in MODIFYING state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
atomic action UpdateCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: a MemoryDB cluster update completes
# result: the cluster returns to AVAILABLE state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is MODIFYING
# guard_violation: the cluster is not MODIFYING
atomic action CompleteClusterUpdate:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a MemoryDB cluster is deleted
# result: the cluster is in DELETING state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
atomic action DeleteCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a MemoryDB cluster deletion completes
# result: the cluster is DELETED and its tags are removed
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is DELETING
# guard_violation: the cluster is not DELETING
atomic action CompleteClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"
                tag_exists[cid] = False

# fake_skip: internal
# step: a shard failover is triggered on a multi-AZ cluster
# result: the cluster remains AVAILABLE after the shard failover
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: multi-AZ is enabled for the cluster
# guard_violation: multi-AZ is not enabled for the cluster
atomic action FailoverShard:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_multi_az[cid]:
                    cluster_status[cid] = "AVAILABLE"

# step: a snapshot is created from an available cluster
# result: the snapshot is in CREATING state and the cluster is SNAPSHOTTING
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: the snapshot slot is available
# guard_violation: the snapshot slot is not available
atomic action CreateSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_cluster[sid] = cid
                        tag_exists[sid] = True
                        cluster_status[cid] = "SNAPSHOTTING"

# fake_skip: internal
# step: a snapshot finishes creating
# result: the snapshot is AVAILABLE and the cluster returns to AVAILABLE state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is CREATING
# guard_violation: the snapshot is not CREATING
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the snapshot belongs to this cluster
# guard_violation: the snapshot does not belong to this cluster
# guard: the cluster is SNAPSHOTTING
# guard_violation: the cluster is not SNAPSHOTTING
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if snapshot_cluster[sid] == cid:
                            if cluster_status[cid] == "SNAPSHOTTING":
                                cluster_status[cid] = "AVAILABLE"

# step: a snapshot is deleted
# result: the snapshot is in DELETING state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is AVAILABLE
# guard_violation_lifecycle: the snapshot is not AVAILABLE
atomic action DeleteSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a snapshot deletion completes
# result: the snapshot is DELETED and its tags are removed
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is DELETING
# guard_violation: the snapshot is not DELETING
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"
                tag_exists[sid] = False

# step: a cluster is restored from a snapshot
# result: the restored cluster is in RESTORING state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is AVAILABLE
# guard_violation_lifecycle: the snapshot is not AVAILABLE
# guard: the target cluster slot is available
# guard_violation: the target cluster slot is not available
atomic action RestoreCluster:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_multi_az[cid] = True
                        cluster_acl[cid] = ""
                        cluster_writes_persisted[cid] = True
                        tag_exists[cid] = True

# fake_skip: internal
# step: a cluster restore from snapshot completes
# result: the cluster is AVAILABLE
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is RESTORING
# guard_violation: the cluster is not RESTORING
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# step: an ACL is created
# result: the ACL is in CREATING state
# guard: the ACL does not already exist
# guard_violation: the ACL already exists
atomic action CreateACL:
    oneof aid in ACL_IDS:
        if aid not in acl_status:
            acl_status[aid] = "CREATING"

# fake_skip: internal
# step: an ACL finishes creating
# result: the ACL is ACTIVE
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is CREATING
# guard_violation: the ACL is not CREATING
atomic action CompleteACLCreation:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "CREATING":
                acl_status[aid] = "ACTIVE"

# step: an ACL is updated
# result: the ACL is in MODIFYING state
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is ACTIVE
# guard_violation_lifecycle: the ACL is not ACTIVE
atomic action UpdateACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                acl_status[aid] = "MODIFYING"

# fake_skip: internal
# step: an ACL update completes
# result: the ACL returns to ACTIVE state
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is MODIFYING
# guard_violation: the ACL is not MODIFYING
atomic action CompleteACLUpdate:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "MODIFYING":
                acl_status[aid] = "ACTIVE"

# step: an ACL is deleted
# result: the ACL is in DELETING state
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is ACTIVE
# guard_violation_lifecycle: the ACL is not ACTIVE
# guard: the cluster has an ACL association
# guard_violation: the cluster does not have an ACL association
# guard: the cluster uses this ACL
# guard_violation: the cluster does not use this ACL
# guard: the ACL is not in use by any cluster
# guard_violation: the ACL is in use by a cluster
atomic action DeleteACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                in_use = False
                for cid in CLUSTER_IDS:
                    if cid in cluster_acl:
                        if cluster_acl[cid] == aid:
                            in_use = True
                if not in_use:
                    acl_status[aid] = "DELETING"

# fake_skip: internal
# step: an ACL deletion completes
# result: the ACL is DELETED
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is DELETING
# guard_violation: the ACL is not DELETING
atomic action CompleteACLDeletion:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "DELETING":
                acl_status[aid] = "DELETED"

# step: an ACL is associated with a cluster
# result: the cluster is linked to the active ACL
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is ACTIVE
# guard_violation_lifecycle: the ACL is not ACTIVE
atomic action AssociateACLWithCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof aid in ACL_IDS:
                    if aid in acl_status:
                        if acl_status[aid] == "ACTIVE":
                            cluster_acl[cid] = aid

# step: a user is created
# result: the user is in CREATING state
# guard: the user does not already exist
# guard_violation: the user already exists
atomic action CreateUser:
    oneof uid in USER_IDS:
        if uid not in user_status:
            user_status[uid] = "CREATING"

# fake_skip: internal
# step: a user finishes creating
# result: the user is ACTIVE
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is CREATING
# guard_violation: the user is not CREATING
atomic action CompleteUserCreation:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "CREATING":
                user_status[uid] = "ACTIVE"

# step: a user is updated
# result: the user is in MODIFYING state
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is ACTIVE
# guard_violation_lifecycle: the user is not ACTIVE
atomic action UpdateUser:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "ACTIVE":
                user_status[uid] = "MODIFYING"

# fake_skip: internal
# step: a user update completes
# result: the user returns to ACTIVE state
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is MODIFYING
# guard_violation: the user is not MODIFYING
atomic action CompleteUserUpdate:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "MODIFYING":
                user_status[uid] = "ACTIVE"

# step: a user is deleted
# result: the user is in DELETING state
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is ACTIVE
# guard_violation_lifecycle: the user is not ACTIVE
# guard: the user has an ACL membership entry
# guard_violation: the user does not have an ACL membership entry
# guard: the user is a member of the ACL
# guard_violation: the user is not a member of the ACL
# guard: the user is not a member of any ACL
# guard_violation: the user is a member of an ACL
atomic action DeleteUser:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "ACTIVE":
                in_acl = False
                for aid in ACL_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            in_acl = True
                if not in_acl:
                    user_status[uid] = "DELETING"

# fake_skip: internal
# step: a user deletion completes
# result: the user is DELETED
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is DELETING
# guard_violation: the user is not DELETING
atomic action CompleteUserDeletion:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "DELETING":
                user_status[uid] = "DELETED"

# step: a user is added to an ACL
# result: the user is a member of the ACL
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is ACTIVE
# guard_violation_lifecycle: the ACL is not ACTIVE
# guard: the user exists
# guard_violation: the user does not exist
# guard: the user is ACTIVE
# guard_violation_lifecycle: the user is not ACTIVE
# guard: the user is not already a member of the ACL
# guard_violation: the user is already a member of the ACL
atomic action AddUserToACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                oneof uid in USER_IDS:
                    if uid in user_status:
                        if user_status[uid] == "ACTIVE":
                            mkey = aid + "#" + uid
                            if mkey not in acl_has_user:
                                acl_has_user[mkey] = True

# step: a user is removed from an ACL
# result: the user is no longer a member of the ACL
# guard: the ACL exists
# guard_violation: the ACL does not exist
# guard: the ACL is ACTIVE
# guard_violation_lifecycle: the ACL is not ACTIVE
# guard: the user membership entry exists
# guard_violation: the user membership entry does not exist
# guard: the user is a member of the ACL
# guard_violation: the user is not a member of the ACL
atomic action RemoveUserFromACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                oneof uid in USER_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            acl_has_user[mkey] = False

# step: tags are added to a MemoryDB resource
# result: the resource remains tagged
# guard: the resource has a tag entry
# guard_violation: the resource does not have a tag entry
# guard: the resource is tagged
# guard_violation: the resource is not tagged
atomic action TagResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# step: tags are removed from a MemoryDB resource
# result: the resource tag state is unchanged (no-op model)
# guard: the resource has a tag entry
# guard_violation: the resource does not have a tag entry
# guard: the resource is tagged
# guard_violation: the resource is not tagged
atomic action UntagResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# All MemoryDB clusters have writes_persisted set (durability guarantee)
# check: every active cluster has write durability enabled
always assertion AllClustersHaveDurability:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if not cluster_writes_persisted[cid]:
                    return False
    return True

# A cluster in SNAPSHOTTING state must have a corresponding in-progress snapshot
# check: every snapshotting cluster has a corresponding in-progress snapshot
always assertion SnapshottingClusterHasSnapshot:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "SNAPSHOTTING":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_cluster[sid] == cid:
                            if snapshot_status[sid] == "CREATING":
                                found = True
                if not found:
                    return False
    return True

# An ACL cannot be deleted while associated with a cluster
# check: no ACL in DELETING state is currently associated with a cluster
always assertion ACLNotDeletedWhileInUse:
    for aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "DELETING":
                for cid in CLUSTER_IDS:
                    if cid in cluster_acl:
                        if cluster_acl[cid] == aid:
                            return False
    return True

# A user cannot be deleted while referenced by an ACL
# check: no user in DELETING state is currently a member of an ACL
always assertion UserNotDeletedWhileInACL:
    for uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "DELETING":
                for aid in ACL_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            return False
    return True

# Tags exist for every active resource
# check: every active cluster and snapshot has tags
always assertion TagsExistForResources:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cid not in tag_exists:
                    return False
                if not tag_exists[cid]:
                    return False
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                if sid not in tag_exists:
                    return False
                if not tag_exists[sid]:
                    return False
    return True
