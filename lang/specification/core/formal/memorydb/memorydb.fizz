---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 12
---
# Amazon MemoryDB for Redis formal specification
# Models clusters, snapshots, ACLs, users, and durability guarantees

CLUSTER_IDS = ["cl1", "cl2", "cl3", "cl4"]
SNAPSHOT_IDS = ["snap1", "snap2", "snap3"]
ACL_IDS = ["acl1", "acl2", "acl3"]
USER_IDS = ["user1", "user2", "user3", "user4"]

action Init:
    cluster_status = {}
    cluster_multi_az = {}
    cluster_acl = {}
    cluster_writes_persisted = {}

    snapshot_status = {}
    snapshot_cluster = {}

    acl_status = {}

    user_status = {}

    acl_has_user = {}

    tag_exists = {}

# step: a "memorydb" "cluster" is created
# result: the "memorydb" "cluster" will be in "CREATING" state
# guard: the "memorydb" "cluster" did not already exist
# guard_violation: the "memorydb" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_multi_az[cid] = True
            cluster_acl[cid] = ""
            cluster_writes_persisted[cid] = True
            tag_exists[cid] = True

# fake_skip: internal
# step: a "memorydb" "cluster" finishes creating
# result: the "memorydb" "cluster" will be "AVAILABLE"
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "CREATING"
# guard_violation: the "memorydb" "cluster" was not "CREATING"
atomic action CompleteClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "AVAILABLE"

# step: a "memorydb" "cluster" configuration is updated
# result: the "memorydb" "cluster" will be in "MODIFYING" state
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
atomic action UpdateCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: a "memorydb" "cluster" update completes
# result: the "memorydb" "cluster" returns to "AVAILABLE" state
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "MODIFYING"
# guard_violation: the "memorydb" "cluster" was not "MODIFYING"
atomic action CompleteClusterUpdate:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a "memorydb" "cluster" is deleted
# result: the "memorydb" "cluster" will be in "DELETING" state
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
atomic action DeleteCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a "memorydb" "cluster" deletion completes
# result: the "memorydb" "cluster" will be "DELETED" and its tags will be removed
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "DELETING"
# guard_violation: the "memorydb" "cluster" was not "DELETING"
atomic action CompleteClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"
                tag_exists[cid] = False

# fake_skip: internal
# step: a shard failover is triggered on a multi-AZ "memorydb" "cluster"
# result: the "memorydb" "cluster" remains "AVAILABLE" after the shard failover
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
# guard: multi-AZ was "ENABLED" for the "memorydb" "cluster"
# guard_violation: multi-AZ was not "ENABLED" for the "memorydb" "cluster"
atomic action FailoverShard:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_multi_az[cid]:
                    cluster_status[cid] = "AVAILABLE"

# step: a "memorydb" "snapshot" is created from an available "memorydb" "cluster"
# result: the "memorydb" "snapshot" will be in "CREATING" state and the "memorydb" "cluster" will be "SNAPSHOTTING"
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
# guard: the "memorydb" "snapshot" slot is available
# guard_violation: the "memorydb" "snapshot" slot is not available
atomic action CreateSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_cluster[sid] = cid
                        tag_exists[sid] = True
                        cluster_status[cid] = "SNAPSHOTTING"

# fake_skip: internal
# step: a "memorydb" "snapshot" finishes creating
# result: the "memorydb" "snapshot" will be "AVAILABLE" and the "memorydb" "cluster" returns to "AVAILABLE" state
# guard: the "memorydb" "snapshot" existed
# guard_violation: the "memorydb" "snapshot" did not exist
# guard: the "memorydb" "snapshot" was "CREATING"
# guard_violation: the "memorydb" "snapshot" was not "CREATING"
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "snapshot" belongs to this "memorydb" "cluster"
# guard_violation: the "memorydb" "snapshot" does not belong to this "memorydb" "cluster"
# guard: the "memorydb" "cluster" was "SNAPSHOTTING"
# guard_violation: the "memorydb" "cluster" was not "SNAPSHOTTING"
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if snapshot_cluster[sid] == cid:
                            if cluster_status[cid] == "SNAPSHOTTING":
                                cluster_status[cid] = "AVAILABLE"

# step: a "memorydb" "snapshot" is deleted
# result: the "memorydb" "snapshot" will be in "DELETING" state
# guard: the "memorydb" "snapshot" existed
# guard_violation: the "memorydb" "snapshot" did not exist
# guard: the "memorydb" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "snapshot" was not "AVAILABLE"
atomic action DeleteSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a "memorydb" "snapshot" deletion completes
# result: the "memorydb" "snapshot" will be "DELETED" and its tags will be removed
# guard: the "memorydb" "snapshot" existed
# guard_violation: the "memorydb" "snapshot" did not exist
# guard: the "memorydb" "snapshot" was "DELETING"
# guard_violation: the "memorydb" "snapshot" was not "DELETING"
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"
                tag_exists[sid] = False

# step: a "memorydb" "cluster" is restored from a "memorydb" "snapshot"
# result: the restored "memorydb" "cluster" will be in "RESTORING" state
# guard: the "memorydb" "snapshot" existed
# guard_violation: the "memorydb" "snapshot" did not exist
# guard: the "memorydb" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "snapshot" was not "AVAILABLE"
# guard: the target "memorydb" "cluster" slot is available
# guard_violation: the target "memorydb" "cluster" slot is not available
atomic action RestoreCluster:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_multi_az[cid] = True
                        cluster_acl[cid] = ""
                        cluster_writes_persisted[cid] = True
                        tag_exists[cid] = True

# fake_skip: internal
# step: a "memorydb" "cluster" restore from "memorydb" "snapshot" completes
# result: the "memorydb" "cluster" will be "AVAILABLE"
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "RESTORING"
# guard_violation: the "memorydb" "cluster" was not "RESTORING"
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# step: an "memorydb" "ACL" is created
# result: the "memorydb" "ACL" will be in "CREATING" state
# guard: the "memorydb" "ACL" did not already exist
# guard_violation: the "memorydb" "ACL" already existed
atomic action CreateACL:
    oneof aid in ACL_IDS:
        if aid not in acl_status:
            acl_status[aid] = "CREATING"

# fake_skip: internal
# step: an "memorydb" "ACL" finishes creating
# result: the "memorydb" "ACL" will be "ACTIVE"
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "CREATING"
# guard_violation: the "memorydb" "ACL" was not "CREATING"
atomic action CompleteACLCreation:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "CREATING":
                acl_status[aid] = "ACTIVE"

# step: an "memorydb" "ACL" is updated
# result: the "memorydb" "ACL" will be in "MODIFYING" state
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "ACL" was not "ACTIVE"
atomic action UpdateACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                acl_status[aid] = "MODIFYING"

# fake_skip: internal
# step: an "memorydb" "ACL" update completes
# result: the "memorydb" "ACL" returns to "ACTIVE" state
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "MODIFYING"
# guard_violation: the "memorydb" "ACL" was not "MODIFYING"
atomic action CompleteACLUpdate:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "MODIFYING":
                acl_status[aid] = "ACTIVE"

# step: an "memorydb" "ACL" is deleted
# result: the "memorydb" "ACL" will be in "DELETING" state
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "ACL" was not "ACTIVE"
# guard: the "memorydb" "cluster" has an "memorydb" "ACL" association
# guard_violation: the "memorydb" "cluster" does not have an "memorydb" "ACL" association
# guard: the "memorydb" "cluster" uses this ACL
# guard_violation: the "memorydb" "cluster" does not use this ACL
# guard: the "memorydb" "ACL" is not in use by any memorydb cluster
# guard_violation: the "memorydb" "ACL" is in use by a "memorydb" "cluster"
atomic action DeleteACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                in_use = False
                for cid in CLUSTER_IDS:
                    if cid in cluster_acl:
                        if cluster_acl[cid] == aid:
                            in_use = True
                if not in_use:
                    acl_status[aid] = "DELETING"

# fake_skip: internal
# step: an "memorydb" "ACL" deletion completes
# result: the "memorydb" "ACL" will be deleted
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "DELETING"
# guard_violation: the "memorydb" "ACL" was not "DELETING"
atomic action CompleteACLDeletion:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "DELETING":
                acl_status[aid] = "DELETED"

# step: an "memorydb" "ACL" is associated with a "memorydb" "cluster"
# result: the "memorydb" "cluster" will be linked to the active ACL
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "ACL" was not "ACTIVE"
atomic action AssociateACLWithCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof aid in ACL_IDS:
                    if aid in acl_status:
                        if acl_status[aid] == "ACTIVE":
                            cluster_acl[cid] = aid

# step: a "memorydb" "user" is created
# result: the "memorydb" "user" will be in "CREATING" state
# guard: the "memorydb" "user" did not already exist
# guard_violation: the "memorydb" "user" already existed
atomic action CreateUser:
    oneof uid in USER_IDS:
        if uid not in user_status:
            user_status[uid] = "CREATING"

# fake_skip: internal
# step: a "memorydb" "user" finishes creating
# result: the "memorydb" "user" will be "ACTIVE"
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "CREATING"
# guard_violation: the "memorydb" "user" was not "CREATING"
atomic action CompleteUserCreation:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "CREATING":
                user_status[uid] = "ACTIVE"

# step: a "memorydb" "user" is updated
# result: the "memorydb" "user" will be in "MODIFYING" state
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "user" was not "ACTIVE"
atomic action UpdateUser:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "ACTIVE":
                user_status[uid] = "MODIFYING"

# fake_skip: internal
# step: a "memorydb" "user" update completes
# result: the "memorydb" "user" returns to "ACTIVE" state
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "MODIFYING"
# guard_violation: the "memorydb" "user" was not "MODIFYING"
atomic action CompleteUserUpdate:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "MODIFYING":
                user_status[uid] = "ACTIVE"

# step: a "memorydb" "user" is deleted
# result: the "memorydb" "user" will be in "DELETING" state
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "user" was not "ACTIVE"
# guard: the "memorydb" "user" has an "memorydb" "ACL" membership entry
# guard_violation: the "memorydb" "user" does not have an "memorydb" "ACL" membership entry
# guard: the "memorydb" "user" was a member of the "memorydb" "ACL"
# guard_violation: the "memorydb" "user" was not a member of the "memorydb" "ACL"
# guard: the "memorydb" "user" was not a member of any ACL
# guard_violation: the "memorydb" "user" was a member of an "memorydb" "ACL"
atomic action DeleteUser:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "ACTIVE":
                in_acl = False
                for aid in ACL_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            in_acl = True
                if not in_acl:
                    user_status[uid] = "DELETING"

# fake_skip: internal
# step: a "memorydb" "user" deletion completes
# result: the "memorydb" "user" will be deleted
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "DELETING"
# guard_violation: the "memorydb" "user" was not "DELETING"
atomic action CompleteUserDeletion:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "DELETING":
                user_status[uid] = "DELETED"

# step: a "memorydb" "user" is added to an "memorydb" "ACL"
# result: the "memorydb" "user" will be a member of the "memorydb" "ACL"
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "ACL" was not "ACTIVE"
# guard: the "memorydb" "user" existed
# guard_violation: the "memorydb" "user" did not exist
# guard: the "memorydb" "user" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "user" was not "ACTIVE"
# guard: the "memorydb" "user" was not already a member of the "memorydb" "ACL"
# guard_violation: the "memorydb" "user" is already a member of the "memorydb" "ACL"
atomic action AddUserToACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                oneof uid in USER_IDS:
                    if uid in user_status:
                        if user_status[uid] == "ACTIVE":
                            mkey = aid + "#" + uid
                            if mkey not in acl_has_user:
                                acl_has_user[mkey] = True

# step: a "memorydb" "user" is removed from an "memorydb" "ACL"
# result: the "memorydb" "user" will no longer be a member of the "memorydb" "ACL"
# guard: the "memorydb" "ACL" existed
# guard_violation: the "memorydb" "ACL" did not exist
# guard: the "memorydb" "ACL" was "ACTIVE"
# guard_violation_lifecycle: the "memorydb" "ACL" was not "ACTIVE"
# guard: the "memorydb" "user" membership entry existed
# guard_violation: the "memorydb" "user" membership entry did not exist
# guard: the "memorydb" "user" was a member of the "memorydb" "ACL"
# guard_violation: the "memorydb" "user" was not a member of the "memorydb" "ACL"
atomic action RemoveUserFromACL:
    oneof aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "ACTIVE":
                oneof uid in USER_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            acl_has_user[mkey] = False

# step: tags are added to a "memorydb" "resource"
# result: the "memorydb" "resource" remains tagged
# guard: the "memorydb" "resource" has a tag entry
# guard_violation: the "memorydb" "resource" does not have a tag entry
# guard: the "memorydb" "resource" was tagged
# guard_violation: the "memorydb" "resource" was not tagged
atomic action TagResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# step: tags are removed from a "memorydb" "resource"
# result: the "memorydb" "resource" tag state will be unchanged (no-op model)
# guard: the "memorydb" "resource" has a tag entry
# guard_violation: the "memorydb" "resource" does not have a tag entry
# guard: the "memorydb" "resource" was tagged
# guard_violation: the "memorydb" "resource" was not tagged
atomic action UntagResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# All MemoryDB clusters have writes_persisted set (durability guarantee)
# check: every active "memorydb" "cluster" has write durability enabled
always assertion AllClustersHaveDurability:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if not cluster_writes_persisted[cid]:
                    return False
    return True

# A cluster in SNAPSHOTTING state must have a corresponding in-progress snapshot
# check: every snapshotting "memorydb" "cluster" has a corresponding in-progress "memorydb" "snapshot"
always assertion SnapshottingClusterHasSnapshot:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "SNAPSHOTTING":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_cluster[sid] == cid:
                            if snapshot_status[sid] == "CREATING":
                                found = True
                if not found:
                    return False
    return True

# An ACL cannot be deleted while associated with a cluster
# check: no "memorydb" "ACL" in "DELETING" state is currently associated with a "memorydb" "cluster"
always assertion ACLNotDeletedWhileInUse:
    for aid in ACL_IDS:
        if aid in acl_status:
            if acl_status[aid] == "DELETING":
                for cid in CLUSTER_IDS:
                    if cid in cluster_acl:
                        if cluster_acl[cid] == aid:
                            return False
    return True

# A user cannot be deleted while referenced by an ACL
# check: no "memorydb" "user" in "DELETING" state is currently a member of a "memorydb" "ACL"
always assertion UserNotDeletedWhileInACL:
    for uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "DELETING":
                for aid in ACL_IDS:
                    mkey = aid + "#" + uid
                    if mkey in acl_has_user:
                        if acl_has_user[mkey]:
                            return False
    return True

# Tags exist for every active resource
# check: every active "memorydb" "cluster" and "snapshot" has tags
always assertion TagsExistForResources:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cid not in tag_exists:
                    return False
                if not tag_exists[cid]:
                    return False
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                if sid not in tag_exists:
                    return False
                if not tag_exists[sid]:
                    return False
    return True
