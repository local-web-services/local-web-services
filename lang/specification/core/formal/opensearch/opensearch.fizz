---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 20
---
DOMAIN_NAMES = ["os-domain-a", "os-domain-b", "os-domain-c"]
CONNECTION_IDS = ["conn-1", "conn-2", "conn-3"]
TAG_KEYS = ["env", "team", "cost-center", "project"]

action Init:
    domain_status = {}
    domain_instance_type = {}
    domain_instance_count = {}
    domain_pending_config = {}
    domain_bg_new_cluster = {}
    domain_bg_traffic_swapped = {}
    domain_tag = {}
    outbound_status = {}
    outbound_local = {}
    outbound_remote = {}
    inbound_status = {}

# step: an "opensearch" "domain" is created
# result: the "opensearch" "domain" will be in "CREATING" state
# guard: the "opensearch" "domain" did not already exist
# guard_violation: the "opensearch" "domain" already existed
atomic action CreateDomain:
    oneof domain in DOMAIN_NAMES:
        if domain not in domain_status:
            domain_status[domain] = "CREATING"
            domain_instance_type[domain] = "r6g.large.search"
            domain_instance_count[domain] = 1
            domain_pending_config[domain] = False
            domain_bg_new_cluster[domain] = False
            domain_bg_traffic_swapped[domain] = False

# fake_skip: internal
# step: an "opensearch" "domain" finishes creating
# result: the "opensearch" "domain" will be "ACTIVE" and ready for use
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "CREATING"
# guard_violation: the "opensearch" "domain" was not "CREATING"
atomic action FinishCreatingDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "CREATING":
                domain_status[domain] = "ACTIVE"

# step: an "opensearch" "domain" is deleted
# result: the "opensearch" "domain" will be in "DELETING" state
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "opensearch" "domain" was not "ACTIVE"
atomic action DeleteDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_status[domain] = "DELETING"

# fake_skip: internal
# step: an "opensearch" "domain" finishes deleting
# result: the "opensearch" "domain" will be "DELETED" and all associated connections will be removed
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "DELETING"
# guard_violation: the "opensearch" "domain" was not "DELETING"
# guard: an "opensearch" "outbound connection" has a local "opensearch" "domain" set
# guard_violation: an "opensearch" "outbound connection" does not have a local "opensearch" "domain" set
# guard: the "opensearch" "outbound connection"'s local "opensearch" "domain" is this "opensearch" "domain"
# guard_violation: the "opensearch" "outbound connection"'s local "opensearch" "domain" is not this "opensearch" "domain"
# guard: an "opensearch" "outbound connection" has a remote "opensearch" "domain" set
# guard_violation: an "opensearch" "outbound connection" does not have a remote "opensearch" "domain" set
# guard: the "opensearch" "outbound connection"'s remote "opensearch" "domain" is this "opensearch" "domain"
# guard_violation: the "opensearch" "outbound connection"'s remote "opensearch" "domain" is not this "opensearch" "domain"
# guard: an "opensearch" "inbound connection" existed
# guard_violation: an "opensearch" "inbound connection" did not exist
# guard: the "opensearch" "inbound connection" is not already "DELETED"
# guard_violation: the "opensearch" "inbound connection" is already "DELETED"
# guard: the associated outbound connection has a local "opensearch" "domain"
# guard_violation: the associated outbound connection does not have a local "opensearch" "domain"
# guard: the "opensearch" "outbound connection"'s local "opensearch" "domain" matches this "opensearch" "domain"
# guard_violation: the "opensearch" "outbound connection"'s local "opensearch" "domain" does not match this "opensearch" "domain"
# guard: the associated outbound connection has a remote "opensearch" "domain"
# guard_violation: the associated outbound connection does not have a remote "opensearch" "domain"
# guard: the "opensearch" "outbound connection"'s remote "opensearch" "domain" matches this "opensearch" "domain"
# guard_violation: the "opensearch" "outbound connection"'s remote "opensearch" "domain" does not match this "opensearch" "domain"
atomic action FinishDeletingDomain:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "DELETING":
                domain_status[domain] = "DELETED"
                for conn in CONNECTION_IDS:
                    if conn in outbound_local:
                        if outbound_local[conn] == domain:
                            outbound_status[conn] = "DELETED"
                    if conn in outbound_remote:
                        if outbound_remote[conn] == domain:
                            outbound_status[conn] = "DELETED"
                    if conn in inbound_status:
                        if inbound_status[conn] != "DELETED":
                            if conn in outbound_local:
                                if outbound_local[conn] == domain:
                                    inbound_status[conn] = "DELETED"
                            if conn in outbound_remote:
                                if outbound_remote[conn] == domain:
                                    inbound_status[conn] = "DELETED"

# step: an "opensearch" "domain" configuration update is requested
# result: the "opensearch" "domain" will be in "PROCESSING" state and a blue-green deployment begins
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "opensearch" "domain" was not "ACTIVE"
atomic action UpdateDomainConfig:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_status[domain] = "PROCESSING"
                domain_pending_config[domain] = True
                domain_bg_new_cluster[domain] = False
                domain_bg_traffic_swapped[domain] = False

# fake_skip: internal
# step: the new "opensearch" "cluster" for a blue-green deployment becomes ready
# result: the "opensearch" "domain" will have a new cluster prepared but traffic will not yet be swapped
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "PROCESSING"
# guard_violation: the "opensearch" "domain" was not "PROCESSING"
# guard: the new "opensearch" "cluster" has not been prepared yet
# guard_violation: the new "opensearch" "cluster" has already been prepared
atomic action BlueGreenNewClusterReady:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "PROCESSING":
                if domain_bg_new_cluster[domain] == False:
                    domain_bg_new_cluster[domain] = True

# fake_skip: internal
# step: traffic is swapped to the new "opensearch" "cluster" during a blue-green deployment
# result: the "opensearch" "domain" will now be serving requests from the new "opensearch" "cluster"
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "PROCESSING"
# guard_violation: the "opensearch" "domain" was not "PROCESSING"
# guard: the new "opensearch" "cluster" was ready
# guard_violation: the new "opensearch" "cluster" was not ready
# guard: the "opensearch" "domain" blue-green traffic had not been swapped yet
# guard_violation: the "opensearch" "domain" blue-green traffic had already been swapped
atomic action BlueGreenSwapTraffic:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "PROCESSING":
                if domain_bg_new_cluster[domain] == True:
                    if domain_bg_traffic_swapped[domain] == False:
                        domain_bg_traffic_swapped[domain] = True

# fake_skip: internal
# step: a "opensearch" "domain" blue-green deployment completes
# result: the "opensearch" "domain" will be "ACTIVE" with the new configuration applied
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "PROCESSING"
# guard_violation: the "opensearch" "domain" was not "PROCESSING"
# guard: traffic has been swapped to the new "opensearch" "cluster"
# guard_violation: traffic has not been swapped to the new "opensearch" "cluster"
atomic action BlueGreenComplete:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "PROCESSING":
                if domain_bg_traffic_swapped[domain] == True:
                    domain_instance_type[domain] = "r6g.xlarge.search"
                    domain_instance_count[domain] = 2
                    domain_pending_config[domain] = False
                    domain_bg_new_cluster[domain] = False
                    domain_bg_traffic_swapped[domain] = False
                    domain_status[domain] = "ACTIVE"

# fake_skip: internal
# step: shards are rebalanced across nodes in an active "opensearch" "domain"
# result: the "opensearch" "domain" instance count will be updated without data loss
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "opensearch" "domain" was not "ACTIVE"
atomic action ShardRebalancing:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] == "ACTIVE":
                domain_instance_count[domain] = domain_instance_count[domain]

# step: an outbound cross-cluster connection is created between two "opensearch" "domain"s
# result: the "opensearch" "connection" will be in "PENDING_ACCEPTANCE" state
# guard: an "opensearch" "connection" "slot" was "available"
# guard_violation: no "opensearch" "connection" "slot" was "available"
# guard: the local "opensearch" "domain" existed
# guard_violation: the local "opensearch" "domain" did not exist
# guard: the local "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the local "opensearch" "domain" was not "ACTIVE"
# guard: the remote "opensearch" "domain" existed
# guard_violation: the remote "opensearch" "domain" did not exist
# guard: the remote "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the remote "opensearch" "domain" was not "ACTIVE"
# guard: the local and remote "opensearch" "domain"s are different
# guard_violation: the local and remote "opensearch" "domain"s are the same
atomic action CreateOutboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn not in outbound_status:
            oneof local_domain in DOMAIN_NAMES:
                if local_domain in domain_status:
                    if domain_status[local_domain] == "ACTIVE":
                        oneof remote_domain in DOMAIN_NAMES:
                            if remote_domain in domain_status:
                                if domain_status[remote_domain] == "ACTIVE":
                                    if local_domain != remote_domain:
                                        outbound_status[conn] = "PENDING_ACCEPTANCE"
                                        outbound_local[conn] = local_domain
                                        outbound_remote[conn] = remote_domain
                                        inbound_status[conn] = "PENDING_ACCEPTANCE"

# step: an "opensearch" "inbound connection" is accepted
# result: both the inbound and outbound connection are "ACTIVE"
# guard: the "opensearch" "inbound connection" existed
# guard_violation: the "opensearch" "inbound connection" did not exist
# guard: the "opensearch" "inbound connection" was "PENDING_ACCEPTANCE"
# guard_violation: the "opensearch" "inbound connection" was not "PENDING_ACCEPTANCE"
# guard: the "opensearch" "outbound connection" existed
# guard_violation: the "opensearch" "outbound connection" did not exist
atomic action AcceptInboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in inbound_status:
            if inbound_status[conn] == "PENDING_ACCEPTANCE":
                inbound_status[conn] = "ACTIVE"
                if conn in outbound_status:
                    outbound_status[conn] = "ACTIVE"

# step: an "opensearch" "inbound connection" is rejected
# result: both the inbound and outbound connection are "REJECTED"
# guard: the "opensearch" "inbound connection" existed
# guard_violation: the "opensearch" "inbound connection" did not exist
# guard: the "opensearch" "inbound connection" was "PENDING_ACCEPTANCE"
# guard_violation: the "opensearch" "inbound connection" was not "PENDING_ACCEPTANCE"
# guard: the "opensearch" "outbound connection" existed
# guard_violation: the "opensearch" "outbound connection" did not exist
atomic action RejectInboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in inbound_status:
            if inbound_status[conn] == "PENDING_ACCEPTANCE":
                inbound_status[conn] = "REJECTED"
                if conn in outbound_status:
                    outbound_status[conn] = "REJECTED"

# step: an "opensearch" "outbound connection" is deleted
# result: the "opensearch" "outbound connection" will be in "DELETING" state
# guard: the "opensearch" "outbound connection" existed
# guard_violation: the "opensearch" "outbound connection" did not exist
# guard: the "opensearch" "outbound connection" is not already "DELETING"
# guard_violation: the "opensearch" "outbound connection" is already "DELETING"
# guard: the "opensearch" "outbound connection" is not already "DELETED"
# guard_violation: the "opensearch" "outbound connection" is already "DELETED"
atomic action DeleteOutboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in outbound_status:
            if outbound_status[conn] != "DELETING":
                if outbound_status[conn] != "DELETED":
                    outbound_status[conn] = "DELETING"

# fake_skip: internal
# step: an "opensearch" "outbound connection" finishes deleting
# result: the "opensearch" "outbound connection" and associated "opensearch" "inbound connection" will be "DELETED"
# guard: the "opensearch" "outbound connection" existed
# guard_violation: the "opensearch" "outbound connection" did not exist
# guard: the "opensearch" "outbound connection" was "DELETING"
# guard_violation: the "opensearch" "outbound connection" was not "DELETING"
# guard: the associated "opensearch" "inbound connection" existed
# guard_violation: the associated "opensearch" "inbound connection" did not exist
atomic action FinishDeletingOutboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in outbound_status:
            if outbound_status[conn] == "DELETING":
                outbound_status[conn] = "DELETED"
                if conn in inbound_status:
                    inbound_status[conn] = "DELETED"

# step: an "opensearch" "inbound connection" is deleted
# result: the "opensearch" "inbound connection" will be in "DELETING" state
# guard: the "opensearch" "inbound connection" existed
# guard_violation: the "opensearch" "inbound connection" did not exist
# guard: the "opensearch" "inbound connection" is not already "DELETING"
# guard_violation: the "opensearch" "inbound connection" is already "DELETING"
# guard: the "opensearch" "inbound connection" is not already "DELETED"
# guard_violation: the "opensearch" "inbound connection" is already "DELETED"
atomic action DeleteInboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in inbound_status:
            if inbound_status[conn] != "DELETING":
                if inbound_status[conn] != "DELETED":
                    inbound_status[conn] = "DELETING"

# fake_skip: internal
# step: an "opensearch" "inbound connection" finishes deleting
# result: the "opensearch" "inbound connection" will be "DELETED"
# guard: the "opensearch" "inbound connection" existed
# guard_violation: the "opensearch" "inbound connection" did not exist
# guard: the "opensearch" "inbound connection" was "DELETING"
# guard_violation: the "opensearch" "inbound connection" was not "DELETING"
atomic action FinishDeletingInboundConnection:
    oneof conn in CONNECTION_IDS:
        if conn in inbound_status:
            if inbound_status[conn] == "DELETING":
                inbound_status[conn] = "DELETED"

# step: tags are added to an "opensearch" "domain"
# result: the specified tags are associated with the "opensearch" "domain"
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" is not being deleted
# guard_violation_lifecycle: the "opensearch" "domain" is being deleted
# guard: the "opensearch" "domain" was not "DELETED"
# guard_violation: the "opensearch" "domain" was "DELETED"
atomic action AddTags:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] != "DELETING":
                if domain_status[domain] != "DELETED":
                    oneof tkey in TAG_KEYS:
                        domain_tag[domain + "#" + tkey] = True

# step: tags are removed from an "opensearch" "domain"
# result: the specified tags are no longer associated with the "opensearch" "domain"
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" is not being deleted
# guard_violation_lifecycle: the "opensearch" "domain" is being deleted
# guard: the "opensearch" "domain" was not "DELETED"
# guard_violation: the "opensearch" "domain" was "DELETED"
# guard: the "opensearch" "tag key" existed
# guard_violation: the "opensearch" "tag key" did not exist
atomic action RemoveTags:
    oneof domain in DOMAIN_NAMES:
        if domain in domain_status:
            if domain_status[domain] != "DELETING":
                if domain_status[domain] != "DELETED":
                    oneof tkey in TAG_KEYS:
                        tk = domain + "#" + tkey
                        if tk in domain_tag:
                            domain_tag[tk] = False

# check: no active "opensearch" "connection" references a deleted "opensearch" "domain"
always assertion ActiveConnectionsReferenceActiveDomains:
    for conn in CONNECTION_IDS:
        if conn in outbound_status:
            if outbound_status[conn] == "ACTIVE":
                if conn in outbound_local:
                    local = outbound_local[conn]
                    if local in domain_status:
                        if domain_status[local] == "DELETED":
                            return False
                if conn in outbound_remote:
                    remote = outbound_remote[conn]
                    if remote in domain_status:
                        if domain_status[remote] == "DELETED":
                            return False
    return True

# check: traffic can only be swapped after the new "opensearch" "cluster" was ready
always assertion TrafficSwapRequiresNewCluster:
    for domain in DOMAIN_NAMES:
        if domain in domain_bg_traffic_swapped:
            if domain_bg_traffic_swapped[domain] == True:
                if domain_bg_new_cluster[domain] == False:
                    return False
    return True

# check: an "opensearch" "outbound connection" that was "ACTIVE" cannot have a "REJECTED" "opensearch" "inbound connection"
always assertion ConnectionStatusConsistency:
    for conn in CONNECTION_IDS:
        if conn in outbound_status:
            if outbound_status[conn] == "ACTIVE":
                if conn in inbound_status:
                    if inbound_status[conn] == "REJECTED":
                        return False
    return True

# check: a pending config change only exists on an "opensearch" "domain" that is "PROCESSING"
always assertion PendingConfigOnlyOnProcessingDomain:
    for domain in DOMAIN_NAMES:
        if domain in domain_pending_config:
            if domain_pending_config[domain] == True:
                if domain in domain_status:
                    if domain_status[domain] != "PROCESSING":
                        return False
    return True
