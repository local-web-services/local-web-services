---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 6
---
POOL_IDS = ["pool-1", "pool-2"]
USER_IDS = ["user-1", "user-2"]
GROUP_IDS = ["group-1"]
SESSION_IDS = ["session-1", "session-2"]

action Init:
    pool_status = {}
    user_status = {}
    user_pool = {}
    user_enabled = {}
    user_attr_updated = {}
    group_pool = {}
    group_status = {}
    user_in_group = {}
    session_status = {}
    session_user = {}
    session_pool = {}

# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE"
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pool_id in POOL_IDS:
        if pool_id not in pool_status:
            pool_status[pool_id] = "ACTIVE"

# step: a "cognito" "user pool" is deleted
# result: the "cognito" "user pool" will be "DELETED" along with all its users and groups
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user" belonged to a "cognito" "user pool"
# guard_violation: the "cognito" "user" did not belong to a "cognito" "user pool"
# guard: the "cognito" "user" belonged to this pool
# guard_violation: the "cognito" "user" belonged to a different pool
# guard: the "cognito" "group" belonged to a "cognito" "user pool"
# guard_violation: the "cognito" "group" did not belong to a "cognito" "user pool"
# guard: the "cognito" "group" belonged to this pool
# guard_violation: the "cognito" "group" belonged to a different pool
atomic action DeleteUserPool:
    oneof pool_id in POOL_IDS:
        if pool_id in pool_status:
            if pool_status[pool_id] == "ACTIVE":
                pool_status[pool_id] = "DELETED"
                for user_id in USER_IDS:
                    if user_id in user_pool:
                        if user_pool[user_id] == pool_id:
                            user_status[user_id] = "DELETED"
                            for session_id in SESSION_IDS:
                                if session_id in session_user:
                                    if session_user[session_id] == user_id:
                                        if session_id in session_status:
                                            if session_status[session_id] != "EXPIRED":
                                                if session_status[session_id] != "CHALLENGE_FAILED":
                                                    session_status[session_id] = "EXPIRED"
                for group_id in GROUP_IDS:
                    if group_id in group_pool:
                        if group_pool[group_id] == pool_id:
                            group_status[group_id] = "DELETED"
                            for user_id in USER_IDS:
                                user_in_group[user_id + "#" + group_id] = False

# step: a "cognito" "user" is created by an admin in an active "cognito" "user pool"
# result: the "cognito" "user" will exist in "FORCE_CHANGE_PASSWORD" state and will be enabled
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user" did not already exist
# guard_violation: the "cognito" "user" already existed
atomic action AdminCreateUser:
    oneof pool_id in POOL_IDS:
        if pool_id in pool_status:
            if pool_status[pool_id] == "ACTIVE":
                oneof user_id in USER_IDS:
                    if user_id not in user_status:
                        user_status[user_id] = "FORCE_CHANGE_PASSWORD"
                        user_pool[user_id] = pool_id
                        user_enabled[user_id] = True

# step: a "cognito" "user" is deleted by an admin
# result: the "cognito" "user" will be deleted, their sessions are expired, and group memberships are cleared
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" is not already "DELETED"
# guard_violation: the "cognito" "user" is already "DELETED"
atomic action AdminDeleteUser:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] != "DELETED":
                user_status[user_id] = "DELETED"
                for session_id in SESSION_IDS:
                    if session_id in session_user:
                        if session_user[session_id] == user_id:
                            if session_id in session_status:
                                if session_status[session_id] != "EXPIRED":
                                    if session_status[session_id] != "CHALLENGE_FAILED":
                                        session_status[session_id] = "EXPIRED"
                for group_id in GROUP_IDS:
                    user_in_group[user_id + "#" + group_id] = False

# step: an admin confirms a "cognito" "user" registration
# result: the "cognito" "user" will be "CONFIRMED"
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "UNCONFIRMED"
# guard_violation: the "cognito" "user" was not "UNCONFIRMED"
atomic action AdminConfirmSignUp:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "UNCONFIRMED":
                user_status[user_id] = "CONFIRMED"

# step: an admin resets a "cognito" "user" password
# result: the "cognito" "user" will be in "RESET_REQUIRED" state
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation: the "cognito" "user" was not "CONFIRMED"
atomic action AdminResetUserPassword:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "CONFIRMED":
                user_status[user_id] = "RESET_REQUIRED"

# step: an admin sets a "cognito" "user" password
# result: the "cognito" "user" will be "CONFIRMED"
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" is in "RESET_REQUIRED" state
# guard_violation: the "cognito" "user" is not in "RESET_REQUIRED" state
# guard: the "cognito" "user" is in "FORCE_CHANGE_PASSWORD" state
# guard_violation: the "cognito" "user" is not in "FORCE_CHANGE_PASSWORD" state
atomic action AdminSetUserPassword:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "RESET_REQUIRED":
                user_status[user_id] = "CONFIRMED"
            if user_status[user_id] == "FORCE_CHANGE_PASSWORD":
                user_status[user_id] = "CONFIRMED"

# step: a "cognito" "user" was "DISABLED" by an admin
# result: the "cognito" "user" will be "DISABLED"
# guard: the "cognito" "user" had an enabled flag
# guard_violation: the "cognito" "user" did not have an enabled flag
# guard: the "cognito" "user" was "ENABLED"
# guard_violation: the "cognito" "user" was not "ENABLED"
atomic action AdminDisableUser:
    oneof user_id in USER_IDS:
        if user_id in user_enabled:
            if user_enabled[user_id]:
                user_enabled[user_id] = False
                for session_id in SESSION_IDS:
                    if session_id in session_user:
                        if session_user[session_id] == user_id:
                            if session_id in session_status:
                                if session_status[session_id] != "EXPIRED":
                                    if session_status[session_id] != "CHALLENGE_FAILED":
                                        session_status[session_id] = "EXPIRED"

# step: a "cognito" "user" was "ENABLED" by an admin
# result: the "cognito" "user" will be "ENABLED"
# guard: the "cognito" "user" had an enabled flag
# guard_violation: the "cognito" "user" did not have an enabled flag
# guard: the "cognito" "user" was "DISABLED"
# guard_violation: the "cognito" "user" was not "DISABLED"
atomic action AdminEnableUser:
    oneof user_id in USER_IDS:
        if user_id in user_enabled:
            if not user_enabled[user_id]:
                user_enabled[user_id] = True

# step: an admin updates attributes for a confirmed "cognito" "user"
# result: the "cognito" "user" attributes are updated
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation: the "cognito" "user" was not "CONFIRMED"
atomic action AdminUpdateUserAttributes:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "CONFIRMED":
                user_attr_updated[user_id] = True

# fake_skip: internal
# step: a "cognito" "user" is marked as compromised
# result: the "cognito" "user" will be in "COMPROMISED" state
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation: the "cognito" "user" was not "CONFIRMED"
atomic action MarkUserCompromised:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "CONFIRMED":
                user_status[user_id] = "COMPROMISED"

# step: a "cognito" "group" is created in an active "cognito" "user pool"
# result: the "cognito" "group" will be "ACTIVE" and associated with the "cognito" "user pool"
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "group" did not already exist
# guard_violation: the "cognito" "group" already existed
atomic action CreateGroup:
    oneof pool_id in POOL_IDS:
        if pool_id in pool_status:
            if pool_status[pool_id] == "ACTIVE":
                oneof group_id in GROUP_IDS:
                    if group_id not in group_status:
                        group_pool[group_id] = pool_id
                        group_status[group_id] = "ACTIVE"

# step: a "cognito" "group" is deleted
# result: the "cognito" "group" will be deleted and all users will be removed from it
# guard: the "cognito" "group" existed
# guard_violation: the "cognito" "group" did not exist
# guard: the "cognito" "group" was "ACTIVE"
# guard_violation: the "cognito" "group" was not "ACTIVE"
atomic action DeleteGroup:
    oneof group_id in GROUP_IDS:
        if group_id in group_status:
            if group_status[group_id] == "ACTIVE":
                group_status[group_id] = "DELETED"
                for user_id in USER_IDS:
                    user_in_group[user_id + "#" + group_id] = False

# step: an admin adds a "cognito" "user" to a "cognito" "group" in the same pool
# result: the "cognito" "user" will be a member of the "cognito" "group"
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was not "DELETED"
# guard_violation: the "cognito" "user" was "DELETED"
# guard: the "cognito" "group" existed
# guard_violation: the "cognito" "group" did not exist
# guard: the "cognito" "group" was "ACTIVE"
# guard_violation: the "cognito" "group" was not "ACTIVE"
# guard: the "cognito" "user" and group belonged to the same pool
# guard_violation: the "cognito" "user" and group belonged to different pools
atomic action AdminAddUserToGroup:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] != "DELETED":
                oneof group_id in GROUP_IDS:
                    if group_id in group_status:
                        if group_status[group_id] == "ACTIVE":
                            if user_pool[user_id] == group_pool[group_id]:
                                user_in_group[user_id + "#" + group_id] = True

# step: an admin removes a "cognito" "user" from a "cognito" "group"
# result: the "cognito" "user" will no longer be a member of the "cognito" "group"
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was not "DELETED"
# guard_violation: the "cognito" "user" was "DELETED"
# guard: the "cognito" "group" existed
# guard_violation: the "cognito" "group" did not exist
# guard: the "cognito" "group" was "ACTIVE"
# guard_violation: the "cognito" "group" was not "ACTIVE"
atomic action AdminRemoveUserFromGroup:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] != "DELETED":
                oneof group_id in GROUP_IDS:
                    if group_id in group_status:
                        if group_status[group_id] == "ACTIVE":
                            user_in_group[user_id + "#" + group_id] = False

# step: a confirmed enabled "cognito" "user" initiates authentication
# result: a "cognito" "session" will be created in "CHALLENGE_REQUIRED" state
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation: the "cognito" "user" was not "CONFIRMED"
# guard: the "cognito" "user" was "ENABLED"
# guard_violation: the "cognito" "user" was not "ENABLED"
# guard: the "cognito" "session" slot is available
# guard_violation_capacity: the "cognito" "session" slot is not available
atomic action InitiateAuth:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "CONFIRMED":
                if user_enabled[user_id]:
                    oneof session_id in SESSION_IDS:
                        if session_id not in session_status:
                            session_status[session_id] = "CHALLENGE_REQUIRED"
                            session_user[session_id] = user_id
                            session_pool[session_id] = user_pool[user_id]

# step: a "cognito" "user" responds to an auth challenge
# result: the "cognito" "session" will be either "AUTHENTICATED" or "CHALLENGE_FAILED"
# guard: the "cognito" "session" existed
# guard_violation: the "cognito" "session" did not exist
# guard: the "cognito" "session" was "CHALLENGE_REQUIRED"
# guard_violation: the "cognito" "session" was not "CHALLENGE_REQUIRED"
atomic action RespondToAuthChallenge:
    oneof session_id in SESSION_IDS:
        if session_id in session_status:
            if session_status[session_id] == "CHALLENGE_REQUIRED":
                oneof:
                    session_status[session_id] = "AUTHENTICATED"
                    session_status[session_id] = "CHALLENGE_FAILED"

# step: an admin initiates authentication on behalf of a confirmed enabled "cognito" "user"
# result: a "cognito" "session" will be created in "AUTHENTICATED" state
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation: the "cognito" "user" was not "CONFIRMED"
# guard: the "cognito" "user" was "ENABLED"
# guard_violation: the "cognito" "user" was not "ENABLED"
# guard: the "cognito" "session" slot is available
# guard_violation_capacity: the "cognito" "session" slot is not available
atomic action AdminInitiateAuth:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "CONFIRMED":
                if user_enabled[user_id]:
                    oneof session_id in SESSION_IDS:
                        if session_id not in session_status:
                            session_status[session_id] = "AUTHENTICATED"
                            session_user[session_id] = user_id
                            session_pool[session_id] = user_pool[user_id]

# fake_skip: internal
# step: an authenticated "cognito" "session" expires
# result: the "cognito" "session" will be in "EXPIRED" state
# guard: the "cognito" "session" existed
# guard_violation: the "cognito" "session" did not exist
# guard: the "cognito" "session" was "AUTHENTICATED"
# guard_violation: the "cognito" "session" was not "AUTHENTICATED"
atomic action ExpireAuthSession:
    oneof session_id in SESSION_IDS:
        if session_id in session_status:
            if session_status[session_id] == "AUTHENTICATED":
                session_status[session_id] = "EXPIRED"

# step: a verification code delivery fails for an unconfirmed "cognito" "user"
# result: the "cognito" "user" remains in "UNCONFIRMED" state
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "UNCONFIRMED"
# guard_violation: the "cognito" "user" was not "UNCONFIRMED"
atomic action VerificationCodeDeliveryFailure:
    oneof user_id in USER_IDS:
        if user_id in user_status:
            if user_status[user_id] == "UNCONFIRMED":
                pass

# check: every "cognito" "user pool" has a valid status (ACTIVE or DELETED)
always assertion ValidUserPoolStatus:
    for pool_id in pool_status:
        if pool_status[pool_id] != "ACTIVE":
            if pool_status[pool_id] != "DELETED":
                return False
    return True

# check: every "cognito" "user" has a valid status
always assertion ValidUserStatus:
    for user_id in user_status:
        s = user_status[user_id]
        if s != "UNCONFIRMED":
            if s != "CONFIRMED":
                if s != "ARCHIVED":
                    if s != "COMPROMISED":
                        if s != "RESET_REQUIRED":
                            if s != "FORCE_CHANGE_PASSWORD":
                                if s != "DELETED":
                                    return False
    return True

# check: every non-deleted "cognito" "user" has an enabled flag set
always assertion UserGroupMembershipEntryExists:
    for user_id in user_status:
        if user_status[user_id] != "DELETED":
            if user_id not in user_enabled:
                return False
    return True

# check: every "cognito" "group" membership references an existing active "cognito" "group"
always assertion GroupMembershipReferencesExistingGroups:
    for user_id in USER_IDS:
        for group_id in GROUP_IDS:
            compound = user_id + "#" + group_id
            if compound in user_in_group:
                if user_in_group[compound]:
                    if group_id not in group_status:
                        return False
                    if group_status[group_id] == "DELETED":
                        return False
    return True

# check: every "cognito" "session" has a valid status
always assertion ValidAuthSessionStatus:
    for session_id in session_status:
        s = session_status[session_id]
        if s != "CHALLENGE_REQUIRED":
            if s != "AUTHENTICATED":
                if s != "CHALLENGE_FAILED":
                    if s != "EXPIRED":
                        return False
    return True

# check: deleted "cognito" "user"s do not have active authenticated "cognito" "session"s
always assertion DeletedUsersNotAuthenticated:
    for session_id in SESSION_IDS:
        if session_id in session_status:
            if session_status[session_id] == "AUTHENTICATED":
                user_id = session_user[session_id]
                if user_id in user_status:
                    if user_status[user_id] == "DELETED":
                        return False
    return True

# check: disabled "cognito" "user"s do not have active authenticated "cognito" "session"s
always assertion DisabledUsersNotAuthenticated:
    for session_id in SESSION_IDS:
        if session_id in session_status:
            if session_status[session_id] == "AUTHENTICATED":
                user_id = session_user[session_id]
                if user_id in user_enabled:
                    if not user_enabled[user_id]:
                        return False
    return True
