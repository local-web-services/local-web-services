---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 30
---
# EventBridge -> SNS Integration Formal Specification
# Models an EventBridge rule routing events from a bus directly to an SNS topic.
# Completes the EventBridge fan-out picture alongside events_sqs, events_lambda,
# and events_stepfunctions.

BUS_IDS = ["bus-1"]
RULE_IDS = ["rule-1"]
TOPIC_IDS = ["topic-1"]
MSG_IDS = ["msg-1", "msg-2"]


action Init:
    bus_status = {}             # bus_status[bid] = "ACTIVE"
    rule_status = {}            # rule_status[rid] = "ENABLED" | "DISABLED"
    rule_bus = {}               # rule_bus[rid] = bus_id
    rule_topic = {}             # rule_topic[rid] = topic_id
    topic_status = {}           # topic_status[tid] = "ACTIVE"
    msg_status = {}             # msg_status[mid] = "AVAILABLE" | "DELETED"
    msg_topic = {}              # msg_topic[mid] = topic_id


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof bid in BUS_IDS:
        if bid not in bus_status:
            bus_status[bid] = "ACTIVE"


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: an "eventbridge" "rule" is created to route matching events to a "sns" "topic"
# result: the "eventbridge" "rule" will be "ENABLED" and will publish to the "sns" "topic" when matching events are received
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
# guard: the "eventbridge" "rule" did not already exist
# guard_violation: the "eventbridge" "rule" already existed
atomic action PutRule:
    oneof rid in RULE_IDS:
        if rid not in rule_status:
            oneof bid in BUS_IDS:
                if bid in bus_status:
                    if bus_status[bid] == "ACTIVE":
                        oneof tid in TOPIC_IDS:
                            if tid in topic_status:
                                if topic_status[tid] == "ACTIVE":
                                    rule_status[rid] = "ENABLED"
                                    rule_bus[rid] = bid
                                    rule_topic[rid] = tid


# step: an "eventbridge" "event" is published to the "eventbridge" "bus" and routed to the target "sns" "topic"
# result: the "sns" "message" will be "AVAILABLE" on the "sns" "topic"
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: an "ENABLED" "eventbridge" "rule" existed on the "eventbridge" "bus" targeting a "sns" "topic"
# guard_violation_lifecycle: no "ENABLED" "eventbridge" "rule" existed on the "eventbridge" "bus" targeting a "sns" "topic"
# guard: the target "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the target "sns" "topic" was not "ACTIVE"
# guard: a "sns" "message" "slot" was "available"
# guard_violation_capacity: no "sns" "message" "slot" was "available"
atomic action PutEvent:
    oneof bid in BUS_IDS:
        if bid in bus_status:
            if bus_status[bid] == "ACTIVE":
                oneof rid in RULE_IDS:
                    if rid in rule_status:
                        if rule_status[rid] == "ENABLED":
                            if rule_bus[rid] == bid:
                                tid = rule_topic[rid]
                                if tid in topic_status:
                                    if topic_status[tid] == "ACTIVE":
                                        oneof mid in MSG_IDS:
                                            if mid not in msg_status or msg_status[mid] == "DELETED":
                                                msg_status[mid] = "AVAILABLE"
                                                msg_topic[mid] = tid


# step: a subscriber consumes a message from the "sns" "topic"
# result: the "sns" "message" will be "DELETED"
# guard: an "AVAILABLE" "sns" "message" existed on the "sns" "topic"
# guard_violation_lifecycle: no "AVAILABLE" "sns" "message" existed on the "sns" "topic"
atomic action ConsumeMessage:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "AVAILABLE":
                msg_status[mid] = "DELETED"


# check: every "ENABLED" "eventbridge" "rule" references an "ACTIVE" "eventbridge" "bus"
always assertion RuleReferencesActiveBus:
    for rid in rule_status:
        if rule_status[rid] == "ENABLED":
            bid = rule_bus[rid]
            if bid in bus_status:
                if bus_status[bid] != "ACTIVE":
                    return False
    return True


# check: every "AVAILABLE" "sns" "message" belongs to an "ACTIVE" "sns" "topic"
always assertion MessageRequiresActiveTopic:
    for mid in msg_status:
        if msg_status[mid] == "AVAILABLE":
            tid = msg_topic[mid]
            if tid in topic_status:
                if topic_status[tid] != "ACTIVE":
                    return False
    return True
