---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> SNS Integration Formal Specification
# Models a Step Functions state machine that publishes a message to an SNS topic as a task step.
# The task succeeds when the message is published; the execution then completes.

SM_IDS = ["sm-1"]
TOPIC_IDS = ["topic-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    sm_topic = {}               # sm_topic[smid] = topic_id or "" (SNS task target)
    topic_status = {}           # topic_status[tid] = "ACTIVE"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_published = {}         # exec_published[eid] = True if message was published


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE" with no SNS task configured
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"
            sm_topic[smid] = ""


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: an "sns" publish task is configured on the "step functions" "state machine"
# result: the state machine will publish a "sns" "message" to the "sns" "topic" when it reaches the task state
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the "step functions" "state machine" has no "sns" task configured
# guard_violation: the "step functions" "state machine" already has an "sns" task configured
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
atomic action ConfigureSNSTask:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_topic[smid] == "":
                    oneof tid in TOPIC_IDS:
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                sm_topic[smid] = tid


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the "step functions" "state machine" has an "sns" task configured
# guard_violation: the "step functions" "state machine" has no "sns" task configured
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_topic[smid] != "":
                    oneof eid in EXEC_IDS:
                        if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                            exec_status[eid] = "RUNNING"
                            exec_sm[eid] = smid
                            exec_published[eid] = False


# step: a running "step functions" "execution" publishes a message to the "sns" "topic" and succeeds
# result: the "step functions" "execution" will be "SUCCEEDED" and the message has been published to the topic
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the target "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the target "sns" "topic" was not "ACTIVE"
atomic action PublishTask:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_topic:
                    tid = sm_topic[smid]
                    if tid != "":
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                exec_published[eid] = True
                                exec_status[eid] = "SUCCEEDED"


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "RUNNING" "step functions" "execution"'s state machine targets an "ACTIVE" "sns" "topic"
always assertion ExecutionRequiresActiveTopic:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_topic:
                tid = sm_topic[smid]
                if tid != "":
                    if tid in topic_status:
                        if topic_status[tid] != "ACTIVE":
                            return False
    return True
