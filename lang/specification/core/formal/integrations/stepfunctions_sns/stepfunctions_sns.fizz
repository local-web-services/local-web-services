---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> SNS Integration Formal Specification
# Models a Step Functions state machine that publishes a message to an SNS topic as a task step.
# The task succeeds when the message is published; the execution then completes.

SM_IDS = ["sm-1"]
TOPIC_IDS = ["topic-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    sm_topic = {}               # sm_topic[smid] = topic_id or "" (SNS task target)
    topic_status = {}           # topic_status[tid] = "ACTIVE"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_published = {}         # exec_published[eid] = True if message was published


# step: a Step Functions state machine is created
# result: the state machine is ACTIVE with no SNS task configured
# guard: the state machine does not already exist
# guard_violation: the state machine already exists
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"
            sm_topic[smid] = ""


# step: an SNS topic is created
# result: the topic is ACTIVE
# guard: the topic does not already exist
# guard_violation: the topic already exists
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: an SNS publish task is configured on the state machine
# result: the state machine will publish a message to the topic when it reaches the task state
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: the state machine has no SNS task configured
# guard_violation: the state machine already has an SNS task configured
# guard: the topic exists
# guard_violation: the topic does not exist
# guard: the topic is ACTIVE
# guard_violation_lifecycle: the topic is not ACTIVE
atomic action ConfigureSNSTask:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_topic[smid] == "":
                    oneof tid in TOPIC_IDS:
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                sm_topic[smid] = tid


# step: an execution of the state machine is started
# result: the execution is RUNNING
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: the state machine has an SNS task configured
# guard_violation: the state machine has no SNS task configured
# guard: an execution slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_topic[smid] != "":
                    oneof eid in EXEC_IDS:
                        if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                            exec_status[eid] = "RUNNING"
                            exec_sm[eid] = smid
                            exec_published[eid] = False


# step: a running execution publishes a message to the SNS topic and succeeds
# result: the execution is SUCCEEDED and the message has been published to the topic
# guard: an execution is RUNNING
# guard_violation: no execution is RUNNING
# guard: the target topic is ACTIVE
# guard_violation_lifecycle: the target topic is not ACTIVE
atomic action PublishTask:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_topic:
                    tid = sm_topic[smid]
                    if tid != "":
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                exec_published[eid] = True
                                exec_status[eid] = "SUCCEEDED"


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every RUNNING execution's state machine targets an ACTIVE topic
always assertion ExecutionRequiresActiveTopic:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_topic:
                tid = sm_topic[smid]
                if tid != "":
                    if tid in topic_status:
                        if topic_status[tid] != "ACTIVE":
                            return False
    return True
