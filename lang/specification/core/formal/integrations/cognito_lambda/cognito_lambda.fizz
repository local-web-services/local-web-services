---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Cognito -> Lambda Integration Formal Specification
# Models a Cognito User Pool pre-signup trigger that synchronously invokes a Lambda function.
# The Lambda can allow the signup (user CONFIRMED) or deny it (user REJECTED).
# Without a trigger configured, signups are confirmed directly.

POOL_IDS = ["pool-1"]
FUNC_IDS = ["func-1"]
USER_IDS = ["user-1"]
INV_IDS = ["inv-1"]


action Init:
    pool_status = {}            # pool_status[pid] = "ACTIVE"
    pool_trigger = {}           # pool_trigger[pid] = func_id or "" (pre-signup trigger)
    func_status = {}            # func_status[fid] = "ACTIVE"
    user_status = {}            # user_status[uid] = "PENDING" | "CONFIRMED" | "REJECTED"
    user_pool = {}              # user_pool[uid] = pool_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_user = {}               # inv_user[iid] = user_id
    user_inv = {}               # user_inv[uid] = inv_id (invocation for this pending signup)


# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE" with no pre-signup trigger configured
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pid in POOL_IDS:
        if pid not in pool_status:
            pool_status[pid] = "ACTIVE"
            pool_trigger[pid] = ""


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a Lambda pre-signup trigger is configured on the "cognito" "user pool"
# result: all subsequent signups will synchronously invoke the "lambda" "function" before confirming
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user pool" has no trigger configured
# guard_violation: the "cognito" "user pool" already has a trigger configured
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
atomic action ConfigureTrigger:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_trigger[pid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                pool_trigger[pid] = fid


# step: a "cognito" "user" signs up to a "cognito" "user pool" that has no pre-signup trigger configured
# result: the "cognito" "user" will be immediately "CONFIRMED"
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user pool" has no pre-signup trigger configured
# guard_violation: the "cognito" "user pool" has a pre-signup trigger configured
# guard: the "cognito" "user" slot is available
# guard_violation_capacity: no "cognito" "user" "slot" was "available"
atomic action SignupWithoutTrigger:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_trigger[pid] == "":
                    oneof uid in USER_IDS:
                        if uid not in user_status:
                            user_status[uid] = "CONFIRMED"
                            user_pool[uid] = pid


# step: a "cognito" "user" initiates signup to a "cognito" "user pool" that has a pre-signup trigger configured
# result: the "cognito" "user" will be "PENDING" and the trigger Lambda will be invoked synchronously
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user pool" has a pre-signup trigger configured
# guard_violation: the "cognito" "user pool" has no pre-signup trigger configured
# guard: the trigger "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the trigger "lambda" "function" was not "ACTIVE"
# guard: the "cognito" "user" slot is available
# guard_violation_capacity: no "cognito" "user" "slot" was "available"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InitiateSignupWithTrigger:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_trigger[pid] != "":
                    fid = pool_trigger[pid]
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof uid in USER_IDS:
                                if uid not in user_status:
                                    oneof iid in INV_IDS:
                                        if iid not in inv_status:
                                            user_status[uid] = "PENDING"
                                            user_pool[uid] = pid
                                            inv_status[iid] = "IN_PROGRESS"
                                            inv_user[iid] = uid
                                            user_inv[uid] = iid


# fake_skip: internal
# step: the pre-signup "lambda" "function" allows the signup
# result: the invocation will be "SUCCESS" and the "cognito" "user" will be "CONFIRMED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action TriggerAllows:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                uid = inv_user[iid]
                inv_status[iid] = "SUCCESS"
                user_status[uid] = "CONFIRMED"


# fake_skip: internal
# step: the pre-signup "lambda" "function" denies the signup
# result: the invocation will be "FAILED" and the "cognito" "user" will be rejected
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action TriggerDenies:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                uid = inv_user[iid]
                inv_status[iid] = "FAILED"
                user_status[uid] = "REJECTED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            uid = inv_user[iid]
            if uid in user_pool:
                pid = user_pool[uid]
                if pid in pool_trigger:
                    fid = pool_trigger[pid]
                    if fid in func_status:
                        if func_status[fid] != "ACTIVE":
                            return False
    return True


# check: every "IN_PROGRESS" "lambda" "invocation" is for a "PENDING" "cognito" "user"
always assertion InvocationLinkedToPendingUser:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            uid = inv_user[iid]
            if uid in user_status:
                if user_status[uid] != "PENDING":
                    return False
    return True


# check: every "PENDING" "cognito" "user" has a corresponding "IN_PROGRESS" "lambda" "invocation"
always assertion PendingSignupHasInProgressInvocation:
    for uid in user_status:
        if user_status[uid] == "PENDING":
            iid = user_inv[uid]
            if iid in inv_status:
                if inv_status[iid] != "IN_PROGRESS":
                    return False
    return True
