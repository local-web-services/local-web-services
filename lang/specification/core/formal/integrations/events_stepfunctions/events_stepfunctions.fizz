---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# EventBridge -> Step Functions Integration Formal Specification
# Models an EventBridge rule starting a Step Functions execution when a matching event is published.

BUS_IDS = ["bus-1"]
RULE_IDS = ["rule-1"]
SM_IDS = ["sm-1"]
EXEC_IDS = ["exec-1"]


action Init:
    # EventBridge
    bus_status = {}             # bus_status[bid] = "ACTIVE"
    rule_status = {}            # rule_status[rid] = "ENABLED" | "DISABLED"
    rule_bus = {}               # rule_bus[rid] = bus_id
    rule_sm = {}                # rule_sm[rid] = sm_id

    # Step Functions state machine
    sm_status = {}              # sm_status[smid] = "ACTIVE"

    # Executions started by EventBridge
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_rule = {}              # exec_rule[eid] = rule_id


# step: an EventBridge event bus is created
# result: the event bus is ACTIVE
# guard: the event bus does not already exist
# guard_violation: the event bus already exists
atomic action CreateEventBus:
    oneof bid in BUS_IDS:
        if bid not in bus_status:
            bus_status[bid] = "ACTIVE"


# step: a Step Functions state machine is created
# result: the state machine is ACTIVE
# guard: the state machine does not already exist
# guard_violation: the state machine already exists
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an EventBridge rule is created to start a Step Functions execution on matching events
# result: the rule is ENABLED and will trigger an execution when matching events are published
# guard: the event bus exists
# guard_violation: the event bus does not exist
# guard: the event bus is ACTIVE
# guard_violation_lifecycle: the event bus is not ACTIVE
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: the rule does not already exist
# guard_violation: the rule already exists
atomic action PutRule:
    oneof rid in RULE_IDS:
        if rid not in rule_status:
            oneof bid in BUS_IDS:
                if bid in bus_status:
                    if bus_status[bid] == "ACTIVE":
                        oneof smid in SM_IDS:
                            if smid in sm_status:
                                if sm_status[smid] == "ACTIVE":
                                    rule_status[rid] = "ENABLED"
                                    rule_bus[rid] = bid
                                    rule_sm[rid] = smid


# step: an event is published to the bus and triggers a new Step Functions execution
# result: the execution is RUNNING
# guard: the event bus exists
# guard_violation: the event bus does not exist
# guard: the event bus is ACTIVE
# guard_violation_lifecycle: the event bus is not ACTIVE
# guard: an ENABLED rule exists on the bus targeting a state machine
# guard_violation_lifecycle: no ENABLED rule exists on the bus targeting a state machine
# guard: the target state machine is ACTIVE
# guard_violation_lifecycle: the target state machine is not ACTIVE
# guard: an execution slot is available
# guard_violation_capacity: no execution slot is available
atomic action PutEvent:
    oneof bid in BUS_IDS:
        if bid in bus_status:
            if bus_status[bid] == "ACTIVE":
                oneof rid in RULE_IDS:
                    if rid in rule_status:
                        if rule_status[rid] == "ENABLED":
                            if rule_bus[rid] == bid:
                                smid = rule_sm[rid]
                                if smid in sm_status:
                                    if sm_status[smid] == "ACTIVE":
                                        oneof eid in EXEC_IDS:
                                            if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                                exec_status[eid] = "RUNNING"
                                                exec_sm[eid] = smid
                                                exec_rule[eid] = rid


# fake_skip: internal
# step: a running execution completes successfully
# result: the execution is SUCCEEDED
# guard: an execution is RUNNING
# guard_violation_lifecycle: no execution is RUNNING
atomic action ExecutionSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                exec_status[eid] = "SUCCEEDED"


# fake_skip: internal
# step: a running execution fails
# result: the execution is FAILED
# guard: an execution is RUNNING
# guard_violation_lifecycle: no execution is RUNNING
atomic action ExecutionFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                exec_status[eid] = "FAILED"


# check: every ENABLED rule references an ACTIVE event bus
always assertion RuleReferencesActiveBus:
    for rid in rule_status:
        if rule_status[rid] == "ENABLED":
            bid = rule_bus[rid]
            if bid in bus_status:
                if bus_status[bid] != "ACTIVE":
                    return False
    return True


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every RUNNING execution was started by an ENABLED rule
always assertion ExecutionRequiresEnabledRule:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            rid = exec_rule[eid]
            if rid in rule_status:
                if rule_status[rid] != "ENABLED":
                    return False
    return True
