---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# EventBridge -> Step Functions Integration Formal Specification
# Models an EventBridge rule starting a Step Functions execution when a matching event is published.

BUS_IDS = ["bus-1"]
RULE_IDS = ["rule-1"]
SM_IDS = ["sm-1"]
EXEC_IDS = ["exec-1"]


action Init:
    # EventBridge
    bus_status = {}             # bus_status[bid] = "ACTIVE"
    rule_status = {}            # rule_status[rid] = "ENABLED" | "DISABLED"
    rule_bus = {}               # rule_bus[rid] = bus_id
    rule_sm = {}                # rule_sm[rid] = sm_id

    # Step Functions state machine
    sm_status = {}              # sm_status[smid] = "ACTIVE"

    # Executions started by EventBridge
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_rule = {}              # exec_rule[eid] = rule_id


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof bid in BUS_IDS:
        if bid not in bus_status:
            bus_status[bid] = "ACTIVE"


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an "eventbridge" "rule" is created to start a Step Functions execution on matching events
# result: the "eventbridge" "rule" will be "ENABLED" and will trigger an "step functions" "execution" when matching events are published
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the "eventbridge" "rule" did not already exist
# guard_violation: the "eventbridge" "rule" already existed
atomic action PutRule:
    oneof rid in RULE_IDS:
        if rid not in rule_status:
            oneof bid in BUS_IDS:
                if bid in bus_status:
                    if bus_status[bid] == "ACTIVE":
                        oneof smid in SM_IDS:
                            if smid in sm_status:
                                if sm_status[smid] == "ACTIVE":
                                    rule_status[rid] = "ENABLED"
                                    rule_bus[rid] = bid
                                    rule_sm[rid] = smid


# step: an "eventbridge" "event" is published to the "eventbridge" "bus" and triggers a new "step functions" "execution"
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: an "ENABLED" "eventbridge" "rule" existed on the "eventbridge" "bus" targeting a "step functions" "state machine"
# guard_violation_lifecycle: no ENABLED rule existed on the bus targeting a state machine
# guard: the target "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the target "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action PutEvent:
    oneof bid in BUS_IDS:
        if bid in bus_status:
            if bus_status[bid] == "ACTIVE":
                oneof rid in RULE_IDS:
                    if rid in rule_status:
                        if rule_status[rid] == "ENABLED":
                            if rule_bus[rid] == bid:
                                smid = rule_sm[rid]
                                if smid in sm_status:
                                    if sm_status[smid] == "ACTIVE":
                                        oneof eid in EXEC_IDS:
                                            if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                                exec_status[eid] = "RUNNING"
                                                exec_sm[eid] = smid
                                                exec_rule[eid] = rid


# fake_skip: internal
# step: a running "step functions" "execution" completes successfully
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
atomic action ExecutionSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                exec_status[eid] = "SUCCEEDED"


# fake_skip: internal
# step: a running "step functions" "execution" fails
# result: the "step functions" "execution" will be "FAILED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
atomic action ExecutionFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                exec_status[eid] = "FAILED"


# check: every "ENABLED" "eventbridge" "rule" references an "ACTIVE" "eventbridge" "bus"
always assertion RuleReferencesActiveBus:
    for rid in rule_status:
        if rule_status[rid] == "ENABLED":
            bid = rule_bus[rid]
            if bid in bus_status:
                if bus_status[bid] != "ACTIVE":
                    return False
    return True


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "RUNNING" "step functions" "execution" was started by an "ENABLED" "eventbridge" "rule"
always assertion ExecutionRequiresEnabledRule:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            rid = exec_rule[eid]
            if rid in rule_status:
                if rule_status[rid] != "ENABLED":
                    return False
    return True
