---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# DocumentDB -> EventBridge Integration Formal Specification
# Models DocumentDB cluster and instance events being published to an EventBridge event bus.
# When a DocumentDB cluster changes state (e.g., created, modified, deleted),
# DocumentDB automatically sends an event to EventBridge.
# If the bus has been deleted, event delivery fails silently.

CLUSTER_IDS = ["cluster-1"]
BUS_IDS = ["bus-1"]
EVENT_IDS = ["event-1", "event-2"]


action Init:
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "MODIFYING" | "STOPPING" | "STOPPED"
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    event_status = {}           # event_status[eid] = "DELIVERED"
    event_cluster = {}          # event_cluster[eid] = cluster_id
    event_type = {}             # event_type[eid] = "MODIFIED" | "STOPPED"
    event_bus = {}              # event_bus[eid] = bus_id


# step: a "documentdb" "cluster" is created and becomes AVAILABLE
# result: the "documentdb" "cluster" will be "AVAILABLE"
# guard: the "documentdb" "cluster" did not already exist
# guard_violation: the "documentdb" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: an EventBridge event bus is created
# result: the bus will be "ACTIVE"
# guard: the bus did not already exist
# guard_violation: the bus already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the EventBridge event bus is deleted
# result: the bus will be deleted and DocumentDB event delivery will fail
# guard: the bus existed
# guard_violation: the bus did not exist
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# fake_skip: internal
# step: a "documentdb" "cluster" modification begins and DocumentDB delivers the event to the EventBridge bus
# result: the "documentdb" "cluster" will be "MODIFYING" and the MODIFIED event will be "DELIVERED"
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus was "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action ClusterModifyEventDelivered:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    cluster_status[cid] = "MODIFYING"
                                    event_status[eid] = "DELIVERED"
                                    event_cluster[eid] = cid
                                    event_type[eid] = "MODIFIED"
                                    event_bus[eid] = busid


# fake_skip: internal
# step: a "documentdb" "cluster" modification begins but event delivery fails because the bus is deleted
# result: the "documentdb" "cluster" will be "MODIFYING" but no event will be delivered
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the bus was "DELETED"
# guard_violation_lifecycle: the bus was not "DELETED"
atomic action ClusterModifyEventFails:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            cluster_status[cid] = "MODIFYING"


# fake_skip: internal
# step: the "documentdb" "cluster" modification completes
# result: the "documentdb" "cluster" will be "AVAILABLE" again
# guard: the "documentdb" "cluster" was "MODIFYING"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "MODIFYING"
atomic action ClusterModifyComplete:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"


# check: every DELIVERED event references a "documentdb" "cluster" that exists
always assertion DeliveredEventReferencesExistingCluster:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            cid = event_cluster[eid]
            if cid not in cluster_status:
                return False
    return True


# check: every DELIVERED event references a bus that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
