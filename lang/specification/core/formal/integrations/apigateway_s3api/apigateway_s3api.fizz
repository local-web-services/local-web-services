---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> S3 Integration Formal Specification
# Models an API Gateway REST API with a direct S3 proxy integration (no Lambda proxy).
# Requests to the API are forwarded directly to S3 to GET or PUT objects.
# If the bucket has been deleted, requests fail with a service error.

API_IDS = ["api-1"]
BUCKET_IDS = ["bucket-1"]
REQ_IDS = ["req-1"]
OBJ_IDS = ["obj-1"]


action Init:
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_bucket = {}             # api_bucket[aid] = bucket_id or "" (S3 integration target)
    bucket_status = {}          # bucket_status[bid] = "ACTIVE" | "DELETED"
    req_status = {}             # req_status[rid] = "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id
    obj_status = {}             # obj_status[oid] = "EXISTS" | "DELETED"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    obj_req = {}                # obj_req[oid] = req_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no S3 integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestAPI:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_bucket[aid] = ""


# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE"
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"


# step: the "s3" "bucket" is deleted
# result: the "s3" "bucket" will be deleted and API requests targeting it will fail
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" is already "DELETED"
atomic action DeleteBucket:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                bucket_status[bid] = "DELETED"


# step: a direct S3 integration is configured on the "api gateway" "API"
# result: the "api gateway" "API" will proxy requests to the "s3" "bucket"
# guard: the "api gateway" "API" existed and was "ACTIVE"
# guard_violation: the "api gateway" "API" did not exist or was "ACTIVE"
# guard: the "api gateway" "api" has no S3 integration configured
# guard_violation: the "api gateway" "API" already has a S3 integration configured
# guard: the "s3" "bucket" existed and was "ACTIVE"
# guard_violation: the "s3" "bucket" did not exist or was "ACTIVE"
atomic action ConfigureS3Integration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_bucket[aid] == "":
                    oneof bid in BUCKET_IDS:
                        if bid in bucket_status:
                            if bucket_status[bid] == "ACTIVE":
                                api_bucket[aid] = bid


# step: a PUT request is received and the "api gateway" "API" writes an "s3" "object" to the "s3" "bucket"
# result: the "s3" "object" will exist and the request will be "SUCCESS"
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a S3 integration configured
# guard_violation: the "api gateway" "api" has no S3 integration configured
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
# guard: an "s3" "object" slot is available
# guard_violation_capacity: no object slot is available
atomic action PutObjectRequestSucceeds:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_bucket[aid] != "":
                    bid = api_bucket[aid]
                    if bid in bucket_status:
                        if bucket_status[bid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    oneof oid in OBJ_IDS:
                                        if oid not in obj_status or obj_status[oid] == "DELETED":
                                            req_status[rid] = "SUCCESS"
                                            req_api[rid] = aid
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            obj_req[oid] = rid


# step: a GET request is received and the "api gateway" "API" retrieves an existing object from S3
# result: the request will be "SUCCESS"
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a S3 integration configured
# guard_violation: the "api gateway" "api" has no S3 integration configured
# guard: an "s3" "object" existed in the target bucket
# guard_violation_lifecycle: no "s3" "object" existed in the target "s3" "bucket"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
atomic action GetObjectRequestSucceeds:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_bucket[aid] != "":
                    bid = api_bucket[aid]
                    found = False
                    for oid in obj_status:
                        if obj_status[oid] == "EXISTS":
                            if obj_bucket[oid] == bid:
                                found = True
                    if found == True:
                        oneof rid in REQ_IDS:
                            if rid not in req_status:
                                req_status[rid] = "SUCCESS"
                                req_api[rid] = aid


# step: a request fails because the "s3" "bucket" has been deleted
# result: the request will be "FAILED" with a NoSuchBucket error
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a S3 integration configured
# guard_violation: the "api gateway" "api" has no S3 integration configured
# guard: the "s3" "bucket" was "DELETED"
# guard_violation_lifecycle: the "s3" "bucket" was not "DELETED"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
atomic action RequestFails:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_bucket[aid] != "":
                    bid = api_bucket[aid]
                    if bid in bucket_status:
                        if bucket_status[bid] == "DELETED":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    req_status[rid] = "FAILED"
                                    req_api[rid] = aid


# check: every existing object references a "s3" "bucket" that exists
always assertion ObjectReferencesExistingBucket:
    for oid in obj_status:
        if obj_status[oid] == "EXISTS":
            bid = obj_bucket[oid]
            if bid not in bucket_status:
                return False
    return True


# check: every successful request references an "api gateway" "API" that exists
always assertion SuccessfulRequestReferencesExistingAPI:
    for rid in req_status:
        if req_status[rid] == "SUCCESS":
            aid = req_api[rid]
            if aid not in api_status:
                return False
    return True
