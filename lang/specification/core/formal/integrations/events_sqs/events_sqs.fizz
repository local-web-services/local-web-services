---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 30
---
# EventBridge -> SQS Integration Formal Specification
# Models an EventBridge rule routing events from a bus to an SQS queue.

BUS_IDS = ["bus-1"]
RULE_IDS = ["rule-1"]
QUEUE_IDS = ["queue-1"]
MSG_IDS = ["msg-1", "msg-2"]


action Init:
    # EventBridge
    bus_status = {}             # bus_status[bid] = "ACTIVE"
    rule_status = {}            # rule_status[rid] = "ENABLED" | "DISABLED"
    rule_bus = {}               # rule_bus[rid] = bus_id
    rule_queue = {}             # rule_queue[rid] = queue_id

    # SQS
    queue_status = {}           # queue_status[qid] = "ACTIVE"

    # SQS messages delivered by EventBridge
    msg_status = {}             # msg_status[mid] = "AVAILABLE" | "DELETED"
    msg_queue = {}              # msg_queue[mid] = queue_id


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof bid in BUS_IDS:
        if bid not in bus_status:
            bus_status[bid] = "ACTIVE"


# step: a "sqs" "queue" is created
# result: the "sqs" "queue" will be "ACTIVE"
# guard: the "sqs" "queue" did not already exist
# guard_violation: the "sqs" "queue" already existed
atomic action CreateQueue:
    oneof qid in QUEUE_IDS:
        if qid not in queue_status:
            queue_status[qid] = "ACTIVE"


# step: an "eventbridge" "rule" is created to route matching events to the "sqs" "queue"
# result: the "eventbridge" "rule" will be "ENABLED" and will forward matching events to the "sqs" "queue"
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
# guard: the "eventbridge" "rule" did not already exist
# guard_violation: the "eventbridge" "rule" already existed
atomic action PutRule:
    oneof rid in RULE_IDS:
        if rid not in rule_status:
            oneof bid in BUS_IDS:
                if bid in bus_status:
                    if bus_status[bid] == "ACTIVE":
                        oneof qid in QUEUE_IDS:
                            if qid in queue_status:
                                if queue_status[qid] == "ACTIVE":
                                    rule_status[rid] = "ENABLED"
                                    rule_bus[rid] = bid
                                    rule_queue[rid] = qid


# step: an "eventbridge" "event" is published to the "eventbridge" "bus" and routed to the target "sqs" "queue"
# result: the "sqs" "message" will be "AVAILABLE" in the target "sqs" "queue"
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "ACTIVE"
# guard: an "ENABLED" "eventbridge" "rule" existed on the "eventbridge" "bus" targeting a "sqs" "queue"
# guard_violation_lifecycle: no "ENABLED" "eventbridge" "rule" existed on the "eventbridge" "bus" targeting a "sqs" "queue"
# guard: the target "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the target "sqs" "queue" was not "ACTIVE"
# guard: a "sqs" "message" "slot" was "available"
# guard_violation_capacity: no "sqs" "message" "slot" was "available"
atomic action PutEvent:
    oneof bid in BUS_IDS:
        if bid in bus_status:
            if bus_status[bid] == "ACTIVE":
                oneof rid in RULE_IDS:
                    if rid in rule_status:
                        if rule_status[rid] == "ENABLED":
                            if rule_bus[rid] == bid:
                                qid = rule_queue[rid]
                                if qid in queue_status:
                                    if queue_status[qid] == "ACTIVE":
                                        oneof mid in MSG_IDS:
                                            if mid not in msg_status or msg_status[mid] == "DELETED":
                                                msg_status[mid] = "AVAILABLE"
                                                msg_queue[mid] = qid


# step: a message is consumed from the "sqs" "queue"
# result: the "sqs" "message" will be "DELETED"
# guard: an "AVAILABLE" "sqs" "message" existed in the "sqs" "queue"
# guard_violation_lifecycle: no "AVAILABLE" "sqs" "message" existed in the "sqs" "queue"
atomic action ConsumeMessage:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "AVAILABLE":
                msg_status[mid] = "DELETED"


# check: every "ENABLED" "eventbridge" "rule" references an "ACTIVE" "eventbridge" "bus"
always assertion RuleReferencesActiveBus:
    for rid in rule_status:
        if rule_status[rid] == "ENABLED":
            bid = rule_bus[rid]
            if bid in bus_status:
                if bus_status[bid] != "ACTIVE":
                    return False
    return True


# check: every "AVAILABLE" "sqs" "message" belongs to an "ACTIVE" "sqs" "queue"
always assertion MessagesReferenceActiveQueues:
    for mid in msg_status:
        if msg_status[mid] == "AVAILABLE":
            qid = msg_queue[mid]
            if qid in queue_status:
                if queue_status[qid] != "ACTIVE":
                    return False
    return True
