---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Glacier -> SNS Integration Formal Specification
# Models Glacier sending job completion notifications to an SNS topic.
# When an archive retrieval or inventory job completes, Glacier publishes
# a notification to the configured SNS topic.
# If the topic has been deleted, notification delivery fails silently.

VAULT_IDS = ["vault-1"]
TOPIC_IDS = ["topic-1"]
JOB_IDS = ["job-1"]
MSG_IDS = ["msg-1"]


action Init:
    vault_status = {}           # vault_status[vid] = "EXISTS"
    vault_topic = {}            # vault_topic[vid] = topic_id or "" (SNS notification config)
    topic_status = {}           # topic_status[tid] = "ACTIVE" | "DELETED"
    job_status = {}             # job_status[jid] = "IN_PROGRESS" | "SUCCEEDED" | "FAILED"
    job_vault = {}              # job_vault[jid] = vault_id
    msg_status = {}             # msg_status[mid] = "PUBLISHED"
    msg_topic = {}              # msg_topic[mid] = topic_id
    msg_job = {}                # msg_job[mid] = job_id


# step: a Glacier vault is created
# result: the vault EXISTS with no SNS notification configuration
# guard: the vault does not already exist
# guard_violation: the vault already exists
atomic action CreateVault:
    oneof vid in VAULT_IDS:
        if vid not in vault_status:
            vault_status[vid] = "EXISTS"
            vault_topic[vid] = ""


# step: an SNS topic is created
# result: the topic is ACTIVE
# guard: the topic does not already exist
# guard_violation: the topic already exists
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: the SNS topic is deleted
# result: the topic is DELETED and Glacier notifications will fail
# guard: the topic exists
# guard_violation: the topic does not exist
# guard: the topic is ACTIVE
# guard_violation_lifecycle: the topic is already DELETED
atomic action DeleteTopic:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                topic_status[tid] = "DELETED"


# step: an SNS notification is configured on the vault
# result: the vault will publish job completion notifications to the topic
# guard: the vault exists
# guard_violation: the vault does not exist
# guard: the vault has no SNS notification configured
# guard_violation: the vault already has an SNS notification configured
# guard: the topic exists and is ACTIVE
# guard_violation: the topic does not exist or is not ACTIVE
atomic action ConfigureNotification:
    oneof vid in VAULT_IDS:
        if vid in vault_status:
            if vault_topic[vid] == "":
                oneof tid in TOPIC_IDS:
                    if tid in topic_status:
                        if topic_status[tid] == "ACTIVE":
                            vault_topic[vid] = tid


# step: a Glacier archive retrieval job is initiated on the vault
# result: the job is IN_PROGRESS
# guard: the vault exists
# guard_violation: the vault does not exist
# guard: a job slot is available
# guard_violation_capacity: no job slot is available
atomic action InitiateJob:
    oneof vid in VAULT_IDS:
        if vid in vault_status:
            oneof jid in JOB_IDS:
                if jid not in job_status:
                    job_status[jid] = "IN_PROGRESS"
                    job_vault[jid] = vid


# fake_skip: internal
# step: the Glacier job completes and publishes a notification to the configured SNS topic
# result: the job is SUCCEEDED and the notification is PUBLISHED
# guard: a job is IN_PROGRESS
# guard_violation_lifecycle: no job is IN_PROGRESS
# guard: the vault has an SNS notification configured
# guard_violation: the vault has no SNS notification configured
# guard: the configured topic is ACTIVE
# guard_violation_lifecycle: the configured topic is DELETED
# guard: a message slot is available
# guard_violation_capacity: no message slot is available
atomic action JobCompletedNotificationDelivered:
    oneof jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "IN_PROGRESS":
                vid = job_vault[jid]
                if vid in vault_topic:
                    if vault_topic[vid] != "":
                        tid = vault_topic[vid]
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                oneof mid in MSG_IDS:
                                    if mid not in msg_status:
                                        job_status[jid] = "SUCCEEDED"
                                        msg_status[mid] = "PUBLISHED"
                                        msg_topic[mid] = tid
                                        msg_job[mid] = jid


# fake_skip: internal
# step: the Glacier job completes but notification delivery fails because the topic was deleted
# result: the job is SUCCEEDED but no notification is published
# guard: a job is IN_PROGRESS
# guard_violation_lifecycle: no job is IN_PROGRESS
# guard: the vault has an SNS notification configured
# guard_violation: the vault has no SNS notification configured
# guard: the configured topic is DELETED
# guard_violation_lifecycle: the configured topic is not DELETED
atomic action JobCompletedNotificationFails:
    oneof jid in JOB_IDS:
        if jid in job_status:
            if job_status[jid] == "IN_PROGRESS":
                vid = job_vault[jid]
                if vid in vault_topic:
                    if vault_topic[vid] != "":
                        tid = vault_topic[vid]
                        if tid in topic_status:
                            if topic_status[tid] == "DELETED":
                                job_status[jid] = "SUCCEEDED"


# check: every PUBLISHED notification references a job that exists
always assertion PublishedNotificationReferencesExistingJob:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            jid = msg_job[mid]
            if jid not in job_status:
                return False
    return True


# check: every PUBLISHED notification references a topic that exists
always assertion PublishedNotificationReferencesExistingTopic:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            tid = msg_topic[mid]
            if tid not in topic_status:
                return False
    return True
