---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> DynamoDB Integration Formal Specification
# Models a Lambda function writing an item to a DynamoDB table during invocation.
# The item persists in the table after the invocation completes.

FUNC_IDS = ["func-1"]
TABLE_IDS = ["table-1"]
INV_IDS = ["inv-1"]
ITEM_IDS = ["item-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    table_status = {}           # table_status[tid] = "ACTIVE"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    item_status = {}            # item_status[oid] = "EXISTS" | "DELETED"
    item_table = {}             # item_table[oid] = table_id
    item_inv = {}               # item_inv[oid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "dynamodb" "table" is created
# result: the "dynamodb" "table" will be "ACTIVE"
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# step: the "lambda" "function" writes an item to the "dynamodb" "table" during invocation
# result: the "dynamodb" "item" will exist in the "dynamodb" "table"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: a "dynamodb" "item" "slot" was "available"
# guard_violation_capacity: no "dynamodb" "item" "slot" was "available"
atomic action PutItem:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "ACTIVE":
                            oneof oid in ITEM_IDS:
                                if oid not in item_status or item_status[oid] == "DELETED":
                                    item_status[oid] = "EXISTS"
                                    item_table[oid] = tid
                                    item_inv[oid] = iid


# fake_skip: internal
# step: the "lambda" "function" invocation completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails
# result: the "lambda" "invocation" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every existing "dynamodb" "item" belongs to an "ACTIVE" "dynamodb" "table"
always assertion ItemRequiresActiveTable:
    for oid in item_status:
        if item_status[oid] == "EXISTS":
            tid = item_table[oid]
            if tid in table_status:
                if table_status[tid] != "ACTIVE":
                    return False
    return True
