---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> Elasticsearch Integration Formal Specification
# Models a Lambda function indexing documents into and querying an Elasticsearch domain.
# When the domain is PROCESSING (config update in progress) write operations may fail.

FUNC_IDS = ["func-1"]
DOMAIN_IDS = ["domain-1"]
INV_IDS = ["inv-1"]
DOC_IDS = ["doc-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    domain_status = {}          # domain_status[did] = "AVAILABLE" | "PROCESSING"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    doc_status = {}             # doc_status[docid] = "EXISTS" | "DELETED"
    doc_domain = {}             # doc_domain[docid] = domain_id
    doc_inv = {}                # doc_inv[docid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: an "elasticsearch" "domain" is created and becomes AVAILABLE
# result: the "elasticsearch" "domain" will be "AVAILABLE"
# guard: the "elasticsearch" "domain" did not already exist
# guard_violation: the "elasticsearch" "domain" already existed
atomic action CreateDomain:
    oneof did in DOMAIN_IDS:
        if did not in domain_status:
            domain_status[did] = "AVAILABLE"


# step: a "elasticsearch" "domain" configuration update begins
# result: the "elasticsearch" "domain" will be "PROCESSING" and write operations may fail
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "AVAILABLE"
atomic action DomainProcessingBegins:
    oneof did in DOMAIN_IDS:
        if did in domain_status:
            if domain_status[did] == "AVAILABLE":
                domain_status[did] = "PROCESSING"


# fake_skip: internal
# step: the "elasticsearch" "domain" configuration update completes
# result: the "elasticsearch" "domain" will be "AVAILABLE" again
# guard: the "elasticsearch" "domain" was "PROCESSING"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "PROCESSING"
atomic action DomainProcessingComplete:
    oneof did in DOMAIN_IDS:
        if did in domain_status:
            if domain_status[did] == "PROCESSING":
                domain_status[did] = "AVAILABLE"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" indexes a "elasticsearch" "document" into the AVAILABLE domain and succeeds
# result: the "elasticsearch" "document" will exist and the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "elasticsearch" "domain" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "AVAILABLE"
# guard: a "elasticsearch" "document" "slot" was "available"
# guard_violation_capacity: no "elasticsearch" "document" "slot" was "available"
atomic action IndexDocumentTask:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof did in DOMAIN_IDS:
                    if did in domain_status:
                        if domain_status[did] == "AVAILABLE":
                            oneof docid in DOC_IDS:
                                if docid not in doc_status or doc_status[docid] == "DELETED":
                                    doc_status[docid] = "EXISTS"
                                    doc_domain[docid] = did
                                    doc_inv[docid] = iid
                                    inv_status[iid] = "SUCCESS"


# step: the "lambda" "function" fails to write because the "elasticsearch" "domain" is processing a config update
# result: the "lambda" "invocation" will be "FAILED" with a connection error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "elasticsearch" "domain" was "PROCESSING"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "PROCESSING"
atomic action InvocationFailsDomainProcessing:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof did in DOMAIN_IDS:
                    if did in domain_status:
                        if domain_status[did] == "PROCESSING":
                            inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every existing document references a "elasticsearch" "domain" that exists
always assertion DocumentRequiresExistingDomain:
    for docid in doc_status:
        if doc_status[docid] == "EXISTS":
            did = doc_domain[docid]
            if did not in domain_status:
                return False
    return True
