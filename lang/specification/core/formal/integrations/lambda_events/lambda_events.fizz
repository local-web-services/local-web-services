---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> EventBridge Integration Formal Specification
# Models a Lambda function publishing custom events to an EventBridge event bus.
# If the event bus has been deleted, the PutEvents call fails with a ResourceNotFoundException.

FUNC_IDS = ["func-1"]
BUS_IDS = ["bus-1"]
INV_IDS = ["inv-1"]
EVENT_IDS = ["event-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    event_status = {}           # event_status[eid] = "PUBLISHED"
    event_bus = {}              # event_bus[eid] = bus_id
    event_inv = {}              # event_inv[eid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the "eventbridge" "bus" is deleted
# result: the "eventbridge" "bus" will be deleted and Lambda PutEvents calls targeting it will fail
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" publishes an event to the ACTIVE event bus and succeeds
# result: the "eventbridge" "event" will be "PUBLISHED" and the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" did not exist or was "DELETED"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action PublishEventTask:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    event_status[eid] = "PUBLISHED"
                                    event_bus[eid] = busid
                                    event_inv[eid] = iid
                                    inv_status[iid] = "SUCCESS"


# step: the "lambda" "function" fails to publish because the event bus has been deleted
# result: the "lambda" "invocation" will be "FAILED" with a ResourceNotFoundException
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "eventbridge" "bus" was "DELETED"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "DELETED"
atomic action InvocationFailsBusDeleted:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "PUBLISHED" "eventbridge" "event" references a "eventbridge" "bus" that exists
always assertion PublishedEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "PUBLISHED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
