---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> S3 Tables Integration Formal Specification
# Models a Step Functions state machine calling S3 Tables APIs
# (e.g., writing or reading Iceberg table records) as a task step via the SDK integration.
# If the table is being deleted, the task fails with a ResourceNotFoundException.

SM_IDS = ["sm-1"]
TABLE_IDS = ["table-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    table_status = {}           # table_status[tid] = "ACTIVE" | "DELETING"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_table = {}             # exec_table[eid] = table_id (table called by this execution)


# step: a Step Functions state machine is created
# result: the state machine is ACTIVE
# guard: the state machine does not already exist
# guard_violation: the state machine already exists
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an S3 Tables table is created
# result: the table is ACTIVE
# guard: the table does not already exist
# guard_violation: the table already exists
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: a table deletion is initiated
# result: the table is DELETING and SDK task calls targeting it will fail
# guard: the table exists
# guard_violation: the table does not exist
# guard: the table is ACTIVE
# guard_violation_lifecycle: the table is already DELETING
atomic action DeleteTable:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                table_status[tid] = "DELETING"


# step: an execution of the state machine is started
# result: the execution is RUNNING
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: an execution slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running execution calls an ACTIVE S3 Tables table and the task succeeds
# result: the execution is SUCCEEDED
# guard: an execution is RUNNING
# guard_violation_lifecycle: no execution is RUNNING
# guard: the table is ACTIVE
# guard_violation_lifecycle: the table does not exist or is DELETING
atomic action S3TablesTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "ACTIVE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_table[eid] = tid


# fake_skip: internal
# step: a running execution fails because the S3 Tables table is being deleted
# result: the execution is FAILED with a ResourceNotFoundException
# guard: an execution is RUNNING
# guard_violation_lifecycle: no execution is RUNNING
# guard: the table is DELETING
# guard_violation_lifecycle: the table is not DELETING
atomic action S3TablesTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "DELETING":
                            exec_status[eid] = "FAILED"
                            exec_table[eid] = tid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which table it called
# (verifies an execution cannot succeed without calling a table; table may enter DELETING afterwards)
always assertion SuccessfulExecutionCalledATable:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_table:
                return False
    return True
