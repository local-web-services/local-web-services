---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> S3 Tables Integration Formal Specification
# Models a Step Functions state machine calling S3 Tables APIs
# (e.g., writing or reading Iceberg table records) as a task step via the SDK integration.
# If the table is being deleted, the task fails with a ResourceNotFoundException.

SM_IDS = ["sm-1"]
TABLE_IDS = ["table-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    table_status = {}           # table_status[tid] = "ACTIVE" | "DELETING"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_table = {}             # exec_table[eid] = table_id (table called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "s3 tables" "table" is created
# result: the "s3 tables" "table" will be "ACTIVE"
# guard: the "s3 tables" "table" did not already exist
# guard_violation: the "s3 tables" "table" already existed
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: a "s3 tables" "table" deletion is initiated
# result: the "s3 tables" "table" will be "DELETING" and SDK task calls targeting it will fail
# guard: the "s3 tables" "table" existed
# guard_violation: the "s3 tables" "table" did not exist
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" is already "DELETING"
atomic action DeleteTable:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                table_status[tid] = "DELETING"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" calls an ACTIVE S3 Tables table and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
# guard: the "s3 tables" "table" was "ACTIVE"
# guard_violation_lifecycle: the "s3 tables" "table" did not exist or was "DELETING"
atomic action S3TablesTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "ACTIVE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_table[eid] = tid


# fake_skip: internal
# step: a running "step functions" "execution" fails because the S3 Tables table is being deleted
# result: the "step functions" "execution" will be "FAILED" with a ResourceNotFoundException
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
# guard: the "s3 tables" "table" was "DELETING"
# guard_violation_lifecycle: the "s3 tables" "table" was not "DELETING"
atomic action S3TablesTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "DELETING":
                            exec_status[eid] = "FAILED"
                            exec_table[eid] = tid


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "SUCCEEDED" "step functions" "execution" recorded which "s3 tables" "table" it called
# (verifies an execution cannot succeed without calling a table; table may enter DELETING afterwards)
always assertion SuccessfulExecutionCalledATable:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_table:
                return False
    return True
