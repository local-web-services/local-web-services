---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# RDS -> Lambda Integration Formal Specification
# Models an RDS instance (PostgreSQL or MySQL) invoking a Lambda function
# from a stored procedure using the native aws_lambda.invoke() integration.
# The DB instance must have a Lambda function configured via an IAM role.
# If the Lambda function has been deleted, the stored procedure call fails.

DB_IDS = ["db-1"]
FUNC_IDS = ["func-1"]
INV_IDS = ["inv-1"]


action Init:
    db_status = {}              # db_status[dbid] = "AVAILABLE" | "FAILING_OVER"
    db_func = {}                # db_func[dbid] = func_id or "" (Lambda integration configured)
    func_status = {}            # func_status[fid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_db = {}                 # inv_db[iid] = db_id (DB that triggered this invocation)
    inv_func = {}               # inv_func[iid] = func_id


# step: a RDS DB instance is created
# result: the DB instance will be "AVAILABLE" with no Lambda integration configured
# guard: the DB instance did not already exist
# guard_violation: the DB instance already existed
atomic action CreateDBInstance:
    oneof dbid in DB_IDS:
        if dbid not in db_status:
            db_status[dbid] = "AVAILABLE"
            db_func[dbid] = ""


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: the "lambda" "function" is deleted
# result: the "lambda" "function" will be deleted and stored procedure invocations targeting it will fail
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the function is already "DELETED"
atomic action DeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_status[fid] = "DELETED"


# step: the DB instance is configured with an IAM role to invoke the "lambda" "function"
# result: stored procedures on the DB can invoke the "lambda" "function"
# guard: the DB instance existed and was "AVAILABLE"
# guard_violation_lifecycle: the DB instance did not exist or was "AVAILABLE"
# guard: the DB instance has no Lambda integration configured
# guard_violation: the DB instance already has a Lambda integration configured
# guard: the "lambda" "function" existed and was "ACTIVE"
# guard_violation: the "lambda" "function" did not exist or was "ACTIVE"
atomic action ConfigureLambdaIntegration:
    oneof dbid in DB_IDS:
        if dbid in db_status:
            if db_status[dbid] == "AVAILABLE":
                if db_func[dbid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                db_func[dbid] = fid


# step: a RDS stored procedure invokes the "lambda" "function" and succeeds
# result: the invocation will be "SUCCESS"
# guard: the DB instance was "AVAILABLE"
# guard_violation_lifecycle: the DB instance was not "AVAILABLE"
# guard: the DB instance has a Lambda integration configured
# guard_violation: the DB instance has no Lambda integration configured
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action StoredProcInvokesLambda:
    oneof dbid in DB_IDS:
        if dbid in db_status:
            if db_status[dbid] == "AVAILABLE":
                if db_func[dbid] != "":
                    fid = db_func[dbid]
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof iid in INV_IDS:
                                if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                    inv_status[iid] = "SUCCESS"
                                    inv_db[iid] = dbid
                                    inv_func[iid] = fid


# step: a RDS stored procedure fails to invoke Lambda because the function has been deleted
# result: the invocation will be "FAILED" with a function not found error
# guard: the DB instance was "AVAILABLE"
# guard_violation_lifecycle: the DB instance was not "AVAILABLE"
# guard: the DB instance has a Lambda integration configured
# guard_violation: the DB instance has no Lambda integration configured
# guard: the "lambda" "function" was "DELETED"
# guard_violation_lifecycle: the "lambda" "function" was not "DELETED"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvocationFailsFunctionDeleted:
    oneof dbid in DB_IDS:
        if dbid in db_status:
            if db_status[dbid] == "AVAILABLE":
                if db_func[dbid] != "":
                    fid = db_func[dbid]
                    if fid in func_status:
                        if func_status[fid] == "DELETED":
                            oneof iid in INV_IDS:
                                if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                    inv_status[iid] = "FAILED"
                                    inv_db[iid] = dbid
                                    inv_func[iid] = fid


# check: every successful invocation references a DB instance that exists
always assertion SuccessfulInvocationReferencesExistingDB:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            dbid = inv_db[iid]
            if dbid not in db_status:
                return False
    return True


# check: every successful invocation recorded which function it invoked
always assertion SuccessfulInvocationInvokedAFunction:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_func:
                return False
    return True
