---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Secrets Manager -> EventBridge Integration Formal Specification
# Models Secrets Manager publishing secret lifecycle events to an EventBridge event bus.
# When a secret is created, rotated, or deleted, Secrets Manager automatically sends
# an event to the default EventBridge bus (and any configured custom buses).
# If the bus has been deleted, event delivery fails silently.

SECRET_IDS = ["secret-1"]
BUS_IDS = ["bus-1"]
EVENT_IDS = ["event-1", "event-2"]


action Init:
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "ROTATING" | "PENDING_DELETION"
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    event_status = {}           # event_status[eid] = "DELIVERED" | "UNDELIVERED"
    event_secret = {}           # event_secret[eid] = secret_id
    event_type = {}             # event_type[eid] = "CREATED" | "ROTATED" | "DELETED"
    event_bus = {}              # event_bus[eid] = bus_id


# fake_skip: internal
# step: a "secretsmanager" "secret" is created and Secrets Manager delivers a CREATED event to the EventBridge bus
# result: the "secrets manager" "secret" will be "ACTIVE" and the CREATED event will be "DELIVERED"
# guard: the "secretsmanager" "secret" did not already exist
# guard_violation: the "secretsmanager" "secret" already existed
# guard: the bus existed and was "ACTIVE"
# guard_violation_lifecycle: the bus did not exist or was "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action CreateSecretEventDelivered:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "ACTIVE":
                        oneof eid in EVENT_IDS:
                            if eid not in event_status:
                                secret_status[sid] = "ACTIVE"
                                event_status[eid] = "DELIVERED"
                                event_secret[eid] = sid
                                event_type[eid] = "CREATED"
                                event_bus[eid] = busid


# fake_skip: internal
# step: a "secretsmanager" "secret" is created but the CREATED event delivery fails because the bus is deleted
# result: the "secrets manager" "secret" will be "ACTIVE" but no event will be delivered
# guard: the "secretsmanager" "secret" did not already exist
# guard_violation: the "secretsmanager" "secret" already existed
# guard: the bus was "DELETED"
# guard_violation_lifecycle: the bus was not "DELETED"
atomic action CreateSecretEventFails:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "DELETED":
                        secret_status[sid] = "ACTIVE"


# step: an EventBridge event bus is created
# result: the bus will be "ACTIVE"
# guard: the bus did not already exist
# guard_violation: the bus already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the EventBridge event bus is deleted
# result: the bus will be deleted and Secrets Manager event delivery will fail
# guard: the bus existed
# guard_violation: the bus did not exist
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# fake_skip: internal
# step: a "secretsmanager" "secret" rotation occurs and Secrets Manager delivers a ROTATED event to the bus
# result: the "secrets manager" "secret" will be "ACTIVE" with a new version and the ROTATED event will be "DELIVERED"
# guard: the secrets manager secret existed and was "ACTIVE"
# guard_violation_lifecycle: the secrets manager secret did not exist or was "ACTIVE"
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus was "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action RotateSecretEventDelivered:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    event_status[eid] = "DELIVERED"
                                    event_secret[eid] = sid
                                    event_type[eid] = "ROTATED"
                                    event_bus[eid] = busid


# fake_skip: internal
# step: a "secretsmanager" "secret" is scheduled for deletion and Secrets Manager delivers a DELETED event to the bus
# result: the "secrets manager" "secret" will be "PENDING_DELETION" and the "DELETED" event will be "DELIVERED"
# guard: the secrets manager secret existed and was "ACTIVE"
# guard_violation_lifecycle: the secrets manager secret did not exist or was "ACTIVE"
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus was "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action DeleteSecretEventDelivered:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    secret_status[sid] = "PENDING_DELETION"
                                    event_status[eid] = "DELIVERED"
                                    event_secret[eid] = sid
                                    event_type[eid] = "DELETED"
                                    event_bus[eid] = busid


# check: every DELIVERED event references a "secretsmanager" "secret" that exists
always assertion DeliveredEventReferencesExistingSecret:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            sid = event_secret[eid]
            if sid not in secret_status:
                return False
    return True


# check: every DELIVERED event references a bus that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
