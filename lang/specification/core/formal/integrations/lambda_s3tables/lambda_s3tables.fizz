---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> S3 Tables Integration Formal Specification
# Models a Lambda function reading and writing records to an S3 Tables table.
# If the table is being deleted, write operations fail with a ResourceNotFoundException.

FUNC_IDS = ["func-1"]
BUCKET_IDS = ["bucket-1"]
TABLE_IDS = ["table-1"]
INV_IDS = ["inv-1"]
RECORD_IDS = ["record-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    table_status = {}           # table_status[tid] = "ACTIVE" | "DELETING"
    table_bucket = {}           # table_bucket[tid] = bucket_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    record_status = {}          # record_status[rid] = "EXISTS" | "DELETED"
    record_table = {}           # record_table[rid] = table_id
    record_inv = {}             # record_inv[rid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a S3 table bucket is created
# result: the "s3" "bucket" will be "ACTIVE"
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateTableBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"


# step: a table is created in the table bucket
# result: the table will be "ACTIVE"
# guard: the table did not already exist
# guard_violation: the table already existed
# guard: the table bucket was "ACTIVE"
# guard_violation_lifecycle: the table bucket was not "ACTIVE"
atomic action CreateTable:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                oneof tid in TABLE_IDS:
                    if tid not in table_status:
                        table_status[tid] = "ACTIVE"
                        table_bucket[tid] = bid


# step: a table deletion is initiated
# result: the table will be "DELETING" and write operations will fail
# guard: the table existed
# guard_violation: the table did not exist
# guard: the table was "ACTIVE"
# guard_violation_lifecycle: the table is already "DELETING"
atomic action DeleteTable:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                table_status[tid] = "DELETING"


# step: the "lambda" "function" is invoked
# result: the invocation will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" writes a record to an ACTIVE table and succeeds
# result: the record will exist and the invocation will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: a table was "ACTIVE"
# guard_violation_lifecycle: no table was "ACTIVE"
# guard: a record slot is available
# guard_violation_capacity: no record slot is available
atomic action WriteRecord:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "ACTIVE":
                            oneof rid in RECORD_IDS:
                                if rid not in record_status or record_status[rid] == "DELETED":
                                    record_status[rid] = "EXISTS"
                                    record_table[rid] = tid
                                    record_inv[rid] = iid
                                    inv_status[iid] = "SUCCESS"


# step: the "lambda" "function" fails to write because the table is being deleted
# result: the invocation will be "FAILED" with a ResourceNotFoundException
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the table was "DELETING"
# guard_violation_lifecycle: the table was not "DELETING"
atomic action InvocationFailsTableDeleting:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof tid in TABLE_IDS:
                    if tid in table_status:
                        if table_status[tid] == "DELETING":
                            inv_status[iid] = "FAILED"


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every existing record references a table that exists
# (records are stored in the table bucket and persist structurally)
always assertion RecordReferencesExistingTable:
    for rid in record_status:
        if record_status[rid] == "EXISTS":
            tid = record_table[rid]
            if tid not in table_status:
                return False
    return True
