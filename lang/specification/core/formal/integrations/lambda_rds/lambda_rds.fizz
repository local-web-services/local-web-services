---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> RDS Integration Formal Specification
# Models a Lambda function executing SQL queries against an RDS instance.
# During a Multi-AZ failover the instance is temporarily unavailable; Lambda
# invocations that attempt queries during this window fail with a connection error.

FUNC_IDS = ["func-1"]
DB_IDS = ["db-1"]
INV_IDS = ["inv-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    db_status = {}              # db_status[did] = "AVAILABLE" | "FAILING_OVER"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_db = {}                 # inv_db[iid] = db_id (DB queried during invocation)


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "rds" "database instance" is created
# result: the "rds" "instance" will be "AVAILABLE"
# guard: the "rds" "instance" did not already exist
# guard_violation: the "rds" "instance" already existed
atomic action CreateDBInstance:
    oneof did in DB_IDS:
        if did not in db_status:
            db_status[did] = "AVAILABLE"


# step: a Multi-AZ failover begins on the "rds" "instance"
# result: the "rds" "instance" will be "FAILING_OVER" and temporarily unavailable for connections
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
atomic action DBFailoverBegins:
    oneof did in DB_IDS:
        if did in db_status:
            if db_status[did] == "AVAILABLE":
                db_status[did] = "FAILING_OVER"


# fake_skip: internal
# step: the Multi-AZ failover completes and the new primary is promoted
# result: the "rds" "instance" will be "AVAILABLE" again
# guard: the "rds" "instance" was "FAILING_OVER"
# guard_violation_lifecycle: the "rds" "instance" was not "FAILING_OVER"
atomic action DBFailoverComplete:
    oneof did in DB_IDS:
        if did in db_status:
            if db_status[did] == "FAILING_OVER":
                db_status[did] = "AVAILABLE"


# step: the "lambda" "function" is invoked
# result: the invocation will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" executes a SQL query against the AVAILABLE database and succeeds
# result: the invocation will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the database instance was "AVAILABLE"
# guard_violation_lifecycle: the database instance was not "AVAILABLE"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof did in DB_IDS:
                    if did in db_status:
                        if db_status[did] == "AVAILABLE":
                            inv_status[iid] = "SUCCESS"
                            inv_db[iid] = did


# step: the "lambda" "function" fails to connect because the database is failing over
# result: the invocation will be "FAILED" with a connection error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "rds" "database instance" was "FAILING_OVER"
# guard_violation_lifecycle: the "rds" "database instance" was not "FAILING_OVER"
atomic action InvocationFailsDBUnavailable:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof did in DB_IDS:
                    if did in db_status:
                        if db_status[did] == "FAILING_OVER":
                            inv_status[iid] = "FAILED"
                            inv_db[iid] = did


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every successful invocation recorded which database it queried
# (verifies Lambda cannot succeed without connecting to a database; DB may fail over afterwards)
always assertion SuccessfulInvocationQueriedADB:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_db:
                return False
    return True
