---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> Glacier Integration Formal Specification
# Models a Step Functions state machine calling Glacier APIs
# (e.g., UploadArchive, InitiateJob) as a task step via the SDK integration.
# If the vault has been deleted, the task fails with a ResourceNotFoundException.

SM_IDS = ["sm-1"]
VAULT_IDS = ["vault-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    vault_status = {}           # vault_status[vid] = "EXISTS" | "DELETED"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_vault = {}             # exec_vault[eid] = vault_id (vault called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "glacier" "vault" is created
# result: the "glacier" "vault" will exist
# guard: the "glacier" "vault" did not already exist
# guard_violation: the "glacier" "vault" already existed
atomic action CreateVault:
    oneof vid in VAULT_IDS:
        if vid not in vault_status:
            vault_status[vid] = "EXISTS"


# step: a "glacier" "vault" is deleted
# result: the "glacier" "vault" will be deleted and SDK task calls targeting it will fail
# guard: the "glacier" "vault" existed
# guard_violation: the "glacier" "vault" did not exist
# guard: the "glacier" "vault" existed (not already "DELETED")
# guard_violation_lifecycle: the "glacier" "vault" is already "DELETED"
atomic action DeleteVault:
    oneof vid in VAULT_IDS:
        if vid in vault_status:
            if vault_status[vid] == "EXISTS":
                vault_status[vid] = "DELETED"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" calls a "glacier" "vault" that EXISTS and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "glacier" "vault" existed
# guard_violation_lifecycle: the "glacier" "vault" did not exist or was "DELETED"
atomic action GlacierTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof vid in VAULT_IDS:
                    if vid in vault_status:
                        if vault_status[vid] == "EXISTS":
                            exec_status[eid] = "SUCCEEDED"
                            exec_vault[eid] = vid


# fake_skip: internal
# step: a running "step functions" "execution" fails because the Glacier vault has been deleted
# result: the "step functions" "execution" will be "FAILED" with a ResourceNotFoundException
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "glacier" "vault" was "DELETED"
# guard_violation_lifecycle: the "glacier" "vault" was not "DELETED"
atomic action GlacierTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof vid in VAULT_IDS:
                    if vid in vault_status:
                        if vault_status[vid] == "DELETED":
                            exec_status[eid] = "FAILED"
                            exec_vault[eid] = vid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which vault it called
# (verifies an execution cannot succeed without calling a vault; vault may be deleted afterwards)
always assertion SuccessfulExecutionCalledAVault:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_vault:
                return False
    return True
