---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> Secrets Manager Integration Formal Specification
# Models a Step Functions state machine reading a secret from Secrets Manager as a task step.
# If the secret is pending deletion the task fails and the execution fails.

SM_IDS = ["sm-1"]
SECRET_IDS = ["secret-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "PENDING_DELETION"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_secret = {}            # exec_secret[eid] = secret_id (secret read by this execution)


# step: a Step Functions state machine is created
# result: the state machine is ACTIVE
# guard: the state machine does not already exist
# guard_violation: the state machine already exists
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a secret is created in Secrets Manager
# result: the secret is ACTIVE
# guard: the secret does not already exist
# guard_violation: the secret already exists
atomic action CreateSecret:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            secret_status[sid] = "ACTIVE"


# step: a secret is scheduled for deletion
# result: the secret is PENDING_DELETION and will cause task failures when read
# guard: the secret exists
# guard_violation: the secret does not exist
# guard: the secret is ACTIVE
# guard_violation_lifecycle: the secret is not ACTIVE
atomic action ScheduleSecretDeletion:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                secret_status[sid] = "PENDING_DELETION"


# step: an execution of the state machine is started
# result: the execution is RUNNING
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: an execution slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running execution reads an ACTIVE secret and the task succeeds
# result: the execution is SUCCEEDED
# guard: an execution is RUNNING
# guard_violation: no execution is RUNNING
# guard: the secret exists and is ACTIVE
# guard_violation_lifecycle: the secret does not exist or is not ACTIVE
atomic action ReadSecretTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "ACTIVE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_secret[eid] = sid


# fake_skip: internal
# step: a running execution fails to read the secret because it is pending deletion
# result: the execution is FAILED with a ResourceNotFoundException
# guard: an execution is RUNNING
# guard_violation: no execution is RUNNING
# guard: the secret is PENDING_DELETION
# guard_violation: the secret is not pending deletion
atomic action ReadSecretTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "PENDING_DELETION":
                            exec_status[eid] = "FAILED"
                            exec_secret[eid] = sid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which secret it read
# (verifies an execution cannot succeed without reading a secret; secret may be deleted afterwards)
always assertion SuccessfulExecutionReadASecret:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_secret:
                return False
    return True
