---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> Secrets Manager Integration Formal Specification
# Models a Step Functions state machine reading a secret from Secrets Manager as a task step.
# If the secret is pending deletion the task fails and the execution fails.

SM_IDS = ["sm-1"]
SECRET_IDS = ["secret-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "PENDING_DELETION"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_secret = {}            # exec_secret[eid] = secret_id (secret read by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "secretsmanager" "secret" is created in Secrets Manager
# result: the "secrets manager" "secret" will be "ACTIVE"
# guard: the "secretsmanager" "secret" did not already exist
# guard_violation: the "secretsmanager" "secret" already existed
atomic action CreateSecret:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            secret_status[sid] = "ACTIVE"


# step: a "secretsmanager" "secret" is scheduled for deletion
# result: the "secrets manager" "secret" will be "PENDING_DELETION" and will cause task failures when read
# guard: the secrets manager secret existed
# guard_violation: the secrets manager secret did not exist
# guard: the "secrets manager" "secret" was "ACTIVE"
# guard_violation_lifecycle: the "secrets manager" "secret" was not "ACTIVE"
atomic action ScheduleSecretDeletion:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                secret_status[sid] = "PENDING_DELETION"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" reads an ACTIVE secret and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the secrets manager secret existed and was "ACTIVE"
# guard_violation_lifecycle: the secrets manager secret did not exist or was "ACTIVE"
atomic action ReadSecretTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "ACTIVE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_secret[eid] = sid


# fake_skip: internal
# step: a running "step functions" "execution" fails to read the "secretsmanager" "secret" because it is pending deletion
# result: the "step functions" "execution" will be "FAILED" with a ResourceNotFoundException
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "secretsmanager" "secret" was "PENDING_DELETION"
# guard_violation: the "secretsmanager" "secret" is not pending deletion
atomic action ReadSecretTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "PENDING_DELETION":
                            exec_status[eid] = "FAILED"
                            exec_secret[eid] = sid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which secret it read
# (verifies an execution cannot succeed without reading a secret; secret may be deleted afterwards)
always assertion SuccessfulExecutionReadASecret:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_secret:
                return False
    return True
