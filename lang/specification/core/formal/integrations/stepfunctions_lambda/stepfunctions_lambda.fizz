---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Step Functions -> Lambda Integration Formal Specification
# Models a Step Functions state machine invoking a Lambda function as a task.
# A task token is issued at invocation time; success or failure resolves the execution.

SM_IDS = ["sm-1"]
FUNC_IDS = ["func-1"]
EXEC_IDS = ["exec-1"]
INV_IDS = ["inv-1"]


action Init:
    # Step Functions state machine
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    sm_func = {}                # sm_func[smid] = func_id or "" (task Lambda not yet configured)

    # Lambda function
    func_status = {}            # func_status[fid] = "ACTIVE"

    # State machine executions
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id

    # Lambda invocations triggered by the state machine task
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_exec = {}               # inv_exec[iid] = exec_id
    inv_func = {}               # inv_func[iid] = func_id


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE" with no Lambda task configured
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"
            sm_func[smid] = ""


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a Lambda task is configured on the state machine
# result: the state machine will invoke the function when it reaches the task state
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the state machine has no Lambda task configured
# guard_violation: the state machine already has a Lambda task configured
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
atomic action ConfigureTask:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_func[smid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                sm_func[smid] = fid


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the state machine has a Lambda task configured
# guard_violation: the state machine has no Lambda task configured
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_func[smid] != "":
                    oneof eid in EXEC_IDS:
                        if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                            exec_status[eid] = "RUNNING"
                            exec_sm[eid] = smid


# step: a running "step functions" "execution" reaches the Lambda task state and invokes the function
# result: the invocation will be "IN_PROGRESS"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the execution's state machine has a configured Lambda task
# guard_violation: the execution's state machine has no Lambda task configured
# guard: the configured function was "ACTIVE"
# guard_violation_lifecycle: the configured function was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeTask:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_func:
                    fid = sm_func[smid]
                    if fid != "":
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                oneof iid in INV_IDS:
                                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                        inv_status[iid] = "IN_PROGRESS"
                                        inv_exec[iid] = eid
                                        inv_func[iid] = fid


# fake_skip: internal
# step: the Lambda task completes successfully and the execution succeeds
# result: the invocation will be "SUCCESS" and the "step functions" "execution" will be "SUCCEEDED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation: no "lambda" "invocation" was "IN_PROGRESS"
atomic action TaskSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                eid = inv_exec[iid]
                inv_status[iid] = "SUCCESS"
                exec_status[eid] = "SUCCEEDED"


# fake_skip: internal
# step: the Lambda task fails and the execution fails
# result: the invocation will be "FAILED" and the "step functions" "execution" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation: no "lambda" "invocation" was "IN_PROGRESS"
atomic action TaskFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                eid = inv_exec[iid]
                inv_status[iid] = "FAILED"
                exec_status[eid] = "FAILED"


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every IN_PROGRESS invocation has a corresponding RUNNING execution
always assertion InvocationLinkedToRunningExecution:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            eid = inv_exec[iid]
            if eid in exec_status:
                if exec_status[eid] != "RUNNING":
                    return False
    return True
