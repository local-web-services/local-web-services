---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> Cognito IdP Integration Formal Specification
# Models a Step Functions state machine calling Cognito IdP admin APIs
# (e.g., AdminCreateUser, AdminGetUser) as a task step via the SDK integration.
# If the user pool has been deleted, the task fails with a ResourceNotFoundException.

SM_IDS = ["sm-1"]
POOL_IDS = ["pool-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    pool_status = {}            # pool_status[pid] = "ACTIVE" | "DELETED"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_pool = {}              # exec_pool[eid] = pool_id (pool called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE"
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pid in POOL_IDS:
        if pid not in pool_status:
            pool_status[pid] = "ACTIVE"


# step: a "cognito" "user pool" is deleted
# result: the "cognito" "user pool" will be deleted and SDK task calls targeting it will fail
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" is already "DELETED"
atomic action DeleteUserPool:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                pool_status[pid] = "DELETED"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" calls an ACTIVE Cognito user pool and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" did not exist or was "DELETED"
atomic action CognitoTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in POOL_IDS:
                    if pid in pool_status:
                        if pool_status[pid] == "ACTIVE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_pool[eid] = pid


# fake_skip: internal
# step: a running "step functions" "execution" fails because the "cognito" "user pool" has been deleted
# result: the "step functions" "execution" will be "FAILED" with a ResourceNotFoundException
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "cognito" "user pool" was "DELETED"
# guard_violation_lifecycle: the "cognito" "user pool" was not "DELETED"
atomic action CognitoTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in POOL_IDS:
                    if pid in pool_status:
                        if pool_status[pid] == "DELETED":
                            exec_status[eid] = "FAILED"
                            exec_pool[eid] = pid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which pool it called
# (verifies an execution cannot succeed without calling a pool; pool may be deleted afterwards)
always assertion SuccessfulExecutionCalledAPool:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_pool:
                return False
    return True
