---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# API Gateway -> SQS Integration Formal Specification
# Models a REST API with a direct SQS integration: the API enqueues the request body
# as a message and immediately returns 200 to the caller without invoking Lambda.
# This is the async API pattern where callers are decoupled from backend processing.

API_IDS = ["api-1"]
QUEUE_IDS = ["queue-1"]
REQ_IDS = ["req-1"]
MSG_IDS = ["msg-1"]


action Init:
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_queue = {}              # api_queue[aid] = queue_id or "" (integrated queue)
    queue_status = {}           # queue_status[qid] = "ACTIVE"
    req_status = {}             # req_status[rid] = "ACCEPTED" | "FAILED"
    req_api = {}                # req_api[rid] = api_id
    msg_status = {}             # msg_status[mid] = "AVAILABLE" | "DELETED"
    msg_queue = {}              # msg_queue[mid] = queue_id
    msg_req = {}                # msg_req[mid] = request_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no SQS integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_queue[aid] = ""


# step: a "sqs" "queue" is created
# result: the "sqs" "queue" will be "ACTIVE"
# guard: the "sqs" "queue" did not already exist
# guard_violation: the "sqs" "queue" already existed
atomic action CreateQueue:
    oneof qid in QUEUE_IDS:
        if qid not in queue_status:
            queue_status[qid] = "ACTIVE"


# step: a SQS direct integration is configured on the "api gateway" "api"
# result: the "api gateway" "API" will enqueue incoming requests as SQS messages without invoking Lambda
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "API" had no integration configured
# guard_violation: the "api gateway" "API" already had an "api gateway" "integration" configured
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" was not "ACTIVE"
atomic action ConfigureIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_queue[aid] == "":
                    oneof qid in QUEUE_IDS:
                        if qid in queue_status:
                            if queue_status[qid] == "ACTIVE":
                                api_queue[aid] = qid


# step: the "api gateway" "API" receives a request and enqueues it as a SQS message
# result: the request will be "ACCEPTED" and the "sqs" "message" will be "AVAILABLE" in the "sqs" "queue"
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a SQS integration configured
# guard_violation: the "api gateway" "api" has no SQS integration configured
# guard: the target queue was "ACTIVE"
# guard_violation_lifecycle: the target queue was not "ACTIVE"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
# guard: a message slot is available
# guard_violation_capacity: no message slot is available
atomic action HandleRequest:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_queue[aid] != "":
                    qid = api_queue[aid]
                    if qid in queue_status:
                        if queue_status[qid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status or req_status[rid] == "ACCEPTED" or req_status[rid] == "FAILED":
                                    oneof mid in MSG_IDS:
                                        if mid not in msg_status or msg_status[mid] == "DELETED":
                                            req_status[rid] = "ACCEPTED"
                                            req_api[rid] = aid
                                            msg_status[mid] = "AVAILABLE"
                                            msg_queue[mid] = qid
                                            msg_req[mid] = rid


# step: a backend consumer processes the "sqs" "message" from the "sqs" "queue"
# result: the "sqs" "message" will be deleted
# guard: an "AVAILABLE" message existed in the "sqs" "queue"
# guard_violation_lifecycle: no "AVAILABLE" message existed in the "sqs" "queue"
atomic action ConsumeMessage:
    oneof mid in MSG_IDS:
        if mid in msg_status:
            if msg_status[mid] == "AVAILABLE":
                msg_status[mid] = "DELETED"


# check: every ACCEPTED request references an ACTIVE API
always assertion RequestRequiresActiveApi:
    for rid in req_status:
        if req_status[rid] == "ACCEPTED":
            aid = req_api[rid]
            if aid in api_status:
                if api_status[aid] != "ACTIVE":
                    return False
    return True


# check: every AVAILABLE message belongs to an ACTIVE queue
always assertion MessageRequiresActiveQueue:
    for mid in msg_status:
        if msg_status[mid] == "AVAILABLE":
            qid = msg_queue[mid]
            if qid in queue_status:
                if queue_status[qid] != "ACTIVE":
                    return False
    return True
