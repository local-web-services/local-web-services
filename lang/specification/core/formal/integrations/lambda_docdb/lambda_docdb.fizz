---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> DocumentDB Integration Formal Specification
# Models a Lambda function reading and writing documents to a DocumentDB cluster.
# DocumentDB clusters can be stopped (e.g., for cost savings); Lambda invocations
# that attempt connections to a STOPPED cluster fail with a connection error.

FUNC_IDS = ["func-1"]
CLUSTER_IDS = ["cluster-1"]
INV_IDS = ["inv-1"]
DOC_IDS = ["doc-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "STOPPED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    doc_status = {}             # doc_status[docid] = "EXISTS" | "DELETED"
    doc_cluster = {}            # doc_cluster[docid] = cluster_id
    doc_inv = {}                # doc_inv[docid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "documentdb" "cluster" is created
# result: the "documentdb" "cluster" will be "AVAILABLE"
# guard: the "documentdb" "cluster" did not already exist
# guard_violation: the "documentdb" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: the "documentdb" "cluster" is stopped
# result: the "documentdb" "cluster" will be "STOPPED" and connections will be rejected
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
atomic action StopCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "STOPPED"


# step: the "documentdb" "cluster" is started
# result: the "documentdb" "cluster" will be "AVAILABLE" and ready to accept connections
# guard: the "documentdb" "cluster" was "STOPPED"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "STOPPED"
atomic action StartCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "STOPPED":
                cluster_status[cid] = "AVAILABLE"


# step: the "lambda" "function" is invoked
# result: the invocation will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" writes a document to the "documentdb" "cluster" that was "AVAILABLE" and succeeds
# result: the document will exist and the invocation will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: a document slot is available
# guard_violation_capacity: no document slot is available
atomic action WriteDocument:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "AVAILABLE":
                            oneof docid in DOC_IDS:
                                if docid not in doc_status or doc_status[docid] == "DELETED":
                                    doc_status[docid] = "EXISTS"
                                    doc_cluster[docid] = cid
                                    doc_inv[docid] = iid
                                    inv_status[iid] = "SUCCESS"


# step: the "lambda" "function" fails to connect because the "documentdb" "cluster" is stopped
# result: the invocation will be "FAILED" with a connection error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "documentdb" "cluster" was "STOPPED"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "STOPPED"
atomic action InvocationFailsClusterStopped:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "STOPPED":
                            inv_status[iid] = "FAILED"


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every existing document references a "documentdb" "cluster" that exists
# (documents persist in DocumentDB storage even if the cluster is later stopped)
always assertion DocumentReferencesExistingCluster:
    for docid in doc_status:
        if doc_status[docid] == "EXISTS":
            cid = doc_cluster[docid]
            if cid not in cluster_status:
                return False
    return True
