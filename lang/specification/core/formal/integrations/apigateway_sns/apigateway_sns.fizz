---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> SNS Integration Formal Specification
# Models an API Gateway REST API with a direct SNS integration (no Lambda proxy).
# The API is configured with a mapping template that publishes to an SNS topic.
# If the topic has been deleted, the request fails with a service error.

API_IDS = ["api-1"]
TOPIC_IDS = ["topic-1"]
REQ_IDS = ["req-1"]
MSG_IDS = ["msg-1"]


action Init:
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_topic = {}              # api_topic[aid] = topic_id or "" (SNS integration target)
    topic_status = {}           # topic_status[tid] = "ACTIVE" | "DELETED"
    req_status = {}             # req_status[rid] = "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id
    msg_status = {}             # msg_status[mid] = "PUBLISHED"
    msg_topic = {}              # msg_topic[mid] = topic_id
    msg_req = {}                # msg_req[mid] = req_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no SNS integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestAPI:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_topic[aid] = ""


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: the "sns" "topic" is deleted
# result: the "sns" "topic" will be deleted and API requests targeting it will fail
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" is already "DELETED"
atomic action DeleteTopic:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                topic_status[tid] = "DELETED"


# step: a direct SNS integration is configured on the "api gateway" "API"
# result: the "api gateway" "API" will publish to the "sns" "topic" when requests are received
# guard: the "api gateway" "API" existed and was "ACTIVE"
# guard_violation: the "api gateway" "API" did not exist or was "ACTIVE"
# guard: the "api gateway" "api" has no SNS integration configured
# guard_violation: the "api gateway" "API" already has a SNS integration configured
# guard: the "sns" "topic" existed and was "ACTIVE"
# guard_violation: the "sns" "topic" did not exist or was "ACTIVE"
atomic action ConfigureDirectIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_topic[aid] == "":
                    oneof tid in TOPIC_IDS:
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                api_topic[aid] = tid


# step: a request is received, the "api gateway" "API" publishes to the "sns" "topic", and returns 200
# result: the message will be "PUBLISHED" and the request will be "SUCCESS"
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a SNS integration configured
# guard_violation: the "api gateway" "api" has no SNS integration configured
# guard: the target topic was "ACTIVE"
# guard_violation_lifecycle: the target topic was not "ACTIVE"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
# guard: a message slot is available
# guard_violation_capacity: no message slot is available
atomic action RequestSucceeds:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_topic[aid] != "":
                    tid = api_topic[aid]
                    if tid in topic_status:
                        if topic_status[tid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    oneof mid in MSG_IDS:
                                        if mid not in msg_status:
                                            req_status[rid] = "SUCCESS"
                                            req_api[rid] = aid
                                            msg_status[mid] = "PUBLISHED"
                                            msg_topic[mid] = tid
                                            msg_req[mid] = rid


# step: a request is received but the SNS publish fails because the "sns" "topic" has been deleted
# result: the request will be "FAILED" and no message will be published
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a SNS integration configured
# guard_violation: the "api gateway" "api" has no SNS integration configured
# guard: the target topic was "DELETED"
# guard_violation_lifecycle: the target topic was not "DELETED"
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
atomic action RequestFails:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_topic[aid] != "":
                    tid = api_topic[aid]
                    if tid in topic_status:
                        if topic_status[tid] == "DELETED":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    req_status[rid] = "FAILED"
                                    req_api[rid] = aid


# check: every PUBLISHED message references a "sns" "topic" that exists
always assertion PublishedMessageReferencesExistingTopic:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            tid = msg_topic[mid]
            if tid not in topic_status:
                return False
    return True


# check: every successful request references an "api gateway" "API" that exists
always assertion SuccessfulRequestReferencesExistingAPI:
    for rid in req_status:
        if req_status[rid] == "SUCCESS":
            aid = req_api[rid]
            if aid not in api_status:
                return False
    return True
