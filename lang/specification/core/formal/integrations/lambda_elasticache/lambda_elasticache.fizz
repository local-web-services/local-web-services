---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> ElastiCache Integration Formal Specification
# Models a Lambda function reading and writing values to an ElastiCache cluster.
# On a cache miss the function falls through; on a cache hit the function can return early.
# Cache entries can be evicted by ElastiCache independently of Lambda activity.

FUNC_IDS = ["func-1"]
CLUSTER_IDS = ["cluster-1"]
INV_IDS = ["inv-1"]
KEY_IDS = ["key-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    key_status = {}             # key_status[kid] = "CACHED" | "EVICTED"
    key_cluster = {}            # key_cluster[kid] = cluster_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: an "elasticache" "cluster" is created
# result: the "elasticache" "cluster" will be "AVAILABLE"
# guard: the "elasticache" "cluster" did not already exist
# guard_violation: the "elasticache" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# step: the "lambda" "function" writes a value to the "elasticache" "cluster" during invocation
# result: the "elasticache" "cache" "entry" will be "CACHED" in the "elasticache" "cluster"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
# guard: an "elasticache" "key" "slot" was "available"
# guard_violation_capacity: no "elasticache" "key" "slot" was "available"
atomic action CacheWrite:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "AVAILABLE":
                            oneof kid in KEY_IDS:
                                if kid not in key_status or key_status[kid] == "EVICTED":
                                    key_status[kid] = "CACHED"
                                    key_cluster[kid] = cid


# fake_skip: internal
# step: the "elasticache" "cluster" evicts a "cache" "entry" due to memory pressure or TTL expiry
# result: the "elasticache" "cache entry" will be "EVICTED"
# guard: a "CACHED" "elasticache" "entry" existed
# guard_violation_lifecycle: no "CACHED" "elasticache" "entry" existed
atomic action CacheEvict:
    oneof kid in KEY_IDS:
        if kid in key_status:
            if key_status[kid] == "CACHED":
                key_status[kid] = "EVICTED"


# fake_skip: internal
# step: the "lambda" "function" invocation reads an existing cache entry and completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: a "CACHED" "elasticache" "entry" existed in the "elasticache" "cluster"
# guard_violation_lifecycle: no "CACHED" "elasticache" "entry" existed in the "elasticache" "cluster"
atomic action InvocationSucceedsCacheHit:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                found = False
                for kid in key_status:
                    if key_status[kid] == "CACHED":
                        found = True
                if found == True:
                    inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails because all cache entries have been evicted
# result: the "lambda" "invocation" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: no "CACHED" "elasticache" "entries" existed in the "elasticache" "cluster"
# guard_violation_lifecycle: a "CACHED" "elasticache" "entry" existed in the "elasticache" "cluster"
atomic action InvocationFailsCacheMiss:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                found = False
                for kid in key_status:
                    if key_status[kid] == "CACHED":
                        found = True
                if found == False:
                    inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "CACHED" "elasticache" "entry" belongs to an "AVAILABLE" "elasticache" "cluster"
always assertion CachedEntryRequiresAvailableCluster:
    for kid in key_status:
        if key_status[kid] == "CACHED":
            cid = key_cluster[kid]
            if cid in cluster_status:
                if cluster_status[cid] != "AVAILABLE":
                    return False
    return True
