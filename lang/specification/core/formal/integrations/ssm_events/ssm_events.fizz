---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# SSM -> EventBridge Integration Formal Specification
# Models SSM Parameter Store publishing parameter change events to an EventBridge event bus.
# When a parameter is created, updated, or deleted, SSM automatically sends an event
# to EventBridge, enabling event-driven reactions to configuration changes.
# If the bus has been deleted, event delivery fails silently.

PARAM_IDS = ["param-1"]
BUS_IDS = ["bus-1"]
EVENT_IDS = ["event-1", "event-2"]


action Init:
    param_status = {}           # param_status[pid] = "EXISTS" | "DELETED"
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    event_status = {}           # event_status[eid] = "DELIVERED"
    event_param = {}            # event_param[eid] = param_id
    event_type = {}             # event_type[eid] = "CREATED" | "UPDATED" | "DELETED"
    event_bus = {}              # event_bus[eid] = bus_id


# step: an EventBridge event bus is created
# result: the bus is ACTIVE
# guard: the bus does not already exist
# guard_violation: the bus already exists
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the EventBridge event bus is deleted
# result: the bus is DELETED and SSM event delivery will fail
# guard: the bus exists
# guard_violation: the bus does not exist
# guard: the bus is ACTIVE
# guard_violation_lifecycle: the bus is already DELETED
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# fake_skip: internal
# step: a parameter is created and SSM delivers a CREATED event to the EventBridge bus
# result: the parameter EXISTS and the CREATED event is DELIVERED
# guard: the parameter does not already exist
# guard_violation: the parameter already exists
# guard: the bus is ACTIVE
# guard_violation_lifecycle: the bus is DELETED
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action PutParameterEventDelivered:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "ACTIVE":
                        oneof eid in EVENT_IDS:
                            if eid not in event_status:
                                param_status[pid] = "EXISTS"
                                event_status[eid] = "DELIVERED"
                                event_param[eid] = pid
                                event_type[eid] = "CREATED"
                                event_bus[eid] = busid


# fake_skip: internal
# step: a parameter is created but the CREATED event delivery fails because the bus is deleted
# result: the parameter EXISTS but no event is delivered
# guard: the parameter does not already exist
# guard_violation: the parameter already exists
# guard: the bus is DELETED
# guard_violation_lifecycle: the bus is not DELETED
atomic action PutParameterEventFails:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "DELETED":
                        param_status[pid] = "EXISTS"


# fake_skip: internal
# step: a parameter is deleted and SSM delivers a DELETED event to the EventBridge bus
# result: the parameter is DELETED and the DELETED event is DELIVERED
# guard: the parameter exists
# guard_violation: the parameter does not exist
# guard: the parameter EXISTS (not already DELETED)
# guard_violation_lifecycle: the parameter is already DELETED
# guard: the bus is ACTIVE
# guard_violation_lifecycle: the bus is DELETED
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action DeleteParameterEventDelivered:
    oneof pid in PARAM_IDS:
        if pid in param_status:
            if param_status[pid] == "EXISTS":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    param_status[pid] = "DELETED"
                                    event_status[eid] = "DELIVERED"
                                    event_param[eid] = pid
                                    event_type[eid] = "DELETED"
                                    event_bus[eid] = busid


# check: every DELIVERED event references a parameter that exists (in any state)
always assertion DeliveredEventReferencesExistingParameter:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            pid = event_param[eid]
            if pid not in param_status:
                return False
    return True


# check: every DELIVERED event references a bus that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
