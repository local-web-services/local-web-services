---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# SSM -> EventBridge Integration Formal Specification
# Models SSM Parameter Store publishing parameter change events to an EventBridge event bus.
# When a parameter is created, updated, or deleted, SSM automatically sends an event
# to EventBridge, enabling event-driven reactions to configuration changes.
# If the bus has been deleted, event delivery fails silently.

PARAM_IDS = ["param-1"]
BUS_IDS = ["bus-1"]
EVENT_IDS = ["event-1", "event-2"]


action Init:
    param_status = {}           # param_status[pid] = "EXISTS" | "DELETED"
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    event_status = {}           # event_status[eid] = "DELIVERED"
    event_param = {}            # event_param[eid] = param_id
    event_type = {}             # event_type[eid] = "CREATED" | "UPDATED" | "DELETED"
    event_bus = {}              # event_bus[eid] = bus_id


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the "eventbridge" "bus" is deleted
# result: the "eventbridge" "bus" will be deleted and SSM event delivery will fail
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# fake_skip: internal
# step: a "ssm" "parameter" is created and "ssm" delivers a "CREATED" "eventbridge" "event" to the "eventbridge" "bus"
# result: the "ssm" "parameter" will exist and the "eventbridge" "CREATED" "event" will be "DELIVERED"
# guard: the "ssm" "parameter" did not already exist
# guard_violation: the "ssm" "parameter" already existed
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was "DELETED"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action PutParameterEventDelivered:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "ACTIVE":
                        oneof eid in EVENT_IDS:
                            if eid not in event_status:
                                param_status[pid] = "EXISTS"
                                event_status[eid] = "DELIVERED"
                                event_param[eid] = pid
                                event_type[eid] = "CREATED"
                                event_bus[eid] = busid


# fake_skip: internal
# step: a "ssm" "parameter" is created but the "CREATED" "eventbridge" "event" delivery fails because the "eventbridge" "bus" is deleted
# result: the "ssm" "parameter" will exist but no "eventbridge" "event" will be delivered
# guard: the "ssm" "parameter" did not already exist
# guard_violation: the "ssm" "parameter" already existed
# guard: the "eventbridge" "bus" was "DELETED"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "DELETED"
atomic action PutParameterEventFails:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            oneof busid in BUS_IDS:
                if busid in bus_status:
                    if bus_status[busid] == "DELETED":
                        param_status[pid] = "EXISTS"


# fake_skip: internal
# step: a "ssm" "parameter" is deleted and "ssm" delivers a "DELETED" "eventbridge" "event" to the "eventbridge" "bus"
# result: the "ssm" "parameter" will be deleted and the "DELETED" event will be "DELIVERED"
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" existed (not already "DELETED")
# guard_violation_lifecycle: the "ssm" "parameter" is already "DELETED"
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was "DELETED"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action DeleteParameterEventDelivered:
    oneof pid in PARAM_IDS:
        if pid in param_status:
            if param_status[pid] == "EXISTS":
                oneof busid in BUS_IDS:
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    param_status[pid] = "DELETED"
                                    event_status[eid] = "DELIVERED"
                                    event_param[eid] = pid
                                    event_type[eid] = "DELETED"
                                    event_bus[eid] = busid


# check: every "DELIVERED" "eventbridge" "event" references a "ssm" "parameter" that exists (in any state)
always assertion DeliveredEventReferencesExistingParameter:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            pid = event_param[eid]
            if pid not in param_status:
                return False
    return True


# check: every "DELIVERED" "eventbridge" "event" references a "eventbridge" "bus" that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
