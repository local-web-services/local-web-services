---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> RDS Integration Formal Specification
# Models a Step Functions state machine executing queries against an RDS instance
# using the RDS Data API as a task step.
# If the DB instance is failing over, the task fails with a connection error.

SM_IDS = ["sm-1"]
DB_IDS = ["db-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    db_status = {}              # db_status[dbid] = "AVAILABLE" | "FAILING_OVER"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_db = {}                # exec_db[eid] = db_id (DB queried by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an "rds" "DB instance" is created
# result: the "rds" "DB instance" will be "AVAILABLE"
# guard: the "rds" "instance" did not already exist
# guard_violation: the "rds" "instance" already existed
atomic action CreateDBInstance:
    oneof dbid in DB_IDS:
        if dbid not in db_status:
            db_status[dbid] = "AVAILABLE"


# step: a Multi-AZ failover begins on the "rds" "DB instance"
# result: the "rds" "DB instance" will be "FAILING_OVER" and queries will be rejected
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "DB instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "DB instance" was not "AVAILABLE"
atomic action DBFailoverBegins:
    oneof dbid in DB_IDS:
        if dbid in db_status:
            if db_status[dbid] == "AVAILABLE":
                db_status[dbid] = "FAILING_OVER"


# fake_skip: internal
# step: the "rds" "DB instance" failover completes
# result: the DB instance will be "AVAILABLE" again
# guard: the "rds" "DB instance" was "FAILING_OVER"
# guard_violation_lifecycle: the "rds" "DB instance" was not "FAILING_OVER"
atomic action DBFailoverComplete:
    oneof dbid in DB_IDS:
        if dbid in db_status:
            if db_status[dbid] == "FAILING_OVER":
                db_status[dbid] = "AVAILABLE"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" queries the AVAILABLE DB instance and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "rds" "DB instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "DB instance" was not "AVAILABLE"
atomic action QueryDBTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof dbid in DB_IDS:
                    if dbid in db_status:
                        if db_status[dbid] == "AVAILABLE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_db[eid] = dbid


# fake_skip: internal
# step: a running "step functions" "execution" fails to query the DB because it is failing over
# result: the "step functions" "execution" will be "FAILED" with a connection error
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "rds" "DB instance" was "FAILING_OVER"
# guard_violation_lifecycle: the "rds" "DB instance" was not "FAILING_OVER"
atomic action QueryDBTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof dbid in DB_IDS:
                    if dbid in db_status:
                        if db_status[dbid] == "FAILING_OVER":
                            exec_status[eid] = "FAILED"
                            exec_db[eid] = dbid


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "SUCCEEDED" "step functions" "execution" recorded which "rds" "DB instance" it queried
# (verifies an execution cannot succeed without querying a DB; DB may fail over afterwards)
always assertion SuccessfulExecutionQueriedADB:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_db:
                return False
    return True
