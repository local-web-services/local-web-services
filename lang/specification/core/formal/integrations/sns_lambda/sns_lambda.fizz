---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# SNS -> Lambda Integration Formal Specification
# Models an SNS topic asynchronously invoking a subscribed Lambda function when a message is published.

TOPIC_IDS = ["topic-1"]
FUNC_IDS = ["func-1"]
SUB_IDS = ["sub-1"]
INV_IDS = ["inv-1"]


action Init:
    # SNS
    topic_status = {}           # topic_status[tid] = "ACTIVE"

    # SNS -> Lambda subscription
    sub_status = {}             # sub_status[sid] = "CONFIRMED" | "DELETED"
    sub_topic = {}              # sub_topic[sid] = topic_id
    sub_func = {}               # sub_func[sid] = func_id

    # Lambda function
    func_status = {}            # func_status[fid] = "ACTIVE"

    # Lambda invocations triggered asynchronously by SNS
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_sub = {}                # inv_sub[iid] = sub_id


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "lambda" "function" subscribes to a "sns" "topic"
# result: the "sns" "subscription" will be "CONFIRMED" and the "lambda" "function" will be invoked on published messages
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "sns" "subscription" "slot" was "available"
# guard_violation_capacity: no "sns" "subscription" "slot" was "available"
atomic action SubscribeFunctionToTopic:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                oneof fid in FUNC_IDS:
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof sid in SUB_IDS:
                                if sid not in sub_status:
                                    sub_status[sid] = "CONFIRMED"
                                    sub_topic[sid] = tid
                                    sub_func[sid] = fid


# step: a message is published to a "sns" "topic" and asynchronously invokes the subscribed Lambda function
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was not "ACTIVE"
# guard: a "sns" "subscription" was "CONFIRMED" for the "sns" "topic"
# guard_violation_lifecycle: no "sns" "subscription" was "CONFIRMED" for the "sns" "topic"
# guard: the subscribed "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the subscribed "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action PublishAndInvoke:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                oneof sid in SUB_IDS:
                    if sid in sub_status:
                        if sub_status[sid] == "CONFIRMED":
                            if sub_topic[sid] == tid:
                                fid = sub_func[sid]
                                if fid in func_status:
                                    if func_status[fid] == "ACTIVE":
                                        oneof iid in INV_IDS:
                                            if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                                inv_status[iid] = "IN_PROGRESS"
                                                inv_func[iid] = fid
                                                inv_sub[iid] = sid


# fake_skip: internal
# step: the "lambda" "function" invocation completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails
# result: the "lambda" "invocation" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "FAILED"


# check: every "CONFIRMED" "sns" "subscription" references an "ACTIVE" "sns" "topic"
always assertion SubscriptionReferencesActiveTopic:
    for sid in sub_status:
        if sub_status[sid] == "CONFIRMED":
            tid = sub_topic[sid]
            if tid in topic_status:
                if topic_status[tid] != "ACTIVE":
                    return False
    return True


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "IN_PROGRESS" "lambda" "invocation" was triggered by a "CONFIRMED" "sns" "subscription"
always assertion InvocationRequiresConfirmedSubscription:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            sid = inv_sub[iid]
            if sid in sub_status:
                if sub_status[sid] != "CONFIRMED":
                    return False
    return True


# Note: invocation liveness (eventually SUCCESS or FAILED) is not modeled here because
# InvocationSucceeds and InvocationFails are external triggers (async Lambda runtime events)
# and FizzBee liveness requires fairness assumptions that are not supported.
# SNS retries async Lambda invocations up to two additional times before discarding.
