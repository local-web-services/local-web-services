---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# S3 -> Lambda Integration Formal Specification
# Models S3 event notifications triggering an asynchronous Lambda invocation on object PUT.

BUCKET_IDS = ["bucket-1"]
FUNC_IDS = ["func-1"]
OBJ_IDS = ["obj-1"]
INV_IDS = ["inv-1"]


action Init:
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    bucket_func = {}            # bucket_func[bid] = func_id or "" (notification target)
    func_status = {}            # func_status[fid] = "ACTIVE"
    obj_status = {}             # obj_status[oid] = "EXISTS" | "DELETED"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_obj = {}                # inv_obj[iid] = obj_id


# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE" with no event notification configured
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"
            bucket_func[bid] = ""


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a S3 event notification is configured to invoke a "lambda" "function" on object PUT
# result: the "s3" "bucket" will asynchronously invoke the "lambda" "function" when an "s3" "object" is put
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has no notification configured
# guard_violation: the "s3" "bucket" already has a notification configured
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
atomic action ConfigureNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_func[bid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                bucket_func[bid] = fid


# step: an "s3" "object" is put into the "s3" "bucket" and asynchronously invokes the configured "lambda" "function"
# result: the "s3" "object" will exist in the "s3" "bucket" and a "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "s3" "bucket" existed
# guard_violation: the "s3" "bucket" did not exist
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has a notification configured
# guard_violation: the "s3" "bucket" has no notification configured
# guard: the notification target "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the notification target "lambda" "function" was not "ACTIVE"
# guard: a "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action PutObjectAndNotify:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_func[bid] != "":
                    fid = bucket_func[bid]
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status or obj_status[oid] == "DELETED":
                                    oneof iid in INV_IDS:
                                        if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            inv_status[iid] = "IN_PROGRESS"
                                            inv_func[iid] = fid
                                            inv_obj[iid] = oid


# fake_skip: internal
# step: the "lambda" "function" invocation completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails
# result: the "lambda" "invocation" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "IN_PROGRESS" "lambda" "invocation" was triggered by an "s3" "object" in an "ACTIVE" "s3" "bucket"
always assertion InvocationRequiresActiveBucket:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            oid = inv_obj[iid]
            if oid in obj_bucket:
                bid = obj_bucket[oid]
                if bid in bucket_status:
                    if bucket_status[bid] != "ACTIVE":
                        return False
    return True
