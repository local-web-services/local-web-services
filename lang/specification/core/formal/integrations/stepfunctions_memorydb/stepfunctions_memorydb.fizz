---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> MemoryDB Integration Formal Specification
# Models a Step Functions state machine connecting to a MemoryDB cluster
# as a task step to read or write cached data.
# If the cluster is being updated, the connection may be refused.

SM_IDS = ["sm-1"]
CLUSTER_IDS = ["cluster-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "UPDATING"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_cluster = {}           # exec_cluster[eid] = cluster_id (cluster called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "memorydb" "cluster" is created
# result: the "memorydb" "cluster" will be "AVAILABLE"
# guard: the "memorydb" "cluster" did not already exist
# guard_violation: the "memorydb" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: a "memorydb" "cluster" update begins
# result: the "memorydb" "cluster" will be "UPDATING" and connections may be refused
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
atomic action ClusterUpdateBegins:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "UPDATING"


# fake_skip: internal
# step: the "memorydb" "cluster" update completes
# result: the "memorydb" "cluster" will be "AVAILABLE" again
# guard: the "memorydb" "cluster" was "UPDATING"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "UPDATING"
atomic action ClusterUpdateComplete:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "UPDATING":
                cluster_status[cid] = "AVAILABLE"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" connects to the AVAILABLE MemoryDB cluster and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
atomic action MemoryDBTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "AVAILABLE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_cluster[eid] = cid


# fake_skip: internal
# step: a running "step functions" "execution" fails to connect because the "memorydb" "cluster" is updating
# result: the "step functions" "execution" will be "FAILED" with a connection error
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "memorydb" "cluster" was "UPDATING"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "UPDATING"
atomic action MemoryDBTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "UPDATING":
                            exec_status[eid] = "FAILED"
                            exec_cluster[eid] = cid


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "SUCCEEDED" "step functions" "execution" recorded which "memorydb" "cluster" it connected to
# (verifies an execution cannot succeed without connecting to a cluster; cluster may enter UPDATING afterwards)
always assertion SuccessfulExecutionConnectedToACluster:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_cluster:
                return False
    return True
