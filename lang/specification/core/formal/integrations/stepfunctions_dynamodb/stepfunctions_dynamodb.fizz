---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Step Functions -> DynamoDB Integration Formal Specification
# Models a Step Functions state machine that writes an item to DynamoDB as a task step.
# The task succeeds when the item is written; the execution then completes.
# An execution that attempts a GetItem on a non-existent item fails.

SM_IDS = ["sm-1"]
TABLE_IDS = ["table-1"]
EXEC_IDS = ["exec-1"]
ITEM_IDS = ["item-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    sm_table = {}               # sm_table[smid] = table_id or "" (DynamoDB task target)
    table_status = {}           # table_status[tid] = "ACTIVE"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    item_status = {}            # item_status[iid] = "EXISTS" | "DELETED"
    item_table = {}             # item_table[iid] = table_id
    item_exec = {}              # item_exec[iid] = exec_id


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE" with no DynamoDB task configured
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"
            sm_table[smid] = ""


# step: a "dynamodb" "table" is created
# result: the "dynamodb" "table" will be "ACTIVE"
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: a "dynamodb" "PutItem" task is configured on the "step functions" "state machine"
# result: the state machine will write an item to the "dynamodb" "table" when it reaches the task state
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the "step functions" "state machine" had no "dynamodb" task configured
# guard_violation: the "step functions" "state machine" already has a "dynamodb" task configured
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
atomic action ConfigureDynamoDBTask:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_table[smid] == "":
                    oneof tid in TABLE_IDS:
                        if tid in table_status:
                            if table_status[tid] == "ACTIVE":
                                sm_table[smid] = tid


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: the "step functions" "state machine" had a "dynamodb" task configured
# guard_violation: the "step functions" "state machine" had no "dynamodb" task configured
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_table[smid] != "":
                    oneof eid in EXEC_IDS:
                        if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                            exec_status[eid] = "RUNNING"
                            exec_sm[eid] = smid


# step: a running "step functions" "execution" writes an item to the "dynamodb" "table" and succeeds
# result: the item will exist in the "dynamodb" "table" and the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the target "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the target "dynamodb" "table" was not "ACTIVE"
# guard: an "item" "slot" was "available"
# guard_violation_capacity: no "dynamodb" "item" "slot" was "available"
atomic action PutItemTask:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_table:
                    tid = sm_table[smid]
                    if tid != "":
                        if tid in table_status:
                            if table_status[tid] == "ACTIVE":
                                oneof iid in ITEM_IDS:
                                    if iid not in item_status or item_status[iid] == "DELETED":
                                        item_status[iid] = "EXISTS"
                                        item_table[iid] = tid
                                        item_exec[iid] = eid
                                        exec_status[eid] = "SUCCEEDED"


# step: a running "step functions" "execution" attempts to get an item that does not exist and the execution fails
# result: the "step functions" "execution" will be "FAILED" because the item was not found
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: no "dynamodb" "item" existed in the target "dynamodb" "table"
# guard_violation: a "dynamodb" "item" existed in the target "dynamodb" "table"
atomic action GetItemNotFoundTask:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_table:
                    tid = sm_table[smid]
                    if tid != "":
                        found = False
                        for iid in item_status:
                            if item_status[iid] == "EXISTS":
                                if item_table[iid] == tid:
                                    found = True
                        if found == False:
                            exec_status[eid] = "FAILED"


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every existing "dynamodb" "item" belongs to an "ACTIVE" "dynamodb" "table"
always assertion ItemRequiresActiveTable:
    for iid in item_status:
        if item_status[iid] == "EXISTS":
            tid = item_table[iid]
            if tid in table_status:
                if table_status[tid] != "ACTIVE":
                    return False
    return True
