---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# ElastiCache -> SNS Integration Formal Specification
# Models ElastiCache cluster event notifications delivered to an SNS topic.
# ElastiCache can be configured to publish cluster lifecycle events
# (e.g., node replacements, failovers, parameter group changes) to an SNS topic.
# If the topic has been deleted, notification delivery fails silently.

CLUSTER_IDS = ["cluster-1"]
TOPIC_IDS = ["topic-1"]
MSG_IDS = ["msg-1"]


action Init:
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "MODIFYING" | "DELETED"
    cluster_topic = {}          # cluster_topic[cid] = topic_id or "" (SNS notification config)
    topic_status = {}           # topic_status[tid] = "ACTIVE" | "DELETED"
    msg_status = {}             # msg_status[mid] = "PUBLISHED"
    msg_topic = {}              # msg_topic[mid] = topic_id
    msg_cluster = {}            # msg_cluster[mid] = cluster_id


# step: an "elasticache" "cluster" is created
# result: the "elasticache" "cluster" will be "AVAILABLE" with no SNS notification configured
# guard: the "elasticache" "cluster" did not already exist
# guard_violation: the "elasticache" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"
            cluster_topic[cid] = ""


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: the "sns" "topic" is deleted
# result: the "sns" "topic" will be deleted and ElastiCache event notifications will fail
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" is already "DELETED"
atomic action DeleteTopic:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                topic_status[tid] = "DELETED"


# step: a SNS notification is configured on the "elasticache" "cluster"
# result: the "elasticache" "cluster" will publish lifecycle events to the "sns" "topic"
# guard: the "elasticache" "cluster" existed and was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" did not exist or was "AVAILABLE"
# guard: the "elasticache" "cluster" has no SNS notification configured
# guard_violation: the "elasticache" "cluster" already has a SNS notification configured
# guard: the "sns" "topic" existed and was "ACTIVE"
# guard_violation: the "sns" "topic" did not exist or was "ACTIVE"
atomic action ConfigureNotification:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_topic[cid] == "":
                    oneof tid in TOPIC_IDS:
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                cluster_topic[cid] = tid


# fake_skip: internal
# step: a cluster modification event occurs and ElastiCache publishes a notification to the "sns" "topic"
# result: the "elasticache" "cluster" will be "MODIFYING" and the notification will be "PUBLISHED" to the "sns" "topic"
# guard: the "elasticache" "cluster" existed and was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" did not exist or was "AVAILABLE"
# guard: the "elasticache" "cluster" has a SNS notification configured
# guard_violation: the "elasticache" "cluster" has no SNS notification configured
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" was "DELETED"
# guard: a "sns" "message" "slot" was "available"
# guard_violation_capacity: no "sns" "message" "slot" was "available"
atomic action ClusterEventNotificationDelivered:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_topic[cid] != "":
                    tid = cluster_topic[cid]
                    if tid in topic_status:
                        if topic_status[tid] == "ACTIVE":
                            oneof mid in MSG_IDS:
                                if mid not in msg_status:
                                    cluster_status[cid] = "MODIFYING"
                                    msg_status[mid] = "PUBLISHED"
                                    msg_topic[mid] = tid
                                    msg_cluster[mid] = cid


# fake_skip: internal
# step: a cluster event occurs but the SNS notification fails because the "sns" "topic" has been deleted
# result: the "elasticache" "cluster" will be "MODIFYING" but no notification will be published
# guard: the "elasticache" "cluster" existed and was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" did not exist or was "AVAILABLE"
# guard: the "elasticache" "cluster" has a SNS notification configured
# guard_violation: the "elasticache" "cluster" has no SNS notification configured
# guard: the "sns" "topic" was "DELETED"
# guard_violation_lifecycle: the "sns" "topic" was not "DELETED"
atomic action ClusterEventNotificationFails:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_topic[cid] != "":
                    tid = cluster_topic[cid]
                    if tid in topic_status:
                        if topic_status[tid] == "DELETED":
                            cluster_status[cid] = "MODIFYING"


# fake_skip: internal
# step: the "elasticache" "cluster" modification completes
# result: the "elasticache" "cluster" will be "AVAILABLE" again
# guard: the "elasticache" "cluster" was "MODIFYING"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "MODIFYING"
atomic action ClusterModificationComplete:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"


# check: every "PUBLISHED" "sns" "notification" references a "elasticache" "cluster" that exists
always assertion PublishedNotificationReferencesExistingCluster:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            cid = msg_cluster[mid]
            if cid not in cluster_status:
                return False
    return True


# check: every PUBLISHED notification references a "sns" "topic" that exists
always assertion PublishedNotificationReferencesExistingTopic:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            tid = msg_topic[mid]
            if tid not in topic_status:
                return False
    return True
