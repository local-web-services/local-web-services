---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> DynamoDB Integration Formal Specification
# Models an API Gateway REST API with a direct DynamoDB integration (no Lambda proxy).
# The API is configured with a VTL mapping template that writes to a DynamoDB table.
# If the table is being deleted, the request fails with a service error.

API_IDS = ["api-1"]
TABLE_IDS = ["table-1"]
REQ_IDS = ["req-1"]
ITEM_IDS = ["item-1"]


action Init:
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_table = {}              # api_table[aid] = table_id or "" (DynamoDB integration target)
    table_status = {}           # table_status[tid] = "ACTIVE" | "DELETING"
    req_status = {}             # req_status[rid] = "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id
    item_status = {}            # item_status[iid] = "EXISTS"
    item_table = {}             # item_table[iid] = table_id
    item_req = {}               # item_req[iid] = req_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no DynamoDB integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestAPI:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_table[aid] = ""


# step: a "dynamodb" "table" is created
# result: the "dynamodb" "table" will be "ACTIVE"
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: a "dynamodb" "table" deletion is initiated
# result: the "dynamodb" "table" will be "DELETING" and API requests targeting it will fail
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" is already "DELETING"
atomic action DeleteTable:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                table_status[tid] = "DELETING"


# step: a direct "dynamodb" integration is configured on the "api gateway" "API"
# result: the "api gateway" "api" will write to the "dynamodb" "table" when requests are received
# guard: the "api gateway" "API" existed and was "ACTIVE"
# guard_violation: the "api gateway" "API" did not exist or was "ACTIVE"
# guard: the "api gateway" "api" has no "dynamodb" integration configured
# guard_violation: the "api gateway" "API" already has a DynamoDB integration configured
# guard: the "dynamodb" "table" existed and was "ACTIVE"
# guard_violation: the "dynamodb" "table" did not exist or was "ACTIVE"
atomic action ConfigureDirectIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_table[aid] == "":
                    oneof tid in TABLE_IDS:
                        if tid in table_status:
                            if table_status[tid] == "ACTIVE":
                                api_table[aid] = tid


# step: a request is received, the "api gateway" "API" writes to the "dynamodb" "table", and returns 200
# result: the "dynamodb" "item" will exist and the "api gateway" "request" will be "SUCCESS"
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a "dynamodb" integration configured
# guard_violation: the "api gateway" "api" has no "dynamodb" integration configured
# guard: the target "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the target "dynamodb" "table" was not "ACTIVE"
# guard: a "request" "slot" was "available"
# guard_violation_capacity: no "request" "slot" was "available"
# guard: an "item" "slot" was "available"
# guard_violation_capacity: no "item" "slot" was "available"
atomic action RequestSucceeds:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_table[aid] != "":
                    tid = api_table[aid]
                    if tid in table_status:
                        if table_status[tid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    oneof iid in ITEM_IDS:
                                        if iid not in item_status:
                                            req_status[rid] = "SUCCESS"
                                            req_api[rid] = aid
                                            item_status[iid] = "EXISTS"
                                            item_table[iid] = tid
                                            item_req[iid] = rid


# step: a request is received but the DynamoDB write fails because the "dynamodb" "table" is being deleted
# result: the "api gateway" "request" will be "FAILED" and no "dynamodb" "item" will be written
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a "dynamodb" integration configured
# guard_violation: the "api gateway" "api" has no "dynamodb" integration configured
# guard: the target "dynamodb" "table" was "DELETING"
# guard_violation_lifecycle: the target "dynamodb" "table" was not "DELETING"
# guard: a "request" "slot" was "available"
# guard_violation_capacity: no "request" "slot" was "available"
atomic action RequestFails:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_table[aid] != "":
                    tid = api_table[aid]
                    if tid in table_status:
                        if table_status[tid] == "DELETING":
                            oneof rid in REQ_IDS:
                                if rid not in req_status:
                                    req_status[rid] = "FAILED"
                                    req_api[rid] = aid


# check: every existing item references a "dynamodb" "table" that exists
always assertion ItemReferencesExistingTable:
    for iid in item_status:
        if item_status[iid] == "EXISTS":
            tid = item_table[iid]
            if tid not in table_status:
                return False
    return True


# check: every successful request references an "api gateway" "API" that exists
always assertion SuccessfulRequestReferencesExistingAPI:
    for rid in req_status:
        if req_status[rid] == "SUCCESS":
            aid = req_api[rid]
            if aid not in api_status:
                return False
    return True
