---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> Cognito IdP Integration Formal Specification
# Models a Lambda function calling Cognito IdP admin APIs (e.g., AdminGetUser, AdminCreateUser).
# If the user pool has been deleted the invocation fails with a ResourceNotFoundException.

FUNC_IDS = ["func-1"]
POOL_IDS = ["pool-1"]
INV_IDS = ["inv-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    pool_status = {}            # pool_status[pid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_pool = {}               # inv_pool[iid] = pool_id (pool called by this invocation)


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE"
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pid in POOL_IDS:
        if pid not in pool_status:
            pool_status[pid] = "ACTIVE"


# step: a "cognito" "user pool" is deleted
# result: the "cognito" "user pool" will be deleted and Lambda calls targeting it will fail
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" is already "DELETED"
atomic action DeleteUserPool:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                pool_status[pid] = "DELETED"


# step: the "lambda" "function" is invoked
# result: the invocation will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" calls a Cognito admin API on an ACTIVE pool and succeeds
# result: the invocation will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" did not exist or was "DELETED"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof pid in POOL_IDS:
                    if pid in pool_status:
                        if pool_status[pid] == "ACTIVE":
                            inv_status[iid] = "SUCCESS"
                            inv_pool[iid] = pid


# step: the "lambda" "function" fails to call Cognito because the "cognito" "user pool" has been deleted
# result: the invocation will be "FAILED" with a ResourceNotFoundException
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "cognito" "user pool" was "DELETED"
# guard_violation_lifecycle: the "cognito" "user pool" was not "DELETED"
atomic action InvocationFailsPoolDeleted:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof pid in POOL_IDS:
                    if pid in pool_status:
                        if pool_status[pid] == "DELETED":
                            inv_status[iid] = "FAILED"
                            inv_pool[iid] = pid


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every successful invocation recorded which pool it called
# (verifies Lambda cannot succeed without calling a pool; pool may be deleted afterwards)
always assertion SuccessfulInvocationCalledAPool:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_pool:
                return False
    return True
