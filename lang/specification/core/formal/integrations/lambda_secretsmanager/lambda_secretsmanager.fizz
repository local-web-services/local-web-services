---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> Secrets Manager Integration Formal Specification
# Models a Lambda function reading a secret from Secrets Manager during invocation.
# If the secret is scheduled for deletion (pending deletion window), the read fails
# and the invocation fails with a ResourceNotFoundException.

FUNC_IDS = ["func-1"]
SECRET_IDS = ["secret-1"]
INV_IDS = ["inv-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "PENDING_DELETION"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_secret = {}             # inv_secret[iid] = secret_id (secret read during invocation)


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "secretsmanager" "secret" is created in Secrets Manager
# result: the "secrets manager" "secret" will be "ACTIVE" and can be read by Lambda
# guard: the "secretsmanager" "secret" did not already exist
# guard_violation: the "secretsmanager" "secret" already existed
atomic action CreateSecret:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            secret_status[sid] = "ACTIVE"


# step: a "secretsmanager" "secret" is scheduled for deletion
# result: the "secrets manager" "secret" will be "PENDING_DELETION" and will be unavailable to Lambda during the recovery window
# guard: the "secrets manager" "secret" existed
# guard_violation: the "secrets manager" "secret" did not exist
# guard: the "secrets manager" "secret" was "ACTIVE"
# guard_violation_lifecycle: the "secrets manager" "secret" was not "ACTIVE"
atomic action ScheduleSecretDeletion:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                secret_status[sid] = "PENDING_DELETION"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" reads an ACTIVE secret and completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "secrets manager" "secret" existed and was "ACTIVE"
# guard_violation_lifecycle: the "secrets manager" "secret" did not exist or was not "ACTIVE"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "ACTIVE":
                            inv_status[iid] = "SUCCESS"
                            inv_secret[iid] = sid


# step: the "lambda" "function" fails because the "secretsmanager" "secret" is pending deletion
# result: the "lambda" "invocation" will be "FAILED" with a ResourceNotFoundException
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "secretsmanager" "secret" was "PENDING_DELETION"
# guard_violation_lifecycle: the "secretsmanager" "secret" is not pending deletion
atomic action InvocationFailsSecretUnavailable:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof sid in SECRET_IDS:
                    if sid in secret_status:
                        if secret_status[sid] == "PENDING_DELETION":
                            inv_status[iid] = "FAILED"
                            inv_secret[iid] = sid


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every successful "lambda" "invocation" recorded which "secrets manager" "secret" it read
# (verifies Lambda cannot succeed without accessing a secret; secret may be deleted afterwards)
always assertion SuccessfulInvocationReadASecret:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_secret:
                return False
    return True
