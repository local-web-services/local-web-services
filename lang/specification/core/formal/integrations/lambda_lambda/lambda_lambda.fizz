---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> Lambda Integration Formal Specification
# Models a Lambda function (caller) invoking another Lambda function (callee)
# synchronously or asynchronously as part of its execution.
# If the callee function has been deleted, the invoke call fails with a ResourceNotFoundException.

CALLER_IDS = ["caller-1"]
CALLEE_IDS = ["callee-1"]
INV_IDS = ["inv-1"]


action Init:
    caller_status = {}          # caller_status[fid] = "ACTIVE"
    callee_status = {}          # callee_status[fid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_caller = {}             # inv_caller[iid] = caller func_id
    inv_callee = {}             # inv_callee[iid] = callee func_id (callee invoked)


# step: a caller "lambda" "function" is deployed
# result: the caller "lambda" "function" will be "ACTIVE"
# guard: the caller "lambda" "function" did not already exist
# guard_violation: the caller "lambda" "function" already existed
atomic action DeployCaller:
    oneof fid in CALLER_IDS:
        if fid not in caller_status:
            caller_status[fid] = "ACTIVE"


# step: a callee "lambda" "function" is deployed
# result: the callee "lambda" "function" will be "ACTIVE"
# guard: the callee "lambda" "function" did not already exist
# guard_violation: the callee "lambda" "function" already existed
atomic action DeployCallee:
    oneof fid in CALLEE_IDS:
        if fid not in callee_status:
            callee_status[fid] = "ACTIVE"


# step: the callee "lambda" "function" is deleted
# result: the callee "lambda" "function" will be "DELETED" and invocations targeting it will fail
# guard: the callee "lambda" "function" existed
# guard_violation: the callee "lambda" "function" did not exist
# guard: the callee "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the callee "lambda" "function" was already "DELETED"
atomic action DeleteCallee:
    oneof fid in CALLEE_IDS:
        if fid in callee_status:
            if callee_status[fid] == "ACTIVE":
                callee_status[fid] = "DELETED"


# step: the caller "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the caller "lambda" "function" existed
# guard_violation: the caller "lambda" "function" did not exist
# guard: the caller "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the caller "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeCaller:
    oneof cfid in CALLER_IDS:
        if cfid in caller_status:
            if caller_status[cfid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_caller[iid] = cfid


# fake_skip: internal
# step: the caller "lambda" "function" invokes the ACTIVE callee and the call succeeds
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the callee "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the callee "lambda" "function" did not exist or was "DELETED"
atomic action CalleeInvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof fid in CALLEE_IDS:
                    if fid in callee_status:
                        if callee_status[fid] == "ACTIVE":
                            inv_status[iid] = "SUCCESS"
                            inv_callee[iid] = fid


# fake_skip: internal
# step: the caller "lambda" "function" fails to invoke the callee "lambda" "function" because the callee "lambda" "function" has been deleted
# result: the "lambda" "invocation" will be "FAILED" with a ResourceNotFoundException
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the callee "lambda" "function" was "DELETED"
# guard_violation_lifecycle: the callee "lambda" "function" was not "DELETED"
atomic action CalleeInvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof fid in CALLEE_IDS:
                    if fid in callee_status:
                        if callee_status[fid] == "DELETED":
                            inv_status[iid] = "FAILED"
                            inv_callee[iid] = fid


# check: every "IN_PROGRESS" "lambda" "invocation" references an "ACTIVE" caller "lambda" "function"
always assertion InvocationRequiresActiveCaller:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_caller[iid]
            if fid in caller_status:
                if caller_status[fid] != "ACTIVE":
                    return False
    return True


# check: every successful "lambda" "invocation" recorded which callee "lambda" "function" was invoked
# (verifies a caller cannot succeed without invoking a callee; callee may be deleted afterwards)
always assertion SuccessfulInvocationInvokedACallee:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_callee:
                return False
    return True
