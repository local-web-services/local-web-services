---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> Elasticsearch Integration Formal Specification
# Models a Step Functions state machine calling Elasticsearch APIs as a task step
# (e.g., indexing documents or running search queries via the SDK integration).
# If the domain is PROCESSING a configuration update, the task fails.

SM_IDS = ["sm-1"]
DOMAIN_IDS = ["domain-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    domain_status = {}          # domain_status[did] = "AVAILABLE" | "PROCESSING"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_domain = {}            # exec_domain[eid] = domain_id (domain called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an "elasticsearch" "domain" is created and becomes AVAILABLE
# result: the "elasticsearch" "domain" will be "AVAILABLE"
# guard: the "elasticsearch" "domain" did not already exist
# guard_violation: the "elasticsearch" "domain" already existed
atomic action CreateDomain:
    oneof did in DOMAIN_IDS:
        if did not in domain_status:
            domain_status[did] = "AVAILABLE"


# step: a "elasticsearch" "domain" configuration update begins
# result: the "elasticsearch" "domain" will be "PROCESSING" and API calls may fail
# guard: the "elasticsearch" "domain" existed
# guard_violation: the "elasticsearch" "domain" did not exist
# guard: the "elasticsearch" "domain" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "AVAILABLE"
atomic action DomainProcessingBegins:
    oneof did in DOMAIN_IDS:
        if did in domain_status:
            if domain_status[did] == "AVAILABLE":
                domain_status[did] = "PROCESSING"


# fake_skip: internal
# step: the "elasticsearch" "domain" configuration update completes
# result: the "elasticsearch" "domain" will be "AVAILABLE" again
# guard: the "elasticsearch" "domain" was "PROCESSING"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "PROCESSING"
atomic action DomainProcessingComplete:
    oneof did in DOMAIN_IDS:
        if did in domain_status:
            if domain_status[did] == "PROCESSING":
                domain_status[did] = "AVAILABLE"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" calls an AVAILABLE Elasticsearch domain and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "elasticsearch" "domain" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "AVAILABLE"
atomic action SearchTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof did in DOMAIN_IDS:
                    if did in domain_status:
                        if domain_status[did] == "AVAILABLE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_domain[eid] = did


# fake_skip: internal
# step: a running "step functions" "execution" fails because the "elasticsearch" "domain" is processing a config update
# result: the "step functions" "execution" will be "FAILED" with a connection error
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "elasticsearch" "domain" was "PROCESSING"
# guard_violation_lifecycle: the "elasticsearch" "domain" was not "PROCESSING"
atomic action SearchTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof did in DOMAIN_IDS:
                    if did in domain_status:
                        if domain_status[did] == "PROCESSING":
                            exec_status[eid] = "FAILED"
                            exec_domain[eid] = did


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "SUCCEEDED" "step functions" "execution" recorded which "elasticsearch" "domain" it called
# (verifies an execution cannot succeed without calling a domain; domain may enter PROCESSING afterwards)
always assertion SuccessfulExecutionCalledADomain:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_domain:
                return False
    return True
