---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 50
---
# API Gateway -> Cognito Integration Formal Specification
# Models a REST API with a Cognito User Pool authorizer that validates JWT tokens before routing.
# Requests with a valid token from a user in the configured pool are AUTHORIZED.
# Requests with a valid token from a user in a different pool are REJECTED (pool mismatch).

API_IDS = ["api-1"]
POOL_IDS = ["pool-1", "pool-2"]
USER_IDS = ["user-1"]
TOKEN_IDS = ["token-1"]
REQ_IDS = ["req-1"]


action Init:
    # API Gateway
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_pool = {}               # api_pool[aid] = pool_id or "" (configured Cognito authorizer)

    # Cognito User Pools
    pool_status = {}            # pool_status[pid] = "ACTIVE"

    # Users within a pool
    user_status = {}            # user_status[uid] = "CONFIRMED"
    user_pool = {}              # user_pool[uid] = pool_id

    # JWT tokens issued by Cognito
    token_status = {}           # token_status[tkid] = "VALID"
    token_user = {}             # token_user[tkid] = user_id
    token_pool = {}             # token_pool[tkid] = pool_id

    # Incoming HTTP requests
    req_status = {}             # req_status[rid] = "AUTHORIZED" | "REJECTED"
    req_api = {}                # req_api[rid] = api_id
    req_token = {}              # req_token[rid] = token_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no Cognito authorizer configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_pool[aid] = ""


# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE"
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pid in POOL_IDS:
        if pid not in pool_status:
            pool_status[pid] = "ACTIVE"


# step: a "cognito" "user pool" authorizer is configured on the "api gateway" "api"
# result: the "api gateway" "API" will validate JWT tokens against the configured pool before routing requests
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has no authorizer configured
# guard_violation: the "api gateway" "API" already has an authorizer configured
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" was not "ACTIVE"
atomic action ConfigureAuthorizer:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_pool[aid] == "":
                    oneof pid in POOL_IDS:
                        if pid in pool_status:
                            if pool_status[pid] == "ACTIVE":
                                api_pool[aid] = pid


# step: a "cognito" "user" is confirmed in a "cognito" "user pool"
# result: the "cognito" "user" will be "CONFIRMED" and can authenticate
# guard: the "cognito" "user pool" existed
# guard_violation: the "cognito" "user pool" did not exist
# guard: the "cognito" "user pool" was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" was not "ACTIVE"
# guard: the "cognito" "user" did not already exist
# guard_violation: the "cognito" "user" already existed
atomic action ConfirmUser:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                oneof uid in USER_IDS:
                    if uid not in user_status:
                        user_status[uid] = "CONFIRMED"
                        user_pool[uid] = pid


# step: a "cognito" "user" receives a "VALID" "JWT" token from the "cognito" "user pool"
# result: a "VALID" token will be issued that can be presented to API Gateway for authorization
# guard: the "cognito" "user" existed
# guard_violation: the "cognito" "user" did not exist
# guard: the "cognito" "user" was "CONFIRMED"
# guard_violation_lifecycle: the "cognito" "user" was not "CONFIRMED"
# guard: a "cognito" "token" "slot" was "available"
# guard_violation_capacity: no "cognito" "token" "slot" was "available"
atomic action IssueToken:
    oneof uid in USER_IDS:
        if uid in user_status:
            if user_status[uid] == "CONFIRMED":
                oneof tkid in TOKEN_IDS:
                    if tkid not in token_status:
                        token_status[tkid] = "VALID"
                        token_user[tkid] = uid
                        token_pool[tkid] = user_pool[uid]


# step: a request with a valid token from a "cognito" "user" in the "api gateway" "API"'s configured pool is authorized
# result: the "api gateway" "request" will be "AUTHORIZED" and routed to the backend
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a Cognito authorizer configured
# guard_violation: the "api gateway" "api" has no Cognito authorizer configured
# guard: a "VALID" "cognito" "token" existed
# guard_violation_lifecycle: no "VALID" "cognito" "token" existed
# guard: the "cognito" "token" belongs to a "CONFIRMED" "cognito" "user" in the "api gateway" "API"'s configured pool
# guard_violation_lifecycle: the "cognito" "token" does not belong to a "CONFIRMED" "cognito" "user" in the configured pool
# guard: a "api gateway" "request" "slot" was "available"
# guard_violation_capacity: no "api gateway" "request" "slot" was "available"
atomic action AuthorizeRequest:
    oneof rid in REQ_IDS:
        if rid not in req_status:
            oneof aid in API_IDS:
                if aid in api_status:
                    if api_status[aid] == "ACTIVE":
                        if api_pool[aid] != "":
                            pid = api_pool[aid]
                            oneof tkid in TOKEN_IDS:
                                if tkid in token_status:
                                    if token_status[tkid] == "VALID":
                                        uid = token_user[tkid]
                                        if uid in user_status:
                                            if user_status[uid] == "CONFIRMED":
                                                if user_pool[uid] == pid:
                                                    req_status[rid] = "AUTHORIZED"
                                                    req_api[rid] = aid
                                                    req_token[rid] = tkid


# step: a request with a valid token from a "cognito" "user" in a different pool is rejected
# result: the "api gateway" "request" will be "REJECTED" because the "cognito" "token" issuing "cognito" "user pool" does not match the configured authorizer
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a Cognito authorizer configured
# guard_violation: the "api gateway" "api" has no Cognito authorizer configured
# guard: a "VALID" "cognito" "token" existed from a "cognito" "user" in a different "cognito" "user pool" than the configured authorizer
# guard_violation_lifecycle: no such mismatched "cognito" "token" existed
# guard: a "api gateway" "request" "slot" was "available"
# guard_violation_capacity: no "api gateway" "request" "slot" was "available"
atomic action RejectRequest:
    oneof rid in REQ_IDS:
        if rid not in req_status:
            oneof aid in API_IDS:
                if aid in api_status:
                    if api_status[aid] == "ACTIVE":
                        if api_pool[aid] != "":
                            pid = api_pool[aid]
                            oneof tkid in TOKEN_IDS:
                                if tkid in token_status:
                                    if token_status[tkid] == "VALID":
                                        if token_pool[tkid] != pid:
                                            req_status[rid] = "REJECTED"
                                            req_api[rid] = aid
                                            req_token[rid] = tkid


# check: every "api gateway" "API" with a configured authorizer references an "ACTIVE" "cognito" "user pool"
always assertion AuthorizerRequiresActivePool:
    for aid in api_pool:
        if api_pool[aid] != "":
            pid = api_pool[aid]
            if pid in pool_status:
                if pool_status[pid] != "ACTIVE":
                    return False
    return True


# check: every "AUTHORIZED" "api gateway" "request" was validated against a "VALID" "token"
always assertion AuthorizedRequestRequiresValidToken:
    for rid in req_status:
        if req_status[rid] == "AUTHORIZED":
            tkid = req_token[rid]
            if tkid in token_status:
                if token_status[tkid] != "VALID":
                    return False
    return True


# check: every AUTHORIZED request's token belongs to a "cognito" "user" in the "api gateway" "API"'s configured pool
always assertion AuthorizedRequestRequiresPoolMembership:
    for rid in req_status:
        if req_status[rid] == "AUTHORIZED":
            aid = req_api[rid]
            tkid = req_token[rid]
            if aid in api_pool:
                pid = api_pool[aid]
                if tkid in token_pool:
                    if token_pool[tkid] != pid:
                        return False
    return True


# check: every REJECTED request's token belongs to a "cognito" "user" in a different pool than the configured authorizer
always assertion RejectedRequestHasMismatchedPool:
    for rid in req_status:
        if req_status[rid] == "REJECTED":
            aid = req_api[rid]
            tkid = req_token[rid]
            if aid in api_pool:
                pid = api_pool[aid]
                if tkid in token_pool:
                    if token_pool[tkid] == pid:
                        return False
    return True
