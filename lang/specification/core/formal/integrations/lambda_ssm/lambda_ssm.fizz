---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> SSM Parameter Store Integration Formal Specification
# Models a Lambda function reading a parameter from SSM Parameter Store during invocation.
# If the parameter has been deleted, the read fails and the invocation fails
# with a ParameterNotFound error.

FUNC_IDS = ["func-1"]
PARAM_IDS = ["param-1"]
INV_IDS = ["inv-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    param_status = {}           # param_status[pid] = "EXISTS" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_param = {}              # inv_param[iid] = param_id (parameter read during invocation)


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "ssm" "parameter" is created
# result: the parameter will exist and can be read by Lambda
# guard: the "ssm" "parameter" did not already exist
# guard_violation: the "ssm" "parameter" already existed
atomic action CreateParameter:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            param_status[pid] = "EXISTS"


# step: a "ssm" "parameter" is deleted
# result: the "ssm" "parameter" will be deleted and will cause a ParameterNotFound error when read
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" existed
# guard_violation_lifecycle: the parameter is already "DELETED"
atomic action DeleteParameter:
    oneof pid in PARAM_IDS:
        if pid in param_status:
            if param_status[pid] == "EXISTS":
                param_status[pid] = "DELETED"


# step: the "lambda" "function" is invoked
# result: the invocation will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no invocation slot is available
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" reads an existing parameter and completes successfully
# result: the invocation will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "ssm" "parameter" existed
# guard_violation_lifecycle: the "ssm" "parameter" did not exist or was "DELETED"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "EXISTS":
                            inv_status[iid] = "SUCCESS"
                            inv_param[iid] = pid


# fake_skip: internal
# step: the "lambda" "function" fails because the parameter has been deleted
# result: the invocation will be "FAILED" with a ParameterNotFound error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "ssm" "parameter" was "DELETED"
# guard_violation_lifecycle: the "ssm" "parameter" was not "DELETED"
atomic action InvocationFailsParameterNotFound:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "DELETED":
                            inv_status[iid] = "FAILED"
                            inv_param[iid] = pid


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every successful invocation recorded which parameter it read
# (verifies Lambda cannot succeed without reading a parameter; parameter may be deleted afterwards)
always assertion SuccessfulInvocationReadAParameter:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_param:
                return False
    return True
