---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> OpenSearch Integration Formal Specification
# Models a Lambda function indexing a document into an OpenSearch domain during invocation.
# The index must exist in the domain before a document can be indexed.

FUNC_IDS = ["func-1"]
DOMAIN_IDS = ["domain-1"]
INDEX_IDS = ["index-1"]
INV_IDS = ["inv-1"]
DOC_IDS = ["doc-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    domain_status = {}          # domain_status[did] = "ACTIVE"
    index_status = {}           # index_status[xid] = "EXISTS" | "DELETED"
    index_domain = {}           # index_domain[xid] = domain_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    doc_status = {}             # doc_status[docid] = "INDEXED" | "DELETED"
    doc_index = {}              # doc_index[docid] = index_id
    doc_inv = {}                # doc_inv[docid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: an "opensearch" "domain" is created
# result: the "opensearch" "domain" will be "ACTIVE"
# guard: the "opensearch" "domain" did not already exist
# guard_violation: the "opensearch" "domain" already existed
atomic action CreateDomain:
    oneof did in DOMAIN_IDS:
        if did not in domain_status:
            domain_status[did] = "ACTIVE"


# step: an "opensearch" "index" is created in the "opensearch" "domain"
# result: the "opensearch" "index" will exist and will be ready to receive documents
# guard: the "opensearch" "domain" existed
# guard_violation: the "opensearch" "domain" did not exist
# guard: the "opensearch" "domain" was "ACTIVE"
# guard_violation_lifecycle: the "opensearch" "domain" was not "ACTIVE"
# guard: the "opensearch" "index" did not already exist
# guard_violation: the "opensearch" "index" already existed
atomic action CreateIndex:
    oneof did in DOMAIN_IDS:
        if did in domain_status:
            if domain_status[did] == "ACTIVE":
                oneof xid in INDEX_IDS:
                    if xid not in index_status:
                        index_status[xid] = "EXISTS"
                        index_domain[xid] = did


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# step: the "lambda" "function" indexes a document into the OpenSearch index during invocation
# result: the "opensearch" "document" will be "INDEXED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "opensearch" "index" existed
# guard_violation_lifecycle: the "opensearch" "index" did not exist
# guard: the "opensearch" "index"'s domain was "ACTIVE"
# guard_violation_lifecycle: the "opensearch" "index"'s domain was not "ACTIVE"
# guard: a "document" "slot" was "available"
# guard_violation_capacity: no "opensearch" "document" "slot" was "available"
atomic action IndexDocument:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof xid in INDEX_IDS:
                    if xid in index_status:
                        if index_status[xid] == "EXISTS":
                            did = index_domain[xid]
                            if did in domain_status:
                                if domain_status[did] == "ACTIVE":
                                    oneof docid in DOC_IDS:
                                        if docid not in doc_status or doc_status[docid] == "DELETED":
                                            doc_status[docid] = "INDEXED"
                                            doc_index[docid] = xid
                                            doc_inv[docid] = iid


# fake_skip: internal
# step: the "lambda" "function" invocation completes successfully
# result: the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails
# result: the "lambda" "invocation" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "INDEXED" "opensearch" "document" belongs to an existing "opensearch" "index"
always assertion DocumentRequiresExistingIndex:
    for docid in doc_status:
        if doc_status[docid] == "INDEXED":
            xid = doc_index[docid]
            if xid in index_status:
                if index_status[xid] != "EXISTS":
                    return False
    return True


# check: every existing "opensearch" "index" belongs to an "ACTIVE" "opensearch" "domain"
always assertion IndexRequiresActiveDomain:
    for xid in index_status:
        if index_status[xid] == "EXISTS":
            did = index_domain[xid]
            if did in domain_status:
                if domain_status[did] != "ACTIVE":
                    return False
    return True
