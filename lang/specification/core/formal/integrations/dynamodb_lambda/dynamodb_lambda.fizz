---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# DynamoDB Streams -> Lambda Integration Formal Specification
# Models a Lambda event source mapping (ESM) polling a DynamoDB Stream and invoking a function.
# Failed invocations return the record to AVAILABLE for retry (stream ordering is preserved).

TABLE_IDS = ["table-1"]
FUNC_IDS = ["func-1"]
ESM_IDS = ["esm-1"]
RECORD_IDS = ["record-1"]
INV_IDS = ["inv-1"]


action Init:
    table_status = {}           # table_status[tid] = "ACTIVE"
    table_stream = {}           # table_stream[tid] = True if stream enabled
    func_status = {}            # func_status[fid] = "ACTIVE"
    esm_status = {}             # esm_status[eid] = "ENABLED" | "DISABLED"
    esm_func = {}               # esm_func[eid] = func_id
    esm_table = {}              # esm_table[eid] = table_id
    record_status = {}          # record_status[rid] = "AVAILABLE" | "PROCESSED"
    record_table = {}           # record_table[rid] = table_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_record = {}             # inv_record[iid] = record_id
    inv_esm = {}                # inv_esm[iid] = esm_id


# step: a DynamoDB table is created with streaming enabled
# result: the table is ACTIVE and its stream is ready to receive change records
# guard: the table does not already exist
# guard_violation: the table already exists
atomic action CreateTableWithStream:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"
            table_stream[tid] = True


# step: a Lambda function is deployed
# result: the function is ACTIVE
# guard: the function does not already exist
# guard_violation: the function already exists
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a Lambda event source mapping is created to process the DynamoDB Stream
# result: the event source mapping is ENABLED and will poll the stream for change records
# guard: the table exists
# guard_violation: the table does not exist
# guard: the table is ACTIVE
# guard_violation_lifecycle: the table is not ACTIVE
# guard: the table has a stream enabled
# guard_violation: the table does not have a stream enabled
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
# guard: the event source mapping does not already exist
# guard_violation: the event source mapping already exists
atomic action CreateEventSourceMapping:
    oneof eid in ESM_IDS:
        if eid not in esm_status:
            oneof tid in TABLE_IDS:
                if tid in table_status:
                    if table_status[tid] == "ACTIVE":
                        if table_stream[tid] == True:
                            oneof fid in FUNC_IDS:
                                if fid in func_status:
                                    if func_status[fid] == "ACTIVE":
                                        esm_status[eid] = "ENABLED"
                                        esm_table[eid] = tid
                                        esm_func[eid] = fid


# step: a change to the DynamoDB table produces a stream record
# result: a change record is AVAILABLE for the event source mapping to process
# guard: the table exists
# guard_violation: the table does not exist
# guard: the table is ACTIVE
# guard_violation_lifecycle: the table is not ACTIVE
# guard: the table has a stream enabled
# guard_violation: the table does not have a stream enabled
# guard: a record slot is available
# guard_violation_capacity: no record slot is available
atomic action TableChangeProducesRecord:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                if table_stream[tid] == True:
                    oneof rid in RECORD_IDS:
                        if rid not in record_status or record_status[rid] == "PROCESSED":
                            record_status[rid] = "AVAILABLE"
                            record_table[rid] = tid


# fake_skip: internal
# step: the event source mapping polls the stream and invokes the Lambda function with the record
# result: the record is being processed and a Lambda invocation is IN_PROGRESS
# guard: the event source mapping exists
# guard_violation: the event source mapping does not exist
# guard: the event source mapping is ENABLED
# guard_violation_lifecycle: the event source mapping is not ENABLED
# guard: the mapped function is ACTIVE
# guard_violation_lifecycle: the mapped function is not ACTIVE
# guard: an AVAILABLE record exists in the mapped table's stream
# guard_violation_lifecycle: no AVAILABLE record exists in the mapped table's stream
# guard: an invocation slot is available
# guard_violation_capacity: no invocation slot is available
atomic action ESMPollAndInvoke:
    oneof eid in ESM_IDS:
        if eid in esm_status:
            if esm_status[eid] == "ENABLED":
                fid = esm_func[eid]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        tid = esm_table[eid]
                        oneof rid in RECORD_IDS:
                            if rid in record_status:
                                if record_status[rid] == "AVAILABLE":
                                    if record_table[rid] == tid:
                                        oneof iid in INV_IDS:
                                            if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                                inv_status[iid] = "IN_PROGRESS"
                                                inv_record[iid] = rid
                                                inv_esm[iid] = eid


# fake_skip: internal
# step: the Lambda invocation processes the stream record successfully
# result: the invocation is SUCCESS and the record is PROCESSED
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_record[iid]
                inv_status[iid] = "SUCCESS"
                record_status[rid] = "PROCESSED"


# fake_skip: internal
# step: the Lambda invocation fails and the stream record is retried
# result: the invocation is FAILED and the record is AVAILABLE again for reprocessing
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_record[iid]
                inv_status[iid] = "FAILED"
                record_status[rid] = "AVAILABLE"


# check: every IN_PROGRESS invocation was initiated by an ENABLED event source mapping
always assertion InvocationRequiresEnabledESM:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            eid = inv_esm[iid]
            if eid in esm_status:
                if esm_status[eid] != "ENABLED":
                    return False
    return True


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            eid = inv_esm[iid]
            if eid in esm_func:
                fid = esm_func[eid]
                if fid in func_status:
                    if func_status[fid] != "ACTIVE":
                        return False
    return True


# check: every ENABLED event source mapping references an ACTIVE table with streaming enabled
always assertion ESMReferencesActiveStream:
    for eid in esm_status:
        if esm_status[eid] == "ENABLED":
            tid = esm_table[eid]
            if tid in table_status:
                if table_status[tid] != "ACTIVE":
                    return False
            if tid in table_stream:
                if table_stream[tid] != True:
                    return False
    return True
