---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# DynamoDB Streams -> Lambda Integration Formal Specification
# Models a Lambda event source mapping (ESM) polling a DynamoDB Stream and invoking a function.
# Failed invocations return the record to AVAILABLE for retry (stream ordering is preserved).

TABLE_IDS = ["table-1"]
FUNC_IDS = ["func-1"]
ESM_IDS = ["esm-1"]
RECORD_IDS = ["record-1"]
INV_IDS = ["inv-1"]


action Init:
    table_status = {}           # table_status[tid] = "ACTIVE"
    table_stream = {}           # table_stream[tid] = True if stream enabled
    func_status = {}            # func_status[fid] = "ACTIVE"
    esm_status = {}             # esm_status[eid] = "ENABLED" | "DISABLED"
    esm_func = {}               # esm_func[eid] = func_id
    esm_table = {}              # esm_table[eid] = table_id
    record_status = {}          # record_status[rid] = "AVAILABLE" | "PROCESSED"
    record_table = {}           # record_table[rid] = table_id
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_record = {}             # inv_record[iid] = record_id
    inv_esm = {}                # inv_esm[iid] = esm_id


# step: a "dynamodb" "table" is created with streaming enabled
# result: the "dynamodb" "table" will be "ACTIVE" and its stream will be ready to receive change records
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTableWithStream:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"
            table_stream[tid] = True


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "lambda" "event source mapping" is created to process the DynamoDB Stream
# result: the "lambda" "event source mapping" will be "ENABLED" and will poll the stream for change records
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: the "dynamodb" "table" has a stream enabled
# guard_violation: the "dynamodb" "table" does not have a stream enabled
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: the "lambda" "event source mapping" did not already exist
# guard_violation: the "lambda" "event source mapping" already existed
atomic action CreateEventSourceMapping:
    oneof eid in ESM_IDS:
        if eid not in esm_status:
            oneof tid in TABLE_IDS:
                if tid in table_status:
                    if table_status[tid] == "ACTIVE":
                        if table_stream[tid] == True:
                            oneof fid in FUNC_IDS:
                                if fid in func_status:
                                    if func_status[fid] == "ACTIVE":
                                        esm_status[eid] = "ENABLED"
                                        esm_table[eid] = tid
                                        esm_func[eid] = fid


# step: a change to the "dynamodb" "table" produces a stream record
# result: a "dynamodb" "change record" will be "AVAILABLE" for the "lambda" "event source mapping" to process
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" was not "ACTIVE"
# guard: the "dynamodb" "table" has a stream enabled
# guard_violation: the "dynamodb" "table" does not have a stream enabled
# guard: a "dynamodb" "record" "slot" was "available"
# guard_violation_capacity: no "dynamodb" "record" "slot" was "available"
atomic action TableChangeProducesRecord:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                if table_stream[tid] == True:
                    oneof rid in RECORD_IDS:
                        if rid not in record_status or record_status[rid] == "PROCESSED":
                            record_status[rid] = "AVAILABLE"
                            record_table[rid] = tid


# fake_skip: internal
# step: the event source mapping polls the stream and invokes the "lambda" "function" with the record
# result: the "dynamodb" "record" will be being processed and a "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "event source mapping" existed
# guard_violation: the "lambda" "event source mapping" did not exist
# guard: the "lambda" "event source mapping" was "ENABLED"
# guard_violation_lifecycle: the "lambda" "event source mapping" was not "ENABLED"
# guard: the mapped "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the mapped "lambda" "function" was not "ACTIVE"
# guard: an "AVAILABLE" "dynamodb" "record" existed in the mapped table's stream
# guard_violation_lifecycle: no "AVAILABLE" "dynamodb" "record" existed in the mapped table's stream
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action ESMPollAndInvoke:
    oneof eid in ESM_IDS:
        if eid in esm_status:
            if esm_status[eid] == "ENABLED":
                fid = esm_func[eid]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        tid = esm_table[eid]
                        oneof rid in RECORD_IDS:
                            if rid in record_status:
                                if record_status[rid] == "AVAILABLE":
                                    if record_table[rid] == tid:
                                        oneof iid in INV_IDS:
                                            if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                                inv_status[iid] = "IN_PROGRESS"
                                                inv_record[iid] = rid
                                                inv_esm[iid] = eid


# fake_skip: internal
# step: the "lambda" "function" invocation processes the "dynamodb" "stream" record successfully
# result: the "lambda" "invocation" will be "SUCCESS" and the "dynamodb" "record" will be "PROCESSED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_record[iid]
                inv_status[iid] = "SUCCESS"
                record_status[rid] = "PROCESSED"


# fake_skip: internal
# step: the "lambda" "function" invocation fails and the stream record is retried
# result: the "lambda" "invocation" will be "FAILED" and the "dynamodb" "record" will be "AVAILABLE" again for reprocessing
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_record[iid]
                inv_status[iid] = "FAILED"
                record_status[rid] = "AVAILABLE"


# check: every "IN_PROGRESS" "lambda" "function" invocation was initiated by an "ENABLED" "lambda" "event source mapping"
always assertion InvocationRequiresEnabledESM:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            eid = inv_esm[iid]
            if eid in esm_status:
                if esm_status[eid] != "ENABLED":
                    return False
    return True


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            eid = inv_esm[iid]
            if eid in esm_func:
                fid = esm_func[eid]
                if fid in func_status:
                    if func_status[fid] != "ACTIVE":
                        return False
    return True


# check: every "ENABLED" "lambda" "event source mapping" references an "ACTIVE" "dynamodb" "table" with streaming enabled
always assertion ESMReferencesActiveStream:
    for eid in esm_status:
        if esm_status[eid] == "ENABLED":
            tid = esm_table[eid]
            if tid in table_status:
                if table_status[tid] != "ACTIVE":
                    return False
            if tid in table_stream:
                if table_stream[tid] != True:
                    return False
    return True
