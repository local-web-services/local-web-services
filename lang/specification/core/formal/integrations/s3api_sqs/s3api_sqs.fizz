---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# S3 -> SQS Integration Formal Specification
# Models S3 bucket event notifications delivered to an SQS queue.
# When an object is uploaded to a bucket with a notification configuration,
# S3 sends a notification message to the target SQS queue.
# If the queue has been deleted, notification delivery fails silently.

BUCKET_IDS = ["bucket-1"]
QUEUE_IDS = ["queue-1"]
OBJ_IDS = ["obj-1"]
MSG_IDS = ["msg-1"]


action Init:
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    bucket_queue = {}           # bucket_queue[bid] = queue_id or "" (notification config)
    queue_status = {}           # queue_status[qid] = "ACTIVE" | "DELETED"
    obj_status = {}             # obj_status[oid] = "EXISTS"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    msg_status = {}             # msg_status[mid] = "QUEUED" | "DELETED"
    msg_queue = {}              # msg_queue[mid] = queue_id
    msg_obj = {}                # msg_obj[mid] = obj_id


# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE" with no notification configuration
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"
            bucket_queue[bid] = ""


# step: a "sqs" "queue" is created
# result: the "sqs" "queue" will be "ACTIVE"
# guard: the "sqs" "queue" did not already exist
# guard_violation: the "sqs" "queue" already existed
atomic action CreateQueue:
    oneof qid in QUEUE_IDS:
        if qid not in queue_status:
            queue_status[qid] = "ACTIVE"


# step: the "sqs" "queue" is deleted
# result: the "sqs" "queue" will be deleted and notification delivery to it will fail
# guard: the "sqs" "queue" existed
# guard_violation: the "sqs" "queue" did not exist
# guard: the "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the "sqs" "queue" is already "DELETED"
atomic action DeleteQueue:
    oneof qid in QUEUE_IDS:
        if qid in queue_status:
            if queue_status[qid] == "ACTIVE":
                queue_status[qid] = "DELETED"


# step: an "sqs" notification configuration is added to the "s3" "bucket"
# result: the "s3" "bucket" will send "sqs" notifications to the "sqs" "queue" when "s3" "objects" are uploaded
# guard: the "s3" "bucket" existed and was "ACTIVE"
# guard_violation: the "s3" "bucket" did not exist or was "ACTIVE"
# guard: the "s3" "bucket" has no notification configuration
# guard_violation: the "s3" "bucket" already has a notification configuration
# guard: the "sqs" "queue" existed and was "ACTIVE"
# guard_violation: the "sqs" "queue" did not exist or was "ACTIVE"
atomic action ConfigureNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_queue[bid] == "":
                    oneof qid in QUEUE_IDS:
                        if qid in queue_status:
                            if queue_status[qid] == "ACTIVE":
                                bucket_queue[bid] = qid


# step: an object is uploaded to the bucket and S3 delivers a notification to the "sqs" "queue"
# result: the "s3" "object" will exist and a "sqs" notification "message" will be "QUEUED"
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has a notification configuration
# guard_violation: the "s3" "bucket" has no notification configuration
# guard: the target "sqs" "queue" was "ACTIVE"
# guard_violation_lifecycle: the target "sqs" "queue" was "DELETED"
# guard: a "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
# guard: a "sqs" "message" "slot" was "available"
# guard_violation_capacity: no "sqs" "message" "slot" was "available"
atomic action PutObjectWithNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_queue[bid] != "":
                    qid = bucket_queue[bid]
                    if qid in queue_status:
                        if queue_status[qid] == "ACTIVE":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    oneof mid in MSG_IDS:
                                        if mid not in msg_status:
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            msg_status[mid] = "QUEUED"
                                            msg_queue[mid] = qid
                                            msg_obj[mid] = oid


# step: an "s3" "object" is uploaded but "sqs" notification delivery fails because the "sqs" "queue" has been deleted
# result: the "s3" "object" will exist but no "sqs" notification "message" will be delivered
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has a notification configuration
# guard_violation: the "s3" "bucket" has no notification configuration
# guard: the target "sqs" "queue" was "DELETED"
# guard_violation_lifecycle: the target "sqs" "queue" was not "DELETED"
# guard: a "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
atomic action PutObjectNotificationFails:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_queue[bid] != "":
                    qid = bucket_queue[bid]
                    if qid in queue_status:
                        if queue_status[qid] == "DELETED":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    obj_status[oid] = "EXISTS"
                                    obj_bucket[oid] = bid


# check: every "QUEUED" "sqs" "message" references an "s3" "object" that exists
always assertion QueuedMessageReferencesExistingObject:
    for mid in msg_status:
        if msg_status[mid] == "QUEUED":
            oid = msg_obj[mid]
            if oid not in obj_status:
                return False
    return True


# check: every "QUEUED" "sqs" "message" references an "sqs" "queue" that exists
always assertion QueuedMessageReferencesExistingQueue:
    for mid in msg_status:
        if msg_status[mid] == "QUEUED":
            qid = msg_queue[mid]
            if qid not in queue_status:
                return False
    return True
