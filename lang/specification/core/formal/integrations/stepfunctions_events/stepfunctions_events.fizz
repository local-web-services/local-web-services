---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Step Functions -> EventBridge Integration Formal Specification
# Models Step Functions automatically publishing execution state change events
# to an EventBridge event bus. When an execution starts, succeeds, or fails,
# Step Functions sends an event to the configured bus.
# If the bus has been deleted, event delivery fails but the execution still completes.

SM_IDS = ["sm-1"]
BUS_IDS = ["bus-1"]
EXEC_IDS = ["exec-1"]
EVENT_IDS = ["event-1", "event-2"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    sm_bus = {}                 # sm_bus[smid] = bus_id or "" (EventBridge config)
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    event_status = {}           # event_status[evid] = "DELIVERED" | "UNDELIVERED"
    event_exec = {}             # event_exec[evid] = exec_id
    event_type = {}             # event_type[evid] = "STARTED" | "SUCCEEDED" | "FAILED"


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE" with no EventBridge bus configured
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"
            sm_bus[smid] = ""


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the "eventbridge" "bus" is deleted
# result: the "eventbridge" "bus" will be deleted and execution event delivery will fail
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# step: the "step functions" "state machine" is configured to publish execution events to the "eventbridge" "bus"
# result: the "step functions" "state machine" will send execution state change "eventbridge" "events" to the "eventbridge" "bus"
# guard: the "step functions" "state machine" existed and was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" did not exist or was "ACTIVE"
# guard: the "step functions" "state machine" has no "eventbridge" "bus" configured
# guard_violation: the "step functions" "state machine" already has an "eventbridge" "bus" configured
# guard: the "eventbridge" "bus" existed and was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" did not exist or was "ACTIVE"
atomic action ConfigureEventPublishing:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_bus[smid] == "":
                    oneof busid in BUS_IDS:
                        if busid in bus_status:
                            if bus_status[busid] == "ACTIVE":
                                sm_bus[smid] = busid


# step: a "step functions" "execution" starts and "step functions" delivers a "STARTED" event to the "eventbridge" "bus"
# result: the "step functions" "execution" will be "RUNNING" and the STARTED event will be "DELIVERED"
# guard: the "step functions" "state machine" existed and was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" did not exist or was "ACTIVE"
# guard: the "step functions" "state machine" has an "eventbridge" "bus" configured
# guard_violation: the "step functions" "state machine" has no "eventbridge" "bus" configured
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was "DELETED"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action StartExecutionEventDelivered:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_bus[smid] != "":
                    busid = sm_bus[smid]
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EXEC_IDS:
                                if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                    oneof evid in EVENT_IDS:
                                        if evid not in event_status:
                                            exec_status[eid] = "RUNNING"
                                            exec_sm[eid] = smid
                                            event_status[evid] = "DELIVERED"
                                            event_exec[evid] = eid
                                            event_type[evid] = "STARTED"


# step: a "step functions" "execution" starts but the "STARTED" "eventbridge" "event" delivery fails because the "eventbridge" "bus" is deleted
# result: the "step functions" "execution" will be "RUNNING" but no STARTED event will be delivered
# guard: the "step functions" "state machine" existed and was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" did not exist or was "ACTIVE"
# guard: the "step functions" "state machine" has an "eventbridge" "bus" configured
# guard_violation: the "step functions" "state machine" has no "eventbridge" "bus" configured
# guard: the "eventbridge" "bus" was "DELETED"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "DELETED"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecutionEventFails:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                if sm_bus[smid] != "":
                    busid = sm_bus[smid]
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            oneof eid in EXEC_IDS:
                                if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                    exec_status[eid] = "RUNNING"
                                    exec_sm[eid] = smid


# step: a running "step functions" "execution" succeeds and Step Functions delivers a SUCCEEDED event to the bus
# result: the "step functions" "execution" will be "SUCCEEDED" and the "SUCCEEDED" event will be "DELIVERED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" was "DELETED"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action ExecutionSucceedsEventDelivered:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_bus:
                    busid = sm_bus[smid]
                    if busid != "":
                        if busid in bus_status:
                            if bus_status[busid] == "ACTIVE":
                                oneof evid in EVENT_IDS:
                                    if evid not in event_status:
                                        exec_status[eid] = "SUCCEEDED"
                                        event_status[evid] = "DELIVERED"
                                        event_exec[evid] = eid
                                        event_type[evid] = "SUCCEEDED"


# step: a running "step functions" "execution" succeeds but the SUCCEEDED event delivery fails because the bus is deleted
# result: the "step functions" "execution" will be "SUCCEEDED" but no "SUCCEEDED" event will be delivered
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "eventbridge" "bus" was "DELETED"
# guard_violation_lifecycle: the "eventbridge" "bus" was not "DELETED"
atomic action ExecutionSucceedsEventFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                smid = exec_sm[eid]
                if smid in sm_bus:
                    busid = sm_bus[smid]
                    if busid != "":
                        if busid in bus_status:
                            if bus_status[busid] == "DELETED":
                                exec_status[eid] = "SUCCEEDED"


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every "DELIVERED" "eventbridge" "event" references a "step functions" "execution" that exists
always assertion DeliveredEventReferencesExistingExecution:
    for evid in event_status:
        if event_status[evid] == "DELIVERED":
            eid = event_exec[evid]
            if eid not in exec_status:
                return False
    return True
