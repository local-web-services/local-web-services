---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Lambda -> Step Functions Integration Formal Specification
# Models a Lambda function starting a Step Functions state machine execution.
# If the state machine has been deleted, StartExecution fails with a StateMachineDoesNotExist error.

FUNC_IDS = ["func-1"]
SM_IDS = ["sm-1"]
INV_IDS = ["inv-1"]
EXEC_IDS = ["exec-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    sm_status = {}              # sm_status[smid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_inv = {}               # exec_inv[eid] = inv_id (invocation that started this execution)


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "step functions" "state machine" is deleted
# result: the "step functions" "state machine" will be deleted and Lambda StartExecution calls will fail
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" is already "DELETED"
atomic action DeleteStateMachine:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                sm_status[smid] = "DELETED"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" starts an execution of an ACTIVE state machine and succeeds
# result: the "step functions" "execution" will be "RUNNING" and the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" did not exist or was "DELETED"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action StartExecutionTask:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof smid in SM_IDS:
                    if smid in sm_status:
                        if sm_status[smid] == "ACTIVE":
                            oneof eid in EXEC_IDS:
                                if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                    exec_status[eid] = "RUNNING"
                                    exec_sm[eid] = smid
                                    exec_inv[eid] = iid
                                    inv_status[iid] = "SUCCESS"


# step: the "lambda" "function" fails to start an execution because the state machine has been deleted
# result: the "lambda" "invocation" will be "FAILED" with a StateMachineDoesNotExist error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "step functions" "state machine" was "DELETED"
# guard_violation_lifecycle: the "step functions" "state machine" was not "DELETED"
atomic action InvocationFailsStateMachineDeleted:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof smid in SM_IDS:
                    if smid in sm_status:
                        if sm_status[smid] == "DELETED":
                            inv_status[iid] = "FAILED"


# fake_skip: internal
# step: a running "step functions" "execution" completes successfully
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
atomic action ExecutionCompletes:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                exec_status[eid] = "SUCCEEDED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every "RUNNING" "step functions" "execution" references a "step functions" "state machine" that exists
# (state machine may be deleted after execution starts; execution continues until terminal state)
always assertion RunningExecutionReferencesExistingStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid not in sm_status:
                return False
    return True
