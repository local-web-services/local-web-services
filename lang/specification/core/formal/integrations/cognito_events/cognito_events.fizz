---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Cognito IdP -> EventBridge Integration Formal Specification
# Models Cognito user pool events (sign-in, sign-up, etc.) being published
# to an EventBridge event bus. When a user action occurs in an ACTIVE pool,
# Cognito sends an event to the configured event bus.
# If the bus has been deleted, event delivery fails silently.

POOL_IDS = ["pool-1"]
BUS_IDS = ["bus-1"]
EVENT_IDS = ["event-1"]


action Init:
    pool_status = {}            # pool_status[pid] = "ACTIVE" | "DELETED"
    pool_bus = {}               # pool_bus[pid] = bus_id or "" (EventBridge config)
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    event_status = {}           # event_status[eid] = "DELIVERED" | "FAILED"
    event_pool = {}             # event_pool[eid] = pool_id
    event_bus = {}              # event_bus[eid] = bus_id


# step: a "cognito" "user pool" is created
# result: the "cognito" "user pool" will be "ACTIVE" with no EventBridge configuration
# guard: the "cognito" "user pool" did not already exist
# guard_violation: the "cognito" "user pool" already existed
atomic action CreateUserPool:
    oneof pid in POOL_IDS:
        if pid not in pool_status:
            pool_status[pid] = "ACTIVE"
            pool_bus[pid] = ""


# step: an EventBridge event bus is created
# result: the bus will be "ACTIVE"
# guard: the bus did not already exist
# guard_violation: the bus already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the EventBridge event bus is deleted
# result: the bus will be deleted and Cognito event delivery will fail
# guard: the bus existed
# guard_violation: the bus did not exist
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# step: EventBridge publishing was "ENABLED" on the "cognito" "user" pool
# result: the "cognito" "user pool" will send user events to the bus
# guard: the "cognito" "user pool" existed and was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" did not exist or was "ACTIVE"
# guard: the "cognito" "user pool" has no EventBridge configuration
# guard_violation: the "cognito" "user pool" already has an EventBridge configuration
# guard: the bus existed and was "ACTIVE"
# guard_violation: the bus did not exist or was "ACTIVE"
atomic action EnableEventPublishing:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_bus[pid] == "":
                    oneof busid in BUS_IDS:
                        if busid in bus_status:
                            if bus_status[busid] == "ACTIVE":
                                pool_bus[pid] = busid


# fake_skip: internal
# step: a "cognito" "user" action occurs in the "cognito" "user pool" and Cognito delivers the event to the EventBridge bus
# result: the event will be "DELIVERED" to the bus
# guard: the "cognito" "user pool" existed and was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" did not exist or was "ACTIVE"
# guard: the "cognito" "user pool" has an EventBridge configuration
# guard_violation: the "cognito" "user pool" has no EventBridge configuration
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus was "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action UserActionDelivered:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_bus[pid] != "":
                    busid = pool_bus[pid]
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    event_status[eid] = "DELIVERED"
                                    event_pool[eid] = pid
                                    event_bus[eid] = busid


# fake_skip: internal
# step: a "cognito" "user" action occurs but event delivery fails because the bus has been deleted
# result: the event delivery "FAILED"
# guard: the "cognito" "user pool" existed and was "ACTIVE"
# guard_violation_lifecycle: the "cognito" "user pool" did not exist or was "ACTIVE"
# guard: the "cognito" "user pool" has an EventBridge configuration
# guard_violation: the "cognito" "user pool" has no EventBridge configuration
# guard: the bus was "DELETED"
# guard_violation_lifecycle: the bus was not "DELETED"
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action UserActionDeliveryFails:
    oneof pid in POOL_IDS:
        if pid in pool_status:
            if pool_status[pid] == "ACTIVE":
                if pool_bus[pid] != "":
                    busid = pool_bus[pid]
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            oneof eid in EVENT_IDS:
                                if eid not in event_status:
                                    event_status[eid] = "FAILED"
                                    event_pool[eid] = pid
                                    event_bus[eid] = busid


# check: every DELIVERED event references a "cognito" "user pool" that exists
always assertion DeliveredEventReferencesExistingPool:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            pid = event_pool[eid]
            if pid not in pool_status:
                return False
    return True


# check: every DELIVERED event references a bus that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
