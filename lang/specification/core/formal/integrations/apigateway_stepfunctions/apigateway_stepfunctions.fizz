---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> Step Functions Integration Formal Specification
# Models a REST API that synchronously starts a Step Functions Express Workflow execution.
# The API waits for the execution to complete and returns the result to the caller.

API_IDS = ["api-1"]
SM_IDS = ["sm-1"]
REQ_IDS = ["req-1"]
EXEC_IDS = ["exec-1"]


action Init:
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_sm = {}                 # api_sm[aid] = sm_id or "" (integrated state machine)
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    req_status = {}             # req_status[rid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_req = {}               # exec_req[eid] = request_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no Step Functions integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_sm[aid] = ""


# step: a "step functions" "Express Workflow state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a Step Functions direct integration is configured on the "api gateway" "api"
# result: the "api gateway" "API" will synchronously start and await an Express Workflow execution per request
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "API" had no integration configured
# guard_violation: the "api gateway" "API" already had an "api gateway" "integration" configured
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
atomic action ConfigureIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_sm[aid] == "":
                    oneof smid in SM_IDS:
                        if smid in sm_status:
                            if sm_status[smid] == "ACTIVE":
                                api_sm[aid] = smid


# step: the "api gateway" "API" receives a HTTP request and synchronously starts a Step Functions execution
# result: the "api gateway" "request" will be "IN_PROGRESS" and the "step functions" "execution" will be "RUNNING"
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "api" has a Step Functions integration configured
# guard_violation: the "api gateway" "api" has no Step Functions integration configured
# guard: the integrated "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the integrated "step functions" "state machine" was not "ACTIVE"
# guard: a "api gateway" "request" "slot" was "available"
# guard_violation_capacity: no "api gateway" "request" "slot" was "available"
# guard: a "step functions" "execution" "slot" was "available"
# guard_violation_capacity: no "step functions" "execution" "slot" was "available"
atomic action HandleRequest:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_sm[aid] != "":
                    smid = api_sm[aid]
                    if smid in sm_status:
                        if sm_status[smid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status or req_status[rid] == "SUCCESS" or req_status[rid] == "FAILED":
                                    oneof eid in EXEC_IDS:
                                        if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                                            req_status[rid] = "IN_PROGRESS"
                                            req_api[rid] = aid
                                            exec_status[eid] = "RUNNING"
                                            exec_req[eid] = rid


# fake_skip: internal
# step: the Step Functions execution completes successfully and the "api gateway" "API" returns a successful response
# result: the "step functions" "execution" will be "SUCCEEDED" and the "api gateway" "request" will be "SUCCESS"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
atomic action ExecutionSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                rid = exec_req[eid]
                exec_status[eid] = "SUCCEEDED"
                req_status[rid] = "SUCCESS"


# fake_skip: internal
# step: the Step Functions execution fails and the "api gateway" "API" returns an error response
# result: the "step functions" "execution" will be "FAILED" and the "api gateway" "request" will be "FAILED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation_lifecycle: no "step functions" "execution" was "RUNNING"
atomic action ExecutionFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                rid = exec_req[eid]
                exec_status[eid] = "FAILED"
                req_status[rid] = "FAILED"


# check: every "IN_PROGRESS" "api gateway" "request" references an "ACTIVE" "api gateway" "API"
always assertion RequestRequiresActiveApi:
    for rid in req_status:
        if req_status[rid] == "IN_PROGRESS":
            aid = req_api[rid]
            if aid in api_status:
                if api_status[aid] != "ACTIVE":
                    return False
    return True


# check: every "RUNNING" "step functions" "execution" references an "ACTIVE" "step functions" "state machine"
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            rid = exec_req[eid]
            if rid in req_api:
                aid = req_api[rid]
                if aid in api_sm:
                    smid = api_sm[aid]
                    if smid in sm_status:
                        if sm_status[smid] != "ACTIVE":
                            return False
    return True


# check: every "RUNNING" "step functions" "execution" has a corresponding "IN_PROGRESS" "api gateway" "request"
always assertion ExecutionLinkedToRequest:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            rid = exec_req[eid]
            if rid in req_status:
                if req_status[rid] != "IN_PROGRESS":
                    return False
    return True
