---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# S3 -> EventBridge Integration Formal Specification
# Models S3 bucket event notifications delivered to an EventBridge event bus.
# When an object is uploaded to a bucket with EventBridge notifications enabled,
# S3 sends an event to the target event bus.
# If the event bus has been deleted, notification delivery fails silently.

BUCKET_IDS = ["bucket-1"]
BUS_IDS = ["bus-1"]
OBJ_IDS = ["obj-1"]
EVENT_IDS = ["event-1"]


action Init:
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    bucket_bus = {}             # bucket_bus[bid] = bus_id or "" (EventBridge notification config)
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    obj_status = {}             # obj_status[oid] = "EXISTS"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    event_status = {}           # event_status[eid] = "DELIVERED" | "DELETED"
    event_bus = {}              # event_bus[eid] = bus_id
    event_obj = {}              # event_obj[eid] = obj_id


# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE" with no EventBridge notification configuration
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"
            bucket_bus[bid] = ""


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the "eventbridge" "bus" is deleted
# result: the "eventbridge" "bus" will be deleted and event delivery to it will fail
# guard: the "eventbridge" "bus" existed
# guard_violation: the "eventbridge" "bus" did not exist
# guard: the "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the "eventbridge" "bus" is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# step: "eventbridge" notifications are enabled on the "s3" "bucket" targeting a specific "eventbridge" "bus"
# result: the "s3" "bucket" will send "eventbridge" "events" to the "eventbridge" "bus" when "s3" "objects" are uploaded
# guard: the "s3" "bucket" existed and was "ACTIVE"
# guard_violation: the "s3" "bucket" did not exist or was "ACTIVE"
# guard: the "s3" "bucket" has no "eventbridge" notification configured
# guard_violation: the "s3" "bucket" already has an "eventbridge" notification configured
# guard: the "eventbridge" "bus" existed and was "ACTIVE"
# guard_violation: the "eventbridge" "bus" did not exist or was "ACTIVE"
atomic action EnableEventBridgeNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] == "":
                    oneof busid in BUS_IDS:
                        if busid in bus_status:
                            if bus_status[busid] == "ACTIVE":
                                bucket_bus[bid] = busid


# step: an "s3" "object" is uploaded and "s3" delivers an "eventbridge" "event" to the "eventbridge" "bus"
# result: the "s3" "object" will exist and an "eventbridge" "event" will be "DELIVERED" to the "eventbridge" "bus"
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has an "eventbridge" notification configured
# guard_violation: the "s3" "bucket" has no "eventbridge" notification configured
# guard: the target "eventbridge" "bus" was "ACTIVE"
# guard_violation_lifecycle: the target "eventbridge" "bus" was "DELETED"
# guard: an "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action PutObjectWithEvent:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] != "":
                    busid = bucket_bus[bid]
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    oneof eid in EVENT_IDS:
                                        if eid not in event_status:
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            event_status[eid] = "DELIVERED"
                                            event_bus[eid] = busid
                                            event_obj[eid] = oid


# step: an "s3" "object" is uploaded but "eventbridge" "event" delivery fails because the "eventbridge" "bus" has been deleted
# result: the "s3" "object" will exist but no "eventbridge" "event" will be delivered
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has an "eventbridge" notification configured
# guard_violation: the "s3" "bucket" has no "eventbridge" notification configured
# guard: the target "eventbridge" "bus" was "DELETED"
# guard_violation_lifecycle: the target "eventbridge" "bus" was not "DELETED"
# guard: an "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
atomic action PutObjectEventFails:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] != "":
                    busid = bucket_bus[bid]
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    obj_status[oid] = "EXISTS"
                                    obj_bucket[oid] = bid


# check: every "DELIVERED" "eventbridge" "event" references an "s3" "object" that exists
always assertion DeliveredEventReferencesExistingObject:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            oid = event_obj[eid]
            if oid not in obj_status:
                return False
    return True


# check: every "DELIVERED" "eventbridge" "event" references a "eventbridge" "bus" that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
