---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# S3 -> EventBridge Integration Formal Specification
# Models S3 bucket event notifications delivered to an EventBridge event bus.
# When an object is uploaded to a bucket with EventBridge notifications enabled,
# S3 sends an event to the target event bus.
# If the event bus has been deleted, notification delivery fails silently.

BUCKET_IDS = ["bucket-1"]
BUS_IDS = ["bus-1"]
OBJ_IDS = ["obj-1"]
EVENT_IDS = ["event-1"]


action Init:
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    bucket_bus = {}             # bucket_bus[bid] = bus_id or "" (EventBridge notification config)
    bus_status = {}             # bus_status[busid] = "ACTIVE" | "DELETED"
    obj_status = {}             # obj_status[oid] = "EXISTS"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    event_status = {}           # event_status[eid] = "DELIVERED" | "DELETED"
    event_bus = {}              # event_bus[eid] = bus_id
    event_obj = {}              # event_obj[eid] = obj_id


# step: a "s3" "bucket" is created
# result: the bucket will be "ACTIVE" with no EventBridge notification configuration
# guard: the bucket did not already exist
# guard_violation: the bucket already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"
            bucket_bus[bid] = ""


# step: an EventBridge event bus is created
# result: the bus will be "ACTIVE"
# guard: the bus did not already exist
# guard_violation: the bus already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: the EventBridge event bus is deleted
# result: the bus will be deleted and event delivery to it will fail
# guard: the bus existed
# guard_violation: the bus did not exist
# guard: the bus was "ACTIVE"
# guard_violation_lifecycle: the bus is already "DELETED"
atomic action DeleteEventBus:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                bus_status[busid] = "DELETED"


# step: EventBridge notifications are enabled on the bucket targeting a specific bus
# result: the bucket will send events to the bus when objects are uploaded
# guard: the bucket existed and was "ACTIVE"
# guard_violation: the bucket did not exist or was "ACTIVE"
# guard: the bucket has no EventBridge notification configured
# guard_violation: the bucket already has an EventBridge notification configured
# guard: the bus existed and was "ACTIVE"
# guard_violation: the bus did not exist or was "ACTIVE"
atomic action EnableEventBridgeNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] == "":
                    oneof busid in BUS_IDS:
                        if busid in bus_status:
                            if bus_status[busid] == "ACTIVE":
                                bucket_bus[bid] = busid


# step: an object is uploaded and S3 delivers an event to the EventBridge bus
# result: the object will exist and an event will be "DELIVERED" to the bus
# guard: the bucket was "ACTIVE"
# guard_violation_lifecycle: the bucket was not "ACTIVE"
# guard: the bucket has an EventBridge notification configured
# guard_violation: the bucket has no EventBridge notification configured
# guard: the target bus was "ACTIVE"
# guard_violation_lifecycle: the target bus was "DELETED"
# guard: an object slot is available
# guard_violation_capacity: no object slot is available
# guard: an event slot is available
# guard_violation_capacity: no event slot is available
atomic action PutObjectWithEvent:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] != "":
                    busid = bucket_bus[bid]
                    if busid in bus_status:
                        if bus_status[busid] == "ACTIVE":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    oneof eid in EVENT_IDS:
                                        if eid not in event_status:
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            event_status[eid] = "DELIVERED"
                                            event_bus[eid] = busid
                                            event_obj[eid] = oid


# step: an object is uploaded but event delivery fails because the bus has been deleted
# result: the object will exist but no event will be delivered
# guard: the bucket was "ACTIVE"
# guard_violation_lifecycle: the bucket was not "ACTIVE"
# guard: the bucket has an EventBridge notification configured
# guard_violation: the bucket has no EventBridge notification configured
# guard: the target bus was "DELETED"
# guard_violation_lifecycle: the target bus was not "DELETED"
# guard: an object slot is available
# guard_violation_capacity: no object slot is available
atomic action PutObjectEventFails:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_bus[bid] != "":
                    busid = bucket_bus[bid]
                    if busid in bus_status:
                        if bus_status[busid] == "DELETED":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    obj_status[oid] = "EXISTS"
                                    obj_bucket[oid] = bid


# check: every DELIVERED event references an object that exists
always assertion DeliveredEventReferencesExistingObject:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            oid = event_obj[eid]
            if oid not in obj_status:
                return False
    return True


# check: every DELIVERED event references a bus that exists
always assertion DeliveredEventReferencesExistingBus:
    for eid in event_status:
        if event_status[eid] == "DELIVERED":
            busid = event_bus[eid]
            if busid not in bus_status:
                return False
    return True
