---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# S3 -> SNS Integration Formal Specification
# Models S3 bucket event notifications delivered to an SNS topic.
# When an object is uploaded to a bucket with a notification configuration,
# S3 publishes a notification to the target SNS topic.
# If the topic has been deleted, notification delivery fails silently.

BUCKET_IDS = ["bucket-1"]
TOPIC_IDS = ["topic-1"]
OBJ_IDS = ["obj-1"]
MSG_IDS = ["msg-1"]


action Init:
    bucket_status = {}          # bucket_status[bid] = "ACTIVE"
    bucket_topic = {}           # bucket_topic[bid] = topic_id or "" (notification config)
    topic_status = {}           # topic_status[tid] = "ACTIVE" | "DELETED"
    obj_status = {}             # obj_status[oid] = "EXISTS"
    obj_bucket = {}             # obj_bucket[oid] = bucket_id
    msg_status = {}             # msg_status[mid] = "PUBLISHED" | "DELETED"
    msg_topic = {}              # msg_topic[mid] = topic_id
    msg_obj = {}                # msg_obj[mid] = obj_id


# step: a "s3" "bucket" is created
# result: the "s3" "bucket" will be "ACTIVE" with no notification configuration
# guard: the "s3" "bucket" did not already exist
# guard_violation: the "s3" "bucket" already existed
atomic action CreateBucket:
    oneof bid in BUCKET_IDS:
        if bid not in bucket_status:
            bucket_status[bid] = "ACTIVE"
            bucket_topic[bid] = ""


# step: a "sns" "topic" is created
# result: the "sns" "topic" will be "ACTIVE"
# guard: the "sns" "topic" did not already exist
# guard_violation: the "sns" "topic" already existed
atomic action CreateTopic:
    oneof tid in TOPIC_IDS:
        if tid not in topic_status:
            topic_status[tid] = "ACTIVE"


# step: the "sns" "topic" is deleted
# result: the "sns" "topic" will be deleted and notification delivery to it will fail
# guard: the "sns" "topic" existed
# guard_violation: the "sns" "topic" did not exist
# guard: the "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the "sns" "topic" is already "DELETED"
atomic action DeleteTopic:
    oneof tid in TOPIC_IDS:
        if tid in topic_status:
            if topic_status[tid] == "ACTIVE":
                topic_status[tid] = "DELETED"


# step: a "sns" notification configuration is added to the "s3" "bucket"
# result: the "s3" "bucket" will publish "sns" notifications to the "sns" "topic" when "s3" "objects" are uploaded
# guard: the "s3" "bucket" existed and was "ACTIVE"
# guard_violation: the "s3" "bucket" did not exist or was "ACTIVE"
# guard: the "s3" "bucket" has no notification configuration
# guard_violation: the "s3" "bucket" already has a notification configuration
# guard: the "sns" "topic" existed and was "ACTIVE"
# guard_violation: the "sns" "topic" did not exist or was "ACTIVE"
atomic action ConfigureNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_topic[bid] == "":
                    oneof tid in TOPIC_IDS:
                        if tid in topic_status:
                            if topic_status[tid] == "ACTIVE":
                                bucket_topic[bid] = tid


# step: an object is uploaded and S3 publishes a notification to the "sns" "topic"
# result: the "s3" "object" will exist and a "sns" notification will be "PUBLISHED" to the "sns" "topic"
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has a notification configuration
# guard_violation: the "s3" "bucket" has no notification configuration
# guard: the target "sns" "topic" was "ACTIVE"
# guard_violation_lifecycle: the target "sns" "topic" was "DELETED"
# guard: a "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
# guard: a "sns" "message" "slot" was "available"
# guard_violation_capacity: no "sns" "message" "slot" was "available"
atomic action PutObjectWithNotification:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_topic[bid] != "":
                    tid = bucket_topic[bid]
                    if tid in topic_status:
                        if topic_status[tid] == "ACTIVE":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    oneof mid in MSG_IDS:
                                        if mid not in msg_status:
                                            obj_status[oid] = "EXISTS"
                                            obj_bucket[oid] = bid
                                            msg_status[mid] = "PUBLISHED"
                                            msg_topic[mid] = tid
                                            msg_obj[mid] = oid


# step: an "s3" "object" is uploaded but "sns" notification delivery fails because the "sns" "topic" has been deleted
# result: the "s3" "object" will exist but no "sns" notification will be published
# guard: the "s3" "bucket" was "ACTIVE"
# guard_violation_lifecycle: the "s3" "bucket" was not "ACTIVE"
# guard: the "s3" "bucket" has a notification configuration
# guard_violation: the "s3" "bucket" has no notification configuration
# guard: the target "sns" "topic" was "DELETED"
# guard_violation_lifecycle: the target "sns" "topic" was not "DELETED"
# guard: a "s3" "object" "slot" was "available"
# guard_violation_capacity: no "s3" "object" "slot" was "available"
atomic action PutObjectNotificationFails:
    oneof bid in BUCKET_IDS:
        if bid in bucket_status:
            if bucket_status[bid] == "ACTIVE":
                if bucket_topic[bid] != "":
                    tid = bucket_topic[bid]
                    if tid in topic_status:
                        if topic_status[tid] == "DELETED":
                            oneof oid in OBJ_IDS:
                                if oid not in obj_status:
                                    obj_status[oid] = "EXISTS"
                                    obj_bucket[oid] = bid


# check: every "PUBLISHED" "sns" notification references an "s3" "object" that exists
always assertion PublishedNotificationReferencesExistingObject:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            oid = msg_obj[mid]
            if oid not in obj_status:
                return False
    return True


# check: every "PUBLISHED" "sns" notification references an "sns" "topic" that exists
always assertion PublishedNotificationReferencesExistingTopic:
    for mid in msg_status:
        if msg_status[mid] == "PUBLISHED":
            tid = msg_topic[mid]
            if tid not in topic_status:
                return False
    return True
