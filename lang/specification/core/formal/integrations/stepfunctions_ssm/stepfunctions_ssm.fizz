---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> SSM Parameter Store Integration Formal Specification
# Models a Step Functions state machine reading an SSM parameter as a task step.
# If the parameter has been deleted the task fails and the execution fails.

SM_IDS = ["sm-1"]
PARAM_IDS = ["param-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    param_status = {}           # param_status[pid] = "EXISTS" | "DELETED"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_param = {}             # exec_param[eid] = param_id (parameter read by this execution)


# step: a Step Functions state machine is created
# result: the state machine is ACTIVE
# guard: the state machine does not already exist
# guard_violation: the state machine already exists
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a parameter is created in SSM Parameter Store
# result: the parameter EXISTS
# guard: the parameter does not already exist
# guard_violation: the parameter already exists
atomic action CreateParameter:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            param_status[pid] = "EXISTS"


# step: a parameter is deleted from SSM Parameter Store
# result: the parameter is DELETED and will cause task failures when read
# guard: the parameter exists
# guard_violation: the parameter does not exist
# guard: the parameter EXISTS
# guard_violation_lifecycle: the parameter is already DELETED
atomic action DeleteParameter:
    oneof pid in PARAM_IDS:
        if pid in param_status:
            if param_status[pid] == "EXISTS":
                param_status[pid] = "DELETED"


# step: an execution of the state machine is started
# result: the execution is RUNNING
# guard: the state machine exists
# guard_violation: the state machine does not exist
# guard: the state machine is ACTIVE
# guard_violation_lifecycle: the state machine is not ACTIVE
# guard: an execution slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running execution reads an existing parameter and the task succeeds
# result: the execution is SUCCEEDED
# guard: an execution is RUNNING
# guard_violation: no execution is RUNNING
# guard: the parameter EXISTS
# guard_violation_lifecycle: the parameter does not exist or is DELETED
atomic action ReadParameterTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "EXISTS":
                            exec_status[eid] = "SUCCEEDED"
                            exec_param[eid] = pid


# fake_skip: internal
# step: a running execution fails to read the parameter because it has been deleted
# result: the execution is FAILED with a ParameterNotFound error
# guard: an execution is RUNNING
# guard_violation: no execution is RUNNING
# guard: the parameter is DELETED
# guard_violation_lifecycle: the parameter is not DELETED
atomic action ReadParameterTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "DELETED":
                            exec_status[eid] = "FAILED"
                            exec_param[eid] = pid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which parameter it read
# (verifies an execution cannot succeed without reading a parameter; parameter may be deleted afterwards)
always assertion SuccessfulExecutionReadAParameter:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_param:
                return False
    return True
