---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> SSM Parameter Store Integration Formal Specification
# Models a Step Functions state machine reading an SSM parameter as a task step.
# If the parameter has been deleted the task fails and the execution fails.

SM_IDS = ["sm-1"]
PARAM_IDS = ["param-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    param_status = {}           # param_status[pid] = "EXISTS" | "DELETED"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_param = {}             # exec_param[eid] = param_id (parameter read by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: a "ssm" "parameter" is created
# result: the parameter will exist
# guard: the "ssm" "parameter" did not already exist
# guard_violation: the "ssm" "parameter" already existed
atomic action CreateParameter:
    oneof pid in PARAM_IDS:
        if pid not in param_status:
            param_status[pid] = "EXISTS"


# step: a "ssm" "parameter" is deleted
# result: the "ssm" "parameter" will be deleted and will cause task failures when read
# guard: the "ssm" "parameter" existed
# guard_violation: the "ssm" "parameter" did not exist
# guard: the "ssm" "parameter" existed
# guard_violation_lifecycle: the parameter is already "DELETED"
atomic action DeleteParameter:
    oneof pid in PARAM_IDS:
        if pid in param_status:
            if param_status[pid] == "EXISTS":
                param_status[pid] = "DELETED"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" reads an existing parameter and the task succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "ssm" "parameter" existed
# guard_violation_lifecycle: the "ssm" "parameter" did not exist or was "DELETED"
atomic action ReadParameterTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "EXISTS":
                            exec_status[eid] = "SUCCEEDED"
                            exec_param[eid] = pid


# fake_skip: internal
# step: a running "step functions" "execution" fails to read the parameter because it has been deleted
# result: the "step functions" "execution" will be "FAILED" with a ParameterNotFound error
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "ssm" "parameter" was "DELETED"
# guard_violation_lifecycle: the "ssm" "parameter" was not "DELETED"
atomic action ReadParameterTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof pid in PARAM_IDS:
                    if pid in param_status:
                        if param_status[pid] == "DELETED":
                            exec_status[eid] = "FAILED"
                            exec_param[eid] = pid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which parameter it read
# (verifies an execution cannot succeed without reading a parameter; parameter may be deleted afterwards)
always assertion SuccessfulExecutionReadAParameter:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_param:
                return False
    return True
