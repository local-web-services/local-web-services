---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> Lambda Integration Formal Specification
# Models a REST API receiving requests and synchronously invoking an integrated Lambda function.
# A successful Lambda response is returned to the caller; a failure returns an HTTP 500.

API_IDS = ["api-1"]
FUNC_IDS = ["func-1"]
REQ_IDS = ["req-1"]
INV_IDS = ["inv-1"]


action Init:
    # API Gateway
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_func = {}               # api_func[aid] = func_id or "" (no integration configured)

    # Lambda function
    func_status = {}            # func_status[fid] = "ACTIVE"

    # Incoming HTTP requests
    req_status = {}             # req_status[rid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id

    # Lambda invocations triggered synchronously by API Gateway
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_req = {}                # inv_req[iid] = request_id


# step: an "api gateway" "api" is created
# result: the "api gateway" "api" will be "ACTIVE" with no Lambda integration configured
# guard: the "api gateway" "API" did not already exist
# guard_violation: the "api gateway" "API" already existed
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_func[aid] = ""


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a Lambda integration is configured on the "api gateway" "api"
# result: the "api gateway" "API" will synchronously invoke the function when a request arrives
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "API" had no integration configured
# guard_violation: the "api gateway" "API" already had an "api gateway" "integration" configured
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
atomic action ConfigureIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_func[aid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                api_func[aid] = fid


# step: the "api gateway" "API" receives a HTTP request and synchronously invokes the "lambda" "function"
# result: the "api gateway" "request" and "lambda" "invocation" are both "IN_PROGRESS"
# guard: the "api gateway" "API" existed
# guard_violation: the "api gateway" "API" did not exist
# guard: the "api gateway" "api" was "ACTIVE"
# guard_violation_lifecycle: the "api gateway" "api" was not "ACTIVE"
# guard: the "api gateway" "API" had a Lambda integration configured
# guard_violation: the "api gateway" "API" had no Lambda integration configured
# guard: the integrated "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the integrated "lambda" "function" was not "ACTIVE"
# guard: a "request" "slot" was "available"
# guard_violation_capacity: no "request" "slot" was "available"
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action HandleRequest:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_func[aid] != "":
                    fid = api_func[aid]
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status or req_status[rid] == "SUCCESS" or req_status[rid] == "FAILED":
                                    oneof iid in INV_IDS:
                                        if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                            req_status[rid] = "IN_PROGRESS"
                                            req_api[rid] = aid
                                            inv_status[iid] = "IN_PROGRESS"
                                            inv_req[iid] = rid


# fake_skip: internal
# step: the "lambda" "function" invocation completes successfully and the "api gateway" "API" returns a successful response
# result: the "lambda" "invocation" will be "SUCCESS" and the "api gateway" "request" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_req[iid]
                inv_status[iid] = "SUCCESS"
                req_status[rid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" invocation fails and the "api gateway" "API" returns an error response
# result: the "lambda" "invocation" will be "FAILED" and the "api gateway" "request" will be "FAILED"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_req[iid]
                inv_status[iid] = "FAILED"
                req_status[rid] = "FAILED"


# check: every "IN_PROGRESS" "api gateway" "request" references an "ACTIVE" "api gateway" "API"
always assertion RequestRequiresActiveApi:
    for rid in req_status:
        if req_status[rid] == "IN_PROGRESS":
            aid = req_api[rid]
            if aid in api_status:
                if api_status[aid] != "ACTIVE":
                    return False
    return True


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            rid = inv_req[iid]
            if rid in req_api:
                aid = req_api[rid]
                if aid in api_func:
                    fid = api_func[aid]
                    if fid in func_status:
                        if func_status[fid] != "ACTIVE":
                            return False
    return True


# check: every "IN_PROGRESS" "lambda" "invocation" has a corresponding "IN_PROGRESS" "api gateway" "request"
always assertion InvocationLinkedToRequest:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            rid = inv_req[iid]
            if rid in req_status:
                if req_status[rid] != "IN_PROGRESS":
                    return False
    return True
