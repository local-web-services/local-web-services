---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# API Gateway -> Lambda Integration Formal Specification
# Models a REST API receiving requests and synchronously invoking an integrated Lambda function.
# A successful Lambda response is returned to the caller; a failure returns an HTTP 500.

API_IDS = ["api-1"]
FUNC_IDS = ["func-1"]
REQ_IDS = ["req-1"]
INV_IDS = ["inv-1"]


action Init:
    # API Gateway
    api_status = {}             # api_status[aid] = "ACTIVE"
    api_func = {}               # api_func[aid] = func_id or "" (no integration configured)

    # Lambda function
    func_status = {}            # func_status[fid] = "ACTIVE"

    # Incoming HTTP requests
    req_status = {}             # req_status[rid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    req_api = {}                # req_api[rid] = api_id

    # Lambda invocations triggered synchronously by API Gateway
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_req = {}                # inv_req[iid] = request_id


# step: a REST API is created
# result: the API is ACTIVE with no Lambda integration configured
# guard: the API does not already exist
# guard_violation: the API already exists
atomic action CreateRestApi:
    oneof aid in API_IDS:
        if aid not in api_status:
            api_status[aid] = "ACTIVE"
            api_func[aid] = ""


# step: a Lambda function is deployed
# result: the function is ACTIVE
# guard: the function does not already exist
# guard_violation: the function already exists
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a Lambda integration is configured on the REST API
# result: the API will synchronously invoke the function when a request arrives
# guard: the API exists
# guard_violation: the API does not exist
# guard: the API is ACTIVE
# guard_violation_lifecycle: the API is not ACTIVE
# guard: the API has no integration configured
# guard_violation: the API already has an integration configured
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is not ACTIVE
atomic action ConfigureIntegration:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_func[aid] == "":
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                api_func[aid] = fid


# step: the API receives an HTTP request and synchronously invokes the Lambda function
# result: the request and invocation are both IN_PROGRESS
# guard: the API exists
# guard_violation: the API does not exist
# guard: the API is ACTIVE
# guard_violation_lifecycle: the API is not ACTIVE
# guard: the API has a Lambda integration configured
# guard_violation: the API has no Lambda integration configured
# guard: the integrated function is ACTIVE
# guard_violation_lifecycle: the integrated function is not ACTIVE
# guard: a request slot is available
# guard_violation_capacity: no request slot is available
# guard: an invocation slot is available
# guard_violation_capacity: no invocation slot is available
atomic action HandleRequest:
    oneof aid in API_IDS:
        if aid in api_status:
            if api_status[aid] == "ACTIVE":
                if api_func[aid] != "":
                    fid = api_func[aid]
                    if fid in func_status:
                        if func_status[fid] == "ACTIVE":
                            oneof rid in REQ_IDS:
                                if rid not in req_status or req_status[rid] == "SUCCESS" or req_status[rid] == "FAILED":
                                    oneof iid in INV_IDS:
                                        if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                                            req_status[rid] = "IN_PROGRESS"
                                            req_api[rid] = aid
                                            inv_status[iid] = "IN_PROGRESS"
                                            inv_req[iid] = rid


# fake_skip: internal
# step: the Lambda invocation completes successfully and the API returns a successful response
# result: the invocation is SUCCESS and the request is SUCCESS
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
atomic action InvocationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_req[iid]
                inv_status[iid] = "SUCCESS"
                req_status[rid] = "SUCCESS"


# fake_skip: internal
# step: the Lambda invocation fails and the API returns an error response
# result: the invocation is FAILED and the request is FAILED
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
atomic action InvocationFails:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                rid = inv_req[iid]
                inv_status[iid] = "FAILED"
                req_status[rid] = "FAILED"


# check: every IN_PROGRESS request references an ACTIVE API
always assertion RequestRequiresActiveApi:
    for rid in req_status:
        if req_status[rid] == "IN_PROGRESS":
            aid = req_api[rid]
            if aid in api_status:
                if api_status[aid] != "ACTIVE":
                    return False
    return True


# check: every IN_PROGRESS invocation references an ACTIVE Lambda function
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            rid = inv_req[iid]
            if rid in req_api:
                aid = req_api[rid]
                if aid in api_func:
                    fid = api_func[aid]
                    if fid in func_status:
                        if func_status[fid] != "ACTIVE":
                            return False
    return True


# check: every IN_PROGRESS invocation has a corresponding IN_PROGRESS request
always assertion InvocationLinkedToRequest:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            rid = inv_req[iid]
            if rid in req_status:
                if req_status[rid] != "IN_PROGRESS":
                    return False
    return True
