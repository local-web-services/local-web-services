---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# EventBridge -> DynamoDB Integration Formal Specification
# Models an EventBridge rule that targets a DynamoDB table via the PutItem API action.
# When an event matches an ENABLED rule, EventBridge writes an item to the target table.
# If the table is being deleted, the target invocation fails.

BUS_IDS = ["bus-1"]
RULE_IDS = ["rule-1"]
TABLE_IDS = ["table-1"]
EVENT_IDS = ["event-1"]
ITEM_IDS = ["item-1"]


action Init:
    bus_status = {}             # bus_status[busid] = "ACTIVE"
    rule_status = {}            # rule_status[rid] = "ENABLED" | "DISABLED"
    rule_bus = {}               # rule_bus[rid] = bus_id
    rule_table = {}             # rule_table[rid] = table_id (DynamoDB target)
    table_status = {}           # table_status[tid] = "ACTIVE" | "DELETING"
    event_status = {}           # event_status[eid] = "MATCHED"
    event_rule = {}             # event_rule[eid] = rule_id
    item_status = {}            # item_status[iid] = "EXISTS"
    item_table = {}             # item_table[iid] = table_id
    item_event = {}             # item_event[iid] = event_id


# step: an "eventbridge" "bus" is created
# result: the "eventbridge" "bus" will be "ACTIVE"
# guard: the "eventbridge" "bus" did not already exist
# guard_violation: the "eventbridge" "bus" already existed
atomic action CreateEventBus:
    oneof busid in BUS_IDS:
        if busid not in bus_status:
            bus_status[busid] = "ACTIVE"


# step: a "dynamodb" "table" is created
# result: the "dynamodb" "table" will be "ACTIVE"
# guard: the "dynamodb" "table" did not already exist
# guard_violation: the "dynamodb" "table" already existed
atomic action CreateTable:
    oneof tid in TABLE_IDS:
        if tid not in table_status:
            table_status[tid] = "ACTIVE"


# step: a "dynamodb" "table" deletion is initiated
# result: the "dynamodb" "table" will be "DELETING" and item writes to it will fail
# guard: the "dynamodb" "table" existed
# guard_violation: the "dynamodb" "table" did not exist
# guard: the "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the "dynamodb" "table" is already "DELETING"
atomic action DeleteTable:
    oneof tid in TABLE_IDS:
        if tid in table_status:
            if table_status[tid] == "ACTIVE":
                table_status[tid] = "DELETING"


# step: an "eventbridge" "rule" is created targeting a "dynamodb" "table"
# result: the "eventbridge" "rule" will be "DISABLED" on the "eventbridge" "bus" with the "dynamodb" "table" target configured
# guard: the "eventbridge" "bus" existed and was "ACTIVE"
# guard_violation: the "eventbridge" "bus" did not exist or was "ACTIVE"
# guard: the "eventbridge" "rule" did not already exist
# guard_violation: the "eventbridge" "rule" already existed
# guard: the "dynamodb" "table" existed and was "ACTIVE"
# guard_violation: the "dynamodb" "table" did not exist or was "ACTIVE"
atomic action CreateRule:
    oneof busid in BUS_IDS:
        if busid in bus_status:
            if bus_status[busid] == "ACTIVE":
                oneof rid in RULE_IDS:
                    if rid not in rule_status:
                        oneof tid in TABLE_IDS:
                            if tid in table_status:
                                if table_status[tid] == "ACTIVE":
                                    rule_status[rid] = "DISABLED"
                                    rule_bus[rid] = busid
                                    rule_table[rid] = tid


# step: an "eventbridge" "rule" was "ENABLED"
# result: the "eventbridge" "rule" will be "ENABLED" and will match events
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was "DISABLED"
# guard_violation_lifecycle: the "eventbridge" "rule" is already "ENABLED"
atomic action EnableRule:
    oneof rid in RULE_IDS:
        if rid in rule_status:
            if rule_status[rid] == "DISABLED":
                rule_status[rid] = "ENABLED"


# step: an "eventbridge" "rule" was "DISABLED"
# result: the "eventbridge" "rule" will be "DISABLED" and will not match events
# guard: the "eventbridge" "rule" existed
# guard_violation: the "eventbridge" "rule" did not exist
# guard: the "eventbridge" "rule" was "ENABLED"
# guard_violation_lifecycle: the "eventbridge" "rule" is already "DISABLED"
atomic action DisableRule:
    oneof rid in RULE_IDS:
        if rid in rule_status:
            if rule_status[rid] == "ENABLED":
                rule_status[rid] = "DISABLED"


# step: an "eventbridge" "event" matches an "ENABLED" "eventbridge" "rule" and writes an "item" to the "dynamodb" target
# result: the "dynamodb" "item" will exist in the "dynamodb" "table" and the "eventbridge" "event" will be "MATCHED"
# guard: a "eventbridge" "rule" was "ENABLED"
# guard_violation_lifecycle: no "eventbridge" "rule" was "ENABLED"
# guard: the target "dynamodb" "table" was "ACTIVE"
# guard_violation_lifecycle: the target "dynamodb" "table" was not "ACTIVE"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
# guard: a "dynamodb" "item" "slot" was "available"
# guard_violation_capacity: no "dynamodb" "item" "slot" was "available"
atomic action EventTargetsDynamoDB:
    oneof rid in RULE_IDS:
        if rid in rule_status:
            if rule_status[rid] == "ENABLED":
                tid = rule_table[rid]
                if tid in table_status:
                    if table_status[tid] == "ACTIVE":
                        oneof eid in EVENT_IDS:
                            if eid not in event_status:
                                oneof iid in ITEM_IDS:
                                    if iid not in item_status:
                                        event_status[eid] = "MATCHED"
                                        event_rule[eid] = rid
                                        item_status[iid] = "EXISTS"
                                        item_table[iid] = tid
                                        item_event[iid] = eid


# step: an event matches an ENABLED rule but the DynamoDB write fails because the "dynamodb" "table" is being deleted
# result: the "eventbridge" "event" will be "MATCHED" but no "dynamodb" "item" will be written
# guard: a "eventbridge" "rule" was "ENABLED"
# guard_violation_lifecycle: no "eventbridge" "rule" was "ENABLED"
# guard: the target "dynamodb" "table" was "DELETING"
# guard_violation_lifecycle: the target "dynamodb" "table" was not "DELETING"
# guard: an "eventbridge" "event" "slot" was "available"
# guard_violation_capacity: no "eventbridge" "event" "slot" was "available"
atomic action EventTargetFails:
    oneof rid in RULE_IDS:
        if rid in rule_status:
            if rule_status[rid] == "ENABLED":
                tid = rule_table[rid]
                if tid in table_status:
                    if table_status[tid] == "DELETING":
                        oneof eid in EVENT_IDS:
                            if eid not in event_status:
                                event_status[eid] = "MATCHED"
                                event_rule[eid] = rid


# check: every existing item references a "dynamodb" "table" that exists
always assertion ItemReferencesExistingTable:
    for iid in item_status:
        if item_status[iid] == "EXISTS":
            tid = item_table[iid]
            if tid not in table_status:
                return False
    return True


# check: every matched "eventbridge" "event" references an "eventbridge" "rule" that exists
always assertion MatchedEventReferencesExistingRule:
    for eid in event_status:
        if event_status[eid] == "MATCHED":
            rid = event_rule[eid]
            if rid not in rule_status:
                return False
    return True
