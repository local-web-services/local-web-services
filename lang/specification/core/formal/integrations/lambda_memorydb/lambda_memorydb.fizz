---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 40
---
# Lambda -> MemoryDB Integration Formal Specification
# Models a Lambda function reading and writing records to a MemoryDB cluster.
# MemoryDB is Redis-compatible with durable storage, so records are not evicted
# but the cluster can be in an UPDATING state during configuration changes.

FUNC_IDS = ["func-1"]
CLUSTER_IDS = ["cluster-1"]
INV_IDS = ["inv-1"]
RECORD_IDS = ["record-1"]


action Init:
    func_status = {}            # func_status[fid] = "ACTIVE"
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "UPDATING"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    record_status = {}          # record_status[rid] = "EXISTS" | "DELETED"
    record_cluster = {}         # record_cluster[rid] = cluster_id
    record_inv = {}             # record_inv[rid] = inv_id


# step: a "lambda" "function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: a "memorydb" "cluster" is created
# result: the "memorydb" "cluster" will be "AVAILABLE"
# guard: the "memorydb" "cluster" did not already exist
# guard_violation: the "memorydb" "cluster" already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: a "memorydb" "cluster" update begins
# result: the "memorydb" "cluster" will be "UPDATING" and write operations may fail
# guard: the "memorydb" "cluster" existed
# guard_violation: the "memorydb" "cluster" did not exist
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
atomic action ClusterUpdateBegins:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "UPDATING"


# step: the "memorydb" "cluster" update completes
# result: the "memorydb" "cluster" will be "AVAILABLE" again
# guard: the "memorydb" "cluster" was "UPDATING"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "UPDATING"
atomic action ClusterUpdateComplete:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "UPDATING":
                cluster_status[cid] = "AVAILABLE"


# step: the "lambda" "function" is invoked
# result: the "lambda" "invocation" will be "IN_PROGRESS"
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" was not "ACTIVE"
# guard: a "lambda" "invocation" "slot" was "available"
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action InvokeFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                oneof iid in INV_IDS:
                    if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                        inv_status[iid] = "IN_PROGRESS"
                        inv_func[iid] = fid


# fake_skip: internal
# step: the "lambda" "function" writes a record to the AVAILABLE MemoryDB cluster during invocation
# result: the "memorydb" "record" will exist in the "memorydb" "cluster" and the "lambda" "invocation" will be "SUCCESS"
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "memorydb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "AVAILABLE"
# guard: a "memorydb" "record" "slot" was "available"
# guard_violation_capacity: no "memorydb" "record" "slot" was "available"
atomic action WriteRecord:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "AVAILABLE":
                            oneof rid in RECORD_IDS:
                                if rid not in record_status or record_status[rid] == "DELETED":
                                    record_status[rid] = "EXISTS"
                                    record_cluster[rid] = cid
                                    record_inv[rid] = iid
                                    inv_status[iid] = "SUCCESS"


# fake_skip: internal
# step: the "lambda" "function" fails to write because the "memorydb" "cluster" is updating
# result: the "lambda" "invocation" will be "FAILED" with a connection refused error
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the "memorydb" "cluster" was "UPDATING"
# guard_violation_lifecycle: the "memorydb" "cluster" was not "UPDATING"
atomic action InvocationFailsClusterUpdating:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "UPDATING":
                            inv_status[iid] = "FAILED"


# check: every "IN_PROGRESS" "lambda" "function" invocation references an "ACTIVE" "lambda" "function"
always assertion InvocationRequiresActiveFunction:
    for iid in inv_status:
        if inv_status[iid] == "IN_PROGRESS":
            fid = inv_func[iid]
            if fid in func_status:
                if func_status[fid] != "ACTIVE":
                    return False
    return True


# check: every existing record references a "memorydb" "cluster" that exists
# (records are durable in MemoryDB and persist across cluster updates)
always assertion RecordReferencesExistingCluster:
    for rid in record_status:
        if record_status[rid] == "EXISTS":
            cid = record_cluster[rid]
            if cid not in cluster_status:
                return False
    return True
