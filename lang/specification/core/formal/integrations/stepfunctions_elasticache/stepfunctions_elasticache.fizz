---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Step Functions -> ElastiCache Integration Formal Specification
# Models a Step Functions state machine connecting to an ElastiCache cluster
# as a task step (e.g., reading cached data to influence workflow branching).
# If the cluster is being modified, the connection may be refused.

SM_IDS = ["sm-1"]
CLUSTER_IDS = ["cluster-1"]
EXEC_IDS = ["exec-1"]


action Init:
    sm_status = {}              # sm_status[smid] = "ACTIVE"
    cluster_status = {}         # cluster_status[cid] = "AVAILABLE" | "MODIFYING"
    exec_status = {}            # exec_status[eid] = "RUNNING" | "SUCCEEDED" | "FAILED"
    exec_sm = {}                # exec_sm[eid] = sm_id
    exec_cluster = {}           # exec_cluster[eid] = cluster_id (cluster called by this execution)


# step: a "step functions" "state machine" is created
# result: the "step functions" "state machine" will be "ACTIVE"
# guard: the "step functions" "state machine" did not already exist
# guard_violation: the "step functions" "state machine" already existed
atomic action CreateStateMachine:
    oneof smid in SM_IDS:
        if smid not in sm_status:
            sm_status[smid] = "ACTIVE"


# step: an "elasticache" "cluster" is created and becomes AVAILABLE
# result: the "elasticache" "cluster" will be "AVAILABLE"
# guard: the cluster did not already exist
# guard_violation: the cluster already existed
atomic action CreateCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "AVAILABLE"


# step: a cluster modification begins
# result: the "elasticache" "cluster" will be "MODIFYING" and connections may be refused
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
atomic action ClusterModificationBegins:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"


# fake_skip: internal
# step: the cluster modification completes
# result: the "elasticache" "cluster" will be "AVAILABLE" again
# guard: the "elasticache" "cluster" was "MODIFYING"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "MODIFYING"
atomic action ClusterModificationComplete:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"


# step: an "step functions" "execution" of the "step functions" "state machine" is started
# result: the "step functions" "execution" will be "RUNNING"
# guard: the "step functions" "state machine" existed
# guard_violation: the "step functions" "state machine" did not exist
# guard: the "step functions" "state machine" was "ACTIVE"
# guard_violation_lifecycle: the "step functions" "state machine" was not "ACTIVE"
# guard: an "step functions" "execution" slot is available
# guard_violation_capacity: no execution slot is available
atomic action StartExecution:
    oneof smid in SM_IDS:
        if smid in sm_status:
            if sm_status[smid] == "ACTIVE":
                oneof eid in EXEC_IDS:
                    if eid not in exec_status or exec_status[eid] == "SUCCEEDED" or exec_status[eid] == "FAILED":
                        exec_status[eid] = "RUNNING"
                        exec_sm[eid] = smid


# fake_skip: internal
# step: a running "step functions" "execution" reads from the AVAILABLE ElastiCache cluster and succeeds
# result: the "step functions" "execution" will be "SUCCEEDED"
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
atomic action ReadCacheTaskSucceeds:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "AVAILABLE":
                            exec_status[eid] = "SUCCEEDED"
                            exec_cluster[eid] = cid


# fake_skip: internal
# step: a running "step functions" "execution" fails to connect because the cluster is being modified
# result: the "step functions" "execution" will be "FAILED" with a connection error
# guard: a "step functions" "execution" was "RUNNING"
# guard_violation: no "step functions" "execution" was "RUNNING"
# guard: the "elasticache" "cluster" was "MODIFYING"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "MODIFYING"
atomic action ReadCacheTaskFails:
    oneof eid in EXEC_IDS:
        if eid in exec_status:
            if exec_status[eid] == "RUNNING":
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_status[cid] == "MODIFYING":
                            exec_status[eid] = "FAILED"
                            exec_cluster[eid] = cid


# check: every RUNNING execution references an ACTIVE state machine
always assertion ExecutionRequiresActiveStateMachine:
    for eid in exec_status:
        if exec_status[eid] == "RUNNING":
            smid = exec_sm[eid]
            if smid in sm_status:
                if sm_status[smid] != "ACTIVE":
                    return False
    return True


# check: every succeeded execution recorded which cluster it read
# (verifies an execution cannot succeed without connecting to a cluster; cluster may enter MODIFYING afterwards)
always assertion SuccessfulExecutionReadACluster:
    for eid in exec_status:
        if exec_status[eid] == "SUCCEEDED":
            if eid not in exec_cluster:
                return False
    return True
