---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Secrets Manager -> Lambda Integration Formal Specification
# Models Secrets Manager invoking a Lambda function as a rotation function.
# The secret has a rotation function configured; when rotation is triggered,
# Secrets Manager invokes the Lambda. If the function fails, the rotation fails.

SECRET_IDS = ["secret-1"]
FUNC_IDS = ["func-1"]
INV_IDS = ["inv-1"]


action Init:
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "ROTATING" | "PENDING_DELETION"
    secret_rotation_func = {}   # secret_rotation_func[sid] = func_id (rotation function configured)
    func_status = {}            # func_status[fid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_secret = {}             # inv_secret[iid] = secret_id being rotated


# step: a "secretsmanager" "secret" is created in Secrets Manager
# result: the "secrets manager" "secret" will be "ACTIVE"
# guard: the "secretsmanager" "secret" did not already exist
# guard_violation: the "secretsmanager" "secret" already existed
atomic action CreateSecret:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            secret_status[sid] = "ACTIVE"


# step: a "lambda" "rotation function" is deployed
# result: the "lambda" "function" will be "ACTIVE"
# guard: the "lambda" "function" did not already exist
# guard_violation: the "lambda" "function" already existed
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: the "lambda" "rotation function" is deleted
# result: the "lambda" "function" will be deleted and rotation will fail
# guard: the "lambda" "function" existed
# guard_violation: the "lambda" "function" did not exist
# guard: the "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the "lambda" "function" is already "DELETED"
atomic action DeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_status[fid] = "DELETED"


# step: rotation is configured on the "secretsmanager" "secret" linking it to the "lambda" "rotation function"
# result: the "secretsmanager" "secret" has a rotation function configured
# guard: the "secrets manager" "secret" existed and was "ACTIVE"
# guard_violation_lifecycle: the "secrets manager" "secret" did not exist or was not "ACTIVE"
# guard: the "lambda" "function" existed and was "ACTIVE"
# guard_violation: the "lambda" "function" did not exist or was "ACTIVE"
# guard: the "secretsmanager" "secret" has no rotation function configured
# guard_violation: the "secretsmanager" "secret" already has a rotation function configured
atomic action ConfigureRotation:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                if sid not in secret_rotation_func:
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                secret_rotation_func[sid] = fid


# step: a rotation is triggered for the "secretsmanager" "secret"
# result: the "secrets manager" "secret" will be "ROTATING" and Secrets Manager will invoke the "lambda" "rotation function"
# guard: the "secrets manager" "secret" existed and was "ACTIVE"
# guard_violation_lifecycle: the "secrets manager" "secret" did not exist or was not "ACTIVE"
# guard: the "secretsmanager" "secret" has a rotation function configured
# guard_violation: the "secretsmanager" "secret" has no rotation function configured
# guard: a "lambda" "invocation" slot is available
# guard_violation_capacity: no "lambda" "invocation" "slot" was "available"
atomic action TriggerRotation:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                if sid in secret_rotation_func:
                    fid = secret_rotation_func[sid]
                    oneof iid in INV_IDS:
                        if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                            secret_status[sid] = "ROTATING"
                            inv_status[iid] = "IN_PROGRESS"
                            inv_func[iid] = fid
                            inv_secret[iid] = sid


# fake_skip: internal
# step: the "lambda" "rotation function" succeeds and the "secretsmanager" "secret" is rotated to a new version
# result: the invocation will be "SUCCESS" and the "secrets manager" "secret" will be "ACTIVE" with a new version
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the rotation "lambda" "function" was "ACTIVE"
# guard_violation_lifecycle: the rotation "lambda" "function" was not "ACTIVE"
atomic action RotationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                fid = inv_func[iid]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        sid = inv_secret[iid]
                        inv_status[iid] = "SUCCESS"
                        secret_status[sid] = "ACTIVE"


# fake_skip: internal
# step: the "lambda" "rotation function" fails and the rotation is aborted
# result: the invocation will be "FAILED" and the "secretsmanager" "secret" remains "ACTIVE" with the old version
# guard: a "lambda" "invocation" was "IN_PROGRESS"
# guard_violation_lifecycle: no "lambda" "invocation" was "IN_PROGRESS"
# guard: the rotation "lambda" "function" was "DELETED"
# guard_violation_lifecycle: the rotation "lambda" "function" was not "DELETED"
atomic action RotationFailsFunctionDeleted:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                fid = inv_func[iid]
                if fid in func_status:
                    if func_status[fid] == "DELETED":
                        sid = inv_secret[iid]
                        inv_status[iid] = "FAILED"
                        secret_status[sid] = "ACTIVE"


# check: every "ROTATING" "secrets manager" "secret" has an "IN_PROGRESS" "lambda" "rotation invocation"
always assertion RotatingSecretHasInProgressInvocation:
    for sid in secret_status:
        if secret_status[sid] == "ROTATING":
            found = False
            for iid in inv_status:
                if inv_status[iid] == "IN_PROGRESS":
                    if inv_secret[iid] == sid:
                        found = True
            if found == False:
                return False
    return True


# check: every successful "lambda" "rotation invocation" recorded which "secrets manager" "secret" it rotated
always assertion SuccessfulRotationRotatedASecret:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_secret:
                return False
    return True
