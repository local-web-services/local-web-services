---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 35
---
# Secrets Manager -> Lambda Integration Formal Specification
# Models Secrets Manager invoking a Lambda function as a rotation function.
# The secret has a rotation function configured; when rotation is triggered,
# Secrets Manager invokes the Lambda. If the function fails, the rotation fails.

SECRET_IDS = ["secret-1"]
FUNC_IDS = ["func-1"]
INV_IDS = ["inv-1"]


action Init:
    secret_status = {}          # secret_status[sid] = "ACTIVE" | "ROTATING" | "PENDING_DELETION"
    secret_rotation_func = {}   # secret_rotation_func[sid] = func_id (rotation function configured)
    func_status = {}            # func_status[fid] = "ACTIVE" | "DELETED"
    inv_status = {}             # inv_status[iid] = "IN_PROGRESS" | "SUCCESS" | "FAILED"
    inv_func = {}               # inv_func[iid] = func_id
    inv_secret = {}             # inv_secret[iid] = secret_id being rotated


# step: a secret is created in Secrets Manager
# result: the secret is ACTIVE
# guard: the secret does not already exist
# guard_violation: the secret already exists
atomic action CreateSecret:
    oneof sid in SECRET_IDS:
        if sid not in secret_status:
            secret_status[sid] = "ACTIVE"


# step: a Lambda rotation function is deployed
# result: the function is ACTIVE
# guard: the function does not already exist
# guard_violation: the function already exists
atomic action DeployFunction:
    oneof fid in FUNC_IDS:
        if fid not in func_status:
            func_status[fid] = "ACTIVE"


# step: the rotation function is deleted
# result: the function is DELETED and rotation will fail
# guard: the function exists
# guard_violation: the function does not exist
# guard: the function is ACTIVE
# guard_violation_lifecycle: the function is already DELETED
atomic action DeleteFunction:
    oneof fid in FUNC_IDS:
        if fid in func_status:
            if func_status[fid] == "ACTIVE":
                func_status[fid] = "DELETED"


# step: rotation is configured on the secret linking it to the Lambda rotation function
# result: the secret has a rotation function configured
# guard: the secret exists and is ACTIVE
# guard_violation_lifecycle: the secret does not exist or is not ACTIVE
# guard: the function exists and is ACTIVE
# guard_violation: the function does not exist or is not ACTIVE
# guard: the secret has no rotation function configured
# guard_violation: the secret already has a rotation function configured
atomic action ConfigureRotation:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                if sid not in secret_rotation_func:
                    oneof fid in FUNC_IDS:
                        if fid in func_status:
                            if func_status[fid] == "ACTIVE":
                                secret_rotation_func[sid] = fid


# step: a rotation is triggered for the secret
# result: the secret is ROTATING and Secrets Manager invokes the Lambda rotation function
# guard: the secret exists and is ACTIVE
# guard_violation_lifecycle: the secret does not exist or is not ACTIVE
# guard: the secret has a rotation function configured
# guard_violation: the secret has no rotation function configured
# guard: an invocation slot is available
# guard_violation_capacity: no invocation slot is available
atomic action TriggerRotation:
    oneof sid in SECRET_IDS:
        if sid in secret_status:
            if secret_status[sid] == "ACTIVE":
                if sid in secret_rotation_func:
                    fid = secret_rotation_func[sid]
                    oneof iid in INV_IDS:
                        if iid not in inv_status or inv_status[iid] == "SUCCESS" or inv_status[iid] == "FAILED":
                            secret_status[sid] = "ROTATING"
                            inv_status[iid] = "IN_PROGRESS"
                            inv_func[iid] = fid
                            inv_secret[iid] = sid


# fake_skip: internal
# step: the Lambda rotation function succeeds and the secret is rotated to a new version
# result: the invocation is SUCCESS and the secret is ACTIVE with a new version
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
# guard: the rotation function is ACTIVE
# guard_violation_lifecycle: the rotation function is not ACTIVE
atomic action RotationSucceeds:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                fid = inv_func[iid]
                if fid in func_status:
                    if func_status[fid] == "ACTIVE":
                        sid = inv_secret[iid]
                        inv_status[iid] = "SUCCESS"
                        secret_status[sid] = "ACTIVE"


# fake_skip: internal
# step: the Lambda rotation function fails and the rotation is aborted
# result: the invocation is FAILED and the secret remains ACTIVE with the old version
# guard: an invocation is IN_PROGRESS
# guard_violation_lifecycle: no invocation is IN_PROGRESS
# guard: the rotation function is DELETED
# guard_violation_lifecycle: the rotation function is not DELETED
atomic action RotationFailsFunctionDeleted:
    oneof iid in INV_IDS:
        if iid in inv_status:
            if inv_status[iid] == "IN_PROGRESS":
                fid = inv_func[iid]
                if fid in func_status:
                    if func_status[fid] == "DELETED":
                        sid = inv_secret[iid]
                        inv_status[iid] = "FAILED"
                        secret_status[sid] = "ACTIVE"


# check: every ROTATING secret has an IN_PROGRESS rotation invocation
always assertion RotatingSecretHasInProgressInvocation:
    for sid in secret_status:
        if secret_status[sid] == "ROTATING":
            found = False
            for iid in inv_status:
                if inv_status[iid] == "IN_PROGRESS":
                    if inv_secret[iid] == sid:
                        found = True
            if found == False:
                return False
    return True


# check: every successful rotation invocation recorded which secret it rotated
always assertion SuccessfulRotationRotatedASecret:
    for iid in inv_status:
        if inv_status[iid] == "SUCCESS":
            if iid not in inv_secret:
                return False
    return True
