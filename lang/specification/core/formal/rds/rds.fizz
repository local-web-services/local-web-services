---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# AWS RDS Formal Specification
# Models DB instance lifecycle, snapshots, automated backups, and Multi-AZ failover
# Uses flat dicts and fixed resource pools (no nested subscript, no del, no state: block)

INSTANCE_IDS = ["db-1", "db-2", "db-3", "db-4"]
SNAPSHOT_IDS = ["snap-1", "snap-2", "snap-3", "snap-4", "snap-5", "snap-6"]

action Init:
    instance_status = {}
    instance_multi_az = {}

    snapshot_status = {}
    snapshot_instance = {}

# CreateDBInstance: instance starts in CREATING state
# step: a "rds" "instance" is created
# result: the "rds" "instance" will be in "CREATING" state
# guard: the "rds" "instance" did not already exist
# guard_violation: the "rds" "instance" already existed
atomic action CreateDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid not in instance_status:
            instance_status[iid] = "CREATING"
            instance_multi_az[iid] = False

# Non-deterministic: instance becomes AVAILABLE or FAILED after CREATING
# fake_skip: internal
# step: a "rds" "instance" finishes creating
# result: the "rds" "instance" will be "AVAILABLE" or "FAILED"
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "CREATING"
# guard_violation_lifecycle: the "rds" "instance" was not "CREATING"
atomic action ActivateDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "CREATING":
                oneof:
                    instance_status[iid] = "AVAILABLE"
                    instance_status[iid] = "FAILED"

# ModifyDBInstance: transitions AVAILABLE instance to MODIFYING
# step: a "rds" "instance" configuration is modified
# result: the "rds" "instance" will be in "MODIFYING" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
atomic action ModifyDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_status[iid] = "MODIFYING"

# fake_skip: internal
# step: a "rds" "instance" modification completes
# result: the "rds" "instance" returns to "AVAILABLE" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "MODIFYING"
# guard_violation_lifecycle: the "rds" "instance" was not "MODIFYING"
atomic action FinishModifyDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "MODIFYING":
                instance_status[iid] = "AVAILABLE"

# RebootDBInstance: only on AVAILABLE instances
# step: a "rds" "instance" is rebooted
# result: the "rds" "instance" will be in "REBOOTING" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
atomic action RebootDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_status[iid] = "REBOOTING"

# fake_skip: internal
# step: a "rds" "instance" reboot completes
# result: the "rds" "instance" returns to "AVAILABLE" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "REBOOTING"
# guard_violation_lifecycle: the "rds" "instance" was not "REBOOTING"
atomic action FinishRebootDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "REBOOTING":
                instance_status[iid] = "AVAILABLE"

# DeleteDBInstance: with SkipFinalSnapshot flag = True
# step: a "rds" "instance" is deleted without a final "rds" "snapshot"
# result: the "rds" "instance" will be in "DELETING" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE" or "FAILED"
# guard_violation_lifecycle: the "rds" "instance" is neither "AVAILABLE" nor "FAILED"
atomic action DeleteDBInstanceSkipSnapshot:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE" or instance_status[iid] == "FAILED":
                instance_status[iid] = "DELETING"

# DeleteDBInstance: without SkipFinalSnapshot — links a final snapshot to the instance
# step: a "rds" "instance" is deleted with a final "rds" "snapshot"
# result: the "rds" "instance" will be in "DELETING" state and a "rds" "snapshot" will be "CREATING"
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
# guard: a "rds" "snapshot" slot is available
# guard_violation: no "rds" "snapshot" slot is available
atomic action DeleteDBInstanceWithSnapshot:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_instance[sid] = iid
                        instance_status[iid] = "DELETING"

# fake_skip: internal
# step: a "rds" "instance" deletion completes
# result: the "rds" "instance" will be "DELETED"
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "DELETING"
# guard_violation_lifecycle: the "rds" "instance" was not "DELETING"
atomic action FinishDeleteDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "DELETING":
                instance_status[iid] = "DELETED"

# CreateDBSnapshot: only on AVAILABLE instances; instance moves to BACKING_UP
# step: a "rds" "snapshot" is created from a "rds" "instance"
# result: the "rds" "snapshot" will be "CREATING" and the "rds" "instance" will be in "BACKING_UP" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
# guard: a "rds" "snapshot" slot is available
# guard_violation: no "rds" "snapshot" slot is available
atomic action CreateDBSnapshot:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_instance[sid] = iid
                        instance_status[iid] = "BACKING_UP"

# fake_skip: internal
# step: a "rds" "snapshot" finishes creating
# result: the "rds" "snapshot" will be "AVAILABLE" and the "rds" "instance" returns to "AVAILABLE" state
# guard: the "rds" "snapshot" existed
# guard_violation: the "rds" "snapshot" did not exist
# guard: the "rds" "snapshot" was "CREATING"
# guard_violation_lifecycle: the "rds" "snapshot" was not "CREATING"
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "BACKING_UP"
# guard_violation_lifecycle: the "rds" "instance" was not "BACKING_UP"
atomic action FinishCreateDBSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                iid = snapshot_instance[sid]
                if iid in instance_status:
                    if instance_status[iid] == "BACKING_UP":
                        instance_status[iid] = "AVAILABLE"

# DeleteDBSnapshot: only on AVAILABLE snapshots
# step: a "rds" "snapshot" is deleted
# result: the "rds" "snapshot" will be in "DELETING" state
# guard: the "rds" "snapshot" existed
# guard_violation: the "rds" "snapshot" did not exist
# guard: the "rds" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "snapshot" was not "AVAILABLE"
atomic action DeleteDBSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a "rds" "snapshot" deletion completes
# result: the "rds" "snapshot" will be "DELETED"
# guard: the "rds" "snapshot" existed
# guard_violation: the "rds" "snapshot" did not exist
# guard: the "rds" "snapshot" was "DELETING"
# guard_violation_lifecycle: the "rds" "snapshot" was not "DELETING"
atomic action FinishDeleteDBSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"

# RestoreDBInstanceFromDBSnapshot: creates a new instance in RESTORING state from an AVAILABLE snapshot
# step: a "rds" "instance" is restored from a "rds" "snapshot"
# result: the restored "rds" "instance" will be in "RESTORING" state
# guard: the "rds" "snapshot" existed
# guard_violation: the "rds" "snapshot" did not exist
# guard: the "rds" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "snapshot" was not "AVAILABLE"
# guard: the target "rds" "instance" slot is available
# guard_violation: the target "rds" "instance" slot is not available
atomic action RestoreDBInstanceFromDBSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof iid in INSTANCE_IDS:
                    if iid not in instance_status:
                        instance_status[iid] = "RESTORING"
                        instance_multi_az[iid] = False

# fake_skip: internal
# step: a "rds" "instance" restore from "rds" "snapshot" completes
# result: the "rds" "instance" will be "AVAILABLE"
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "RESTORING"
# guard_violation_lifecycle: the "rds" "instance" was not "RESTORING"
atomic action FinishRestoreDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "RESTORING":
                instance_status[iid] = "AVAILABLE"

# Non-deterministic automated backup window
# fake_skip: internal
# step: an automated backup runs on an available "rds" "instance"
# result: a "rds" "snapshot" will be "CREATING" and the "rds" "instance" will be in "BACKING_UP" state
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
# guard: a "rds" "snapshot" slot is available
# guard_violation: no "rds" "snapshot" slot is available
atomic action AutomatedBackup:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_instance[sid] = iid
                        instance_status[iid] = "BACKING_UP"

# Non-deterministic Multi-AZ failover: AVAILABLE multi-az instance goes through MODIFYING
# fake_skip: internal
# step: a multi-AZ failover is triggered on a "rds" "instance"
# result: the "rds" "instance" will be in "MODIFYING" state during promotion
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
# guard: the "rds" "instance" has multi-AZ enabled
# guard_violation: the "rds" "instance" does not have multi-AZ enabled
atomic action MultiAZFailover:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                if instance_multi_az[iid]:
                    instance_status[iid] = "MODIFYING"

# EnableMultiAZ on an AVAILABLE instance
# step: multi-AZ was "ENABLED" on a "rds" "instance"
# result: the "rds" "instance" will be configured for multi-AZ deployment
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
atomic action EnableMultiAZ:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_multi_az[iid] = True

# Tag operation on AVAILABLE instances (simplified: set a tagged flag)
# step: a tag is applied to a "rds" "instance"
# result: the "rds" "instance" tag state will be unchanged (no-op model)
# guard: the "rds" "instance" existed
# guard_violation: the "rds" "instance" did not exist
# guard: the "rds" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "rds" "instance" was not "AVAILABLE"
atomic action TagDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_multi_az[iid] = instance_multi_az[iid]

# Safety: DB instance statuses are valid
# check: every database instance has a valid status
always assertion ValidDBInstanceStatus:
    for iid in instance_status:
        s = instance_status[iid]
        if s != "CREATING" and s != "AVAILABLE" and s != "MODIFYING" and s != "DELETING" and s != "FAILED" and s != "BACKING_UP" and s != "REBOOTING" and s != "RESTORING" and s != "DELETED":
            return False
    return True

# Safety: DB snapshot statuses are valid
# check: every database snapshot has a valid status
always assertion ValidDBSnapshotStatus:
    for sid in snapshot_status:
        s = snapshot_status[sid]
        if s != "CREATING" and s != "AVAILABLE" and s != "DELETING" and s != "DELETED":
            return False
    return True

# Safety: every BACKING_UP instance has a corresponding in-progress snapshot
# check: every backing-up instance has a corresponding in-progress snapshot
always assertion BackingUpInstanceHasSnapshot:
    for iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "BACKING_UP":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_status[sid] == "CREATING":
                            if snapshot_instance[sid] == iid:
                                found = True
                if not found:
                    return False
    return True
