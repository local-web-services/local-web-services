---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 12
---
# Amazon DocumentDB (docdb) formal specification
# Models clusters, instances, snapshots, and async state transitions
# Uses flat dicts and fixed resource pools (no nested subscript, no del, no state: block)

CLUSTER_IDS = ["cluster-1", "cluster-2"]
INSTANCE_IDS = ["instance-1", "instance-2"]
SNAPSHOT_IDS = ["snapshot-1"]

action Init:
    cluster_status = {}
    cluster_primary_instance = {}

    instance_status = {}
    instance_cluster = {}
    instance_is_primary = {}

    snapshot_status = {}
    snapshot_cluster = {}

# step: a "documentdb" "cluster" is created
# result: the "documentdb" "cluster" will be in "CREATING" state
# guard: the "documentdb" "cluster" did not already exist
# guard_violation: the "documentdb" "cluster" already existed
atomic action CreateDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_primary_instance[cid] = ""

# fake_skip: internal
# step: a "documentdb" "cluster" finishes creating
# result: the "documentdb" "cluster" will be "AVAILABLE"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "CREATING"
# guard_violation: the "documentdb" "cluster" was not "CREATING"
atomic action CompleteClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "AVAILABLE"

# fake_skip: internal
# step: a "documentdb" "cluster" creation fails
# result: the "documentdb" "cluster" will be in "FAILED" state
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "CREATING"
# guard_violation: the "documentdb" "cluster" was not "CREATING"
atomic action FailClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                cluster_status[cid] = "FAILED"

# step: a "documentdb" "cluster" configuration is modified
# result: the "documentdb" "cluster" will be in "MODIFYING" state
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
atomic action ModifyDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: a "documentdb" "cluster" modification completes
# result: the "documentdb" "cluster" returns to AVAILABLE state
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "MODIFYING"
# guard_violation: the "documentdb" "cluster" was not "MODIFYING"
atomic action CompleteClusterModification:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a "documentdb" "cluster" is deleted
# result: the "documentdb" "cluster" will be in "DELETING" state
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the "documentdb" "cluster" has no non-deleted instances
# guard_violation_lifecycle: the "documentdb" "cluster" has non-deleted instances
atomic action DeleteDBCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if all([iid not in instance_status or instance_cluster[iid] != cid or instance_status[iid] == "DELETED" for iid in INSTANCE_IDS]):
                    cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a "documentdb" "cluster" deletion completes
# result: the "documentdb" "cluster" will be "DELETED"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "DELETING"
# guard_violation: the "documentdb" "cluster" was not "DELETING"
atomic action CompleteClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_status[sid] == "CREATING":
                            if snapshot_cluster[sid] == cid:
                                snapshot_status[sid] = "DELETED"

# step: a "documentdb" "instance" is created in an available documentdb cluster
# result: the "documentdb" "instance" will be in "CREATING" state and associated with the "documentdb" "cluster"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the "documentdb" "instance" slot is available
# guard_violation: the "documentdb" "instance" slot is not available
atomic action CreateDBInstance:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof iid in INSTANCE_IDS:
                    if iid not in instance_status:
                        instance_status[iid] = "CREATING"
                        instance_cluster[iid] = cid
                        if cluster_primary_instance[cid] == "":
                            instance_is_primary[iid] = True
                        else:
                            instance_is_primary[iid] = False

# fake_skip: internal
# step: a "documentdb" "instance" finishes creating
# result: the "documentdb" "instance" will be "AVAILABLE" and the "documentdb" "cluster" primary will be updated if applicable
# guard: the "documentdb" "instance" existed
# guard_violation: the "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" was "CREATING"
# guard_violation: the "documentdb" "instance" was not "CREATING"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "instance" is the primary
# guard_violation: the "documentdb" "instance" is not the primary
atomic action CompleteInstanceCreation:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "CREATING":
                instance_status[iid] = "AVAILABLE"
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if instance_is_primary[iid]:
                        cluster_primary_instance[cid] = iid

# step: a "documentdb" "instance" configuration is modified
# result: the "documentdb" "instance" will be in "MODIFYING" state
# guard: the "documentdb" "instance" existed
# guard_violation: the "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "instance" was not "AVAILABLE"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
atomic action ModifyDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_status[cid] == "AVAILABLE":
                        instance_status[iid] = "MODIFYING"

# fake_skip: internal
# step: a "documentdb" "instance" modification completes
# result: the "documentdb" "instance" returns to AVAILABLE state
# guard: the "documentdb" "instance" existed
# guard_violation: the "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" was "MODIFYING"
# guard_violation: the "documentdb" "instance" was not "MODIFYING"
atomic action CompleteInstanceModification:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "MODIFYING":
                instance_status[iid] = "AVAILABLE"

# step: a "documentdb" "instance" is deleted
# result: the "documentdb" "instance" will be in "DELETING" state
# guard: the "documentdb" "instance" existed
# guard_violation: the "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "instance" was not "AVAILABLE"
atomic action DeleteDBInstance:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "AVAILABLE":
                instance_status[iid] = "DELETING"

# fake_skip: internal
# step: a "documentdb" "instance" deletion completes
# result: the "documentdb" "instance" will be "DELETED" and the "documentdb" "cluster" primary will be cleared if applicable
# guard: the "documentdb" "instance" existed
# guard_violation: the "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" was "DELETING"
# guard_violation: the "documentdb" "instance" was not "DELETING"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "instance" is the primary of the "documentdb" "cluster"
# guard_violation: the "documentdb" "instance" is not the primary of the "documentdb" "cluster"
atomic action CompleteInstanceDeletion:
    oneof iid in INSTANCE_IDS:
        if iid in instance_status:
            if instance_status[iid] == "DELETING":
                instance_status[iid] = "DELETED"
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_primary_instance[cid] == iid:
                        cluster_primary_instance[cid] = ""

# step: a "documentdb" "cluster" documentdb snapshot is created
# result: the "documentdb" "snapshot" will be in "CREATING" state and linked to the "documentdb" "cluster"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the "documentdb" "snapshot" slot is available
# guard_violation: the "documentdb" "snapshot" slot is not available
atomic action CreateDBClusterSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof sid in SNAPSHOT_IDS:
                    if sid not in snapshot_status:
                        snapshot_status[sid] = "CREATING"
                        snapshot_cluster[sid] = cid

# fake_skip: internal
# step: a "documentdb" "cluster" documentdb snapshot finishes creating
# result: the "documentdb" "snapshot" will be "AVAILABLE"
# guard: the "documentdb" "snapshot" existed
# guard_violation: the "documentdb" "snapshot" did not exist
# guard: the "documentdb" "snapshot" was "CREATING"
# guard_violation: the "documentdb" "snapshot" was not "CREATING"
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"

# step: a "documentdb" "cluster" documentdb snapshot is deleted
# result: the "documentdb" "snapshot" will be in "DELETING" state
# guard: the "documentdb" "snapshot" existed
# guard_violation: the "documentdb" "snapshot" did not exist
# guard: the "documentdb" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "snapshot" was not "AVAILABLE"
atomic action DeleteDBClusterSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a "documentdb" "cluster" documentdb snapshot deletion completes
# result: the "documentdb" "snapshot" will be "DELETED"
# guard: the "documentdb" "snapshot" existed
# guard_violation: the "documentdb" "snapshot" did not exist
# guard: the "documentdb" "snapshot" was "DELETING"
# guard_violation: the "documentdb" "snapshot" was not "DELETING"
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"

# step: a "documentdb" "cluster" is restored from a "documentdb" "snapshot"
# result: the restored "documentdb" "cluster" will be in "RESTORING" state
# guard: the "documentdb" "snapshot" existed
# guard_violation: the "documentdb" "snapshot" did not exist
# guard: the "documentdb" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "snapshot" was not "AVAILABLE"
# guard: the target "documentdb" "cluster" slot is available
# guard_violation: the target "documentdb" "cluster" slot is not available
atomic action RestoreDBClusterFromSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_primary_instance[cid] = ""

# fake_skip: internal
# step: a "documentdb" "cluster" restore from documentdb snapshot completes
# result: the "documentdb" "cluster" will be "AVAILABLE"
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "RESTORING"
# guard_violation: the "documentdb" "cluster" was not "RESTORING"
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# fake_skip: internal
# Failover: pick a replica instance to become the new primary
# step: a "documentdb" "cluster" failover is triggered and a replica is promoted to primary
# result: the "documentdb" "cluster" has a new primary documentdb instance
# guard: the "documentdb" "cluster" existed
# guard_violation: the "documentdb" "cluster" did not exist
# guard: the "documentdb" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "cluster" was not "AVAILABLE"
# guard: the new primary "documentdb" "instance" existed
# guard_violation: the new primary "documentdb" "instance" did not exist
# guard: the "documentdb" "instance" belongs to this documentdb cluster
# guard_violation: the "documentdb" "instance" does not belong to this documentdb cluster
# guard: the "documentdb" "instance" was not already the primary
# guard_violation: the "documentdb" "instance" was already the primary
# guard: the "documentdb" "instance" was "AVAILABLE"
# guard_violation_lifecycle: the "documentdb" "instance" was not "AVAILABLE"
atomic action Failover:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                oneof new_primary in INSTANCE_IDS:
                    if new_primary in instance_status:
                        if instance_cluster[new_primary] == cid:
                            if not instance_is_primary[new_primary]:
                                if instance_status[new_primary] == "AVAILABLE":
                                    old_primary = cluster_primary_instance[cid]
                                    cluster_primary_instance[cid] = new_primary
                                    instance_is_primary[new_primary] = True
                                    if old_primary != "":
                                        instance_is_primary[old_primary] = False

# Safety: cluster statuses are valid
# check: every "documentdb" "cluster" has a valid status
always assertion ValidClusterStatus:
    for cid in cluster_status:
        s = cluster_status[cid]
        if s != "CREATING" and s != "AVAILABLE" and s != "MODIFYING" and s != "DELETING" and s != "FAILED" and s != "RESTORING" and s != "DELETED":
            return False
    return True

# Safety: instance statuses are valid
# check: every "documentdb" "instance" has a valid status
always assertion ValidInstanceStatus:
    for iid in instance_status:
        s = instance_status[iid]
        if s != "CREATING" and s != "AVAILABLE" and s != "MODIFYING" and s != "DELETING" and s != "DELETED":
            return False
    return True

# Safety: snapshot statuses are valid
# check: every "documentdb" "snapshot" has a valid status
always assertion ValidSnapshotStatus:
    for sid in snapshot_status:
        s = snapshot_status[sid]
        if s != "CREATING" and s != "AVAILABLE" and s != "DELETING" and s != "DELETED":
            return False
    return True

# Safety: DELETED clusters should not have non-deleted instances
# check: a deleted "documentdb" "cluster" has no non-deleted "documentdb" "instance"s
always assertion NoNonDeletedInstancesOnDeletedCluster:
    for cid in cluster_status:
        if cluster_status[cid] == "DELETED":
            for iid in INSTANCE_IDS:
                if iid in instance_status:
                    if iid in instance_cluster:
                        if instance_cluster[iid] == cid:
                            if instance_status[iid] != "DELETED":
                                return False
    return True

# Safety: a FAILED cluster should not have AVAILABLE instances
# check: a failed "documentdb" "cluster" has no available "documentdb" "instance"s
always assertion NoAvailableInstancesOnFailedCluster:
    for cid in cluster_status:
        if cluster_status[cid] == "FAILED":
            for iid in instance_status:
                if iid in instance_cluster:
                    if instance_cluster[iid] == cid:
                        if instance_status[iid] == "AVAILABLE":
                            return False
    return True

# Safety: instances on a DELETING cluster should not be CREATING
# check: a deleting "documentdb" "cluster" receives no new "documentdb" "instance"s
always assertion DeletingClusterGetsNoNewInstances:
    for iid in instance_status:
        if instance_status[iid] == "CREATING":
            if iid in instance_cluster:
                cid = instance_cluster[iid]
                if cid in cluster_status:
                    if cluster_status[cid] == "DELETING":
                        return False
    return True

# Safety: a CREATING snapshot must reference a cluster that still exists (not DELETED)
# check: every creating "documentdb" "snapshot" references a "documentdb" "cluster" that has not been deleted
always assertion SnapshotHasValidClusterReference:
    for sid in snapshot_status:
        if snapshot_status[sid] == "CREATING":
            cid = snapshot_cluster[sid]
            if cid in cluster_status:
                if cluster_status[cid] == "DELETED":
                    return False
    return True
