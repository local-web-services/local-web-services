---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 14
---
# AWS Organizations Formal Specification
# Models the organization, root, organizational units (OUs), accounts,
# service control policies (SCPs), and policy attachments.
#
# State is tracked in a unified node_status dict that covers:
#   - the root node (ROOT_ID)
#   - organizational units (OU_IDS)
#   - accounts (ACCOUNT_IDS)
#
# Parent relationships are tracked in node_parent (OU and account parents).
# Policy attachments use compound keys: pol_id + "#" + target_id.

ROOT_ID = "root-1"
OU_IDS = ["ou-1", "ou-2"]
ACCOUNT_IDS = ["acc-1", "acc-2"]
POLICY_IDS = ["pol-1"]
PARENT_IDS = ["root-1", "ou-1", "ou-2"]
ALL_MEMBER_IDS = ["root-1", "ou-1", "ou-2", "acc-1", "acc-2"]

action Init:
    org_status = {}
    node_status = {}
    node_parent = {}
    policy_status = {}
    policy_attached = {}

# step: an organization is created
# result: the organization and its root exist
# guard: the organization does not already exist
# guard_violation: the organization already exists
atomic action CreateOrganization:
    if "org-1" not in org_status:
        org_status["org-1"] = "ACTIVE"
        node_status[ROOT_ID] = "ACTIVE"

# step: an organizational unit is created under a parent
# result: the organizational unit is ACTIVE
# guard: the organization exists
# guard_violation: the organization does not exist
# guard: the parent exists and is ACTIVE
# guard_violation: the parent does not exist or is not ACTIVE
# guard: the organizational unit does not already exist
# guard_violation: the organizational unit already exists
atomic action CreateOrganizationalUnit:
    if "org-1" in org_status:
        oneof ou_id in OU_IDS:
            if ou_id not in node_status:
                oneof parent_id in PARENT_IDS:
                    if parent_id in node_status:
                        if node_status[parent_id] == "ACTIVE":
                            node_status[ou_id] = "ACTIVE"
                            node_parent[ou_id] = parent_id

# step: an organizational unit is deleted
# result: the organizational unit is DELETED
# guard: the organizational unit exists and is ACTIVE
# guard_violation: the organizational unit does not exist or is not ACTIVE
# guard: the organizational unit has no child accounts
# guard_violation: the organizational unit has child accounts
# guard: the organizational unit has no child organizational units
# guard_violation: the organizational unit has child organizational units
# guard: the organizational unit has no attached policies
# guard_violation: the organizational unit has attached policies
atomic action DeleteOrganizationalUnit:
    oneof ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "ACTIVE":
                if all([acc_id not in node_parent or node_parent[acc_id] != ou_id for acc_id in ACCOUNT_IDS]):
                    if all([child_id not in node_parent or node_parent[child_id] != ou_id for child_id in OU_IDS]):
                        if all([(pol_id + "#" + ou_id) not in policy_attached or policy_attached[pol_id + "#" + ou_id] == False for pol_id in POLICY_IDS]):
                            node_status[ou_id] = "DELETED"

# step: an account is created in the organization
# result: the account is ACTIVE under the root
# guard: the organization exists
# guard_violation: the organization does not exist
# guard: the account does not already exist
# guard_violation: the account already exists
atomic action CreateAccount:
    if "org-1" in org_status:
        oneof acc_id in ACCOUNT_IDS:
            if acc_id not in node_status:
                node_status[acc_id] = "ACTIVE"
                node_parent[acc_id] = ROOT_ID

# step: an account is moved to a new parent
# result: the account is under the new parent
# guard: the account exists and is ACTIVE
# guard_violation: the account does not exist or is not ACTIVE
# guard: the source parent matches the account's current parent
# guard_violation: the source parent does not match the account's current parent
# guard: the destination parent is ACTIVE
# guard_violation: the destination parent is not ACTIVE
atomic action MoveAccount:
    oneof acc_id in ACCOUNT_IDS:
        if acc_id in node_status:
            if node_status[acc_id] == "ACTIVE":
                oneof src_id in PARENT_IDS:
                    if acc_id in node_parent:
                        if node_parent[acc_id] == src_id:
                            oneof dst_id in PARENT_IDS:
                                if dst_id in node_status:
                                    if node_status[dst_id] == "ACTIVE":
                                        if dst_id != src_id:
                                            node_parent[acc_id] = dst_id

# step: a service control policy is created
# result: the policy is ACTIVE
# guard: the organization exists
# guard_violation: the organization does not exist
# guard: the policy does not already exist
# guard_violation: the policy already exists
atomic action CreatePolicy:
    if "org-1" in org_status:
        oneof pol_id in POLICY_IDS:
            if pol_id not in policy_status:
                policy_status[pol_id] = "ACTIVE"

# step: a policy is attached to a target
# result: the policy is attached to the target
# guard: the policy exists and is ACTIVE
# guard_violation: the policy does not exist or is not ACTIVE
# guard: the target exists and is ACTIVE
# guard_violation: the target does not exist or is not ACTIVE
# guard: the policy is not already attached to the target
# guard_violation: the policy is already attached to the target
atomic action AttachPolicy:
    oneof pol_id in POLICY_IDS:
        if pol_id in policy_status:
            if policy_status[pol_id] == "ACTIVE":
                oneof target_id in ALL_MEMBER_IDS:
                    if target_id in node_status:
                        if node_status[target_id] == "ACTIVE":
                            if (pol_id + "#" + target_id) not in policy_attached:
                                policy_attached[pol_id + "#" + target_id] = True

# step: a policy is detached from a target
# result: the policy is no longer attached to the target
# guard: the policy is attached to the target
# guard_violation: the policy is not attached to the target
atomic action DetachPolicy:
    oneof pol_id in POLICY_IDS:
        oneof target_id in ALL_MEMBER_IDS:
            if (pol_id + "#" + target_id) in policy_attached:
                if policy_attached[pol_id + "#" + target_id] == True:
                    policy_attached[pol_id + "#" + target_id] = False

# check: the root is ACTIVE whenever the organization exists
always assertion OrgRootConsistency:
    if "org-1" in org_status:
        if ROOT_ID not in node_status:
            return False
        if node_status[ROOT_ID] != "ACTIVE":
            return False
    return True

# check: every active account has an ACTIVE parent
always assertion AccountParentValid:
    for acc_id in ACCOUNT_IDS:
        if acc_id in node_status:
            if node_status[acc_id] == "ACTIVE":
                if acc_id not in node_parent:
                    return False
                if node_parent[acc_id] not in node_status:
                    return False
                if node_status[node_parent[acc_id]] != "ACTIVE":
                    return False
    return True

# check: every active organizational unit has an ACTIVE parent
always assertion OuParentValid:
    for ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "ACTIVE":
                if ou_id not in node_parent:
                    return False
                if node_parent[ou_id] not in node_status:
                    return False
                if node_status[node_parent[ou_id]] != "ACTIVE":
                    return False
    return True

# check: no active node is a child of a deleted organizational unit
always assertion NoChildOfDeletedOu:
    for ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "DELETED":
                for acc_id in ACCOUNT_IDS:
                    if acc_id in node_parent:
                        if node_parent[acc_id] == ou_id:
                            return False
                for child_id in OU_IDS:
                    if child_id in node_parent:
                        if node_parent[child_id] == ou_id:
                            return False
    return True

# check: every active policy attachment targets an ACTIVE node
always assertion PolicyAttachmentTargetValid:
    for pol_id in POLICY_IDS:
        for target_id in ALL_MEMBER_IDS:
            key = pol_id + "#" + target_id
            if key in policy_attached:
                if policy_attached[key] == True:
                    if target_id not in node_status:
                        return False
                    if node_status[target_id] != "ACTIVE":
                        return False
    return True
