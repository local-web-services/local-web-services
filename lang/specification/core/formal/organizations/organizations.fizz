---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 14
---
# AWS Organizations Formal Specification
# Models the organization, root, organizational units (OUs), accounts,
# service control policies (SCPs), and policy attachments.
#
# State is tracked in a unified node_status dict that covers:
#   - the root node (ROOT_ID)
#   - organizational units (OU_IDS)
#   - accounts (ACCOUNT_IDS)
#
# Parent relationships are tracked in node_parent (OU and account parents).
# Policy attachments use compound keys: pol_id + "#" + target_id.

ROOT_ID = "root-1"
OU_IDS = ["ou-1", "ou-2"]
ACCOUNT_IDS = ["acc-1", "acc-2"]
POLICY_IDS = ["pol-1"]
PARENT_IDS = ["root-1", "ou-1", "ou-2"]
ALL_MEMBER_IDS = ["root-1", "ou-1", "ou-2", "acc-1", "acc-2"]
TAG_RESOURCE_IDS = ["acc-1"]

action Init:
    org_status = {}
    node_status = {}
    node_parent = {}
    policy_status = {}
    policy_attached = {}
    resource_tags_set = {}

# step: an "organizations" "organization" is created
# result: the "organizations" "organization" and its root will exist
# guard: the "organizations" "organization" did not already exist
# guard_violation: the "organizations" "organization" already existed
atomic action CreateOrganization:
    if "org-1" not in org_status:
        org_status["org-1"] = "ACTIVE"
        node_status[ROOT_ID] = "ACTIVE"

# step: an "organizations" "organizational unit" is created under a parent
# result: the "organizations" "organizational unit" will be "ACTIVE"
# guard: the "organizations" "organization" existed
# guard_violation: the "organizations" "organization" did not exist
# guard: the "organizations" "parent" existed and was "ACTIVE"
# guard_violation: the "organizations" "parent" did not exist or was "ACTIVE"
# guard: the "organizations" "organizational unit" did not already exist
# guard_violation: the "organizations" "organizational unit" already existed
atomic action CreateOrganizationalUnit:
    if "org-1" in org_status:
        oneof ou_id in OU_IDS:
            if ou_id not in node_status:
                oneof parent_id in PARENT_IDS:
                    if parent_id in node_status:
                        if node_status[parent_id] == "ACTIVE":
                            node_status[ou_id] = "ACTIVE"
                            node_parent[ou_id] = parent_id

# step: an "organizations" "organizational unit" is deleted
# result: the "organizations" "organizational unit" will be "DELETED"
# guard: the "organizations" "organizational unit" existed and was "ACTIVE"
# guard_violation: the "organizations" "organizational unit" did not exist or was "ACTIVE"
# guard: the "organizations" "organizational unit" has no child accounts
# guard_violation: the "organizations" "organizational unit" has child accounts
# guard: the "organizations" "organizational unit" has no child organizational units
# guard_violation: the "organizations" "organizational unit" has child organizational units
# guard: the "organizations" "organizational unit" has no attached policies
# guard_violation: the "organizations" "organizational unit" has attached policies
atomic action DeleteOrganizationalUnit:
    oneof ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "ACTIVE":
                if all([acc_id not in node_parent or node_parent[acc_id] != ou_id for acc_id in ACCOUNT_IDS]):
                    if all([child_id not in node_parent or node_parent[child_id] != ou_id for child_id in OU_IDS]):
                        if all([(pol_id + "#" + ou_id) not in policy_attached or policy_attached[pol_id + "#" + ou_id] == False for pol_id in POLICY_IDS]):
                            node_status[ou_id] = "DELETED"

# step: an "organizations" "account" is created in the "organizations" "organization"
# result: the "organizations" "account" will be "ACTIVE" under the root
# guard: the "organizations" "organization" existed
# guard_violation: the "organizations" "organization" did not exist
# guard: the "organizations" "account" did not already exist
# guard_violation: the "organizations" "account" already existed
atomic action CreateAccount:
    if "org-1" in org_status:
        oneof acc_id in ACCOUNT_IDS:
            if acc_id not in node_status:
                node_status[acc_id] = "ACTIVE"
                node_parent[acc_id] = ROOT_ID

# step: an "organizations" "account" is moved to a new parent
# result: the "organizations" "account" will be under the new parent
# guard: the "organizations" "account" existed and was "ACTIVE"
# guard_violation: the "organizations" "account" did not exist or was "ACTIVE"
# guard: the source parent matched the "organizations" "account"'s current parent
# guard_violation: the source parent did not match the "organizations" "account"'s current parent
# guard: the destination "organizations" "parent" was "ACTIVE"
# guard_violation: the destination "organizations" "parent" was not "ACTIVE"
atomic action MoveAccount:
    oneof acc_id in ACCOUNT_IDS:
        if acc_id in node_status:
            if node_status[acc_id] == "ACTIVE":
                oneof src_id in PARENT_IDS:
                    if acc_id in node_parent:
                        if node_parent[acc_id] == src_id:
                            oneof dst_id in PARENT_IDS:
                                if dst_id in node_status:
                                    if node_status[dst_id] == "ACTIVE":
                                        if dst_id != src_id:
                                            node_parent[acc_id] = dst_id

# step: an "organizations" "policy" is created
# result: the "organizations" "policy" will be "ACTIVE"
# guard: the "organizations" "organization" existed
# guard_violation: the "organizations" "organization" did not exist
# guard: the "organizations" "policy" did not already exist
# guard_violation: the "organizations" "policy" already existed
atomic action CreatePolicy:
    if "org-1" in org_status:
        oneof pol_id in POLICY_IDS:
            if pol_id not in policy_status:
                policy_status[pol_id] = "ACTIVE"

# step: an "organizations" "policy" is attached to a target
# result: the "organizations" "policy" will be attached to the "organizations" "target"
# guard: the "organizations" "policy" existed and was "ACTIVE"
# guard_violation: the "organizations" "policy" did not exist or was "ACTIVE"
# guard: the "organizations" "target" existed and was "ACTIVE"
# guard_violation: the "organizations" "target" did not exist or was "ACTIVE"
# guard: the "organizations" "policy" was not already attached to the "organizations" "target"
# guard_violation: the "organizations" "policy" was already attached to the "organizations" "target"
atomic action AttachPolicy:
    oneof pol_id in POLICY_IDS:
        if pol_id in policy_status:
            if policy_status[pol_id] == "ACTIVE":
                oneof target_id in ALL_MEMBER_IDS:
                    if target_id in node_status:
                        if node_status[target_id] == "ACTIVE":
                            if (pol_id + "#" + target_id) not in policy_attached:
                                policy_attached[pol_id + "#" + target_id] = True

# step: an "organizations" "policy" is detached from a target
# result: the "organizations" "policy" will no longer be attached to the "organizations" "target"
# guard: the "organizations" "policy" is attached to the "organizations" "target"
# guard_violation: the "organizations" "policy" is not attached to the "organizations" "target"
atomic action DetachPolicy:
    oneof pol_id in POLICY_IDS:
        oneof target_id in ALL_MEMBER_IDS:
            if (pol_id + "#" + target_id) in policy_attached:
                if policy_attached[pol_id + "#" + target_id] == True:
                    policy_attached[pol_id + "#" + target_id] = False

# step: an "organizations" resource is tagged
# result: the "organizations" resource tags will be set
# guard: the "organizations" resource existed
# guard_violation: the "organizations" resource did not exist
atomic action TagResource:
    oneof node_id in TAG_RESOURCE_IDS:
        if node_id in node_status:
            resource_tags_set[node_id] = True

# check: the root was "ACTIVE" whenever the "organizations" "organization" exists
always assertion OrgRootConsistency:
    if "org-1" in org_status:
        if ROOT_ID not in node_status:
            return False
        if node_status[ROOT_ID] != "ACTIVE":
            return False
    return True

# check: every active account has an ACTIVE parent
always assertion AccountParentValid:
    for acc_id in ACCOUNT_IDS:
        if acc_id in node_status:
            if node_status[acc_id] == "ACTIVE":
                if acc_id not in node_parent:
                    return False
                if node_parent[acc_id] not in node_status:
                    return False
                if node_status[node_parent[acc_id]] != "ACTIVE":
                    return False
    return True

# check: every active organizational unit has an ACTIVE parent
always assertion OuParentValid:
    for ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "ACTIVE":
                if ou_id not in node_parent:
                    return False
                if node_parent[ou_id] not in node_status:
                    return False
                if node_status[node_parent[ou_id]] != "ACTIVE":
                    return False
    return True

# check: no active node is a child of a deleted organizational unit
always assertion NoChildOfDeletedOu:
    for ou_id in OU_IDS:
        if ou_id in node_status:
            if node_status[ou_id] == "DELETED":
                for acc_id in ACCOUNT_IDS:
                    if acc_id in node_parent:
                        if node_parent[acc_id] == ou_id:
                            return False
                for child_id in OU_IDS:
                    if child_id in node_parent:
                        if node_parent[child_id] == ou_id:
                            return False
    return True

# check: tags only exist on nodes that are present in the org
always assertion TagsOnlyForKnownNodes:
    for node_id in ALL_MEMBER_IDS:
        if node_id in resource_tags_set:
            if resource_tags_set[node_id] == True:
                if node_id not in node_status:
                    return False
    return True

# check: every active policy attachment targets an ACTIVE node
always assertion PolicyAttachmentTargetValid:
    for pol_id in POLICY_IDS:
        for target_id in ALL_MEMBER_IDS:
            key = pol_id + "#" + target_id
            if key in policy_attached:
                if policy_attached[key] == True:
                    if target_id not in node_status:
                        return False
                    if node_status[target_id] != "ACTIVE":
                        return False
    return True
