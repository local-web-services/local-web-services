---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 10
---
RECORD_IDS = ["r1", "r2", "r3"]

action Init:
    provisioned = {}

# step: a "service catalog" "product" is provisioned
# result: the "service catalog" "record" will be "SUCCEEDED"
# guard: a "service catalog" "product" and "launch path" existed
# guard_violation: the "service catalog" "product" did not exist
atomic action ProvisionProduct:
    oneof rid in RECORD_IDS:
        if rid not in provisioned:
            provisioned[rid] = "SUCCEEDED"

# check: every "service catalog" "record" has status "SUCCEEDED"
always assertion RecordAlwaysSucceeded:
    for rid in provisioned:
        if provisioned[rid] != "SUCCEEDED":
            return False
    return True

# check: every "service catalog" "provisioned product" has an associated "record"
always assertion ProvisionedProductHasRecord:
    for rid in provisioned:
        if provisioned[rid] not in ["SUCCEEDED", "FAILED"]:
            return False
    return True
