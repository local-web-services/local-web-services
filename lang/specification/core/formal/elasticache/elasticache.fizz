---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# Amazon ElastiCache formal specification
# Models cache clusters, replication groups, snapshots, parameter groups, subnet groups

CLUSTER_IDS = ["c1", "c2", "c3", "c4", "c5", "c6"]
RG_IDS = ["rg1", "rg2", "rg3"]
SNAPSHOT_IDS = ["snap1", "snap2", "snap3"]
PG_IDS = ["pg1", "pg2", "pg3"]
SG_IDS = ["sg1", "sg2", "sg3"]

action Init:
    cluster_status = {}
    cluster_engine = {}
    cluster_rg = {}

    rg_status = {}
    rg_primary = {}
    rg_auto_failover = {}

    snapshot_status = {}
    snapshot_cluster = {}

    pg_exists = {}
    sg_exists = {}

    tag_exists = {}

# step: a redis "elasticache" "cluster" is created
# result: the "elasticache" "cluster" will be in "CREATING" state
# guard: the "elasticache" "cluster" did not already exist
# guard_violation: the "elasticache" "cluster" already existed
atomic action CreateCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_engine[cid] = "redis"
            cluster_rg[cid] = ""
            tag_exists[cid] = True

# step: a memcached "elasticache" "cluster" is created
# result: the "elasticache" "cluster" will be in "CREATING" state with the memcached engine
# guard: the "elasticache" "cluster" did not already exist
# guard_violation: the "elasticache" "cluster" already existed
atomic action CreateMemcachedCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_engine[cid] = "memcached"
            cluster_rg[cid] = ""
            tag_exists[cid] = True

# fake_skip: internal
# step: a standalone "elasticache" "cluster" finishes creating
# result: the "elasticache" "cluster" will be "AVAILABLE"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "CREATING"
# guard_violation: the "elasticache" "cluster" was not "CREATING"
# guard: the "elasticache" "cluster" is standalone (not part of a "elasticache" "replication group")
# guard_violation: the "elasticache" "cluster" is part of a "elasticache" "replication group"
atomic action CompleteCacheClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                if cluster_rg[cid] == "":
                    cluster_status[cid] = "AVAILABLE"

# step: an "elasticache" "cluster" configuration is modified
# result: the "elasticache" "cluster" will be in "MODIFYING" state
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
atomic action ModifyCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: an "elasticache" "cluster" modification completes
# result: the "elasticache" "cluster" returns to "AVAILABLE" state
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "MODIFYING"
# guard_violation: the "elasticache" "cluster" was not "MODIFYING"
atomic action CompleteCacheClusterModification:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a standalone "elasticache" "cluster" is deleted
# result: the "elasticache" "cluster" will be in "DELETING" state
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
# guard: the "elasticache" "cluster" is standalone (not part of a "elasticache" "replication group")
# guard_violation: the "elasticache" "cluster" is part of a "elasticache" "replication group"
atomic action DeleteCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_rg[cid] == "":
                    cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: an "elasticache" "cluster" deletion completes
# result: the "elasticache" "cluster" will be "DELETED" and its tags will be removed
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "DELETING"
# guard_violation: the "elasticache" "cluster" was not "DELETING"
atomic action CompleteCacheClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"
                tag_exists[cid] = False

# step: a "elasticache" "replication group" is created
# result: the "elasticache" "replication group" will be in "CREATING" state
# guard: the "elasticache" "replication group" did not already exist
# guard_violation: the "elasticache" "replication group" already existed
atomic action CreateReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid not in rg_status:
            rg_status[rgid] = "CREATING"
            rg_primary[rgid] = ""
            rg_auto_failover[rgid] = True
            tag_exists[rgid] = True

# fake_skip: internal
# step: a "elasticache" "replication group" finishes creating
# result: the "elasticache" "replication group" and its primary "elasticache" "cluster" are "AVAILABLE"
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "CREATING"
# guard_violation: the "elasticache" "replication group" was not "CREATING"
# guard: an "elasticache" "cluster" slot is available for the primary
# guard_violation: no "elasticache" "cluster" slot is available for the primary
atomic action CompleteReplicationGroupCreation:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "CREATING":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "AVAILABLE"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = rgid
                        tag_exists[cid] = True
                        rg_primary[rgid] = cid
                        rg_status[rgid] = "AVAILABLE"

# step: a "elasticache" "replication group" configuration is modified
# result: the "elasticache" "replication group" will be in "MODIFYING" state
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "replication group" was not "AVAILABLE"
atomic action ModifyReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                rg_status[rgid] = "MODIFYING"

# fake_skip: internal
# step: a "elasticache" "replication group" modification completes
# result: the "elasticache" "replication group" returns to "AVAILABLE" state
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "MODIFYING"
# guard_violation: the "elasticache" "replication group" was not "MODIFYING"
atomic action CompleteReplicationGroupModification:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "MODIFYING":
                rg_status[rgid] = "AVAILABLE"

# step: a "elasticache" "replication group" is deleted
# result: the "elasticache" "replication group" and its clusters are in "DELETING" state
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "replication group" was not "AVAILABLE"
# guard: an "elasticache" "cluster" belongs to this replication group
# guard_violation: no "elasticache" "cluster" belongs to this replication group
# guard: the "elasticache" "cluster" is part of this replication group
# guard_violation: the "elasticache" "cluster" is not part of this replication group
atomic action DeleteReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                rg_status[rgid] = "DELETING"
                for cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_rg[cid] == rgid:
                            cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a "elasticache" "replication group" deletion completes
# result: the "elasticache" "replication group" will be "DELETED" and its tags will be removed
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "DELETING"
# guard_violation: the "elasticache" "replication group" was not "DELETING"
atomic action CompleteReplicationGroupDeletion:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "DELETING":
                rg_status[rgid] = "DELETED"
                tag_exists[rgid] = False

# fake_skip: internal
# step: an automatic failover promotes a new primary in a "elasticache" "replication group"
# result: the "elasticache" "replication group" has a new primary "elasticache" "cluster"
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "replication group" was not "AVAILABLE"
# guard: automatic failover was "ENABLED"
# guard_violation: automatic failover was not "ENABLED"
# guard: a replica "elasticache" "cluster" existed
# guard_violation: no replica "elasticache" "cluster" existed
# guard: the "elasticache" "cluster" is part of this replication group
# guard_violation: the "elasticache" "cluster" is not part of this replication group
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
# guard: the "elasticache" "cluster" was not already the primary
# guard_violation: the "elasticache" "cluster" was already the primary
atomic action FailoverReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                if rg_auto_failover[rgid]:
                    oneof cid in CLUSTER_IDS:
                        if cid in cluster_status:
                            if cluster_rg[cid] == rgid:
                                if cluster_status[cid] == "AVAILABLE":
                                    if cid != rg_primary[rgid]:
                                        rg_primary[rgid] = cid

# step: a replica is added to a "elasticache" "replication group"
# result: a new "elasticache" "cluster" will be in "CREATING" state and associated with the "elasticache" "replication group"
# guard: the "elasticache" "replication group" existed
# guard_violation: the "elasticache" "replication group" did not exist
# guard: the "elasticache" "replication group" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "replication group" was not "AVAILABLE"
# guard: an "elasticache" "cluster" slot is available
# guard_violation: no "elasticache" "cluster" slot is available
atomic action AddReplicaToCacheCluster:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "CREATING"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = rgid
                        tag_exists[cid] = True

# fake_skip: internal
# step: a replica creation in a "elasticache" "replication group" completes
# result: the replica "elasticache" "cluster" will be "AVAILABLE"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "CREATING"
# guard_violation: the "elasticache" "cluster" was not "CREATING"
# guard: the "elasticache" "cluster" is part of a "elasticache" "replication group"
# guard_violation: the "elasticache" "cluster" is not part of a "elasticache" "replication group"
atomic action CompleteReplicaCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                if cluster_rg[cid] != "":
                    cluster_status[cid] = "AVAILABLE"

# step: an "elasticache" "snapshot" is created from an available redis "elasticache" "cluster"
# result: the "elasticache" "snapshot" will be in "CREATING" state and the "elasticache" "cluster" will be "SNAPSHOTTING"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "cluster" was not "AVAILABLE"
# guard: the "elasticache" "cluster" uses the redis engine
# guard_violation: the "elasticache" "cluster" does not use the redis engine
# guard: the "elasticache" "snapshot" slot is available
# guard_violation: the "elasticache" "snapshot" slot is not available
atomic action CreateSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_engine[cid] == "redis":
                    oneof sid in SNAPSHOT_IDS:
                        if sid not in snapshot_status:
                            snapshot_status[sid] = "CREATING"
                            snapshot_cluster[sid] = cid
                            tag_exists[sid] = True
                            cluster_status[cid] = "SNAPSHOTTING"

# fake_skip: internal
# step: an "elasticache" "snapshot" finishes creating
# result: the "elasticache" "snapshot" will be "AVAILABLE" and the "elasticache" "cluster" returns to "AVAILABLE" state
# guard: the "elasticache" "snapshot" existed
# guard_violation: the "elasticache" "snapshot" did not exist
# guard: the "elasticache" "snapshot" was "CREATING"
# guard_violation: the "elasticache" "snapshot" was not "CREATING"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "snapshot" belongs to this "elasticache" "cluster"
# guard_violation: the "elasticache" "snapshot" does not belong to this "elasticache" "cluster"
# guard: the "elasticache" "cluster" was "SNAPSHOTTING"
# guard_violation: the "elasticache" "cluster" was not "SNAPSHOTTING"
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if snapshot_cluster[sid] == cid:
                            if cluster_status[cid] == "SNAPSHOTTING":
                                cluster_status[cid] = "AVAILABLE"

# step: an "elasticache" "snapshot" is deleted
# result: the "elasticache" "snapshot" will be in "DELETING" state
# guard: the "elasticache" "snapshot" existed
# guard_violation: the "elasticache" "snapshot" did not exist
# guard: the "elasticache" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "snapshot" was not "AVAILABLE"
atomic action DeleteSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: an "elasticache" "snapshot" deletion completes
# result: the "elasticache" "snapshot" will be "DELETED" and its tags will be removed
# guard: the "elasticache" "snapshot" existed
# guard_violation: the "elasticache" "snapshot" did not exist
# guard: the "elasticache" "snapshot" was "DELETING"
# guard_violation: the "elasticache" "snapshot" was not "DELETING"
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"
                tag_exists[sid] = False

# step: an "elasticache" "cluster" is created from an "elasticache" "snapshot"
# result: the "elasticache" "cluster" will be in "RESTORING" state
# guard: the "elasticache" "snapshot" existed
# guard_violation: the "elasticache" "snapshot" did not exist
# guard: the "elasticache" "snapshot" was "AVAILABLE"
# guard_violation_lifecycle: the "elasticache" "snapshot" was not "AVAILABLE"
# guard: the target "elasticache" "cluster" slot is available
# guard_violation: the target "elasticache" "cluster" slot is not available
atomic action CreateCacheClusterFromSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = ""
                        tag_exists[cid] = True

# fake_skip: internal
# step: an "elasticache" "cluster" restore from "elasticache" "snapshot" completes
# result: the "elasticache" "cluster" will be "AVAILABLE"
# guard: the "elasticache" "cluster" existed
# guard_violation: the "elasticache" "cluster" did not exist
# guard: the "elasticache" "cluster" was "RESTORING"
# guard_violation: the "elasticache" "cluster" was not "RESTORING"
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# step: an "elasticache" "parameter group" is created
# result: the "elasticache" "parameter group" will exist
# guard: the "elasticache" "parameter group" did not already exist
# guard_violation: the "elasticache" "parameter group" already existed
atomic action CreateCacheParameterGroup:
    oneof pgid in PG_IDS:
        if pgid not in pg_exists:
            pg_exists[pgid] = True

# step: an "elasticache" "parameter group" is deleted
# result: the "elasticache" "parameter group" will no longer exist
# guard: the "elasticache" "parameter group" existed
# guard_violation: the "elasticache" "parameter group" did not exist
# guard: the "elasticache" "parameter group" was "present"
# guard_violation: the "elasticache" "parameter group" was not "present"
atomic action DeleteCacheParameterGroup:
    oneof pgid in PG_IDS:
        if pgid in pg_exists:
            if pg_exists[pgid]:
                pg_exists[pgid] = False

# step: an "elasticache" "subnet group" is created
# result: the "elasticache" "subnet group" will exist
# guard: the "elasticache" "subnet group" did not already exist
# guard_violation: the "elasticache" "subnet group" already existed
atomic action CreateCacheSubnetGroup:
    oneof sgid in SG_IDS:
        if sgid not in sg_exists:
            sg_exists[sgid] = True

# step: an "elasticache" "subnet group" is deleted
# result: the "elasticache" "subnet group" will no longer exist
# guard: the "elasticache" "subnet group" existed
# guard_violation: the "elasticache" "subnet group" did not exist
# guard: the "elasticache" "subnet group" was "present"
# guard_violation: the "elasticache" "subnet group" was not "present"
atomic action DeleteCacheSubnetGroup:
    oneof sgid in SG_IDS:
        if sgid in sg_exists:
            if sg_exists[sgid]:
                sg_exists[sgid] = False

# step: tags are added to an "elasticache" "resource"
# result: the "elasticache" "resource" remains tagged
# guard: the "elasticache" "resource" existed
# guard_violation: the "elasticache" "resource" did not exist
# guard: the "elasticache" "resource" has tags
# guard_violation: the "elasticache" "resource" does not have tags
atomic action AddTagsToResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# step: tags are removed from an "elasticache" "resource"
# result: the "elasticache" "resource" tag state will be unchanged (no-op model)
# guard: the "elasticache" "resource" existed
# guard_violation: the "elasticache" "resource" did not exist
# guard: the "elasticache" "resource" has tags
# guard_violation: the "elasticache" "resource" does not have tags
atomic action RemoveTagsFromResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# Memcached clusters must not belong to a replication group
# check: "memcached" "elasticache" "cluster"s are never associated with a "elasticache" "replication group"
always assertion MemcachedNotInReplicationGroup:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cluster_engine[cid] == "memcached":
                    if cluster_rg[cid] != "":
                        return False
    return True

# Snapshots can only be taken from redis clusters
# check: all "elasticache" "snapshot"s reference "redis" "elasticache" "cluster"s only
always assertion SnapshotOnlyFromRedis:
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                src = snapshot_cluster[sid]
                if src in cluster_engine:
                    if cluster_engine[src] == "memcached":
                        return False
    return True

# An available replication group must have a primary cluster set
# check: every "AVAILABLE" "elasticache" "replication group" has a primary "elasticache" "cluster" assigned
always assertion AvailableRGHasPrimary:
    for rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                if rg_primary[rgid] == "":
                    return False
    return True

# Tags exist for every active resource
# check: every active "elasticache" "cluster", "replication group", and "snapshot" has tags
always assertion TagsExistForResources:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cid not in tag_exists:
                    return False
                if not tag_exists[cid]:
                    return False
    for rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] != "DELETED":
                if rgid not in tag_exists:
                    return False
                if not tag_exists[rgid]:
                    return False
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                if sid not in tag_exists:
                    return False
                if not tag_exists[sid]:
                    return False
    return True

# A cluster in SNAPSHOTTING state must have a corresponding in-progress snapshot
# check: every snapshotting "elasticache" "cluster" has a corresponding in-progress "elasticache" "snapshot"
always assertion SnapshottingClusterHasSnapshot:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "SNAPSHOTTING":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_cluster[sid] == cid:
                            if snapshot_status[sid] == "CREATING":
                                found = True
                if not found:
                    return False
    return True
