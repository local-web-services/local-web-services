---
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 15
---
# Amazon ElastiCache formal specification
# Models cache clusters, replication groups, snapshots, parameter groups, subnet groups

CLUSTER_IDS = ["c1", "c2", "c3", "c4", "c5", "c6"]
RG_IDS = ["rg1", "rg2", "rg3"]
SNAPSHOT_IDS = ["snap1", "snap2", "snap3"]
PG_IDS = ["pg1", "pg2", "pg3"]
SG_IDS = ["sg1", "sg2", "sg3"]

action Init:
    cluster_status = {}
    cluster_engine = {}
    cluster_rg = {}

    rg_status = {}
    rg_primary = {}
    rg_auto_failover = {}

    snapshot_status = {}
    snapshot_cluster = {}

    pg_exists = {}
    sg_exists = {}

    tag_exists = {}

# step: a redis cache cluster is created
# result: the cluster is in CREATING state
# guard: the cluster does not already exist
# guard_violation: the cluster already exists
atomic action CreateCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_engine[cid] = "redis"
            cluster_rg[cid] = ""
            tag_exists[cid] = True

# step: a memcached cache cluster is created
# result: the cluster is in CREATING state with the memcached engine
# guard: the cluster does not already exist
# guard_violation: the cluster already exists
atomic action CreateMemcachedCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid not in cluster_status:
            cluster_status[cid] = "CREATING"
            cluster_engine[cid] = "memcached"
            cluster_rg[cid] = ""
            tag_exists[cid] = True

# fake_skip: internal
# step: a standalone cache cluster finishes creating
# result: the cluster is AVAILABLE
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is CREATING
# guard_violation: the cluster is not CREATING
# guard: the cluster is standalone (not part of a replication group)
# guard_violation: the cluster is part of a replication group
atomic action CompleteCacheClusterCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                if cluster_rg[cid] == "":
                    cluster_status[cid] = "AVAILABLE"

# step: a cache cluster configuration is modified
# result: the cluster is in MODIFYING state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
atomic action ModifyCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                cluster_status[cid] = "MODIFYING"

# fake_skip: internal
# step: a cache cluster modification completes
# result: the cluster returns to AVAILABLE state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is MODIFYING
# guard_violation: the cluster is not MODIFYING
atomic action CompleteCacheClusterModification:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "MODIFYING":
                cluster_status[cid] = "AVAILABLE"

# step: a standalone cache cluster is deleted
# result: the cluster is in DELETING state
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: the cluster is standalone (not part of a replication group)
# guard_violation: the cluster is part of a replication group
atomic action DeleteCacheCluster:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_rg[cid] == "":
                    cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a cache cluster deletion completes
# result: the cluster is DELETED and its tags are removed
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is DELETING
# guard_violation: the cluster is not DELETING
atomic action CompleteCacheClusterDeletion:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "DELETING":
                cluster_status[cid] = "DELETED"
                tag_exists[cid] = False

# step: a replication group is created
# result: the replication group is in CREATING state
# guard: the replication group does not already exist
# guard_violation: the replication group already exists
atomic action CreateReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid not in rg_status:
            rg_status[rgid] = "CREATING"
            rg_primary[rgid] = ""
            rg_auto_failover[rgid] = True
            tag_exists[rgid] = True

# fake_skip: internal
# step: a replication group finishes creating
# result: the replication group and its primary cluster are AVAILABLE
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is CREATING
# guard_violation: the replication group is not CREATING
# guard: a cluster slot is available for the primary
# guard_violation: no cluster slot is available for the primary
atomic action CompleteReplicationGroupCreation:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "CREATING":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "AVAILABLE"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = rgid
                        tag_exists[cid] = True
                        rg_primary[rgid] = cid
                        rg_status[rgid] = "AVAILABLE"

# step: a replication group configuration is modified
# result: the replication group is in MODIFYING state
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is AVAILABLE
# guard_violation_lifecycle: the replication group is not AVAILABLE
atomic action ModifyReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                rg_status[rgid] = "MODIFYING"

# fake_skip: internal
# step: a replication group modification completes
# result: the replication group returns to AVAILABLE state
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is MODIFYING
# guard_violation: the replication group is not MODIFYING
atomic action CompleteReplicationGroupModification:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "MODIFYING":
                rg_status[rgid] = "AVAILABLE"

# step: a replication group is deleted
# result: the replication group and its clusters are in DELETING state
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is AVAILABLE
# guard_violation_lifecycle: the replication group is not AVAILABLE
# guard: a cluster belongs to this replication group
# guard_violation: no cluster belongs to this replication group
# guard: the cluster is part of this replication group
# guard_violation: the cluster is not part of this replication group
atomic action DeleteReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                rg_status[rgid] = "DELETING"
                for cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if cluster_rg[cid] == rgid:
                            cluster_status[cid] = "DELETING"

# fake_skip: internal
# step: a replication group deletion completes
# result: the replication group is DELETED and its tags are removed
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is DELETING
# guard_violation: the replication group is not DELETING
atomic action CompleteReplicationGroupDeletion:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "DELETING":
                rg_status[rgid] = "DELETED"
                tag_exists[rgid] = False

# fake_skip: internal
# step: an automatic failover promotes a new primary in a replication group
# result: the replication group has a new primary cluster
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is AVAILABLE
# guard_violation_lifecycle: the replication group is not AVAILABLE
# guard: automatic failover is enabled
# guard_violation: automatic failover is not enabled
# guard: a replica cluster exists
# guard_violation: no replica cluster exists
# guard: the cluster is part of this replication group
# guard_violation: the cluster is not part of this replication group
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: the cluster is not already the primary
# guard_violation: the cluster is already the primary
atomic action FailoverReplicationGroup:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                if rg_auto_failover[rgid]:
                    oneof cid in CLUSTER_IDS:
                        if cid in cluster_status:
                            if cluster_rg[cid] == rgid:
                                if cluster_status[cid] == "AVAILABLE":
                                    if cid != rg_primary[rgid]:
                                        rg_primary[rgid] = cid

# step: a replica is added to a replication group
# result: a new cluster is in CREATING state and associated with the replication group
# guard: the replication group exists
# guard_violation: the replication group does not exist
# guard: the replication group is AVAILABLE
# guard_violation_lifecycle: the replication group is not AVAILABLE
# guard: a cluster slot is available
# guard_violation: no cluster slot is available
atomic action AddReplicaToCacheCluster:
    oneof rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "CREATING"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = rgid
                        tag_exists[cid] = True

# fake_skip: internal
# step: a replica creation in a replication group completes
# result: the replica cluster is AVAILABLE
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is CREATING
# guard_violation: the cluster is not CREATING
# guard: the cluster is part of a replication group
# guard_violation: the cluster is not part of a replication group
atomic action CompleteReplicaCreation:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "CREATING":
                if cluster_rg[cid] != "":
                    cluster_status[cid] = "AVAILABLE"

# step: a snapshot is created from an available redis cache cluster
# result: the snapshot is in CREATING state and the cluster is SNAPSHOTTING
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is AVAILABLE
# guard_violation_lifecycle: the cluster is not AVAILABLE
# guard: the cluster uses the redis engine
# guard_violation: the cluster does not use the redis engine
# guard: the snapshot slot is available
# guard_violation: the snapshot slot is not available
atomic action CreateSnapshot:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "AVAILABLE":
                if cluster_engine[cid] == "redis":
                    oneof sid in SNAPSHOT_IDS:
                        if sid not in snapshot_status:
                            snapshot_status[sid] = "CREATING"
                            snapshot_cluster[sid] = cid
                            tag_exists[sid] = True
                            cluster_status[cid] = "SNAPSHOTTING"

# fake_skip: internal
# step: a cache snapshot finishes creating
# result: the snapshot is AVAILABLE and the cluster returns to AVAILABLE state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is CREATING
# guard_violation: the snapshot is not CREATING
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the snapshot belongs to this cluster
# guard_violation: the snapshot does not belong to this cluster
# guard: the cluster is SNAPSHOTTING
# guard_violation: the cluster is not SNAPSHOTTING
atomic action CompleteSnapshotCreation:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "CREATING":
                snapshot_status[sid] = "AVAILABLE"
                oneof cid in CLUSTER_IDS:
                    if cid in cluster_status:
                        if snapshot_cluster[sid] == cid:
                            if cluster_status[cid] == "SNAPSHOTTING":
                                cluster_status[cid] = "AVAILABLE"

# step: a cache snapshot is deleted
# result: the snapshot is in DELETING state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is AVAILABLE
# guard_violation_lifecycle: the snapshot is not AVAILABLE
atomic action DeleteSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                snapshot_status[sid] = "DELETING"

# fake_skip: internal
# step: a cache snapshot deletion completes
# result: the snapshot is DELETED and its tags are removed
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is DELETING
# guard_violation: the snapshot is not DELETING
atomic action CompleteSnapshotDeletion:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "DELETING":
                snapshot_status[sid] = "DELETED"
                tag_exists[sid] = False

# step: a cache cluster is created from a snapshot
# result: the cluster is in RESTORING state
# guard: the snapshot exists
# guard_violation: the snapshot does not exist
# guard: the snapshot is AVAILABLE
# guard_violation_lifecycle: the snapshot is not AVAILABLE
# guard: the target cluster slot is available
# guard_violation: the target cluster slot is not available
atomic action CreateCacheClusterFromSnapshot:
    oneof sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] == "AVAILABLE":
                oneof cid in CLUSTER_IDS:
                    if cid not in cluster_status:
                        cluster_status[cid] = "RESTORING"
                        cluster_engine[cid] = "redis"
                        cluster_rg[cid] = ""
                        tag_exists[cid] = True

# fake_skip: internal
# step: a cache cluster restore from snapshot completes
# result: the cluster is AVAILABLE
# guard: the cluster exists
# guard_violation: the cluster does not exist
# guard: the cluster is RESTORING
# guard_violation: the cluster is not RESTORING
atomic action CompleteClusterRestore:
    oneof cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "RESTORING":
                cluster_status[cid] = "AVAILABLE"

# step: a cache parameter group is created
# result: the parameter group exists
# guard: the parameter group does not already exist
# guard_violation: the parameter group already exists
atomic action CreateCacheParameterGroup:
    oneof pgid in PG_IDS:
        if pgid not in pg_exists:
            pg_exists[pgid] = True

# step: a cache parameter group is deleted
# result: the parameter group no longer exists
# guard: the parameter group exists
# guard_violation: the parameter group does not exist
# guard: the parameter group is present
# guard_violation: the parameter group is not present
atomic action DeleteCacheParameterGroup:
    oneof pgid in PG_IDS:
        if pgid in pg_exists:
            if pg_exists[pgid]:
                pg_exists[pgid] = False

# step: a cache subnet group is created
# result: the subnet group exists
# guard: the subnet group does not already exist
# guard_violation: the subnet group already exists
atomic action CreateCacheSubnetGroup:
    oneof sgid in SG_IDS:
        if sgid not in sg_exists:
            sg_exists[sgid] = True

# step: a cache subnet group is deleted
# result: the subnet group no longer exists
# guard: the subnet group exists
# guard_violation: the subnet group does not exist
# guard: the subnet group is present
# guard_violation: the subnet group is not present
atomic action DeleteCacheSubnetGroup:
    oneof sgid in SG_IDS:
        if sgid in sg_exists:
            if sg_exists[sgid]:
                sg_exists[sgid] = False

# step: tags are added to a cache resource
# result: the resource remains tagged
# guard: the resource exists
# guard_violation: the resource does not exist
# guard: the resource has tags
# guard_violation: the resource does not have tags
atomic action AddTagsToResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# step: tags are removed from a cache resource
# result: the resource tag state is unchanged (no-op model)
# guard: the resource exists
# guard_violation: the resource does not exist
# guard: the resource has tags
# guard_violation: the resource does not have tags
atomic action RemoveTagsFromResource:
    oneof cid in CLUSTER_IDS:
        if cid in tag_exists:
            if tag_exists[cid]:
                tag_exists[cid] = True

# Memcached clusters must not belong to a replication group
# check: memcached clusters are never associated with a replication group
always assertion MemcachedNotInReplicationGroup:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cluster_engine[cid] == "memcached":
                    if cluster_rg[cid] != "":
                        return False
    return True

# Snapshots can only be taken from redis clusters
# check: all snapshots reference redis clusters only
always assertion SnapshotOnlyFromRedis:
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                src = snapshot_cluster[sid]
                if src in cluster_engine:
                    if cluster_engine[src] == "memcached":
                        return False
    return True

# An available replication group must have a primary cluster set
# check: every available replication group has a primary cluster assigned
always assertion AvailableRGHasPrimary:
    for rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] == "AVAILABLE":
                if rg_primary[rgid] == "":
                    return False
    return True

# Tags exist for every active resource
# check: every active cluster, replication group, and snapshot has tags
always assertion TagsExistForResources:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] != "DELETED":
                if cid not in tag_exists:
                    return False
                if not tag_exists[cid]:
                    return False
    for rgid in RG_IDS:
        if rgid in rg_status:
            if rg_status[rgid] != "DELETED":
                if rgid not in tag_exists:
                    return False
                if not tag_exists[rgid]:
                    return False
    for sid in SNAPSHOT_IDS:
        if sid in snapshot_status:
            if snapshot_status[sid] != "DELETED":
                if sid not in tag_exists:
                    return False
                if not tag_exists[sid]:
                    return False
    return True

# A cluster in SNAPSHOTTING state must have a corresponding in-progress snapshot
# check: every snapshotting cluster has a corresponding in-progress snapshot
always assertion SnapshottingClusterHasSnapshot:
    for cid in CLUSTER_IDS:
        if cid in cluster_status:
            if cluster_status[cid] == "SNAPSHOTTING":
                found = False
                for sid in SNAPSHOT_IDS:
                    if sid in snapshot_status:
                        if snapshot_cluster[sid] == cid:
                            if snapshot_status[sid] == "CREATING":
                                found = True
                if not found:
                    return False
    return True
