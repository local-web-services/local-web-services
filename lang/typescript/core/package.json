{
  "name": "local-web-services-typescript-core",
  "version": "0.1.0",
  "description": "TypeScript core AWS service emulator for local-web-services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build",
    "test:integration": "cucumber-js",
    "test:architecture": "jest --config tests/architecture/jest.config.ts",
    "test": "npm run test:integration && npm run test:architecture",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "complexity": "npm run lint",
    "cpd": "jscpd src --min-lines 5 --reporters console",
    "type-check": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "fast-xml-parser": "^4.4.0",
    "fastify": "^4.28.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.967.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@cucumber/cucumber": "^11.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "jscpd": "^3.5.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.2.0",
    "lws-arch-tests": "file:../arch_tests",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
