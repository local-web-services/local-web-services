{
  "name": "local-web-services-sdk-typescript-example-project",
  "version": "0.1.0",
  "description": "Example project showing how to test Step Functions with the local-web-services TypeScript SDK",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-sfn": "^3.600.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "local-web-services-typescript-sdk": "file:../sdk",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testTimeout": 120000,
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    }
  }
}
