{
  "name": "local-web-services-sdk-typescript-example-project",
  "version": "0.1.0",
  "description": "Example project showing how to test Step Functions with the local-web-services TypeScript SDK",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathPattern 'tests/.*\\.test\\.ts'",
    "test:e2e": "cucumber-js",
    "test:architecture": "jest --forceExit --config tests/architecture/jest.config.ts",
    "test": "npm run test:unit && npm run test:architecture",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "complexity": "npm run lint",
    "cpd": "jscpd src --min-lines 5 --reporters console",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "local-web-services-typescript-sdk": "file:../sdk",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "jscpd": "^3.5.0",
    "lws-arch-tests": "file:../arch_tests",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testTimeout": 120000,
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/architecture/"
    ]
  }
}
